{{define "bench_options"}}
// {{.InterfaceName}}BenchOption configures [Benchmark{{.InterfaceName}}Contract].
type {{.InterfaceName}}BenchOption{{.TypeParamDecl}} func(*{{.LowerInterfaceName}}BenchConfig{{.TypeParamArgs}})

// {{.InterfaceName}}BenchPrePopulate runs before each benchmark against a fresh impl.
func {{.InterfaceName}}BenchPrePopulate{{.TypeParamDecl}}(fn func(ctx context.Context, s {{.InstantiatedType}})) {{.InterfaceName}}BenchOption{{.TypeParamArgs}} {
	return func(c *{{.LowerInterfaceName}}BenchConfig{{.TypeParamArgs}}) { c.prePopulate = fn }
}

// {{.InterfaceName}}BenchCustom adds a free-form sub-benchmark.
func {{.InterfaceName}}BenchCustom{{.TypeParamDecl}}(name string, fn func(*testing.B, {{.InstantiatedType}})) {{.InterfaceName}}BenchOption{{.TypeParamArgs}} {
	return func(c *{{.LowerInterfaceName}}BenchConfig{{.TypeParamArgs}}) {
		c.custom = append(c.custom, {{.LowerInterfaceName}}BenchCustomSub{{.TypeParamArgs}}{name: name, fn: fn})
	}
}
{{range $m := .Methods}}{{if not $m.Skip}}
// {{$.InterfaceName}}BenchOn{{$m.Name}} adds plug-in bench primitives for the {{$m.Name}} method.
func {{$.InterfaceName}}BenchOn{{$m.Name}}{{$.TypeParamDecl}}(assertions ...{{$m.OnMethodBenchType}}) {{$.InterfaceName}}BenchOption{{$.TypeParamArgs}} {
	return func(c *{{$.LowerInterfaceName}}BenchConfig{{$.TypeParamArgs}}) {
		c.on{{$m.Name}} = append(c.on{{$m.Name}}, assertions...)
	}
}
{{end}}{{end}}
type {{.LowerInterfaceName}}BenchCustomSub{{.TypeParamDecl}} struct {
	name string
	fn   func(*testing.B, {{.InstantiatedType}})
}

type {{.LowerInterfaceName}}BenchConfig{{.TypeParamDecl}} struct {
	prePopulate func(context.Context, {{.InstantiatedType}})
	custom      []{{.LowerInterfaceName}}BenchCustomSub{{.TypeParamArgs}}
{{- range .Methods}}{{if not .Skip}}
	on{{.Name}} []{{.OnMethodBenchType}}
{{- end}}{{end}}
}

func new{{.InterfaceName}}BenchConfig{{.TypeParamDecl}}(opts ...{{.InterfaceName}}BenchOption{{.TypeParamArgs}}) {{.LowerInterfaceName}}BenchConfig{{.TypeParamArgs}} {
	var cfg {{.LowerInterfaceName}}BenchConfig{{.TypeParamArgs}}
	for _, opt := range opts {
		opt(&cfg)
	}
	return cfg
}
{{end}}
