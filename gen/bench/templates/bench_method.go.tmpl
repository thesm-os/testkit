				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				return impl
			}
			wctx := bench.WriterContext[{{.InstantiatedType}}, {{.Shape.ValType}}]{
				B: b,
				WriterBindings: bindings.WriterBindings[{{.InstantiatedType}}, {{.Shape.ValType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.InstantiatedType}}, v {{.Shape.ValType}}) error {
						return impl.{{.Name}}(ctx, v)
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(wctx)
			}
		})
	}
{{- else if .IsDeleter}}
