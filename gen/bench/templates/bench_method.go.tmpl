{{- else}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			for _, fn := range cfg.on{{.Name}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				fn(b, impl)
			}
		})
	}
{{- end}}
