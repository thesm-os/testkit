{{define "bench_method"}}
func bench{{.InterfaceName}}{{.Name}}{{.TypeParamDecl}}(b *testing.B, factory func() {{.InstantiatedType}}, cfg *{{.LowerInterfaceName}}BenchConfig{{.TypeParamArgs}}) {
	b.Helper()

{{- /* Default hot-path benchmark — recover on panic from zero-value args */}}
	b.Run("{{.Name}}/hot-path", func(b *testing.B) {
		defer func() {
			if r := recover(); r != nil {
				b.Skipf("hot-path: {{.Name}} panicked on zero-value args (%v) — supply sample values via {{$.InterfaceName}}BenchOn{{.Name}}", r)
			}
		}()
		impl := factory()
		if cfg.prePopulate != nil {
			cfg.prePopulate(b.Context(), impl)
		}
		b.ResetTimer()
		b.ReportAllocs()
		for b.Loop() {
			{{.BenchIgnoredCallExpr "impl"}}
		}
	})

{{- /* Plug-in dispatch — typed context per shape */}}
{{- if .IsReader}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			prePopFactory := func() {{.InstantiatedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				return impl
			}
			rctx := bench.ReaderContext[{{.InstantiatedType}}, {{.Shape.KeyType}}, {{.Shape.ValType}}]{
				B: b,
				ReaderBindings: bindings.ReaderBindings[{{.InstantiatedType}}, {{.Shape.KeyType}}, {{.Shape.ValType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.InstantiatedType}}, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, error) {
						return impl.{{.Name}}(ctx, k)
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(rctx)
			}
		})
	}
{{- else if .IsWriter}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			prePopFactory := func() {{.InstantiatedType}} {
