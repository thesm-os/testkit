{{define "bench_method"}}
func bench{{.InterfaceName}}{{.Name}}(b *testing.B, factory func() {{.QualifiedType}}, cfg *{{.LowerInterfaceName}}BenchConfig) {
	b.Helper()

{{- /* Default hot-path benchmark — recover on panic from zero-value args */}}
	b.Run("{{.Name}}/hot-path", func(b *testing.B) {
		defer func() {
			if r := recover(); r != nil {
				b.Skipf("hot-path: {{.Name}} panicked on zero-value args (%v) — supply sample values via {{$.InterfaceName}}BenchOn{{.Name}}", r)
			}
		}()
		impl := factory()
		if cfg.prePopulate != nil {
			cfg.prePopulate(b.Context(), impl)
		}
		b.ResetTimer()
		b.ReportAllocs()
		for b.Loop() {
			{{.BenchIgnoredCallExpr "impl"}}
		}
	})

{{- /* Plug-in dispatch — typed context per shape */}}
{{- if .IsReader}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			prePopFactory := func() {{.QualifiedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				return impl
			}
			rctx := bench.ReaderContext[{{.QualifiedType}}, {{.Shape.KeyType}}, {{.Shape.ValType}}]{
				B: b,
				ReaderBindings: bindings.ReaderBindings[{{.QualifiedType}}, {{.Shape.KeyType}}, {{.Shape.ValType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.QualifiedType}}, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, error) {
						return impl.{{.Name}}(ctx, k)
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(rctx)
			}
		})
	}
{{- else if .IsWriter}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			prePopFactory := func() {{.QualifiedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				return impl
			}
			wctx := bench.WriterContext[{{.QualifiedType}}, {{.Shape.ValType}}]{
				B: b,
				WriterBindings: bindings.WriterBindings[{{.QualifiedType}}, {{.Shape.ValType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.QualifiedType}}, v {{.Shape.ValType}}) error {
						return impl.{{.Name}}(ctx, v)
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(wctx)
			}
		})
	}
{{- else if .IsDeleter}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			prePopFactory := func() {{.QualifiedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				return impl
			}
			dctx := bench.DeleterContext[{{.QualifiedType}}, {{.Shape.KeyType}}]{
				B: b,
				DeleterBindings: bindings.DeleterBindings[{{.QualifiedType}}, {{.Shape.KeyType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.QualifiedType}}, k {{.Shape.KeyType}}) error {
						return impl.{{.Name}}(ctx, k)
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(dctx)
			}
		})
	}
{{- else if .IsAggregator}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			prePopFactory := func() {{.QualifiedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				return impl
			}
			actx := bench.AggregatorContext[{{.QualifiedType}}, {{.Shape.ValType}}]{
				B: b,
				AggregatorBindings: bindings.AggregatorBindings[{{.QualifiedType}}, {{.Shape.ValType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.QualifiedType}}) ({{.Shape.ValType}}, error) {
						return impl.{{.Name}}(ctx)
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(actx)
			}
		})
	}
{{- else if .IsLifecycle}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			prePopFactory := func() {{.QualifiedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				return impl
			}
			lctx := bench.LifecycleContext[{{.QualifiedType}}]{
				B: b,
				LifecycleBindings: bindings.LifecycleBindings[{{.QualifiedType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.QualifiedType}}) error {
						return impl.{{.Name}}(ctx)
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(lctx)
			}
		})
	}
{{- else if .IsStreamReader}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			prePopFactory := func() {{.QualifiedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				return impl
			}
			sctx := bench.StreamContext[{{.QualifiedType}}, {{.Shape.IterInfo.ElemType}}]{
				B: b,
				StreamBindings: bindings.StreamBindings[{{.QualifiedType}}, {{.Shape.IterInfo.ElemType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.QualifiedType}}) iter.Seq2[{{.Shape.IterInfo.ElemType}}, error] {
{{- if .Shape.IterInfo.Seq2Error}}
						return impl.{{.Name}}({{.StreamCallArgs}})
{{- else}}
						return func(yield func({{.Shape.IterInfo.ElemType}}, error) bool) {
							for v := range impl.{{.Name}}({{.StreamCallArgs}}) {
								if !yield(v, nil) { return }
							}
						}
{{- end}}
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(sctx)
			}
		})
	}
{{- else if .IsPure}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			prePopFactory := func() {{.QualifiedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				return impl
			}
			pctx := bench.PureContext[{{.QualifiedType}}, {{.Shape.ValType}}]{
				B: b,
				PureBindings: bindings.PureBindings[{{.QualifiedType}}, {{.Shape.ValType}}]{
					Factory: prePopFactory,
					Call: func(impl {{.QualifiedType}}) {{.Shape.ValType}} {
						return impl.{{.Name}}({{.PureCallArgs}})
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(pctx)
			}
		})
	}
{{- else if .IsPredicate}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			prePopFactory := func() {{.QualifiedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				return impl
			}
			pctx := bench.PredicateContext[{{.QualifiedType}}]{
				B: b,
				PredicateBindings: bindings.PredicateBindings[{{.QualifiedType}}]{
					Factory: prePopFactory,
					Call: func(impl {{.QualifiedType}}) bool {
						return impl.{{.Name}}({{.PureCallArgs}})
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(pctx)
			}
		})
	}
{{- else}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			for _, fn := range cfg.on{{.Name}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				fn(b, impl)
			}
		})
	}
{{- end}}
}
{{end}}
