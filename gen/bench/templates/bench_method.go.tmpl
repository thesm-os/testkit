{{define "bench_method"}}
func bench{{.InterfaceName}}{{.Name}}(b *testing.B, factory func() {{.QualifiedType}}, cfg *{{.LowerInterfaceName}}BenchConfig) {
	b.Helper()

{{- /* Default hot-path benchmark — every method gets one */}}
	b.Run("{{.Name}}/hot-path", func(b *testing.B) {
		impl := factory()
		if cfg.prePopulate != nil {
			cfg.prePopulate(b.Context(), impl)
		}
		b.ResetTimer()
		b.ReportAllocs()
		for b.Loop() {
			{{.BenchIgnoredCallExpr "impl"}}
		}
	})

{{- /* Plug-in dispatch for shaped methods */}}
{{- if .IsReader}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			prePopFactory := func() {{.QualifiedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				return impl
			}
			rctx := testkit.BenchReaderContext[{{.QualifiedType}}, {{.Shape.KeyType}}, {{.Shape.ValType}}]{
				B: b,
				ReaderBindings: testkit.ReaderBindings[{{.QualifiedType}}, {{.Shape.KeyType}}, {{.Shape.ValType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.QualifiedType}}, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, error) {
						return impl.{{.Name}}(ctx, k)
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(rctx)
			}
		})
	}
{{- else}}
	if len(cfg.on{{.Name}}) > 0 {
		b.Run("{{.Name}}", func(b *testing.B) {
			for _, fn := range cfg.on{{.Name}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(b.Context(), impl)
				}
				fn(b, impl)
			}
		})
	}
{{- end}}
}
{{end}}
