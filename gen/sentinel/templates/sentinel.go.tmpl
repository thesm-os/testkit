{{define "sentinel"}}
package {{.PackageName}}

import (
	"errors"
{{- if .ErrorTypes}}
	"fmt"
{{- end}}
	"strings"
	"testing"
{{- if .ImportPath}}

	"{{.ImportPath}}"
{{- end}}

	"go.thesmos.sh/testkit"
)
{{- $q := .PkgQualifier}}{{if $q}}{{$q = printf "%s." $q}}{{end}}
{{if .Sentinels}}
func Test{{.TestName}}(t *testing.T) {
	t.Parallel()

	type errEntry struct {
		name string
		err  error
	}
	all := []errEntry{
{{- range .Sentinels}}
		{"{{.Name}}", {{$q}}{{.Name}}},
{{- end}}
	}

	t.Run("prefix", func(t *testing.T) {
		t.Parallel()
		prefix := "{{.Prefix}}"
		for _, e := range all {
			t.Run(e.name+" has correct prefix", func(t *testing.T) {
				t.Parallel()
				testkit.True(t, strings.HasPrefix(e.err.Error(), prefix),
					e.name+" must start with "+prefix)
			})
		}
	})

	t.Run("uniqueness", func(t *testing.T) {
		t.Parallel()
		seen := make(map[string]string)
		for _, e := range all {
			msg := e.err.Error()
			other, dup := seen[msg]
			testkit.False(t, dup,
				e.name+" and "+other+" have identical .Error(): "+msg)
			seen[msg] = e.name
		}
	})

	t.Run("non-overlap", func(t *testing.T) {
		t.Parallel()
		for i, a := range all {
			for j, b := range all {
				if i == j {
					continue
				}
				t.Run(a.name+" is not "+b.name, func(t *testing.T) {
					t.Parallel()
					testkit.ErrorIsNot(t, a.err, b.err,
						a.name+" must not match "+b.name)
				})
			}
		}
	})

	t.Run("unwrap chain", func(t *testing.T) {
		t.Parallel()
		for _, e := range all {
			t.Run(e.name+" preserves chain when wrapped", func(t *testing.T) {
				t.Parallel()
				wrapped := errors.Join(e.err, errors.New("extra context"))
				testkit.ErrorIs(t, wrapped, e.err,
					"wrapped "+e.name+" must satisfy errors.Is")
			})
		}
	})
}
{{end}}
{{- range $et := .ErrorTypes}}

func Test{{$et.Name}}(t *testing.T) {
	t.Parallel()

	t.Run("errors.As extracts type", func(t *testing.T) {
		t.Parallel()
{{- range $et.Fields}}
		want{{.Name}} := {{.SampleValue}}
{{- end}}
		err := &{{$q}}{{$et.Name}}{
{{- range $et.Fields}}
			{{.Name}}: want{{.Name}},
{{- end}}
		}
		target := testkit.ErrorAs[*{{$q}}{{$et.Name}}](t, err,
			"errors.As must succeed for *{{$et.Name}}")
{{- range $et.Fields}}
{{- if .IsError}}
		testkit.ErrorIs(t, target.{{.Name}}, want{{.Name}},
			"{{.Name}} must round-trip through errors.As")
{{- else}}
		testkit.Equal(t, target.{{.Name}}, want{{.Name}},
			"{{.Name}} must round-trip through errors.As")
{{- end}}
{{- end}}
	})

	t.Run("survives errors.Join wrapping", func(t *testing.T) {
		t.Parallel()
		original := &{{$q}}{{$et.Name}}{
{{- range $et.Fields}}
			{{.Name}}: {{.SampleValue}},
{{- end}}
		}
		wrapped := errors.Join(original, errors.New("extra context"))
		_ = testkit.ErrorAs[*{{$q}}{{$et.Name}}](t, wrapped,
			"errors.As must work through errors.Join")
	})

	t.Run("survives fmt.Errorf wrapping", func(t *testing.T) {
		t.Parallel()
		original := &{{$q}}{{$et.Name}}{
{{- range $et.Fields}}
			{{.Name}}: {{.SampleValue}},
{{- end}}
		}
		wrapped := fmt.Errorf("context: %w", original)
		_ = testkit.ErrorAs[*{{$q}}{{$et.Name}}](t, wrapped,
			"errors.As must work through fmt.Errorf")
	})

	t.Run("Error format includes all fields", func(t *testing.T) {
		t.Parallel()
		err := &{{$q}}{{$et.Name}}{
{{- range $et.Fields}}
			{{.Name}}: {{.SampleValue}},
{{- end}}
		}
		got := err.Error()
		testkit.Assert(t, got).
			IsNotEmpty("Error() must return non-empty string"){{- range $et.Fields}}{{if .FormatCheckValue}}.
			Contains("{{.FormatCheckValue}}", "Error() must include {{.Name}} value"){{- end}}{{end}}
	})
{{if $et.HasIs}}
	t.Run("Is matches same type", func(t *testing.T) {
		t.Parallel()
		a := &{{$q}}{{$et.Name}}{}
		b := &{{$q}}{{$et.Name}}{}
		testkit.ErrorIs(t, a, b, "Is must match same type")
	})
{{if $et.Fields}}
	t.Run("Is matches across instances with different fields", func(t *testing.T) {
		t.Parallel()
		a := &{{$q}}{{$et.Name}}{
{{- range $et.Fields}}
			{{.Name}}: {{.SampleValue}},
{{- end}}
		}
		b := &{{$q}}{{$et.Name}}{}
		testkit.ErrorIs(t, a, b,
			"Is must match across instances regardless of field values")
	})
{{end}}
	t.Run("Is rejects different error types", func(t *testing.T) {
		t.Parallel()
		err := &{{$q}}{{$et.Name}}{}
		other := errors.New("different error")
		testkit.ErrorIsNot(t, err, other,
			"Is must reject different error types")
	})
{{end}}
{{- if $et.HasUnwrap}}
	t.Run("Unwrap returns cause", func(t *testing.T) {
		t.Parallel()
		cause := errors.New("inner cause")
		err := &{{$q}}{{$et.Name}}{
{{- if $et.UnwrapField}}
			{{$et.UnwrapField}}: cause,
{{- end}}
		}
		got := err.Unwrap()
{{- if $et.UnwrapField}}
		testkit.ErrorIs(t, got, cause, "Unwrap must return the cause")
{{- end}}
	})

	t.Run("errors.Is traverses Unwrap chain", func(t *testing.T) {
		t.Parallel()
		sentinel := errors.New("findable")
		err := &{{$q}}{{$et.Name}}{
{{- if $et.UnwrapField}}
			{{$et.UnwrapField}}: sentinel,
{{- end}}
		}
{{- if $et.UnwrapField}}
		testkit.ErrorIs(t, err, sentinel,
			"errors.Is must find sentinel through Unwrap chain")
{{- end}}
	})
{{end}}
}
{{end}}
{{end}}
