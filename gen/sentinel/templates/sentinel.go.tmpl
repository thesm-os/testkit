{{define "sentinel"}}
package {{.PackageName}}

import (
	"errors"
{{- if .Sentinels}}
	"strings"
{{- end}}
	"testing"
{{- if .ImportPath}}

	"{{.ImportPath}}"
{{- end}}
)
{{- $q := .PkgQualifier}}{{if $q}}{{$q = printf "%s." $q}}{{end}}
{{if .Sentinels}}
func Test{{.TestName}}(t *testing.T) {
	t.Parallel()

	type errEntry struct {
		name string
		err  error
	}
	all := []errEntry{
{{- range .Sentinels}}
		{"{{.Name}}", {{$q}}{{.Name}}},
{{- end}}
	}

	t.Run("prefix", func(t *testing.T) {
		t.Parallel()
		prefix := "{{.Prefix}}"
		for _, e := range all {
			t.Run(e.name+" has correct prefix", func(t *testing.T) {
				t.Parallel()
				if !strings.HasPrefix(e.err.Error(), prefix) {
					t.Errorf(
						"%s: error %q must start with %q",
						e.name, e.err.Error(), prefix,
					)
				}
			})
		}
	})

	t.Run("uniqueness", func(t *testing.T) {
		t.Parallel()
		seen := make(map[string]string)
		for _, e := range all {
			msg := e.err.Error()
			if other, ok := seen[msg]; ok {
				t.Errorf(
					"%s and %s have identical .Error(): %q",
					e.name, other, msg,
				)
			}
			seen[msg] = e.name
		}
	})

	t.Run("non-overlap", func(t *testing.T) {
		t.Parallel()
		for i, a := range all {
			for j, b := range all {
				if i == j {
					continue
				}
				t.Run(a.name+" is not "+b.name, func(t *testing.T) {
					t.Parallel()
					if errors.Is(a.err, b.err) {
						t.Errorf(
							"%s must not satisfy errors.Is(%s)",
							a.name, b.name,
						)
					}
				})
			}
		}
	})

	t.Run("unwrap chain", func(t *testing.T) {
		t.Parallel()
		for _, e := range all {
			t.Run(e.name+" preserves chain when wrapped", func(t *testing.T) {
				t.Parallel()
				wrapped := errors.Join(e.err, errors.New("extra context"))
				if !errors.Is(wrapped, e.err) {
					t.Errorf("wrapped %s must satisfy errors.Is", e.name)
				}
			})
		}
	})
}
{{end}}
{{- range $et := .ErrorTypes}}

func Test{{$et.Name}}(t *testing.T) {
	t.Parallel()

	t.Run("errors.As extracts type", func(t *testing.T) {
		t.Parallel()
		var target *{{$q}}{{$et.Name}}
		err := &{{$q}}{{$et.Name}}{
{{- range $et.Fields}}
			{{.Name}}: {{.SampleValue}},
{{- end}}
		}
		if !errors.As(err, &target) {
			t.Fatal("errors.As must succeed for *{{$et.Name}}")
		}
{{- range $et.Fields}}
		if target.{{.Name}} != {{.SampleValue}} {
			t.Errorf("{{.Name}}: got %v, want %v", target.{{.Name}}, {{.SampleValue}})
		}
{{- end}}
	})

	t.Run("survives wrapping", func(t *testing.T) {
		t.Parallel()
		var target *{{$q}}{{$et.Name}}
		original := &{{$q}}{{$et.Name}}{
{{- range $et.Fields}}
			{{.Name}}: {{.SampleValue}},
{{- end}}
		}
		wrapped := errors.Join(original, errors.New("extra context"))
		if !errors.As(wrapped, &target) {
			t.Fatal("errors.As must work through wrapping for *{{$et.Name}}")
		}
	})

	t.Run("Error returns non-empty string", func(t *testing.T) {
		t.Parallel()
		err := &{{$q}}{{$et.Name}}{}
		if err.Error() == "" {
			t.Error("Error() must return non-empty string")
		}
	})
{{if $et.HasIs}}
	t.Run("Is matching works", func(t *testing.T) {
		t.Parallel()
		a := &{{$q}}{{$et.Name}}{
{{- range $et.Fields}}
			{{.Name}}: {{.SampleValue}},
{{- end}}
		}
		b := &{{$q}}{{$et.Name}}{}
		if !errors.Is(a, b) {
			t.Error("Is must match same type")
		}
	})
{{end}}
{{- if $et.HasUnwrap}}
	t.Run("Unwrap is accessible", func(t *testing.T) {
		t.Parallel()
		err := &{{$q}}{{$et.Name}}{}
		// Verify Unwrap() does not panic on zero value.
		_ = err.Unwrap()
	})
{{end}}
}
{{end}}
{{end}}
