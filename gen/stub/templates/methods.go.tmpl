{{define "methods"}}
// --- Interface method implementations ---
{{range $m := .Methods}}{{if not $m.Skip}}
func (s *{{$.StubName}}{{$.TypeParamArgs}}) {{$m.Name}}({{$m.ParamList}}){{if $m.ResultList}} {{$m.ResultList}}{{end}} {
{{- if $m.Deprecated}}
	if tb := s.On{{$m.Name}}.TB(); tb != nil {
		tb.Logf("{{$.TypeName}}.{{$m.Name}} is deprecated, use {{$m.Deprecated}} instead")
	}
{{- end}}
{{- if $m.OrderAfter}}
	s.order.AssertAfter("{{$m.Name}}", "{{$m.OrderAfter}}")
{{- end}}
	s.On{{$m.Name}}.SleepLatency()
{{- if $.HasOrderConstraint}}
	defer s.order.Record("{{$m.Name}}")
{{- end}}
	call := {{$m.QualCallType}}{{"{"}}{{$m.ParamFieldAssign}}}
{{- if $m.ReturnsError}}
	if fired, faultErr := s.On{{$m.Name}}.ShouldFaultFor(call); fired {
		call.{{$m.ErrFieldName}} = faultErr
		s.On{{$m.Name}}.Record(call)
		return {{$m.FaultReturn}}
	}
{{- end}}
	if s.On{{$m.Name}}.fn != nil {
		{{$m.ResultVarDecl}}s.On{{$m.Name}}.fn({{$m.ParamNamesSpread}})
{{- if $m.HasResults}}
		{{$m.CallResultStampVars}}
{{- end}}
		s.On{{$m.Name}}.Record(call)
{{- if $m.HasResults}}
		return {{$m.ResultVarNames}}
{{- else}}
		return
{{- end}}
	}
{{- if $m.HasResults}}
	if s.On{{$m.Name}}.fallback != nil {
		f := s.On{{$m.Name}}.fallback
		{{$m.CallResultStampFallback}}
		s.On{{$m.Name}}.Record(call)
		return {{$m.ReturnFromFallback}}
	}
{{- end}}
	s.On{{$m.Name}}.FailUnexpectedCall(call)
	s.On{{$m.Name}}.Record(call)
{{- if $m.HasResults}}
	return {{$m.ZeroReturn}}
{{- end}}
}
{{end}}{{end}}
{{end}}
