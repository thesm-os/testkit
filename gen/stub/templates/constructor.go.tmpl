{{define "constructor"}}
// --- {{.StubName}} ---

// {{.StubName}}Option configures a [{{.StubName}}] at construction time.
type {{.StubName}}Option func(*{{.StubName}})

// {{.StubName}}Strict enables strict mode — unconfigured methods fail the test.
func {{.StubName}}Strict() {{.StubName}}Option {
	return func(s *{{.StubName}}) { s.strict = true }
}

// {{.StubName}}DelegateTo wraps a real implementation — all calls delegate to
// impl and are recorded on the outer stub.
func {{.StubName}}DelegateTo(impl {{.QualifiedType}}) {{.StubName}}Option {
	return func(s *{{.StubName}}) {
{{- range .Methods}}{{if not .Skip}}
		s.On{{.Name}}.Func(impl.{{.Name}})
{{- end}}{{end}}
	}
}
// {{.StubName}}WithClock injects a [clock.Clock] into all per-method stubs.
// Use [clock.NewTestClock] for deterministic virtual time or a consumer's
// own clock implementation. Default is real wall-clock time.
func {{.StubName}}WithClock(clk clock.Clock) {{.StubName}}Option {
	return func(s *{{.StubName}}) {
{{- range .Methods}}{{if not .Skip}}
		s.On{{.Name}}.WithClock(clk)
{{- end}}{{end}}
	}
}

// {{.StubName}}WithRandSource injects a [rand.Source] into all per-method
// stubs. Use [rand.FixedRandSource] for deterministic testing or a consumer's
// own seeded RNG. Default is [rand.DefaultRandSource] (math/rand/v2).
func {{.StubName}}WithRandSource(src rand.Source) {{.StubName}}Option {
	return func(s *{{.StubName}}) {
{{- range .Methods}}{{if not .Skip}}
		s.On{{.Name}}.WithRandSource(src)
{{- end}}{{end}}
	}
}

// {{.StubName}}BenchMode disables call recording on all per-method stubs. Use
// this in benchmarks to avoid allocation overhead from accumulated call logs.
// Dispatch (Func, Returns, Faults) still works normally.
func {{.StubName}}BenchMode() {{.StubName}}Option {
	return func(s *{{.StubName}}) {
{{- range .Methods}}{{if not .Skip}}
		s.On{{.Name}}.BenchMode()
{{- end}}{{end}}
	}
}
{{range .Methods}}{{if not .Skip}}
// With{{$.TypeName}}{{.Name}} sets a function override at construction time.
func With{{$.TypeName}}{{.Name}}(fn {{.FuncTypeStr}}) {{$.StubName}}Option {
	return func(s *{{$.StubName}}) { s.On{{.Name}}.Func(fn) }
}
{{end}}{{end}}

// {{.StubName}} is a configurable test double for [{{.QualifiedType}}].
type {{.StubName}} struct {
{{- range .Methods}}{{if not .Skip}}
	On{{.Name}} *{{.StubType}}
{{- end}}{{end}}
{{- if .HasOrderConstraint}}
	order *stub.OrderTracker
{{- end}}
	strict bool
}

// New{{.StubName}} creates a stub. Pass tb for auto-verification of
// expectations at test cleanup. Pass nil for a pure stub.
func New{{.StubName}}(tb testing.TB, opts ...{{.StubName}}Option) *{{.StubName}} {
	s := &{{.StubName}}{
{{- range .Methods}}{{if not .Skip}}
		On{{.Name}}: &{{.StubType}}{MethodStub: stub.NewMethodStub[{{.CallType}}](tb, "{{$.TypeName}}.{{.Name}}")},
{{- end}}{{end}}
	}
	for _, opt := range opts {
		opt(s)
	}
	if s.strict {
{{- range .Methods}}{{if not .Skip}}
		s.On{{.Name}}.Strict()
{{- end}}{{end}}
	}
{{- if .HasOrderConstraint}}
	s.order = stub.NewOrderTracker(tb, s.strict)
{{- end}}
	if tb != nil {
		if _, isFuzz := tb.(*testing.F); !isFuzz {
			tb.Cleanup(func() {
{{- range .Methods}}{{if not .Skip}}
				s.On{{.Name}}.Verify()
{{- end}}{{end}}
			})
		}
	}
	return s
}

// ResetCalls clears recorded calls, fault counters, and call-count expectations.
// Func, Returns, and Faults configuration is preserved.
func (s *{{.StubName}}) ResetCalls() {
{{- range .Methods}}{{if not .Skip}}
	s.On{{.Name}}.Reset()
{{- end}}{{end}}
{{- if .HasOrderConstraint}}
	s.order.Reset()
{{- end}}
}
{{end}}
