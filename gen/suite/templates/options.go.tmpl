{{define "options"}}
// {{.InterfaceName}}Option configures [Assert{{.InterfaceName}}Contract].
type {{.InterfaceName}}Option func(*{{.LowerInterfaceName}}Config)

// PrePopulate runs before subtests that need pre-populated state.
// Called once per subtest against a fresh impl from the factory.
func PrePopulate(fn func(t testing.TB, s {{.QualifiedType}})) {{.InterfaceName}}Option {
	return func(c *{{.LowerInterfaceName}}Config) { c.prePopulate = fn }
}

// AssertCustom adds a free-form subtest to the contract. Use this for
// contracts not expressible via shape-specific primitives.
func AssertCustom(name string, fn func(*testing.T, {{.QualifiedType}})) {{.InterfaceName}}Option {
	return func(c *{{.LowerInterfaceName}}Config) {
		c.custom = append(c.custom, customSubtest{name: name, fn: fn})
	}
}
{{range $m := .Methods}}{{if not $m.Skip}}
// On{{$m.Name}} adds plug-in assertions for the {{$m.Name}} method.
func On{{$m.Name}}(assertions ...{{$m.OnMethodAssertionType}}) {{$.InterfaceName}}Option {
	return func(c *{{$.LowerInterfaceName}}Config) {
		c.on{{$m.Name}} = append(c.on{{$m.Name}}, assertions...)
	}
}
{{end}}{{end}}
// OnAll adds cross-method assertions that span multiple methods.
func OnAll(assertions ...testkit.CrossMethodAssertion[{{.QualifiedType}}]) {{.InterfaceName}}Option {
	return func(c *{{.LowerInterfaceName}}Config) {
		c.onAll = append(c.onAll, assertions...)
	}
}

type customSubtest struct {
	name string
	fn   func(*testing.T, {{.QualifiedType}})
}

type {{.LowerInterfaceName}}Config struct {
	prePopulate func(testing.TB, {{.QualifiedType}})
	custom      []customSubtest
	onAll       []testkit.CrossMethodAssertion[{{.QualifiedType}}]
{{- range .Methods}}{{if not .Skip}}
	on{{.Name}} []{{.OnMethodAssertionType}}
{{- end}}{{end}}
}

func new{{.InterfaceName}}Config(opts ...{{.InterfaceName}}Option) {{.LowerInterfaceName}}Config {
	var cfg {{.LowerInterfaceName}}Config
	for _, opt := range opts {
		opt(&cfg)
	}
	return cfg
}
{{end}}

