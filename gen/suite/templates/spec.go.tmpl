{{define "spec"}}
package {{.PackageName}}
{{template "imports" .}}

// Assert{{.InterfaceName}}Contract runs conformance assertions against
// implementations of [{{.QualifiedType}}] produced by factory.
//
// Default subtests are auto-detected from method signatures. Directive-derived
// subtests add contract assertions. Plug-in primitives via On<Method> add
// typed shape-specific assertions.
func Assert{{.InterfaceName}}Contract(
	t *testing.T,
	factory func() {{.QualifiedType}},
	opts ...{{.InterfaceName}}Option,
) {
	t.Helper()
	cfg := new{{.InterfaceName}}Config(opts...)
{{range $m := .Methods}}{{if not $m.Skip}}
	run{{$.InterfaceName}}{{$m.Name}}(t, factory, &cfg)
{{- end}}{{end}}

	for _, a := range cfg.onAll {
		cctx := testkit.CrossContext[{{.QualifiedType}}]{
			T:       t,
			Factory: factory,
		}
		a(cctx)
	}

	for _, custom := range cfg.custom {
		t.Run(custom.name, func(t *testing.T) {
			t.Parallel()
			custom.fn(t, factory())
		})
	}
}
{{range $m := .Methods}}{{if not $m.Skip}}
{{template "method" $m}}
{{- end}}{{end}}

{{template "options" .}}
{{end}}

{{define "imports"}}
{{- if .Imports}}
import (
{{- range .Imports}}
	{{if .Alias}}{{.Alias}} {{end}}"{{.Path}}"
{{- end}}
)
{{- end}}
{{end}}
