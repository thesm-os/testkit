{{- else}}
	if len(cfg.on{{.Name}}) > 0 {
		t.Run("{{.Name}}", func(t *testing.T) {
			for _, fn := range cfg.on{{.Name}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(t.Context(), impl)
				}
				fn(t, impl)
			}
		})
