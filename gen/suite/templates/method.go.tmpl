			rctx := suite.ReaderWithBoolContext[{{.InstantiatedType}}, {{.Shape.KeyType}}, {{.Shape.ValType}}]{
				T: t,
				ReaderWithBoolBindings: bindings.ReaderWithBoolBindings[{{.InstantiatedType}}, {{.Shape.KeyType}}, {{.Shape.ValType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.InstantiatedType}}, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, bool) {
{{- if .HasCtx}}
						return impl.{{.Name}}(ctx, k)
{{- else}}
						return impl.{{.Name}}(k)
{{- end}}
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
