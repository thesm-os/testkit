{{define "method"}}
func run{{.InterfaceName}}{{.Name}}(t *testing.T, factory func() {{.QualifiedType}}, cfg *{{.LowerInterfaceName}}Config) {
	t.Helper()

{{template "subtests" .}}

{{- /* Plug-in dispatch — single method-named wrapper, primitives nest inside */}}
{{- if .IsReader}}
	if len(cfg.on{{.Name}}) > 0 {
		t.Run("{{.Name}}", func(t *testing.T) {
			prePopFactory := func() {{.QualifiedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(t, impl)
				}
				return impl
			}
			rctx := testkit.ReaderContext[{{.QualifiedType}}, {{.Shape.KeyType}}, {{.Shape.ValType}}]{
				T:       t,
				Factory: prePopFactory,
				Call: func(impl {{.QualifiedType}}, ctx context.Context, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, error) {
					return impl.{{.Name}}(ctx, k)
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(rctx)
			}
		})
	}
{{- else if .IsWriter}}
	if len(cfg.on{{.Name}}) > 0 {
		t.Run("{{.Name}}", func(t *testing.T) {
			prePopFactory := func() {{.QualifiedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(t, impl)
				}
				return impl
			}
			wctx := testkit.WriterContext[{{.QualifiedType}}, {{.Shape.ValType}}]{
				T:       t,
				Factory: prePopFactory,
				Call: func(impl {{.QualifiedType}}, ctx context.Context, v {{.Shape.ValType}}) error {
					return impl.{{.Name}}(ctx, v)
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(wctx)
			}
		})
	}
{{- else if .IsStreamReader}}
	if len(cfg.on{{.Name}}) > 0 {
		t.Run("{{.Name}}", func(t *testing.T) {
			prePopFactory := func() {{.QualifiedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(t, impl)
				}
				return impl
			}
			sctx := testkit.StreamContext[{{.QualifiedType}}, {{.Shape.IterInfo.ElemType}}]{
				T:       t,
				Factory: prePopFactory,
				Call: func(impl {{.QualifiedType}}) iter.Seq2[{{.Shape.IterInfo.ElemType}}, error] {
{{- if .Shape.IterInfo.Seq2Error}}
					return impl.{{.Name}}({{.ZeroCallArgs}})
{{- else}}
					return func(yield func({{.Shape.IterInfo.ElemType}}, error) bool) {
						for v := range impl.{{.Name}}({{.ZeroCallArgs}}) {
							if !yield(v, nil) { return }
						}
					}
{{- end}}
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(sctx)
			}
		})
	}
{{- else}}
	if len(cfg.on{{.Name}}) > 0 {
		t.Run("{{.Name}}", func(t *testing.T) {
			for _, fn := range cfg.on{{.Name}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(t, impl)
				}
				fn(t, impl)
			}
		})
	}
{{- end}}
}
{{end}}
