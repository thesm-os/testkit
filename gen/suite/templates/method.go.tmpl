{{define "method"}}
func run{{.InterfaceName}}{{.Name}}{{.TypeParamDecl}}(t *testing.T, factory func() {{.InstantiatedType}}, cfg *{{.LowerInterfaceName}}Config{{.TypeParamArgs}}) {
	t.Helper()

{{template "subtests" .}}

{{- /* Plug-in dispatch — single method-named wrapper, primitives nest inside */}}
{{- if .IsReader}}
	if len(cfg.on{{.Name}}) > 0 {
		t.Run("{{.Name}}", func(t *testing.T) {
			prePopFactory := func() {{.InstantiatedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(t.Context(), impl)
				}
				return impl
			}
			rctx := suite.ReaderContext[{{.InstantiatedType}}, {{.Shape.KeyType}}, {{.Shape.ValType}}]{
				T: t,
				ReaderBindings: bindings.ReaderBindings[{{.InstantiatedType}}, {{.Shape.KeyType}}, {{.Shape.ValType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.InstantiatedType}}, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, error) {
						return impl.{{.Name}}(ctx, k)
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(rctx)
			}
		})
	}
{{- else if .IsWriter}}
	if len(cfg.on{{.Name}}) > 0 {
		t.Run("{{.Name}}", func(t *testing.T) {
