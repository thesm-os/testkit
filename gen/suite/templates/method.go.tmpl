			wctx := suite.WriterContext[{{.InstantiatedType}}, {{.Shape.ValType}}]{
				T: t,
				WriterBindings: bindings.WriterBindings[{{.InstantiatedType}}, {{.Shape.ValType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.InstantiatedType}}, v {{.Shape.ValType}}) error {
						return impl.{{.Name}}(ctx, v)
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(wctx)
			}
		})
	}
{{- else if .IsStreamReader}}
	if len(cfg.on{{.Name}}) > 0 {
		t.Run("{{.Name}}", func(t *testing.T) {
			prePopFactory := func() {{.InstantiatedType}} {
				impl := factory()
				if cfg.prePopulate != nil {
					cfg.prePopulate(t.Context(), impl)
				}
				return impl
			}
			sctx := suite.StreamContext[{{.InstantiatedType}}, {{.Shape.IterInfo.ElemType}}]{
				T: t,
				StreamBindings: bindings.StreamBindings[{{.InstantiatedType}}, {{.Shape.IterInfo.ElemType}}]{
					Factory: prePopFactory,
					Call: func(ctx context.Context, impl {{.InstantiatedType}}) iter.Seq2[{{.Shape.IterInfo.ElemType}}, error] {
{{- if .Shape.IterInfo.Seq2Error}}
						return impl.{{.Name}}({{.StreamCallArgs "impl"}})
{{- else}}
						return func(yield func({{.Shape.IterInfo.ElemType}}, error) bool) {
							for v := range impl.{{.Name}}({{.StreamCallArgs "impl"}}) {
								if !yield(v, nil) { return }
							}
						}
{{- end}}
					},
				},
			}
			for _, a := range cfg.on{{.Name}} {
				a(sctx)
			}
		})
	}
