{{define "builder"}}
package {{.PackageName}}

{{template "imports" .}}
{{- range $s := .Structs}}
{{- $bd := printf "%s%s" $s.BuilderName $s.TypeParamDecl}}
{{- $ba := printf "%s%s" $s.BuilderName $s.TypeParamArgs}}

// {{$s.BuilderName}} constructs [{{$s.QualifiedType}}] values for tests.
// Start with [New{{$s.Name}}] or [New{{$s.Name}}From], override fields
// with With* setters, call [{{$s.BuilderName}}.Build].
type {{$bd}} struct {
	v {{$s.QualifiedType}}
}

// New{{$s.Name}} creates a builder{{if $s.HasDefaults}} seeded with
// [{{$s.DefaultsFunc}}]{{else if $s.HasFieldDefaults}} seeded with
// directive defaults{{else}} with zero values{{end}}.
func New{{$s.Name}}{{$s.TypeParamDecl}}() *{{$ba}} {
{{- if $s.HasDefaults}}
	return &{{$ba}}{v: {{$s.DefaultsFunc}}()}
{{- else if $s.HasFieldDefaults}}
	return &{{$ba}}{v: {{$s.QualifiedType}}{
{{- range $s.Fields}}{{if .DefaultValue}}
		{{.Name}}: {{.DefaultValue}},
{{- end}}{{end}}
	}}
{{- else}}
	return &{{$ba}}{}
{{- end}}
}

// New{{$s.Name}}From creates a builder seeded with the given value.
func New{{$s.Name}}From{{$s.TypeParamDecl}}(v {{$s.QualifiedType}}) *{{$ba}} {
	return &{{$ba}}{v: v}
}
{{range $f := $s.Fields}}
{{- if $f.IsSlice}}
// With{{$f.Name}} replaces the {{$f.Name}} slice.
func (b *{{$ba}}) With{{$f.Name}}(v ...{{$f.ElemTypeStr}}) *{{$ba}} {
	b.v.{{$f.Name}} = v
	return b
}

// Append{{$f.Name}} appends to the {{$f.Name}} slice.
func (b *{{$ba}}) Append{{$f.Name}}(v ...{{$f.ElemTypeStr}}) *{{$ba}} {
	b.v.{{$f.Name}} = append(b.v.{{$f.Name}}, v...)
	return b
}
{{else if $f.IsMap}}
// With{{$f.Name}} replaces the {{$f.Name}} map.
func (b *{{$ba}}) With{{$f.Name}}(m {{$f.TypeStr}}) *{{$ba}} {
	b.v.{{$f.Name}} = m
	return b
}

// With{{$f.Name}}Entry adds or replaces a single entry in {{$f.Name}}.
func (b *{{$ba}}) With{{$f.Name}}Entry(k {{$f.MapKeyTypeStr}}, v {{$f.MapValTypeStr}}) *{{$ba}} {
	if b.v.{{$f.Name}} == nil {
		b.v.{{$f.Name}} = {{$f.TypeStr}}{}
	}
	b.v.{{$f.Name}}[k] = v
	return b
}
{{else if $f.IsBytes}}
// With{{$f.Name}} sets the {{$f.Name}} field.
func (b *{{$ba}}) With{{$f.Name}}(v []byte) *{{$ba}} {
	b.v.{{$f.Name}} = v
	return b
}

// With{{$f.Name}}String sets {{$f.Name}} from a string.
func (b *{{$ba}}) With{{$f.Name}}String(s string) *{{$ba}} {
	b.v.{{$f.Name}} = []byte(s)
	return b
}
{{else}}
// With{{$f.Name}} sets the {{$f.Name}} field.
func (b *{{$ba}}) With{{$f.Name}}(v {{$f.TypeStr}}) *{{$ba}} {
	b.v.{{$f.Name}} = v
	return b
}
{{end}}
{{- end}}
// Mutate applies fn to the value under construction. Use for
// deeply nested fields or mutations that don't warrant a setter.
func (b *{{$ba}}) Mutate(fn func(*{{$s.QualifiedType}})) *{{$ba}} {
	fn(&b.v)
	return b
}

// Clone returns a deep copy of the builder. Slice and map fields
// are copied so mutations to the clone do not affect the original.
func (b *{{$ba}}) Clone() *{{$ba}} {
	out := &{{$ba}}{v: b.v}
{{- range $f := $s.Fields}}
{{- if $f.IsSlice}}
	if b.v.{{$f.Name}} != nil {
		out.v.{{$f.Name}} = append([]{{$f.ElemTypeStr}}(nil), b.v.{{$f.Name}}...)
	}
{{- else if $f.IsMap}}
	if b.v.{{$f.Name}} != nil {
		out.v.{{$f.Name}} = make({{$f.TypeStr}}, len(b.v.{{$f.Name}}))
		for k, v := range b.v.{{$f.Name}} {
			out.v.{{$f.Name}}[k] = v
		}
	}
{{- else if $f.IsBytes}}
	if b.v.{{$f.Name}} != nil {
		out.v.{{$f.Name}} = append([]byte(nil), b.v.{{$f.Name}}...)
	}
{{- end}}
{{- end}}
	return out
}

// Build returns the constructed [{{$s.QualifiedType}}].
func (b *{{$ba}}) Build() {{$s.QualifiedType}} {
	return b.v
}
{{end}}
{{end}}
