{{define "builder"}}
package {{.PackageName}}

{{template "imports" .}}
{{- range $s := .Structs}}

// {{$s.BuilderName}} constructs [{{$s.QualifiedType}}] values for tests.
// Start with [New{{$s.BuilderName}}], override fields with With* setters,
// call [{{$s.BuilderName}}.Build].
type {{$s.BuilderName}} struct {
	v {{$s.QualifiedType}}
}

// New{{$s.BuilderName}} creates a builder with zero values.
func New{{$s.BuilderName}}() *{{$s.BuilderName}} {
	return &{{$s.BuilderName}}{}
}
{{range $s.Fields}}
// With{{.Name}} sets the {{.Name}} field.
func (b *{{$s.BuilderName}}) With{{.Name}}(v {{.TypeStr}}) *{{$s.BuilderName}} {
	b.v.{{.Name}} = v
	return b
}
{{end}}
// Build returns the constructed [{{$s.QualifiedType}}].
func (b *{{$s.BuilderName}}) Build() {{$s.QualifiedType}} {
	return b.v
}
{{end}}
{{end}}
