{{define "builder"}}
package {{.PackageName}}

{{template "imports" .}}
{{- range $s := .Structs}}

// {{$s.BuilderName}} constructs [{{$s.QualifiedType}}] values for tests.
// Start with [New{{$s.Name}}] or [New{{$s.Name}}From], override fields
// with With* setters, call [{{$s.BuilderName}}.Build].
type {{$s.BuilderName}} struct {
	v {{$s.QualifiedType}}
}

// New{{$s.Name}} creates a builder{{if $s.HasDefaults}} seeded with
// [{{$s.DefaultsFunc}}]{{else if $s.HasFieldDefaults}} seeded with
// directive defaults{{else}} with zero values{{end}}.
func New{{$s.Name}}() *{{$s.BuilderName}} {
{{- if $s.HasDefaults}}
	return &{{$s.BuilderName}}{v: {{$s.DefaultsFunc}}()}
{{- else if $s.HasFieldDefaults}}
	return &{{$s.BuilderName}}{v: {{$s.QualifiedType}}{
{{- range $s.Fields}}{{if .DefaultValue}}
		{{.Name}}: {{.DefaultValue}},
{{- end}}{{end}}
	}}
{{- else}}
	return &{{$s.BuilderName}}{}
{{- end}}
}

// New{{$s.Name}}From creates a builder seeded with the given value.
func New{{$s.Name}}From(v {{$s.QualifiedType}}) *{{$s.BuilderName}} {
	return &{{$s.BuilderName}}{v: v}
}
{{range $s.Fields}}
// With{{.Name}} sets the {{.Name}} field.
{{- if .IsSlice}}
func (b *{{$s.BuilderName}}) With{{.Name}}(v ...{{.ElemTypeStr}}) *{{$s.BuilderName}} {
{{- else}}
func (b *{{$s.BuilderName}}) With{{.Name}}(v {{.TypeStr}}) *{{$s.BuilderName}} {
{{- end}}
	b.v.{{.Name}} = v
	return b
}
{{end}}
// Mutate applies fn to the value under construction. Use for
// deeply nested fields or mutations that don't warrant a setter.
func (b *{{$s.BuilderName}}) Mutate(fn func(*{{$s.QualifiedType}})) *{{$s.BuilderName}} {
	fn(&b.v)
	return b
}

// Clone returns a copy of the builder. Use to fork variants
// from a shared base.
func (b *{{$s.BuilderName}}) Clone() *{{$s.BuilderName}} {
	return &{{$s.BuilderName}}{v: b.v}
}

// Build returns the constructed [{{$s.QualifiedType}}].
func (b *{{$s.BuilderName}}) Build() {{$s.QualifiedType}} {
	return b.v
}
{{end}}
{{end}}
