package {{.PackageName}}
{{if .Imports}}
import (
{{- range .Imports}}
	{{if .Alias}}{{.Alias}} {{end}}"{{.Path}}"
{{- end}}
)
{{end}}
{{- $gen := .GenQualifier -}}
{{- $dot := "" -}}
{{- if $gen}}{{$dot = "."}}{{end -}}
{{range $s := .Structs}}
func Test{{$s.BuilderName}}(t *testing.T) {
	t.Parallel()
{{if not $s.HasUnexported}}
	t.Run("Build without setters returns defaults", func(t *testing.T) {
		t.Parallel()
		defaults := {{$s.QualifiedType}}{}
		got := {{$gen}}{{$dot}}New{{$s.BuilderName}}(defaults).Build()
		testkit.Equal(t, got, defaults, "must return defaults unchanged")
	})

	t.Run("NewDefault returns zero value", func(t *testing.T) {
		t.Parallel()
		got := {{$gen}}{{$dot}}NewDefault{{$s.BuilderName}}().Build()
		testkit.Equal(t, got, {{$s.QualifiedType}}{}, "must return zero value")
	})
{{else}}
	t.Run("Build without setters does not panic", func(t *testing.T) {
		t.Parallel()
		defaults := {{$s.QualifiedType}}{}
		_ = {{$gen}}{{$dot}}New{{$s.BuilderName}}(defaults).Build()
	})

	t.Run("NewDefault does not panic", func(t *testing.T) {
		t.Parallel()
		_ = {{$gen}}{{$dot}}NewDefault{{$s.BuilderName}}().Build()
	})
{{end}}{{range $s.Fields}}{{if eq .TestKind 0}}
	t.Run("With{{.Name}} sets the {{.Name}} field", func(t *testing.T) {
		t.Parallel()
		sample := {{.SampleValue}}
		got := {{$gen}}{{$dot}}NewDefault{{$s.BuilderName}}().With{{.Name}}(sample).Build()
		testkit.Equal(t, got.{{.Name}}, sample, "With{{.Name}} must set {{.Name}}")
	})
{{else if eq .TestKind 1}}
	t.Run("With{{.Name}} sets the {{.Name}} field", func(t *testing.T) {
		t.Parallel()
		sample := {{.SampleValue}}
		got := {{$gen}}{{$dot}}NewDefault{{$s.BuilderName}}().With{{.Name}}(&sample).Build()
		if got.{{.Name}} == nil {
			t.Fatal("With{{.Name}} must set non-nil pointer")
		}
		testkit.Equal(t, *got.{{.Name}}, sample, "With{{.Name}} must set {{.Name}}")
	})
{{else}}
	t.Run("With{{.Name}} compiles and sets field", func(t *testing.T) {
		t.Parallel()
		got := {{$gen}}{{$dot}}NewDefault{{$s.BuilderName}}().With{{.Name}}({{.SampleValue}}).Build()
		_ = got
	})
{{end}}{{end}}
}
{{end}}
