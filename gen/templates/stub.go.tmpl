package {{.PackageName}}
{{if .Imports}}
import (
{{- range .Imports}}
	{{if .Alias}}{{.Alias}} {{end}}"{{.Path}}"
{{- end}}
)
{{end}}
{{- range $iface := .Interfaces}}
// Compile-time interface check.
var _ {{$iface.QualifiedType}} = (*{{$iface.StubName}})(nil)

// --- Call types ---
{{range $iface.Methods}}
// {{.CallType}} records one invocation of {{$iface.QualifiedType}}.{{.Name}}.
type {{.CallType}} struct {
{{- range .Params}}
	{{.FieldName}} {{.TypeStr}}
{{- end}}
{{- range .Results}}
	{{.FieldName}} {{.TypeStr}}
{{- end}}
}
{{end}}

// --- Per-method stubs ---
{{range $m := $iface.Methods}}
// {{$m.StubType}} controls behavior and records calls for {{$m.Name}}.
type {{$m.StubType}} struct {
	*testkit.MethodStub[{{$m.CallType}}]
	fn       {{$m.FuncTypeStr}}
	fallback *{{$m.ReturnType}}
}

type {{$m.ReturnType}} struct {
{{- range $m.Results}}
	{{.FieldName}} {{.TypeStr}}
{{- end}}
}

// Returns sets a fixed return value for {{$m.Name}}.
func (s *{{$m.StubType}}) Returns({{$m.ReturnParams}}) *{{$m.StubType}} {
	s.fallback = &{{$m.ReturnType}}{{"{"}}{{$m.ReturnFieldAssign}}}
	return s
}

// Func sets a function override for {{$m.Name}}.
func (s *{{$m.StubType}}) Func(fn {{$m.FuncTypeStr}}) *{{$m.StubType}} {
	s.fn = fn
	return s
}
{{end}}

// --- {{$iface.StubName}} ---

// {{$iface.StubName}}Option configures a [{{$iface.StubName}}] at construction time.
type {{$iface.StubName}}Option func(*{{$iface.StubName}})

// {{$iface.StubName}}Strict enables strict mode — unconfigured methods fail the test.
func {{$iface.StubName}}Strict() {{$iface.StubName}}Option {
	return func(s *{{$iface.StubName}}) { s.strict = true }
}

// {{$iface.StubName}}DelegateTo wraps a real implementation — all calls delegate and are recorded.
func {{$iface.StubName}}DelegateTo(impl {{$iface.QualifiedType}}) {{$iface.StubName}}Option {
	return func(s *{{$iface.StubName}}) {
{{- range $iface.Methods}}
		s.On{{.Name}}.Func(impl.{{.Name}})
{{- end}}
	}
}
{{range $iface.Methods}}
// With{{$iface.TypeName}}{{.Name}} sets a function override at construction time.
func With{{$iface.TypeName}}{{.Name}}(fn {{.FuncTypeStr}}) {{$iface.StubName}}Option {
	return func(s *{{$iface.StubName}}) { s.On{{.Name}}.Func(fn) }
}
{{end}}

// {{$iface.StubName}} is a configurable test double for [{{$iface.QualifiedType}}].
type {{$iface.StubName}} struct {
{{- range $iface.Methods}}
	On{{.Name}} *{{.StubType}}
{{- end}}
	strict bool
}

// New{{$iface.StubName}} creates a stub. Pass tb for auto-verification of
// expectations at test cleanup. Pass nil for a pure stub.
func New{{$iface.StubName}}(tb testing.TB, opts ...{{$iface.StubName}}Option) *{{$iface.StubName}} {
	s := &{{$iface.StubName}}{
{{- range $iface.Methods}}
		On{{.Name}}: &{{.StubType}}{MethodStub: testkit.NewMethodStub[{{.CallType}}](tb, "{{$iface.TypeName}}.{{.Name}}")},
{{- end}}
	}
	for _, opt := range opts {
		opt(s)
	}
	if s.strict {
{{- range $iface.Methods}}
		s.On{{.Name}}.Strict()
{{- end}}
	}
	if tb != nil {
		tb.Cleanup(func() {
{{- range $iface.Methods}}
			s.On{{.Name}}.Verify()
{{- end}}
		})
	}
	return s
}

// Reset clears all recordings, fault counters, and expectations.
func (s *{{$iface.StubName}}) Reset() {
{{- range $iface.Methods}}
	s.On{{.Name}}.Reset()
{{- end}}
}

// --- Interface method implementations ---
{{range $m := $iface.Methods}}
func (s *{{$iface.StubName}}) {{$m.Name}}({{$m.ParamListStr}}){{if $m.ResultListStr}} {{$m.ResultListStr}}{{end}} {
{{- if $m.ReturnsError}}
	if fired, faultErr := s.On{{$m.Name}}.ShouldFault(); fired {
		call := {{$m.CallType}}{{"{"}}{{$m.ParamFieldAssign}}{{$m.ErrFieldName}}: faultErr}
		s.On{{$m.Name}}.Record(call)
		return {{$m.FaultReturn}}
	}
{{- end}}
	if s.On{{$m.Name}}.fn != nil {
		{{$m.ResultVarDecl}}s.On{{$m.Name}}.fn({{$m.ParamNames}})
		call := {{$m.CallType}}{{"{"}}{{$m.ParamFieldAssign}}{{$m.ResultFieldAssignVars}}}
		s.On{{$m.Name}}.Record(call)
		return {{$m.ResultVarNames}}
	}
	if s.On{{$m.Name}}.fallback != nil {
		f := s.On{{$m.Name}}.fallback
		call := {{$m.CallType}}{{"{"}}{{$m.ParamFieldAssign}}{{$m.ResultFieldAssignFallback}}}
		s.On{{$m.Name}}.Record(call)
		return {{$m.ReturnFromFallback}}
	}
	s.On{{$m.Name}}.FailUnexpected({{$m.ParamNames}})
	s.On{{$m.Name}}.Record({{$m.CallType}}{{"{"}}{{$m.ParamFieldAssign}}})
	return {{$m.ZeroReturn}}
}
{{end}}
{{end}}
