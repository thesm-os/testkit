package {{.PackageName}}

import (
	"fmt"
	"testing"
{{- if .ImportPath}}

	"{{.ImportPath}}"
{{- end}}

	"go.thesmos.sh/testkit"
)
{{- $q := .PkgQualifier}}{{if $q}}{{$q = printf "%s." $q}}{{end}}
{{range $e := .Enums}}
func Test{{$e.TypeName}}_Enum(t *testing.T) {
	t.Parallel()

	type enumEntry struct {
		value    {{$q}}{{$e.TypeName}}
		wantName string
	}
	all := []enumEntry{
{{- range $e.Values}}
		{{"{"}}{{$q}}{{.Name}}, "{{.ExpectedStr}}"},
{{- end}}
	}

	t.Run("stringer", func(t *testing.T) {
		t.Parallel()
		for _, tt := range all {
			t.Run(tt.wantName, func(t *testing.T) {
				t.Parallel()
				testkit.Equal(t, tt.value.String(), tt.wantName,
					fmt.Sprintf("%s.String() must match expected", tt.wantName))
			})
		}
	})

	t.Run("exhaustive", func(t *testing.T) {
		t.Parallel()
		testkit.Equal(t, len(all), {{len $e.Values}},
			"must have exactly {{len $e.Values}} values")
	})

	t.Run("boundary max+1 uses fallback format", func(t *testing.T) {
		t.Parallel()
		outOfRange := {{$q}}{{$e.TypeName}}({{$e.MaxValue}} + 1)
		expected := fmt.Sprintf("{{$e.TypeName}}(%d)", {{$e.MaxValue}}+1)
		testkit.Equal(t, outOfRange.String(), expected,
			"out-of-range value must use fallback format")
	})

	t.Run("all values are distinct", func(t *testing.T) {
		t.Parallel()
		seen := make(map[{{$q}}{{$e.TypeName}}]string)
		for _, tt := range all {
			if prev, ok := seen[tt.value]; ok {
				t.Errorf("duplicate: %s and %s both equal %d",
					prev, tt.wantName, int(tt.value))
			}
			seen[tt.value] = tt.wantName
		}
	})
}
{{end}}
