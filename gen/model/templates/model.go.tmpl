{{define "model"}}
package {{.PackageName}}
{{template "model_imports" .}}

// Assert{{.InterfaceName}}Model runs property-based state-machine tests against
// implementations of [{{.QualifiedType}}] produced by sutFactory.
//
//	Shapes:        {{.ShapeSummary}}
//	CRUD:          {{if .IsCRUD}}yes{{else}}no{{end}}
//	Key field:     {{if .KeyField}}{{.KeyField}}{{else}}none{{end}}
//	Ref:           {{if .CanSynthesizeRef}}auto (refmap.MapStore){{else if .RefBlockers}}supply via {{.InterfaceName}}ModelReference ({{join .RefBlockers ", "}} not in MapStore){{else}}supply via {{.InterfaceName}}ModelReference{{end}}
//	Auto-laws:     {{if .AutoLaws}}{{join .AutoLaws ", "}}{{else}}none{{end}}
//	Skipped:       {{if .SkippedMethods}}{{join .SkippedMethods ", "}} — supply via {{.InterfaceName}}ModelActions{{else}}none{{end}}
//	Plug-in:       {{.InterfaceName}}ModelReference, {{.InterfaceName}}ModelActions, {{.InterfaceName}}ModelLaw, {{.InterfaceName}}ModelSkipLaw
func Assert{{.InterfaceName}}Model(
	t rapid.TB,
	sutFactory func() {{.QualifiedType}},
	opts ...{{.InterfaceName}}ModelOption,
) {
	t.Helper()
	rapid.Check(t, {{.InterfaceName | toLower}}ModelProperty(sutFactory, opts...))
}

// Fuzz{{.InterfaceName}}Model is a fuzz target for coverage-guided testing
// of [{{.QualifiedType}}] via go test -fuzz. Same property as
// [Assert{{.InterfaceName}}Model] but driven by libFuzzer's corpus.
//
//	func Fuzz{{.InterfaceName}}Model(f *testing.F) {
//	    storetest.Fuzz{{.InterfaceName}}Model(f, factory)
//	}
func Fuzz{{.InterfaceName}}Model(
	f *testing.F,
	sutFactory func() {{.QualifiedType}},
	opts ...{{.InterfaceName}}ModelOption,
) {
	f.Helper()
	f.Fuzz(rapid.MakeFuzz({{.InterfaceName | toLower}}ModelProperty(sutFactory, opts...)))
}

func {{.InterfaceName | toLower}}ModelProperty(
	sutFactory func() {{.QualifiedType}},
	opts ...{{.InterfaceName}}ModelOption,
) func(*rapid.T) {
	cfg := new{{.InterfaceName}}ModelConfig(opts...)

	// Generators — local to this function, not package-level.
{{- if .ReaderMethod}}
	keyGen := rapid.SampledFrom([]{{.ReaderMethod.Shape.KeyType}}{ {{keySamples}} })
{{- end}}
{{- if and .WriterMethod .KeyField}}
	valGen := rapid.MakeCustom[{{.WriterMethod.Shape.ValType}}](rapid.MakeConfig{
		Kinds: map[reflect.Kind]*rapid.Generator[any]{
			reflect.Int:     rapid.IntRange(-1000, 1000).AsAny(),
			reflect.Int8:    rapid.Int8().AsAny(),
			reflect.Int16:   rapid.Int16Range(-1000, 1000).AsAny(),
			reflect.Int32:   rapid.Int32Range(-1000, 1000).AsAny(),
			reflect.Int64:   rapid.Int64Range(-1000, 1000).AsAny(),
			reflect.Uint:    rapid.UintRange(0, 1000).AsAny(),
			reflect.Uint8:   rapid.Uint8().AsAny(),
			reflect.Uint16:  rapid.Uint16Range(0, 1000).AsAny(),
			reflect.Uint32:  rapid.Uint32Range(0, 1000).AsAny(),
			reflect.Uint64:  rapid.Uint64Range(0, 1000).AsAny(),
			reflect.Float32: rapid.Float32Range(-1000, 1000).AsAny(),
			reflect.Float64: rapid.Float64Range(-1000, 1000).AsAny(),
			reflect.String:  rapid.StringMatching(`[a-zA-Z0-9]{0,20}`).AsAny(),
		},
		Fields: map[reflect.Type]map[string]*rapid.Generator[any]{
			reflect.TypeOf({{.WriterMethod.Shape.ValType}}{}): {
				"{{.KeyField}}": keyGen.AsAny(),
			},
		},
	})
{{- else if .WriterMethod}}
	valGen := rapid.Make[{{.WriterMethod.Shape.ValType}}]()
{{- end}}

	// Reference: consumer-supplied or synthesized.
	refFactory := cfg.refFactory
{{- if and .CanSynthesizeRef .KeyField}}
	if refFactory == nil {
		refFactory = func() {{.QualifiedType}} {
			return refmap.NewMapStore(
				func(v {{.WriterMethod.Shape.ValType}}) {{.ReaderMethod.Shape.KeyType}} { return v.{{.KeyField}} },
				{{firstSentinel .ReaderMethod}},
			)
		}
	}
{{- end}}

	// Actions: consumer-supplied or auto-derived.
	actions := cfg.actions
	if len(actions) == 0 {
		actions = []model.Action[{{.QualifiedType}}]{
{{- range .Methods}}{{if not .Skip}}
{{- if .IsReader}}
			action.Reader("{{.Name}}", keyGen,
				func(ctx context.Context, impl {{$.QualifiedType}}, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, error) {
					return impl.{{.Name}}(ctx, k)
				},
			),
{{- else if .IsReaderWithBool}}
			action.ReaderWithBool("{{.Name}}", keyGen,
				func(ctx context.Context, impl {{$.QualifiedType}}, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, bool) {
					return impl.{{.Name}}({{if .HasCtx}}ctx, {{end}}k)
				},
			),
{{- else if .IsLookup}}
			action.Lookup("{{.Name}}", keyGen,
				func(impl {{$.QualifiedType}}, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, {{.Shape.RetType}}, bool) {
					return impl.{{.Name}}({{if .HasCtx}}context.Background(), {{end}}k)
				},
			),
{{- else if .IsWriter}}
			action.Writer("{{.Name}}", {{writerGen .}},
				func(ctx context.Context, impl {{$.QualifiedType}}, v {{.Shape.ValType}}) error {
					return impl.{{.Name}}(ctx, v)
				},
			),
{{- else if .IsMutator}}
			action.Mutator("{{.Name}}", valGen,
				func(ctx context.Context, impl {{$.QualifiedType}}, v {{.Shape.ValType}}) {
					impl.{{.Name}}(ctx, v)
				},
			),
{{- else if .IsDeleter}}
			action.Deleter("{{.Name}}", keyGen,
				func(ctx context.Context, impl {{$.QualifiedType}}, k {{.Shape.KeyType}}) error {
					return impl.{{.Name}}(ctx, k)
				},
			),
{{- else if .IsAggregator}}
			action.Aggregator("{{.Name}}",
				func(ctx context.Context, impl {{$.QualifiedType}}) ({{.Shape.ValType}}, error) {
					return impl.{{.Name}}(ctx)
				},
			),
{{- else if .IsLifecycle}}
			action.Lifecycle("{{.Name}}",
				func(ctx context.Context, impl {{$.QualifiedType}}) error {
					return impl.{{.Name}}(ctx)
				},
			),
{{- else if and .IsPure (not .ParamOnly)}}
			action.Pure("{{.Name}}",
				func(impl {{$.QualifiedType}}) {{.Shape.ValType}} {
					return impl.{{.Name}}()
				},
			),
{{- else if and .IsPredicate (not .ParamOnly)}}
			action.Predicate("{{.Name}}",
				func(impl {{$.QualifiedType}}) bool {
					return impl.{{.Name}}()
				},
			),
{{- else if .IsPoisonAccessor}}
			action.PoisonCheck("{{.Name}}",
				func(impl {{$.QualifiedType}}) error {
					return impl.{{.Name}}()
				},
			),
{{- else if .IsStreamReader}}
			action.Stream("{{.Name}}",
				func(ctx context.Context, impl {{$.QualifiedType}}) ([]{{.Shape.IterInfo.ElemType}}, error) {
					var items []{{.Shape.IterInfo.ElemType}}
					for v, err := range impl.{{.Name}}(ctx) {
						if err != nil {
							return nil, err
						}
						items = append(items, v)
					}
					return items, nil
				},
			),
{{- end}}
{{- end}}{{end}}
		}
	}
	actions = append(actions, cfg.extraActions...)

	// Laws: auto-derived + consumer-supplied.
	laws := model.NewRegistry[{{.QualifiedType}}]()
{{- if and .IsCRUD .KeyField .ReaderMethod}}
	laws.Add(law.ReadAfterWrite[{{.QualifiedType}}, {{.ReaderMethod.Shape.KeyType}}, {{.ReaderMethod.Shape.ValType}}]{
		Read: func(rt *rapid.T, impl {{.QualifiedType}}, k {{.ReaderMethod.Shape.KeyType}}) ({{.ReaderMethod.Shape.ValType}}, error) {
			return impl.{{.ReaderMethod.Name}}(rt.Context(), k)
		},
		Keys: keyGen,
	})
{{- end}}
{{- if and .HasDeleter .ReaderMethod}}
	laws.Add(law.DeleteReturnsNotFound[{{.QualifiedType}}, {{.ReaderMethod.Shape.KeyType}}, {{.ReaderMethod.Shape.ValType}}]{
		Read: func(rt *rapid.T, impl {{.QualifiedType}}, k {{.ReaderMethod.Shape.KeyType}}) ({{.ReaderMethod.Shape.ValType}}, error) {
			return impl.{{.ReaderMethod.Name}}(rt.Context(), k)
		},
		Keys:     keyGen,
		Sentinel: {{firstSentinel .ReaderMethod}},
	})
{{- end}}
{{- if .HasCount}}
	laws.Add(law.CountEqualsReference[{{.QualifiedType}}, {{.CountMethod.Shape.ValType}}]{
		Count: func(rt *rapid.T, impl {{.QualifiedType}}) ({{.CountMethod.Shape.ValType}}, error) {
			return impl.{{.CountMethod.Name}}(rt.Context())
		},
	})
{{- end}}
	for _, l := range cfg.laws {
		laws.Add(l)
	}
	for _, id := range cfg.skipLaws {
		laws.SkipByID(id)
	}

	return model.Property(sutFactory,
		model.WithReference(refFactory),
		model.WithActions(actions...),
		model.WithLaws(laws),
	)
}

// {{.InterfaceName}}ModelOption configures [Assert{{.InterfaceName}}Model].
type {{.InterfaceName}}ModelOption func(*{{.InterfaceName | toLower}}ModelConfig)

// {{.InterfaceName}}ModelReference overrides the auto-synthesized reference
// with a consumer-supplied implementation.
func {{.InterfaceName}}ModelReference(factory func() {{.QualifiedType}}) {{.InterfaceName}}ModelOption {
	return func(c *{{.InterfaceName | toLower}}ModelConfig) { c.refFactory = factory }
}

// {{.InterfaceName}}ModelActions replaces all auto-derived actions.
func {{.InterfaceName}}ModelActions(actions ...model.Action[{{.QualifiedType}}]) {{.InterfaceName}}ModelOption {
	return func(c *{{.InterfaceName | toLower}}ModelConfig) { c.actions = actions }
}

// {{.InterfaceName}}ModelExtraActions appends actions to the auto-derived set.
// Use this to add coverage for Unknown-shaped methods without replacing
// the auto-derived Reader/Writer/Deleter/etc. actions.
func {{.InterfaceName}}ModelExtraActions(actions ...model.Action[{{.QualifiedType}}]) {{.InterfaceName}}ModelOption {
	return func(c *{{.InterfaceName | toLower}}ModelConfig) { c.extraActions = append(c.extraActions, actions...) }
}

// {{.InterfaceName}}ModelLaw adds a custom law to the registry.
func {{.InterfaceName}}ModelLaw(l law.Law[{{.QualifiedType}}]) {{.InterfaceName}}ModelOption {
	return func(c *{{.InterfaceName | toLower}}ModelConfig) { c.laws = append(c.laws, l) }
}

// {{.InterfaceName}}ModelSkipLaw skips an auto-derived law by ID.
func {{.InterfaceName}}ModelSkipLaw(id string) {{.InterfaceName}}ModelOption {
	return func(c *{{.InterfaceName | toLower}}ModelConfig) { c.skipLaws = append(c.skipLaws, id) }
}

type {{.InterfaceName | toLower}}ModelConfig struct {
	refFactory   func() {{.QualifiedType}}
	actions      []model.Action[{{.QualifiedType}}]
	extraActions []model.Action[{{.QualifiedType}}]
	laws         []law.Law[{{.QualifiedType}}]
	skipLaws     []string
}

func new{{.InterfaceName}}ModelConfig(opts ...{{.InterfaceName}}ModelOption) {{.InterfaceName | toLower}}ModelConfig {
	var cfg {{.InterfaceName | toLower}}ModelConfig
	for _, opt := range opts {
		opt(&cfg)
	}
	return cfg
}
{{end}}

{{define "model_imports"}}
import (
	"context"
	"reflect"
	"testing"

	"pgregory.net/rapid"

	"go.thesmos.sh/testkit/model"
	"go.thesmos.sh/testkit/model/action"
	"go.thesmos.sh/testkit/model/law"
	"go.thesmos.sh/testkit/model/refmap"
{{- range .Imports}}
{{- if ne .Path "testing"}}
	{{if .Alias}}{{.Alias}} {{end}}"{{.Path}}"
{{- end}}
{{- end}}
)
{{end}}
