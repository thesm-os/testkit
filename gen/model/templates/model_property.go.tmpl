{{define "model_property"}}
// {{.InterfaceName}}ModelProperty builds the rapid property function.
// Use directly for shared model.Check / model.MakeFuzz targets:
//
//	prop := {{.InterfaceName}}ModelProperty(factory, opts...)
//	model.Check(t, prop)                    // test
//	f.Fuzz(model.MakeFuzz(prop))            // fuzz
func {{.InterfaceName}}ModelProperty(
	sutFactory func() {{.QualifiedType}},
	opts ...{{.InterfaceName}}ModelOption,
) func(*model.T) {
	cfg := new{{.InterfaceName}}ModelConfig(opts...)

	{{template "model_generators" .}}
	{{template "model_chain_setup" .}}
	{{template "model_ref" .}}
	{{template "model_actions" .}}
	{{template "model_laws" .}}

{{- if .IsTimeAware}}
	// Clock: dual TestClock for time-aware testing.
	var sutClock, refClock *clock.TestClock
	if cfg.clockFactory != nil {
		origSut := sutFactory
		_ = origSut
		sutFactory = func() {{.QualifiedType}} {
			sutClock = clock.NewTestClock(time.Unix(0, 0))
			return cfg.clockFactory(sutClock)
		}
		if refFactory == nil {
			refFactory = func() {{.QualifiedType}} {
				refClock = clock.NewTestClock(time.Unix(0, 0))
				return cfg.clockFactory(refClock)
			}
		}
		maxAdv := cfg.maxAdvance
		if maxAdv == 0 {
			maxAdv = time.Hour
		}
		actions = append(actions, action.AdvanceClock[{{.QualifiedType}}]("AdvanceClock",
			func() (*clock.TestClock, *clock.TestClock) { return sutClock, refClock },
			maxAdv,
		))
	}
{{- end}}

	modelOpts := []model.Option[{{.QualifiedType}}]{
		model.WithReference(refFactory),
		model.WithActions(actions...),
		model.WithLaws(laws),
	}
{{- if .HasChain}}
	modelOpts = append(modelOpts, model.WithHistoryReset[{{.QualifiedType}}](attemptedAppends.Reset))
{{- end}}
	if cfg.disableTrace {
		modelOpts = append(modelOpts, model.WithoutTrace[{{.QualifiedType}}]())
	}
	if cfg.artifactDir != "" {
		modelOpts = append(modelOpts, model.WithArtifactDir[{{.QualifiedType}}](cfg.artifactDir))
	}
	return model.Property(sutFactory, modelOpts...)
}
{{end}}

{{define "model_generators"}}
	// Generators — local to this function, not package-level.
{{- if .ReaderMethod}}
	keyGen := model.SampledFrom([]{{.ReaderMethod.Shape.KeyType}}{ {{keySamples}} })
{{- end}}
{{- if and .WriterMethod .KeyField .NeedsValGen}}
	valGen := model.MakeCustom[{{.WriterMethod.Shape.ValType}}](model.MakeConfig{
		Kinds: map[reflect.Kind]*model.Generator[any]{
			reflect.Int:     model.IntRange(-1000, 1000).AsAny(),
			reflect.Int8:    model.Int8().AsAny(),
			reflect.Int16:   model.Int16Range(-1000, 1000).AsAny(),
			reflect.Int32:   model.Int32Range(-1000, 1000).AsAny(),
			reflect.Int64:   model.Int64Range(-1000, 1000).AsAny(),
			reflect.Uint:    model.UintRange(0, 1000).AsAny(),
			reflect.Uint8:   model.Uint8().AsAny(),
			reflect.Uint16:  model.Uint16Range(0, 1000).AsAny(),
			reflect.Uint32:  model.Uint32Range(0, 1000).AsAny(),
			reflect.Uint64:  model.Uint64Range(0, 1000).AsAny(),
			reflect.Float32: model.Float32Range(-1000, 1000).AsAny(),
			reflect.Float64: model.Float64Range(-1000, 1000).AsAny(),
			reflect.String:  model.StringMatching(`[a-zA-Z0-9]{0,20}`).AsAny(),
		},
		Fields: map[reflect.Type]map[string]*model.Generator[any]{
			reflect.TypeOf({{.WriterMethod.Shape.ValType}}{}): {
				"{{.KeyField}}": keyGen.AsAny(),
			},
		},
	})
{{- else if and .WriterMethod .NeedsValGen}}
	valGen := model.Make[{{.WriterMethod.Shape.ValType}}]()
{{- end}}
{{end}}

{{define "model_ref"}}
	// Reference: consumer-supplied or synthesized.
	refFactory := cfg.refFactory
{{- if and .CanSynthesizeRef .KeyField}}
	if refFactory == nil {
		refFactory = func() {{.QualifiedType}} {
			return refmap.NewMapStore(
				func(v {{.WriterMethod.Shape.ValType}}) {{.ReaderMethod.Shape.KeyType}} { return v.{{.KeyField}} },
				{{firstSentinel .ReaderMethod}},
			)
		}
	}
{{- else if and .HasChain .IsChainPartitioned}}
	if refFactory == nil {
		refFactory = func() {{.QualifiedType}} {
			return refchain.NewPartitioned(chainPartKeyOf, {{if .ChainHashFunc}}{{.ChainHashFunc}}(){{else}}nil{{end}})
		}
	}
{{- else if .HasChain}}
	if refFactory == nil {
		refFactory = func() {{.QualifiedType}} {
			return refchain.New[{{.ChainAppendMethod.Shape.ValType}}]({{if .ChainHashFunc}}{{.ChainHashFunc}}(){{else}}nil{{end}})
		}
	}
{{- end}}
{{end}}

{{define "model_chain_setup"}}
{{- if .HasChain}}
	// Chain history — tracks attempted appends for dropped-write detection.
{{- if .IsChainPartitioned}}
	attemptedAppends := chainhistory.New[string, {{.ChainAppendMethod.Shape.ValType}}]()
	chainPartKeyOf := func(e {{.ChainAppendMethod.Shape.ValType}}) string { return e.{{.ChainPartitionField}} }
{{- else}}
	attemptedAppends := chainhistory.New[struct{}, {{.ChainAppendMethod.Shape.ValType}}]()
	chainPartKeyOf := func(_ {{.ChainAppendMethod.Shape.ValType}}) struct{} { return struct{}{} }
{{- end}}
{{- end}}
{{end}}
