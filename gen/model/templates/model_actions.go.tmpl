{{define "model_actions"}}
	// Actions: consumer-supplied or auto-derived.
	actions := cfg.actions
	if len(actions) == 0 {
		actions = []model.Action[{{.QualifiedType}}]{
{{- range .Methods}}{{if not .Skip}}
{{- if .IsReader}}
			action.Reader("{{.Name}}", keyGen,
				func(ctx context.Context, impl {{$.QualifiedType}}, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, error) {
					return impl.{{.Name}}(ctx, k)
				},
			),
{{- else if .IsReaderWithBool}}
			action.ReaderWithBool("{{.Name}}", keyGen,
				func(ctx context.Context, impl {{$.QualifiedType}}, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, bool) {
					return impl.{{.Name}}({{if .HasCtx}}ctx, {{end}}k)
				},
			),
{{- else if .IsLookup}}
			action.Lookup("{{.Name}}", keyGen,
				func(impl {{$.QualifiedType}}, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, {{.Shape.RetType}}, bool) {
					return impl.{{.Name}}({{if .HasCtx}}context.Background(), {{end}}k)
				},
			),
{{- else if and .IsWriter (and $.HasChain (.HasDirective "appends"))}}
			action.ChainAppendRecording("{{.Name}}", {{writerGen .}}, attemptedAppends, chainPartKeyOf,
				func(ctx context.Context, impl {{$.QualifiedType}}, v {{.Shape.ValType}}) error {
					return impl.{{.Name}}(ctx, v)
				},
			),
{{- else if and .IsWriter (eq .Shape.ValType $.ReaderMethod.Shape.KeyType)}}
			action.Writer("{{.Name}}", keyGen,
				func(ctx context.Context, impl {{$.QualifiedType}}, v {{.Shape.ValType}}) error {
					return impl.{{.Name}}(ctx, v)
				},
			),
{{- else if .IsWriter}}
			action.Writer("{{.Name}}", {{writerGen .}},
				func(ctx context.Context, impl {{$.QualifiedType}}, v {{.Shape.ValType}}) error {
					return impl.{{.Name}}(ctx, v)
				},
			),
{{- else if .IsMutator}}
			action.Mutator("{{.Name}}", valGen,
				func(ctx context.Context, impl {{$.QualifiedType}}, v {{.Shape.ValType}}) {
					impl.{{.Name}}(ctx, v)
				},
			),
{{- else if .IsDeleter}}
			action.Deleter("{{.Name}}", keyGen,
				func(ctx context.Context, impl {{$.QualifiedType}}, k {{.Shape.KeyType}}) error {
					return impl.{{.Name}}(ctx, k)
				},
			),
{{- else if .IsAggregator}}
			action.Aggregator("{{.Name}}",
				func(ctx context.Context, impl {{$.QualifiedType}}) ({{.Shape.ValType}}, error) {
					return impl.{{.Name}}(ctx)
				},
			),
{{- else if and .IsLifecycle (and $.HasChain (.HasDirective "verifies"))}}
			action.ChainVerify("{{.Name}}",
				func(ctx context.Context, impl {{$.QualifiedType}}) error {
					return impl.{{.Name}}(ctx)
				},
			),
{{- else if .IsLifecycle}}
			action.Lifecycle("{{.Name}}",
				func(ctx context.Context, impl {{$.QualifiedType}}) error {
					return impl.{{.Name}}(ctx)
				},
			),
{{- else if and .IsPure (not .ParamOnly)}}
{{- if .HasDirective "nondeterministic"}}
			action.Stress("{{.Name}}", func(impl {{$.QualifiedType}}) { impl.{{.Name}}() }),
{{- else}}
			action.Pure("{{.Name}}",
				func(impl {{$.QualifiedType}}) {{.Shape.ValType}} {
					return impl.{{.Name}}()
				},
			),
{{- end}}
{{- else if and .IsPredicate (not .ParamOnly)}}
{{- if .HasDirective "nondeterministic"}}
			action.Stress("{{.Name}}", func(impl {{$.QualifiedType}}) { impl.{{.Name}}() }),
{{- else}}
			action.Predicate("{{.Name}}",
				func(impl {{$.QualifiedType}}) bool {
					return impl.{{.Name}}()
				},
			),
{{- end}}
{{- else if .IsPoisonAccessor}}
			action.PoisonCheck("{{.Name}}",
				func(impl {{$.QualifiedType}}) error {
					return impl.{{.Name}}()
				},
			),
{{- else if and .IsStreamReader (and $.HasChain (.HasDirective "replays"))}}
			action.ChainReplay("{{.Name}}", attemptedAppends,
{{- if $.IsChainPartitioned}}
				func(ctx context.Context, impl {{$.QualifiedType}}, k string) iter.Seq2[{{.Shape.IterInfo.ElemType}}, error] {
					return impl.{{.Name}}(ctx, k)
				},
{{- else}}
				func(ctx context.Context, impl {{$.QualifiedType}}, _ struct{}) iter.Seq2[{{.Shape.IterInfo.ElemType}}, error] {
					return impl.{{.Name}}(ctx)
				},
{{- end}}
			),
{{- else if .IsStreamReader}}
			action.Stream("{{.Name}}",
				func(ctx context.Context, impl {{$.QualifiedType}}) ([]{{.Shape.IterInfo.ElemType}}, error) {
					var items []{{.Shape.IterInfo.ElemType}}
					for v, err := range impl.{{.Name}}(ctx) {
						if err != nil {
							return nil, err
						}
						items = append(items, v)
					}
					return items, nil
				},
			),
{{- end}}
{{- end}}{{end}}
		}
	}
	actions = append(actions, cfg.extraActions...)
{{end}}
