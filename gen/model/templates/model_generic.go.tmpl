{{define "model_generic"}}
package {{.PackageName}}
{{template "model_generic_imports" .}}

{{- $T := printf "%s%s" .QualifiedType .TypeParamNames}}

// Assert{{.InterfaceName}}Model{{.TypeParamDecl}} runs property-based state-machine
// tests against implementations of [{{.QualifiedType}}] produced by sutFactory.
//
// Generic interface — keyfield and reference are consumer-supplied.
// Use {{.InterfaceName}}ModelKeyFunc to enable Tier 0 reference synthesis
// via refmap.MapStore, or {{.InterfaceName}}ModelReference for a custom reference.
//
//	Shapes:        {{.ShapeSummary}}
//	CRUD:          {{if .IsCRUD}}yes{{else}}no{{end}}
//	Key field:     consumer-supplied via {{.InterfaceName}}ModelKeyFunc
//	Ref:           consumer-supplied (generic V — no codegen-time keyfield heuristic)
//	Auto-laws:     derived at instantiation from consumer-supplied keyGen/keyFunc
//	Skipped:       {{if .SkippedMethods}}{{join .SkippedMethods ", "}} — supply via {{.InterfaceName}}ModelActions{{else}}none{{end}}
//	Plug-in:       {{.InterfaceName}}ModelReference, {{.InterfaceName}}ModelKeyFunc, {{.InterfaceName}}ModelActions, {{.InterfaceName}}ModelLaw, {{.InterfaceName}}ModelSkipLaw
func Assert{{.InterfaceName}}Model{{.TypeParamDecl}}(
	t rapid.TB,
	sutFactory func() {{$T}},
	opts ...{{.InterfaceName}}ModelOption{{.TypeParamNames}},
) {
	t.Helper()
	cfg := new{{.InterfaceName}}ModelConfig(opts...)

	// Key generator — consumer must supply for generic interfaces.
	keyGen := cfg.keyGen
{{- if .ReaderMethod}}
	if keyGen == nil {
		t.Fatal("Assert{{.InterfaceName}}Model: keyGen required — supply via {{.InterfaceName}}ModelKeyGen")
	}
{{- end}}

	// Value generator — consumer supplies or framework uses rapid.Make.
	valGen := cfg.valGen
{{- if .WriterMethod}}
	if valGen == nil {
		valGen = rapid.Make[{{.WriterMethod.Shape.ValType}}]()
	}
{{- end}}

	// Reference: consumer-supplied or synthesized from KeyFunc + sentinel.
	refFactory := cfg.refFactory
{{- if .IsCRUD}}
	if refFactory == nil && cfg.keyFunc != nil && cfg.sentinel != nil {
		refFactory = func() {{$T}} {
			return refmap.NewMapStore(cfg.keyFunc, cfg.sentinel)
		}
	}
{{- end}}
	if refFactory == nil {
		t.Fatal("Assert{{.InterfaceName}}Model: no reference model — supply via " +
			"{{.InterfaceName}}ModelReference or {{.InterfaceName}}ModelKeyFunc + {{.InterfaceName}}ModelSentinel")
	}

	// Actions: consumer-supplied or auto-derived.
	actions := cfg.actions
	if len(actions) == 0 {
		actions = []model.Action[{{$T}}]{
{{- range .Methods}}{{if not .Skip}}
{{- if .IsReader}}
			action.Reader("{{.Name}}", keyGen,
				func(ctx context.Context, impl {{$T}}, k {{.Shape.KeyType}}) ({{.Shape.ValType}}, error) {
					return impl.{{.Name}}(ctx, k)
				},
			),
{{- else if .IsWriter}}
			action.Writer("{{.Name}}", {{writerGen .}},
				func(ctx context.Context, impl {{$T}}, v {{.Shape.ValType}}) error {
					return impl.{{.Name}}(ctx, v)
				},
			),
{{- else if .IsDeleter}}
			action.Deleter("{{.Name}}", keyGen,
				func(ctx context.Context, impl {{$T}}, k {{.Shape.KeyType}}) error {
					return impl.{{.Name}}(ctx, k)
				},
			),
{{- else if .IsAggregator}}
			action.Aggregator("{{.Name}}",
				func(ctx context.Context, impl {{$T}}) ({{.Shape.ValType}}, error) {
					return impl.{{.Name}}(ctx)
				},
			),
{{- else if .IsLifecycle}}
			action.Lifecycle("{{.Name}}",
				func(ctx context.Context, impl {{$T}}) error {
					return impl.{{.Name}}(ctx)
				},
			),
{{- else if .IsPure}}
			action.Pure("{{.Name}}",
				func(impl {{$T}}) {{.Shape.ValType}} {
					return impl.{{.Name}}()
				},
			),
{{- else if .IsPredicate}}
			action.Predicate("{{.Name}}",
				func(impl {{$T}}) bool {
					return impl.{{.Name}}()
				},
			),
{{- else if .IsStreamReader}}
			action.Stream("{{.Name}}",
				func(ctx context.Context, impl {{$T}}) ([]{{.Shape.IterInfo.ElemType}}, error) {
					var items []{{.Shape.IterInfo.ElemType}}
					for v, err := range impl.{{.Name}}(ctx) {
						if err != nil {
							return nil, err
						}
						items = append(items, v)
					}
					return items, nil
				},
			),
{{- end}}
{{- end}}{{end}}
		}
	}
	actions = append(actions, cfg.extraActions...)

	// Laws: auto-derived + consumer-supplied.
	laws := model.NewRegistry[{{$T}}]()
{{- if and .IsCRUD .ReaderMethod}}
	if keyGen != nil {
		laws.Add(law.ReadAfterWrite[{{$T}}, {{.ReaderMethod.Shape.KeyType}}, {{.ReaderMethod.Shape.ValType}}]{
			Read: func(rt *rapid.T, impl {{$T}}, k {{.ReaderMethod.Shape.KeyType}}) ({{.ReaderMethod.Shape.ValType}}, error) {
				return impl.{{.ReaderMethod.Name}}(rt.Context(), k)
			},
			Keys: keyGen,
		})
	}
{{- end}}
{{- if and .HasDeleter .ReaderMethod}}
	if keyGen != nil && cfg.sentinel != nil {
		laws.Add(law.DeleteReturnsNotFound[{{$T}}, {{.ReaderMethod.Shape.KeyType}}, {{.ReaderMethod.Shape.ValType}}]{
			Read: func(rt *rapid.T, impl {{$T}}, k {{.ReaderMethod.Shape.KeyType}}) ({{.ReaderMethod.Shape.ValType}}, error) {
				return impl.{{.ReaderMethod.Name}}(rt.Context(), k)
			},
			Keys:     keyGen,
			Sentinel: cfg.sentinel,
		})
	}
{{- end}}
{{- if .HasCount}}
	laws.Add(law.CountEqualsReference[{{$T}}, {{.CountMethod.Shape.ValType}}]{
		Count: func(rt *rapid.T, impl {{$T}}) ({{.CountMethod.Shape.ValType}}, error) {
			return impl.{{.CountMethod.Name}}(rt.Context())
		},
	})
{{- end}}
	for _, l := range cfg.laws {
		laws.Add(l)
	}
	for _, id := range cfg.skipLaws {
		laws.SkipByID(id)
	}

	model.Assert(t, sutFactory,
		model.WithReference(refFactory),
		model.WithActions(actions...),
		model.WithLaws(laws),
	)
}

// {{.InterfaceName}}ModelOption{{.TypeParamDecl}} configures [Assert{{.InterfaceName}}Model].
type {{.InterfaceName}}ModelOption{{.TypeParamDecl}} func(*{{.InterfaceName | toLower}}ModelConfig{{.TypeParamNames}})

// {{.InterfaceName}}ModelReference overrides the reference factory.
func {{.InterfaceName}}ModelReference{{.TypeParamDecl}}(factory func() {{$T}}) {{.InterfaceName}}ModelOption{{.TypeParamNames}} {
	return func(c *{{.InterfaceName | toLower}}ModelConfig{{.TypeParamNames}}) { c.refFactory = factory }
}

// {{.InterfaceName}}ModelKeyGen sets the key generator used by Reader/Deleter
// actions and auto-derived laws. Required for generic interfaces.
func {{.InterfaceName}}ModelKeyGen{{.TypeParamDecl}}(g *rapid.Generator[{{.ReaderMethod.Shape.KeyType}}]) {{.InterfaceName}}ModelOption{{.TypeParamNames}} {
	return func(c *{{.InterfaceName | toLower}}ModelConfig{{.TypeParamNames}}) { c.keyGen = g }
}

// {{.InterfaceName}}ModelValGen overrides the value generator. Default uses
// rapid.Make[V]() which generates all fields via reflection.
func {{.InterfaceName}}ModelValGen{{.TypeParamDecl}}(g *rapid.Generator[{{.WriterMethod.Shape.ValType}}]) {{.InterfaceName}}ModelOption{{.TypeParamNames}} {
	return func(c *{{.InterfaceName | toLower}}ModelConfig{{.TypeParamNames}}) { c.valGen = g }
}

// {{.InterfaceName}}ModelKeyFunc sets the key extraction function for Tier 0
// reference synthesis via refmap.MapStore. Must be paired with
// {{.InterfaceName}}ModelSentinel.
func {{.InterfaceName}}ModelKeyFunc{{.TypeParamDecl}}(fn func({{.WriterMethod.Shape.ValType}}) {{.ReaderMethod.Shape.KeyType}}) {{.InterfaceName}}ModelOption{{.TypeParamNames}} {
	return func(c *{{.InterfaceName | toLower}}ModelConfig{{.TypeParamNames}}) { c.keyFunc = fn }
}

// {{.InterfaceName}}ModelSentinel sets the not-found sentinel error for
// reference synthesis and auto-derived DeleteReturnsNotFound law.
func {{.InterfaceName}}ModelSentinel{{.TypeParamDecl}}(err error) {{.InterfaceName}}ModelOption{{.TypeParamNames}} {
	return func(c *{{.InterfaceName | toLower}}ModelConfig{{.TypeParamNames}}) { c.sentinel = err }
}

// {{.InterfaceName}}ModelActions replaces all auto-derived actions.
func {{.InterfaceName}}ModelActions{{.TypeParamDecl}}(actions ...model.Action[{{$T}}]) {{.InterfaceName}}ModelOption{{.TypeParamNames}} {
	return func(c *{{.InterfaceName | toLower}}ModelConfig{{.TypeParamNames}}) { c.actions = actions }
}

// {{.InterfaceName}}ModelExtraActions appends actions to the auto-derived set.
func {{.InterfaceName}}ModelExtraActions{{.TypeParamDecl}}(actions ...model.Action[{{$T}}]) {{.InterfaceName}}ModelOption{{.TypeParamNames}} {
	return func(c *{{.InterfaceName | toLower}}ModelConfig{{.TypeParamNames}}) { c.extraActions = append(c.extraActions, actions...) }
}

// {{.InterfaceName}}ModelLaw adds a custom law to the registry.
func {{.InterfaceName}}ModelLaw{{.TypeParamDecl}}(l law.Law[{{$T}}]) {{.InterfaceName}}ModelOption{{.TypeParamNames}} {
	return func(c *{{.InterfaceName | toLower}}ModelConfig{{.TypeParamNames}}) { c.laws = append(c.laws, l) }
}

// {{.InterfaceName}}ModelSkipLaw skips an auto-derived law by ID.
func {{.InterfaceName}}ModelSkipLaw{{.TypeParamDecl}}(id string) {{.InterfaceName}}ModelOption{{.TypeParamNames}} {
	return func(c *{{.InterfaceName | toLower}}ModelConfig{{.TypeParamNames}}) { c.skipLaws = append(c.skipLaws, id) }
}

type {{.InterfaceName | toLower}}ModelConfig{{.TypeParamDecl}} struct {
	refFactory   func() {{$T}}
	keyGen       *rapid.Generator[{{.ReaderMethod.Shape.KeyType}}]
	valGen       *rapid.Generator[{{.WriterMethod.Shape.ValType}}]
	keyFunc      func({{.WriterMethod.Shape.ValType}}) {{.ReaderMethod.Shape.KeyType}}
	sentinel     error
	actions      []model.Action[{{$T}}]
	extraActions []model.Action[{{$T}}]
	laws         []law.Law[{{$T}}]
	skipLaws     []string
}

func new{{.InterfaceName}}ModelConfig{{.TypeParamDecl}}(opts ...{{.InterfaceName}}ModelOption{{.TypeParamNames}}) {{.InterfaceName | toLower}}ModelConfig{{.TypeParamNames}} {
	var cfg {{.InterfaceName | toLower}}ModelConfig{{.TypeParamNames}}
	for _, opt := range opts {
		opt(&cfg)
	}
	return cfg
}
{{end}}

{{define "model_generic_imports"}}
import (
	"context"

	"pgregory.net/rapid"

	"go.thesmos.sh/testkit/model"
	"go.thesmos.sh/testkit/model/action"
	"go.thesmos.sh/testkit/model/law"
	"go.thesmos.sh/testkit/model/refmap"
{{- range .Imports}}
{{- if ne .Path "testing"}}
	{{if .Alias}}{{.Alias}} {{end}}"{{.Path}}"
{{- end}}
{{- end}}
)
{{end}}
