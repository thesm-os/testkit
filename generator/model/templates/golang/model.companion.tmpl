{{- /*
The proof of the emission, run from the external test package the way a
consumer would. It certifies what the generator produced — the derived
reference and its inert bodies — not any consumer's subject, which is why it
is generated here instead of asked of every package that arms the tier.
*/ -}}
{{- define "model.companion" -}}
{{ $c := . }}
// Test{{ .IfaceName }}ModelReference holds the reference to the tier it
// anchors: two independent instances driven through the full property, one as
// subject and one as oracle. A failure here is the derivation's own — before
// any consumer's implementation is in the room.
//
// The supplied-option path rides along, so the option, the config and the
// constructor are all exercised by the file that ships them.
func Test{{ .IfaceName }}ModelReference(t *{{ renderExpr (external "testing" "T") }}) {
	t.Parallel()
	{{ renderExpr (external .ModelPkg "Check") }}(t, {{ renderExpr (external .HarnessPkg .PropertyName) }}(
		{{ renderExpr (external .HarnessPkg .RefCtorName) }},
		{{ renderExpr (external .HarnessPkg .ReferenceOptionName) }}({{ renderExpr (external .HarnessPkg .RefCtorName) }}),
	))
}
{{ if .ConcurrentName }}
// Test{{ .IfaceName }}ModelConcurrent holds the linearizability leg to the
// derived reference: a mutex-guarded store is linearizable, so a red run
// here is the wiring's own fault — before any consumer's subject is in the
// room.
func Test{{ .IfaceName }}ModelConcurrent(t *{{ renderExpr (external "testing" "T") }}) {
	t.Parallel()
	{{ renderExpr (external .HarnessPkg .ConcurrentName) }}(t, {{ renderExpr (external .HarnessPkg .RefCtorName) }})
}
{{ end }}
// Fuzz{{ .IfaceName }}Model holds the fuzz wiring to the derived reference —
// the same one-line composition a consumer writes over their own subject. A
// plain `go test` runs the seed as smoke; `-fuzz=Fuzz{{ .IfaceName }}Model` digs.
func Fuzz{{ .IfaceName }}Model(f *{{ renderExpr (external "testing" "F") }}) {
	{{ renderExpr (external .HarnessPkg (printf "%sModelFuzz" .IfaceName)) }}(f, {{ renderExpr (external .HarnessPkg .RefCtorName) }})
}
{{ if .Mutants }}
{{ $c := . }}
// Test{{ .IfaceName }}ModelKillsInertMutants measures the tier's teeth: for
// every driven method, a mutant reference answers zeros there and forwards
// nothing, and the property must fail it. A mutant that survives means that
// method's participation in the run checks nothing — a hole in this
// derivation, not in any consumer's subject. The kill rate this asserts is
// total: {{ len .Mutants }} of {{ len .Mutants }}.
func Test{{ .IfaceName }}ModelKillsInertMutants(t *{{ renderExpr (external "testing" "T") }}) {
	t.Parallel()

	mutants := []struct {
		method string
		wrap   func({{ renderType .IfaceRef }}) {{ renderType .IfaceRef }}
	}{
{{- range .Mutants }}
		{{ "{" }}{{ printf "%q" .Method }}, func(s {{ renderType $c.IfaceRef }}) {{ renderType $c.IfaceRef }} {
			return {{ $c.LowerIface }}ModelMutant{{ .Method }}{s}
		}},
{{- end }}
	}
	for _, m := range mutants {
		t.Run(m.method, func(t *{{ renderExpr (external "testing" "T") }}) {
			t.Parallel()
			// The failure is the expectation, so the artifacts a real failure
			// earns — rapid's failfile, the runner's report — are residue
			// here, not regression seeds; the probe removes what it provoked.
			surrogate := "{{ .IfaceName }}Mutant" + m.method
			t.Cleanup(func() {
				_ = {{ renderExpr (external "os" "RemoveAll") }}({{ renderExpr (external "path/filepath" "Join") }}("testdata", "rapid", surrogate))
				_ = {{ renderExpr (external "os" "Remove") }}({{ renderExpr (external "path/filepath" "Join") }}(
					{{ renderExpr (external .ModelPkg "ResolveArtifactDir") }}(""), "failure-"+surrogate+".json"))
			})
			f := {{ renderExpr (external .RootPkg "NewFailableTB") }}().WithName(surrogate)
			{{ renderExpr (external .ModelPkg "Check") }}(f, {{ renderExpr (external .HarnessPkg .PropertyName) }}(func() {{ renderType $c.IfaceRef }} {
				return m.wrap({{ renderExpr (external .HarnessPkg .RefCtorName) }}())
			}))
			{{ renderExpr (external .RootPkg "True") }}(t, f.Failed(),
				"an inert "+m.method+" must diverge from the clean reference")
		})
	}
}
{{ range .Mutants }}
// {{ $c.LowerIface }}ModelMutant{{ .Method }} answers zeros where {{ .Method }} should act.
type {{ $c.LowerIface }}ModelMutant{{ .Method }} struct{ {{ renderType $c.IfaceRef }} }

func ({{ $c.LowerIface }}ModelMutant{{ .Method }}) {{ .Method }}({{ template "model.mutantparams" .Sig }}) {{ template "model.zeroresults" .Sig }}
{{ end }}
{{ end }}
{{ if .Inert }}
// Test{{ .IfaceName }}ModelReferenceInertBodies calls what the sequences
// never do. An inert body's whole contract is answering zero values whatever
// it is handed; a panic here would ambush the first consumer who reaches the
// reference through the interface.
func Test{{ .IfaceName }}ModelReferenceInertBodies(t *{{ renderExpr (external "testing" "T") }}) {
	t.Parallel()
{{- if .NeedsFixture }}
	fx := {{ renderExpr (external .HarnessPkg .FixtureCtor) }}()
{{- end }}
	r := {{ renderExpr (external .HarnessPkg .RefCtorName) }}()
{{- range $p := .Inert }}
	{{ $p.Assign }}r.{{ $p.Method }}({{ if $p.TakesCtx }}t.Context(){{ end }}{{ range $i, $f := $p.ArgFields }}{{ if or $i $p.TakesCtx }}, {{ end }}fx.{{ $f }}{{ end }})
{{- end }}
}
{{ end }}
{{- end -}}

{{- /*
model.mutantparams spells a mutant override's parameter list, every name
blank: an inert body reads nothing, and an unused name is a lint finding in
a generated file.
*/ -}}
{{- define "model.mutantparams" -}}
{{- range $i, $p := .Params }}{{ if $i }}, {{ end }}_ {{ renderType $p.Type }}{{ end -}}
{{- end -}}
