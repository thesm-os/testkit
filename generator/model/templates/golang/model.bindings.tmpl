{{- /*
The whole model tier for one interface: the contract option, the property, the
derived reference, and its adapter. One file so deleting the directive deletes
the tier — and the engine dependency with it.
*/ -}}
{{- define "model.bindings" -}}
{{ $b := . }}
// {{ .OptionName }} runs random sequences of {{ .IfaceName }}'s methods against every
// subject and a known-good in-memory reference side by side, comparing after
// every call. Pass it to {{ .EntryName }}; it reports under
// "{{ .TierName }}", and {{ .IfaceName }}Without("{{ .TierName }}") declines it.
//
{{- if .Reference.Supplied }}
//	Reference: supplied through //testkit:model ref=
{{- else if .Reference.Collects }}
//	Reference: derived — an append-and-drain collection over the
//	           {{ .Values.Field }} fixture pair; {{ .IfaceName }}ModelReference replaces it
{{- else if .Reference.Keyed }}
//	Reference: derived — a keyed store over the {{ .Keys.Field }} and
//	           {{ .Values.Field }} fixture pairs; {{ .IfaceName }}ModelReference replaces it
{{- else }}
//	Reference: derived — a {{ if .Reference.Pins }}resolution-pinning{{ else }}keyed{{ end }} map over the {{ .Values.Field }} fixture pair,
//	           keyed on {{ .Reference.KeyField }}; {{ .IfaceName }}ModelReference replaces it
{{- end }}
//	Sequences: {{ range $i, $a := .Actions }}{{ if $i }}, {{ end }}{{ $a.Method }} ({{ $a.Shape }}){{ end }}
{{- if .UsesValues }}
{{- if .Values.Wide }}
//	Values:    the fixture pair blended with arbitrary draws{{ if .Values.Pin }}, each keyed
//	           from the pool{{ end }}; {{ .IfaceName }}ModelValues replaces the pool
{{- else }}
//	Values:    the fixture pair — {{ .Values.WhyNarrow }};
//	           {{ .IfaceName }}ModelValues is the door to a wider pool
{{- end }}
{{- end }}
{{- with .Laws }}
//	Laws:      {{ range $i, $l := . }}{{ if $i }}, {{ end }}{{ $l.ID }}{{ end }}
{{- end }}
{{- with .Skipped }}
//	Not driven:
{{- range . }}
//	           {{ .Method }} — {{ .Reason }}
{{- end }}
{{- end }}
{{- with .Unbound }}
//	Not bound:
{{- range . }}
//	           {{ .Method }} — {{ .Reason }}
{{- end }}
{{- end }}
func {{ .OptionName }}(opts ...{{ .OptionTypeName }}) {{ .IfaceName }}Option {
	return func(c *{{ lower .IfaceName }}Config) {
		c.extensions = append(c.extensions, {{ lower .IfaceName }}ContractExtension{
			name: "{{ .TierName }}",
			run: func(t *{{ renderExpr (external "testing" "T") }}, _ string, factory func() {{ renderType .IfaceRef }}, _ *{{ lower .IfaceName }}Config) {
				{{ renderExpr (external .ModelPkg "Check") }}(t, {{ .PropertyName }}(factory, opts...))
			},
		})
	}
}

// {{ .PropertyName }} builds the property the option runs — exported because a
// bespoke harness composes from here: model.Check for a test, model.MakeFuzz
// for a coverage-guided fuzz target, both over this one derivation.
func {{ .PropertyName }}(factory func() {{ renderType .IfaceRef }}, opts ...{{ .OptionTypeName }}) func(*{{ renderExpr (external .ModelPkg "T") }}) {
	cfg := new{{ .IfaceName }}ModelConfig(opts...)
	fx := {{ .FixtureCtor }}()
{{- if .UsesKeys }}
	// Two keys, drawn for every key slot: collision density is what makes a
	// read revisit a write and an overwrite land on held state. A wide key
	// pool would pass every comparison over a history that never collides.
	keys := {{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Keys.Type }}{fx.{{ .Keys.Field }}, fx.{{ .Keys.OtherField }}})
{{- end }}
{{- if .UsesValues }}
{{- if .Values.Wide }}
	// Bodies blend the fixture pair with arbitrary draws: the pair keeps
	// identical rewrites frequent, the wide arm reaches values no fixture
	// spells — and nothing in the claims licenses refusing either.
	bodies := {{ renderExpr (external .ModelPkg "OneOf") }}(
		{{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Values.Type }}{fx.{{ .Values.Field }}, fx.{{ .Values.OtherField }}}),
		{{ renderExpr (external .ModelPkg "Make") }}[{{ renderType .Values.Type }}](),
	)
{{- else }}
	// Bodies keep to the fixture pair —
	// {{ .Values.WhyNarrow }}.
	bodies := {{ renderExpr (external .ModelPkg "SampledFrom") }}([]{{ renderType .Values.Type }}{fx.{{ .Values.Field }}, fx.{{ .Values.OtherField }}})
{{- end }}
{{- if .Values.Pin }}
	// Every drawn value lands on a pooled key: a key rewritten under another
	// body is the history latest-write-wins is about, and a fresh-keyed value
	// would never collide with one already held.
	values := {{ renderExpr (external .ModelPkg "Custom") }}(func(t *{{ renderExpr (external .ModelPkg "T") }}) {{ renderType .Values.Type }} {
		v := bodies.Draw(t, "value_body")
		v.{{ .Values.Pin }} = keys.Draw(t, "value_key")
		return v
	})
{{- else }}
	values := bodies
{{- end }}
	if cfg.values != nil {
		values = cfg.values
	}
{{- end }}
	reference := cfg.reference
	if reference == nil {
{{- if .Reference.Supplied }}
		reference = {{ renderExpr .Reference.SuppliedCtor }}
{{- else }}
		reference = {{ .Reference.CtorName }}
{{- end }}
	}
{{- if .Laws }}
	// The laws the classifications earned, each reporting under its AUTO-
	// identifier when it fails. Observational: a law never mutates, so running
	// them inside the sequences is safe for every step that follows.
	laws := {{ renderExpr (external .ModelPkg "NewRegistry") }}[{{ renderType .IfaceRef }}]()
{{- range .Laws }}
	laws.Add({{ render . }})
{{- end }}
{{- end }}
	return {{ renderExpr (external .ModelPkg "Property") }}(factory,
		{{ renderExpr (external .ModelPkg "WithReference") }}(reference),
{{- if .Laws }}
		{{ renderExpr (external .ModelPkg "WithLaws") }}(laws),
{{- end }}
		{{ renderExpr (external .ModelPkg "WithActions") }}(
{{- range .Actions }}
			{{ render . }},
{{- end }}
		),
	)
}
{{ if not .Reference.Supplied }}
{{ if not .Reference.Collects -}}
// {{ .Reference.MissName }} is what the reference reports for a key nothing
// wrote. Only its presence is compared — a subject reports its own miss
// sentinel, and the run asks whether both sides missed, not how they spelled
// it.
var {{ .Reference.MissName }} = {{ renderExpr (external "errors" "New") }}("{{ .MissPrefix }}: the model reference holds nothing under the key")

{{ end -}}
{{ if .Reference.KeyField -}}
// {{ .KeyOfName }} projects a value's identity — the one derivation the
// reference keys on and every keyed law reuses, so the two cannot disagree
// about which field is the key.
func {{ .KeyOfName }}(v {{ renderType .Values.Type }}) {{ renderType .Keys.Type }} {
	return v.{{ .Reference.KeyField }}
}

{{ end -}}
// {{ .Reference.TypeName }} adapts the shipped {{ .Reference.StoreType }} oracle to {{ .IfaceName }}.
// Deliberately simple: its correctness is read, not tested.
type {{ .Reference.TypeName }} struct {
	store *{{ renderExpr (external .RefPkg .Reference.StoreType) }}[{{ if not .Reference.Collects }}{{ renderType .Keys.Type }}, {{ end }}{{ renderType .Values.Type }}]
}

func {{ .Reference.CtorName }}() {{ renderType .IfaceRef }} {
	return &{{ .Reference.TypeName }}{store: {{ renderExpr (external .RefPkg (printf "New%s" .Reference.StoreType)) }}[{{ if not .Reference.Collects }}{{ renderType .Keys.Type }}, {{ end }}{{ renderType .Values.Type }}](
{{- if not .Reference.Collects }}
{{- if not .Reference.Keyed }}
		{{ .KeyOfName }},
{{- end }}
		{{ .Reference.MissName }},
{{- end }}
	)}
}
{{ range .Adapter }}
{{- if .Op }}
func (r *{{ $b.Reference.TypeName }}) {{ .Sig.Name }}({{ template "model.params" .Sig }}) {{ template "model.results" .Sig }} {
	return r.store.{{ .Op }}({{ range $i, $p := .Sig.Params }}{{ if $i }}, {{ end }}{{ $p.Name }}{{ end }})
}
{{ else }}
// {{ .Sig.Name }} is inert: {{ .Reason }}. The laws that would compare the
// subject against an inert body are not bound.
func (r *{{ $b.Reference.TypeName }}) {{ .Sig.Name }}({{ template "model.params" .Sig }}) {{ template "model.zeroresults" .Sig }}
{{ end }}
{{- end }}
{{- end }}
// {{ .OptionTypeName }} configures the model run.
type {{ .OptionTypeName }} func(*{{ .ConfigName }})

// {{ .IfaceName }}ModelReference replaces the derived reference — for an
// interface whose semantics outrun its shape.
func {{ .IfaceName }}ModelReference(factory func() {{ renderType .IfaceRef }}) {{ .OptionTypeName }} {
	return func(c *{{ .ConfigName }}) { c.reference = factory }
}
{{ if .UsesValues }}
// {{ .IfaceName }}ModelValues replaces the values pool — for a subject whose
// accepted values a raw draw cannot spell. The pool feeds every value slot,
// the sequences and the laws alike; keep its draws colliding, because values
// that never revisit a key pass every comparison over a history that holds
// nothing twice.
func {{ .IfaceName }}ModelValues(values *{{ renderExpr (external .ModelPkg "Generator") }}[{{ renderType .Values.Type }}]) {{ .OptionTypeName }} {
	return func(c *{{ .ConfigName }}) { c.values = values }
}
{{ end -}}
type {{ .ConfigName }} struct {
	reference func() {{ renderType .IfaceRef }}
{{- if .UsesValues }}
	values *{{ renderExpr (external .ModelPkg "Generator") }}[{{ renderType .Values.Type }}]
{{- end }}
}

func new{{ .IfaceName }}ModelConfig(opts ...{{ .OptionTypeName }}) *{{ .ConfigName }} {
	c := &{{ .ConfigName }}{}
	for _, o := range opts {
		o(c)
	}
	return c
}
{{- end -}}

{{- /*
model.params spells a signature's parameter list verbatim.
*/ -}}
{{- define "model.params" -}}
{{- range $i, $p := .Params }}{{ if $i }}, {{ end }}{{ $p.Name }} {{ renderType $p.Type }}{{ end -}}
{{- end -}}

{{- /*
model.results spells the return clause for a delegating body.
*/ -}}
{{- define "model.results" -}}
{{- if eq (len .Returns) 1 }}{{ renderType (index .Returns 0).Type }}
{{- else if .Returns }}({{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}{{ renderType $r.Type }}{{ end }})
{{- end -}}
{{- end -}}

{{- /*
model.zeroresults names every return so an inert body is one naked return of
zero values, whatever the signature — no per-type zero spelling to get wrong.
*/ -}}
{{- define "model.zeroresults" -}}
{{- if .Returns }}({{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}r{{ $i }} {{ renderType $r.Type }}{{ end }}) { return }
{{- else }}{}
{{- end -}}
{{- end -}}
