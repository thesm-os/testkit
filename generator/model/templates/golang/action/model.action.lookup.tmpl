{{- /*
A lookup takes no context by shape: the found flags must agree, the first
result where both found, the second only under an option's comparers.
*/ -}}
{{- define "model.action.lookup" -}}
{{ renderExpr .Ctor }}({{ printf "%q" .Method }}, {{ .Pool }},
				func(s {{ renderType .Iface }}, k {{ renderType .Key }}) ({{ renderType .Value }}, {{ renderType .Value2 }}, bool) {
					return s.{{ .Method }}(k)
				})
{{- end -}}
