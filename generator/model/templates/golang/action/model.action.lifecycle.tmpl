{{- /*
A lifecycle call runs on both sides; the comparison is error presence, which
is what both sides can honestly claim about teardown.
*/ -}}
{{- define "model.action.lifecycle" -}}
{{ renderExpr .Ctor }}({{ printf "%q" .Method }},
				func({{ if .TakesCtx }}ctx{{ else }}_{{ end }} {{ renderExpr (external "context" "Context") }}, s {{ renderType .Iface }}) error {
					return s.{{ .Method }}({{ if .TakesCtx }}ctx{{ end }})
				})
{{- end -}}
