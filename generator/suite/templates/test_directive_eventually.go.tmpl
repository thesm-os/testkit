{{- /* Eventually contract: emits one call to
       [suite.AssertEventuallyConverges] with a single-shot sampler
       closure. Runtime owns the polling loop, deadline, and
       equality (via [polling.RetryUntil] backoff). */ -}}
{{- define "test-directive-eventually" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
		suite.AssertEventuallyConverges[{{ $iface }}](
			{{ $m.EventuallyTimeoutGo }}, {{ printf "%q" $m.EventuallyTimeout }},
			func(ctx context.Context, impl {{ $iface }}) any {
{{- if $m.ReturnsError }}
				cur, err := impl.{{ $m.Name }}(ctx)
				if err != nil {
					return err
				}
				return cur
{{- else }}
				return impl.{{ $m.Name }}(ctx)
{{- end }}
			},
		)(t, factory)
{{- end -}}
