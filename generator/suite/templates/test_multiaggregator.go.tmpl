{{- /* MultiAggregator-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-multiaggregator" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $opts := .Opts -}}
{{- $V1 := $m.ShapeValType -}}
{{- $V2 := $m.ShapeValType2 -}}
		sctx := suite.MultiAggregatorContextFor[{{ $iface }}, {{ $V1 }}, {{ $V2 }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}) ({{ $V1 }}, {{ $V2 }}, error) {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx)
{{- else }}
				return impl.{{ $m.Name }}()
{{- end }}
			})
		var extras []suite.MultiAggregatorAssertion[{{ $iface }}, {{ $V1 }}, {{ $V2 }}]
{{- if $m.HasFirstSentinel }}
		if invalidFactory, ok := {{ $opts }}.InvalidFactory.(func() {{ $iface }}); ok {
			extras = append(extras, suite.AssertMultiAggregatorReturnsSentinel[{{ $iface }}, {{ $V1 }}, {{ $V2 }}](invalidFactory, {{ $m.SentinelsList }}))
		}
{{- end }}
		suite.AssertMultiAggregatorBaseline[{{ $iface }}, {{ $V1 }}, {{ $V2 }}](
			{{ $m.SampleResultAt 0 $tracker }},
			{{ $m.SampleResultAt 1 $tracker }},
			extras...,
		)(sctx)
{{- end -}}
