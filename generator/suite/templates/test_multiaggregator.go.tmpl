{{- /* MultiAggregator-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-multiaggregator" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $V1 := $m.ShapeValType -}}
{{- $V2 := $m.ShapeValType2 -}}
		sctx := suite.MultiAggregatorContextFor[{{ $iface }}, {{ $V1 }}, {{ $V2 }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}) ({{ $V1 }}, {{ $V2 }}, error) {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx)
{{- else }}
				return impl.{{ $m.Name }}()
{{- end }}
			})
		suite.AssertMultiAggregatorReturns[{{ $iface }}, {{ $V1 }}, {{ $V2 }}]({{ $m.SampleResultAt 0 $tracker }}, {{ $m.SampleResultAt 1 $tracker }})(sctx)
		suite.AssertMultiAggregatorRespectsContext[{{ $iface }}, {{ $V1 }}, {{ $V2 }}]()(sctx)
		suite.AssertMultiAggregatorConsistent[{{ $iface }}, {{ $V1 }}, {{ $V2 }}](3)(sctx)
		t.Run("rejects invalid", func(t *testing.T) {
			t.Skipf("{{ $m.Name }}: AssertMultiAggregatorReturnsSentinel requires consumer-supplied invalidFactory + sentinel")
		})
		suite.AssertMultiAggregatorConcurrentSafe[{{ $iface }}, {{ $V1 }}, {{ $V2 }}](4, 10)(sctx)
{{- end -}}
