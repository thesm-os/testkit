{{- /* Read-after-write contract: directive sits on the writer
       method (CompositeWriter shape: ctx, K, V → error). The
       contract calls writer with (sample K, sample V), then reads
       via the named reader, asserts the read returns the written
       value.

       The directive validator (Task 18) rejects read-after-write
       on methods whose shape doesn't match (K, V) → error. */ -}}
{{- define "test-directive-readafterwrite" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
		suite.AssertReadAfterWriteByKey[{{ $iface }}, {{ $K }}, {{ $V }}](
			{{ $m.SampleParamAt 0 $tracker }}, {{ $m.SampleParamAt 1 $tracker }},
			func(ctx context.Context, impl {{ $iface }}, k {{ $K }}, v {{ $V }}) error {
				return impl.{{ $m.Name }}(ctx, k, v)
			},
			func(ctx context.Context, impl {{ $iface }}, k {{ $K }}) ({{ $V }}, error) {
				return impl.{{ $m.ReadAfterWriteReader }}(ctx, k)
			},
		)(t, factory)
{{- end -}}
