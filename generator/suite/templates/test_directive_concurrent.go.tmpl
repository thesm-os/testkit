{{- /* Concurrent (strict) contract: emits one call to
       [suite.AssertConcurrentStrict] with a void-returning closure
       that discards results. The runtime drives 16 workers × 25
       iters; race detector finds violations. */ -}}
{{- define "test-directive-concurrent" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
		suite.AssertConcurrentStrict[{{ $iface }}](
			func(ctx context.Context, impl {{ $iface }}) {
{{- if $m.HasResults }}
				{{ $m.BlankResults }} = impl.{{ $m.Name }}({{ $m.SampleArgs $tracker }})
{{- else }}
				impl.{{ $m.Name }}({{ $m.SampleArgs $tracker }})
{{- end }}
			},
		)(t, factory)
{{- end -}}
