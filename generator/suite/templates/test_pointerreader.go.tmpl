{{- /* PointerReader-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-pointerreader" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
		sctx := suite.PointerReaderContextFor[{{ $iface }}, {{ $K }}, {{ $V }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, key {{ $K }}) *{{ $V }} {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx, key)
{{- else }}
				return impl.{{ $m.Name }}(key)
{{- end }}
			})
		suite.AssertPointerReaderReturnsForKey[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.SampleResultAt 0 $tracker }})(sctx)
		suite.AssertPointerReaderRespectsContext[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }})(sctx)
		suite.AssertPointerReaderConsistent[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, 3)(sctx)
		suite.AssertPointerReaderNilOnUnknown[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.ZeroParamAt 0 $tracker }})(sctx)
		suite.AssertPointerReaderConcurrentSafe[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, 4, 10)(sctx)
{{- end -}}
