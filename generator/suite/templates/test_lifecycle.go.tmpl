{{- /* Lifecycle-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-lifecycle" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
		sctx := suite.LifecycleContextFor[{{ $iface }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}) error {
				return impl.{{ $m.Name }}(ctx)
			})
		suite.AssertLifecycleSucceeds[{{ $iface }}]()(sctx)
		suite.AssertLifecycleRespectsContext[{{ $iface }}]()(sctx)
		suite.AssertLifecycleIdempotent[{{ $iface }}]()(sctx)
		t.Run("rejects invalid", func(t *testing.T) {
			t.Skipf("{{ $m.Name }}: AssertLifecycleRejectInvalid requires consumer-supplied invalidFactory + sentinel")
		})
		suite.AssertLifecycleConcurrentSafe[{{ $iface }}](4, 10)(sctx)
{{- end -}}
