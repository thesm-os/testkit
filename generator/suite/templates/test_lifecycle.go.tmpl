{{- /* Lifecycle-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-lifecycle" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $opts := .Opts -}}
		sctx := suite.LifecycleContextFor[{{ $iface }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}) error {
				return impl.{{ $m.Name }}(ctx)
			})
		var extras []suite.LifecycleAssertion[{{ $iface }}]
		if invalidFactory, ok := {{ $opts }}.InvalidFactory.(func() {{ $iface }}); ok {
{{- if $m.HasFirstSentinel }}
			extras = append(extras, suite.AssertLifecycleRejectInvalid[{{ $iface }}](invalidFactory, {{ $m.SentinelsList }}))
{{- else }}
			extras = append(extras, suite.AssertLifecycleRejectInvalidWith[{{ $iface }}](invalidFactory))
{{- end }}
		}
		suite.AssertLifecycleBaseline[{{ $iface }}](extras...)(sctx)
{{- end -}}
