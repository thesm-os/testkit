{{- /* Per-method dispatcher.
       For each non-skipped method, opens one t.Run("<Method>", ...)
       block containing the shape-specific baseline assertion. Each
       Assert<Shape>Baseline runs its own "smoke" subtest first
       (fail-fast on panic), then the contract assertions, so test
       output groups uniformly under one path per method:
         TestStoreContract/Get/smoke
         TestStoreContract/Get/returns for key …
         TestStoreContract/Get/respects context
       … with smoke owned by the runtime, not the dispatcher. */ -}}
{{- define "test-method" -}}
{{- $iface := .QualifiedTypeForTest -}}
{{- $tracker := .Spec.Tracker -}}
{{- $spec := .Spec -}}
{{- range $m := .Methods }}
{{- if not $m.IsIntegrationOnly }}

	// {{ $m.Name }} — {{ $m.ShapeName }}-shape method.
	//
	// Shape semantics:
	//   {{ $m.ShapeDescription }}
	//
	// Default contracts (always run for {{ $m.ShapeName }}):
{{- range $c := $m.BaselineSubtests }}
	//   - {{ $c.Name }}
	//       {{ $c.Description }}
{{- end }}
{{- $extras := $m.OptionalBaselineExtras }}
{{- if $extras }}
	//
	// Optional baseline extras (gated on signature/options):
{{- range $c := $extras }}
	//   - {{ $c.Name }}
	//       {{ $c.Description }}
{{- end }}
{{- end }}
{{- $directives := $m.DirectiveContracts }}
{{- if $directives }}
	//
	// Directive contracts (extra subtests below the baseline):
{{- range $c := $directives }}
	//   - {{ $c.Name }}
	//       {{ $c.Description }}
{{- end }}
{{- end }}
	t.Run("{{ $m.Name }}", func(t *testing.T) {
{{- $args := (dict "M" $m "Iface" $iface "Tracker" $tracker "Opts" "resolved") -}}
{{- if eq $m.ShapeName "Reader" }}
{{ template "test-method-reader" $args }}
{{- else if eq $m.ShapeName "ReaderNoError" }}
{{ template "test-method-readernoerror" $args }}
{{- else if eq $m.ShapeName "ReaderWithBool" }}
{{ template "test-method-readerwithbool" $args }}
{{- else if eq $m.ShapeName "Lookup" }}
{{ template "test-method-lookup" $args }}
{{- else if eq $m.ShapeName "PointerReader" }}
{{ template "test-method-pointerreader" $args }}
{{- else if eq $m.ShapeName "MultiReader" }}
{{ template "test-method-multireader" $args }}
{{- else if eq $m.ShapeName "BatchReader" }}
{{ template "test-method-batchreader" $args }}
{{- else if eq $m.ShapeName "Writer" }}
{{ template "test-method-writer" $args }}
{{- else if eq $m.ShapeName "CompositeWriter" }}
{{ template "test-method-compositewriter" $args }}
{{- else if eq $m.ShapeName "Mutator" }}
{{ template "test-method-mutator" $args }}
{{- else if eq $m.ShapeName "Deleter" }}
{{ template "test-method-deleter" $args }}
{{- else if eq $m.ShapeName "MultiArgWriter" }}
{{ template "test-method-multiargwriter" $args }}
{{- else if eq $m.ShapeName "Aggregator" }}
{{ template "test-method-aggregator" $args }}
{{- else if eq $m.ShapeName "MultiAggregator" }}
{{ template "test-method-multiaggregator" $args }}
{{- else if eq $m.ShapeName "StreamReader" }}
{{ template "test-method-streamreader" $args }}
{{- else if eq $m.ShapeName "StreamConsumer" }}
{{ template "test-method-streamconsumer" $args }}
{{- else if eq $m.ShapeName "Lifecycle" }}
{{ template "test-method-lifecycle" $args }}
{{- else if eq $m.ShapeName "VoidLifecycle" }}
{{ template "test-method-voidlifecycle" $args }}
{{- else if eq $m.ShapeName "Pure" }}
{{ template "test-method-pure" $args }}
{{- else if eq $m.ShapeName "Predicate" }}
{{ template "test-method-predicate" $args }}
{{- else if eq $m.ShapeName "PoisonAccessor" }}
{{ template "test-method-poisonaccessor" $args }}
{{- end }}
{{- /* Per-directive subtests, in registry order. Each partial is
       gated on the directive's HasX predicate; partials emit
       nothing when the predicate is false. */ -}}
{{- if $m.IsDeprecated }}
{{ template "test-directive-deprecated" $args }}{{ end }}
{{- if $m.HasRetrySucceeds }}
{{ template "test-directive-retryable" $args }}{{ end }}
{{- if $m.HasOrderAfter }}
{{ template "test-directive-orderafter" $args }}{{ end }}
{{- if $m.HasPartition }}
{{ template "test-directive-partition" $args }}{{ end }}
{{- if $m.HasWrappedVia }}
{{ template "test-directive-wrappedvia" $args }}{{ end }}
{{- if $m.IsIdempotent }}
{{ template "test-directive-idempotent" $args }}{{ end }}
{{- if $m.IsPure }}
{{ template "test-directive-pure" $args }}{{ end }}
{{- if $m.IsCacheable }}
{{ template "test-directive-cacheable" $args }}{{ end }}
{{- if $m.IsMonotonic }}
{{ template "test-directive-monotonic" $args }}{{ end }}
{{- if $m.IsConcurrent }}
{{ template "test-directive-concurrent" $args }}{{ end }}
{{- if $m.IsConcurrentReaders }}
{{ template "test-directive-concurrentreaders" $args }}{{ end }}
{{- if $m.IsNilSafe }}
{{ template "test-directive-nilsafe" $args }}{{ end }}
{{- if $m.IsAtomic }}
{{ template "test-directive-atomic" $args }}{{ end }}
{{- if $m.HasBounded }}
{{ template "test-directive-bounded" $args }}{{ end }}
{{- if $m.HasTimeout }}
{{ template "test-directive-timeout" $args }}{{ end }}
{{- if $m.HasSideEffect }}
{{ template "test-directive-sideeffect" $args }}{{ end }}
{{- if $m.HasValidates }}
{{ template "test-directive-validates" $args }}{{ end }}
{{- if $m.HasHooks }}
{{ template "test-directive-hooks" $args }}{{ end }}
{{- if $m.HasEventually }}
{{ template "test-directive-eventually" $args }}{{ end }}
{{- if $m.HasScope }}
{{ template "test-directive-scope" $args }}{{ end }}
{{- if $m.HasPagination }}
{{ template "test-directive-pagination" $args }}{{ end }}
{{- if $m.HasLease }}
{{ template "test-directive-lease" $args }}{{ end }}
{{- if $m.HasReadAfterWrite }}
{{ template "test-directive-readafterwrite" $args }}{{ end }}
{{- if $m.HasDeleteRemoves }}
{{ template "test-directive-deleteremoves" $args }}{{ end }}
{{- if $m.HasStreamReflectsMutations }}
{{ template "test-directive-streamreflectsmutations" $args }}{{ end }}
{{- if $m.HasLifecycleAfterClose }}
{{ template "test-directive-lifecycleafterclose" $args }}{{ end }}
{{- if $m.HasCRDTMerge }}
{{ template "test-directive-crdtmerge" $args }}{{ end }}
	})
{{ end }}{{ end -}}
{{- end -}}
