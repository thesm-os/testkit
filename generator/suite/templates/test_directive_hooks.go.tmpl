{{- /* Hooks contract: emits one call to [suite.AssertHooksFire]
       with the declared hook names + a closure that invokes the
       method with the supplied (recorder-attached) context.
       Methods without context cannot receive the recorder; the
       directive validator (Task 18) rejects hooks on no-ctx
       methods. */ -}}
{{- define "test-directive-hooks" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- if $m.HasContext }}
		suite.AssertHooksFire[{{ $iface }}](
			[]string{ {{ range $i, $h := $m.HookNames }}{{ if $i }}, {{ end }}{{ printf "%q" $h }}{{ end }} },
			func(ctx context.Context, impl {{ $iface }}) {
{{- if $m.HasResults }}
				{{ $m.BlankResults }} = impl.{{ $m.Name }}(ctx{{ range $i := seq $m.NonCtxParamCount }}, {{ $m.SampleParamAt $i $tracker }}{{ end }})
{{- else }}
				impl.{{ $m.Name }}(ctx{{ range $i := seq $m.NonCtxParamCount }}, {{ $m.SampleParamAt $i $tracker }}{{ end }})
{{- end }}
			},
		)(t, factory)
{{- end }}
{{- end -}}
