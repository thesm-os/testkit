{{- /* Cacheable contract: emits one call to
       [suite.AssertCacheableRepeatedReads] with a single-shot
       sampler closure. Runtime owns the three-call loop +
       pairwise equality. */ -}}
{{- define "test-directive-cacheable" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $R := $m.ResultTypeAt 0 $tracker -}}
		suite.AssertCacheableRepeatedReads[{{ $iface }}, {{ $R }}](
			func(ctx context.Context, impl {{ $iface }}) ({{ $R }}, error) {
{{- if $m.ReturnsError }}
				return impl.{{ $m.Name }}({{ $m.SampleArgs $tracker }})
{{- else }}
				return impl.{{ $m.Name }}({{ $m.SampleArgs $tracker }}), nil
{{- end }}
			},
		)(t, factory)
{{- end -}}
