{{- /* Validates contract: emits one call to [suite.AssertValidatesZeroInput]
       with a typed error closure that captures the impl's trailing
       error via [ErrCaptureLHS]. The directive validator (Task 18)
       rejects validates on methods that don't return an error. */ -}}
{{- define "test-directive-validates" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- if $m.ReturnsError }}
		suite.AssertValidatesZeroInput[{{ $iface }}](
			{{ printf "%q" $m.ValidatesField }},
			func(ctx context.Context, impl {{ $iface }}) error {
				{{ $m.ErrCaptureLHS }} := impl.{{ $m.Name }}({{ $m.ZeroArgs $tracker }})
				return err
			},
		)(t, factory)
{{- end }}
{{- end -}}
