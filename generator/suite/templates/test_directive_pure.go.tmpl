{{- /* Pure contract: emits one call to [suite.AssertPureImplIndependent]
       with a single-shot sampler closure. The runtime owns the
       two-impl construction + equality check. */ -}}
{{- define "test-directive-pure" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $R := $m.ResultTypeAt 0 $tracker -}}
		suite.AssertPureImplIndependent[{{ $iface }}, {{ $R }}](
			func(ctx context.Context, impl {{ $iface }}) ({{ $R }}, error) {
{{- if $m.ReturnsError }}
				return impl.{{ $m.Name }}({{ $m.SampleArgs $tracker }})
{{- else }}
				return impl.{{ $m.Name }}({{ $m.SampleArgs $tracker }}), nil
{{- end }}
			},
		)(t, factory)
{{- end -}}
