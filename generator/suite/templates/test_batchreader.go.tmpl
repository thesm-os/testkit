{{- /* BatchReader-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-batchreader" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
		sctx := suite.BatchReaderContextFor[{{ $iface }}, {{ $K }}, {{ $V }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, keys []{{ $K }}) ([]{{ $V }}, error) {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx, keys...)
{{- else }}
				return impl.{{ $m.Name }}(keys...)
{{- end }}
			})
		sampleKeys := {{ $m.SampleParamAt 0 $tracker }}
		sampleVals := {{ $m.SampleResultAt 0 $tracker }}
		suite.AssertBatchReaderReturnsAll[{{ $iface }}, {{ $K }}, {{ $V }}](sampleKeys, sampleVals)(sctx)
		suite.AssertBatchReaderRespectsContext[{{ $iface }}, {{ $K }}, {{ $V }}](sampleKeys)(sctx)
		suite.AssertBatchReaderConsistent[{{ $iface }}, {{ $K }}, {{ $V }}](sampleKeys, 3)(sctx)
{{- if $m.HasFirstSentinel }}
		suite.AssertBatchReaderReturnsSentinel[{{ $iface }}, {{ $K }}, {{ $V }}](sampleKeys, {{ $m.FirstSentinel }})(sctx)
{{- end }}
		suite.AssertBatchReaderConcurrentSafe[{{ $iface }}, {{ $K }}, {{ $V }}](sampleKeys, 4, 10)(sctx)
{{- end -}}
