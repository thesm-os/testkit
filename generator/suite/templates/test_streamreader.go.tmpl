{{- /* StreamReader-shape baseline body. Body-only partial.

       The runtime [suite.StreamContextFor] takes an
       iter.Seq2[V, error] call closure. Methods that return
       iter.Seq[V] (no error) are wrapped in an adapter that yields
       (v, nil) so the same baseline assertions exercise both
       single- and double-arity stream returns. */ -}}
{{- define "test-method-streamreader" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $V := $m.ShapeIterValType -}}
{{- $iter := $m.IterReturn $tracker -}}
		sctx := suite.StreamContextFor[{{ $iface }}, {{ $V }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}) iter.Seq2[{{ $V }}, error] {
{{- if $iter.IsSeq2 }}
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx)
{{- else }}
				return impl.{{ $m.Name }}()
{{- end }}
{{- else }}
{{- if $m.HasContext }}
				seq := impl.{{ $m.Name }}(ctx)
{{- else }}
				seq := impl.{{ $m.Name }}()
{{- end }}
				return func(yield func({{ $V }}, error) bool) {
					for v := range seq {
						if !yield(v, nil) {
							return
						}
					}
				}
{{- end }}
			})
		suite.AssertStreamBaseline[{{ $iface }}, {{ $V }}]()(sctx)
{{- end -}}
