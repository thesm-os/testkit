{{- /* Deleter-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-deleter" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
		sctx := suite.DeleterContextFor[{{ $iface }}, {{ $K }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, key {{ $K }}) error {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx, key)
{{- else }}
				return impl.{{ $m.Name }}(key)
{{- end }}
			})
		suite.AssertDeleteSucceeds[{{ $iface }}, {{ $K }}]({{ $m.SampleParamAt 0 $tracker }})(sctx)
		suite.AssertDeleterRespectsContext[{{ $iface }}, {{ $K }}]({{ $m.SampleParamAt 0 $tracker }})(sctx)
		suite.AssertDeleteIdempotent[{{ $iface }}, {{ $K }}]({{ $m.SampleParamAt 0 $tracker }})(sctx)
{{- if $m.HasFirstSentinel }}
		suite.AssertDeleteReturnsNotFound[{{ $iface }}, {{ $K }}]({{ $m.ZeroParamAt 0 $tracker }}, {{ $m.FirstSentinel }})(sctx)
{{- else }}
		t.Run("rejects invalid (no sentinel)", func(t *testing.T) {
			t.Skipf("{{ $m.Name }}: RejectInvalid baseline requires //testkit:errors <NotFound> sentinel; subtest omitted")
		})
{{- end }}
		suite.AssertDeleterConcurrentSafe[{{ $iface }}, {{ $K }}]({{ $m.SampleParamAt 0 $tracker }}, 4, 10)(sctx)
{{- end -}}
