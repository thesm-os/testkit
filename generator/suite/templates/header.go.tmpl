{{- /* File header partial: package decl + import block. Mirrors
       the stub generator's header partial — the file-prefix lines
       (Code generated, Source attribution, Directives listing) are
       emitted by the pipeline before the template runs. */ -}}
{{- define "header" -}}
package {{ .PackageName }}

import (
{{- range .Imports }}
	{{ if .Alias }}{{ .Alias }} {{ end }}{{ printf "%q" .Path }}
{{- end }}
)
{{ end -}}
