{{- /* Wrapped-via contract: emits one call to [suite.AssertWrappedVia]
       with the wrap target + a typed error closure + the full set of
       declared //testkit:errors sentinels. The runtime asserts the
       error wraps the target AND unwraps to at least one of the
       declared sentinels, so multi-sentinel methods don't silently
       drop their second/third entries. Composes with the errors
       directive (the directive validator rejects wrapped-via without
       errors). */ -}}
{{- define "test-directive-wrappedvia" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- if $m.HasFirstSentinel }}
		suite.AssertWrappedVia[{{ $iface }}](
			{{ $m.WrappedViaTarget }},
			func(ctx context.Context, impl {{ $iface }}) error {
				{{ $m.ErrCaptureLHS }} := impl.{{ $m.Name }}({{ $m.ZeroArgs $tracker }})
				return err
			},
			{{ $m.SentinelsList }},
		)(t, factory)
{{- end }}
{{- end -}}
