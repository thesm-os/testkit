{{- /* StreamConsumer-shape baseline body. Body-only partial.

       The runtime emits "WithDefault" variants that wrap a fresh
       `bytes.NewReader([]byte("test-data"))` per call. Works when
       the impl's stream type S is [io.Reader] (the common case);
       for non-[io.Reader] S, the runtime fails the test with a
       clear message naming the missing [WithStreamSample] option —
       no silent skip. */ -}}
{{- define "test-method-streamconsumer" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $S := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
		sctx := suite.StreamConsumerContextFor[{{ $iface }}, {{ $S }}, {{ $V }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, s {{ $S }}) ({{ $V }}, error) {
				return impl.{{ $m.Name }}(ctx, s)
			})
		suite.AssertStreamConsumerSucceedsWithDefault[{{ $iface }}, {{ $S }}, {{ $V }}]({{ $m.SampleResultAt 0 $tracker }})(sctx)
		suite.AssertStreamConsumerRespectsContextWithDefault[{{ $iface }}, {{ $S }}, {{ $V }}]()(sctx)
		suite.AssertStreamConsumerConcurrentSafeWithDefault[{{ $iface }}, {{ $S }}, {{ $V }}](4, 10)(sctx)
{{- end -}}
