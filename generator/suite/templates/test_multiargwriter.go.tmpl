{{- /* MultiArgWriter-shape baseline body. Body-only partial.

       Uses the variadic suite runtime so any non-ctx arity works
       from one set of assertions. The emitted wrapper closure
       converts `[]any` back to typed args at the call site —
       type safety at the consumer boundary, arity-agnosticism in
       the runtime. */ -}}
{{- define "test-method-multiargwriter" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
		sctx := suite.MultiArgWriterVariadicContextFor[{{ $iface }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, args ...any) error {
				return impl.{{ $m.Name }}(ctx{{ range $i := seq $m.NonCtxParamCount }}, args[{{ $i }}].({{ $m.ParamTypeAt $i $tracker }}){{ end }})
			})
		suite.AssertMultiArgWriteSucceedsVariadic[{{ $iface }}]({{ range $i := seq $m.NonCtxParamCount }}{{ if $i }}, {{ end }}{{ $m.SampleParamAt $i $tracker }}{{ end }})(sctx)
		suite.AssertMultiArgWriterRespectsContextVariadic[{{ $iface }}]({{ range $i := seq $m.NonCtxParamCount }}{{ if $i }}, {{ end }}{{ $m.SampleParamAt $i $tracker }}{{ end }})(sctx)
		suite.AssertMultiArgWriterIdempotentVariadic[{{ $iface }}]({{ range $i := seq $m.NonCtxParamCount }}{{ if $i }}, {{ end }}{{ $m.SampleParamAt $i $tracker }}{{ end }})(sctx)
{{- if $m.HasFirstSentinel }}
		suite.AssertMultiArgWriteRejectInvalidVariadic[{{ $iface }}]({{ $m.FirstSentinel }}{{ range $i := seq $m.NonCtxParamCount }}, {{ $m.ZeroParamAt $i $tracker }}{{ end }})(sctx)
{{- end }}
		suite.AssertMultiArgWriterConcurrentSafeVariadic[{{ $iface }}](4, 10{{ range $i := seq $m.NonCtxParamCount }}, {{ $m.SampleParamAt $i $tracker }}{{ end }})(sctx)
{{- end -}}
