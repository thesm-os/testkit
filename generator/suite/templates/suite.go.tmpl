{{- /*
       Suite root template — composes the per-concern partials. The
       output is the consumer-facing contract driver: a function
       Assert<Iface>Contract(t, factory) that runs every per-method,
       per-shape, per-directive subtest against any implementation
       supplied via the factory, plus the multi-impl
       Assert<Iface>ContractAcrossImpls(t, factories...) entry point.

       Output structure:
         1. package-doc          — // Package X_test ... block
         2. header               — package + imports
         3. driver               — single-impl + multi-impl driver scaffold
*/ -}}
{{- define "suite" -}}
{{ template "package-doc" . -}}
{{ template "header" . }}
{{ template "driver" . }}
{{- end -}}
