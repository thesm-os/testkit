{{- /*
The first check that writes twice. Only the axis differs between them: holding
every other argument fixed is what makes the two writes collide, and a version
that varied them all passed against an implementation ignoring partitions
entirely.
*/ -}}
{{- define "suite.check.partition" -}}
{{ $m := .Method }}
{{ $p := .Partner }}
// {{ .Func }} asserts a write under one partition is invisible to another.
//
// Fails when: {{ $p.Name }} returns the wrong partition's payload, or nothing at
// all. That is the whole content of the mixin and no single call can state it —
// a subject ignoring the partition satisfies every check derived from this
// signature, because one write and one read agree however the key was scoped.
//
// The second write differs from the first in the isolation axis alone, which the
// source names. Everything else is held, so the two land on the same key and
// only the partition keeps them apart.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}
	{{- range $m.CallArgs }}, {{ .Name }} {{ renderType .Type }}{{ end }}
	{{- range .Extra }}, {{ .Name }} {{ renderType .Type }}{{ end }}) {
	tb.Helper()
{{- if or $m.TakesContext $p.TakesContext }}
	ctx := tb.Context()
{{- end }}
	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}err{{ else }}_{{ end }}{{ end }} := subject.{{ $m.Name }}({{ template "suite.args" . }})
	{{ renderExpr (external $.Runtime "NoError") }}(tb, err,
		"the first write must succeed for isolation to mean anything")

	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}otherErr{{ else }}_{{ end }}{{ end }} := subject.{{ $m.Name }}({{ if $m.TakesContext }}ctx{{ end }}{{ range $i, $a := .SecondCall }}{{ if or $i $m.TakesContext }}, {{ end }}{{ $a }}{{ end }})
	{{ renderExpr (external $.Runtime "NoError") }}(tb, otherErr,
		"and so must the write to the other partition")

	{{ range $i, $r := $p.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}readErr{{ else }}got{{ end }}{{ end }} := subject.{{ $p.Name }}({{ template "suite.partnerargs" $ }})
	{{ renderExpr (external $.Runtime "NoError") }}(tb, readErr,
		"reading back the first partition must succeed")
	{{ renderExpr (external $.Runtime "Equal") }}(tb, got, {{ .CompareAgainst }},
		"{{ $p.Name }} must return what {{ $m.Name }} wrote to its own partition, not the other's")
}
{{- end -}}
