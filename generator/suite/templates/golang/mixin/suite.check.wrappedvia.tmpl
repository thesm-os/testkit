{{- /*
Conditional on there being a cause. A subject with nothing wrong has no wrapped
error to show, and demanding one would fail an implementation that is simply
healthy — so the cause is asked first, and a healthy subject is a visible skip
rather than a green line claiming a comparison that never happened.
*/ -}}
{{- define "suite.check.wrappedvia" -}}
{{ $m := .Method }}
{{ $p := .Partner }}
// {{ .Func }} asserts a failure from {{ $m.Name }} carries what {{ $p.Name }} reports.
//
// Fails when: {{ $m.Name }} fails without the cause reachable through
// errors.Is. A caller who wrote `errors.Is(err, target)` against the documented
// cause gets false, and the branch they wrote for it never runs — which is a
// defect no assertion about the error's presence catches.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}
	{{- range $m.CallArgs }}, {{ .Name }} {{ renderType .Type }}{{ end }}) {
	tb.Helper()
{{- if or $m.TakesContext $p.TakesContext }}
	ctx := tb.Context()
{{- end }}
	cause := subject.{{ $p.Name }}({{ template "suite.partnerargs" $ }})
	if cause == nil {
		// Nothing to wrap, so nothing to claim. A subject in good health is not
		// a subject in breach — and the skip says the claim went unexercised.
		tb.Skipf("{{ $p.Name }} reports no cause; nothing this run does makes " +
			"{{ $m.Name }} fail, so the wrapping claim goes unexercised")
		return
	}

	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}err{{ else }}_{{ end }}{{ end }} := subject.{{ $m.Name }}({{ template "suite.args" . }})
	{{ renderExpr (external $.Runtime "ErrorIs") }}(tb, err, cause,
		"{{ $m.Name }} must report {{ $p.Name }}'s cause where errors.Is can find it")
}
{{- end -}}
