{{- /*
The check takes no derived argument at all: the input comes from the builder the
mixin names, which is the whole claim. Handing it the fixture's value instead
would test the derivation rather than the pair.
*/ -}}
{{- define "suite.check.sample" -}}
{{ $m := .Method }}
{{ $p := .Partner }}
// {{ .Func }} asserts {{ $m.Name }} accepts what {{ $p.Name }} produces.
//
// Fails when: {{ $p.Name }} yields a value {{ $m.Name }} rejects. A sampled
// suite is only as good as its sampler, and a builder that drifts from what the
// method accepts turns every sampled run into a wall of failures about the
// fixture rather than the subject — which is how a suite gets switched off.
//
// The sampled value is the builder's answer, never the fixture's — a value the
// fixture invented would say nothing about the pair. The builder's own
// arguments are the fixture's to supply.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}
	{{- range $p.CallArgs }}, {{ .Name }} {{ renderType .Type }}{{ end }}) {
	tb.Helper()
{{- if or $m.TakesContext $p.TakesContext }}
	ctx := tb.Context()
{{- end }}
	{{ range $i, $r := $p.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}buildErr{{ else }}sampled{{ end }}{{ end }} := subject.{{ $p.Name }}({{ template "suite.partnerargs" $ }})
{{- if $p.ReturnsError }}
	{{ renderExpr (external $.Runtime "NoError") }}(tb, buildErr,
		"{{ $p.Name }} must produce a value for {{ $m.Name }} to be sampled with")
{{- end }}

	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}err{{ else }}_{{ end }}{{ end }} := subject.{{ $m.Name }}({{ if $m.TakesContext }}ctx, {{ end }}sampled)
	{{ renderExpr (external $.Runtime "NoError") }}(tb, err,
		"{{ $m.Name }} must accept what {{ $p.Name }} produced")
}
{{- end -}}
