{{- /*
The claim the idempotence check skips on, so its deferral has somewhere to go.
*/ -}}
{{- define "suite.check.cleanteardown" -}}
{{ $m := .Method }}
// {{ .Func }} asserts a fresh subject tears down without error.
//
// Fails when: {{ $m.Name }} refuses on a subject nothing has done anything to.
//
// Separate from the second-call claim, and the separation is the point. That
// check skips when the first call fails, on the grounds that a teardown
// refusing outright is another check's finding — and until this existed there
// was no other check. Smoke discards the error by design and the remaining
// teardown checks assert only what happens under a cancelled or expired
// context, so a subject whose {{ $m.Name }} always failed skipped the
// idempotence claim and passed the tier with nothing asserted about the one
// operation it declared.
//
// Two checks rather than folding this into that one, because they fail for
// different reasons and a reader deserves to be told which: the teardown is
// broken, or the teardown is not repeatable.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}) {
	tb.Helper()
	ctx := tb.Context()
	{{ renderExpr (external $.Runtime "NoError") }}(tb, subject.{{ $m.Name }}(ctx),
		"{{ $m.Name }} on a fresh subject must succeed before anything about a second call can be stated")
}
{{- end -}}
