{{- /*
Agreement rather than rejection. "What the validator rejects, the method
rejects" needs a value the validator rejects, and nothing in the directive says
which one that is — so a derived value it happens to admit would turn the check
into a demand that a correct implementation fail.
*/ -}}
{{- define "suite.check.validates" -}}
{{ $m := .Method }}
{{ $p := .Partner }}
// {{ .Func }} asserts {{ $m.Name }} refuses exactly what {{ $p.Name }} does.
//
// Fails when: the two disagree about the value the run holds. A subject whose
// writer accepts what its validator refuses stores what nobody vetted, and one
// that refuses what the validator admits rejects work that was fine — and
// neither is visible in a single call to either.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}
	{{- range $m.CallArgs }}, {{ .Name }} {{ renderType .Type }}{{ end }}) {
	tb.Helper()
{{- if or $m.TakesContext $p.TakesContext }}
	ctx := tb.Context()
{{- end }}
	verdict := subject.{{ $p.Name }}({{ template "suite.partnerargs" $ }})
	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}err{{ else }}_{{ end }}{{ end }} := subject.{{ $m.Name }}({{ template "suite.args" . }})

	if verdict == nil {
		{{ renderExpr (external $.Runtime "NoError") }}(tb, err,
			"{{ $m.Name }} must accept what {{ $p.Name }} admits")
		return
	}
	{{ renderExpr (external $.Runtime "Error") }}(tb, err,
		"{{ $m.Name }} must refuse what {{ $p.Name }} rejects")
}
{{- end -}}
