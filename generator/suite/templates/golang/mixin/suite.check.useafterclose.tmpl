{{- /*
Closure discipline with an identity: once the named teardown ran, the
operation reports the declared sentinel — not merely something.
*/ -}}
{{- define "suite.check.useafterclose" -}}
{{ $m := .Method }}
{{ $p := .Partner }}
// {{ .Func }} asserts {{ $m.Name }} reports the declared sentinel once {{ $p.Name }} ran.
//
// Fails when: the call after teardown succeeds, or fails with anything the
// declared sentinel cannot be found in through errors.Is. An unrelated error
// passing as closure discipline is exactly what naming the sentinel rules out.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}
	{{- range $m.CallArgs }}, {{ .Name }} {{ renderType .Type }}{{ end }}) {
	tb.Helper()
	{{ if or $m.TakesContext $p.TakesContext }}ctx := tb.Context()
	{{ end }}{{ renderExpr (external $.Runtime "NoError") }}(tb, subject.{{ $p.Name }}({{ if $p.TakesContext }}ctx{{ end }}),
		"{{ $p.Name }} must tear down cleanly for the claim to be reachable")
	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}err{{ else }}_{{ end }}{{ end }} := subject.{{ $m.Name }}({{ template "suite.args" . }})
	{{ renderExpr (external $.Runtime "ErrorIs") }}(tb, err, {{ renderExpr .Sentinel }},
		"{{ $m.Name }} after {{ $p.Name }} must report the declared sentinel")
}
{{- end -}}
