{{- /*
The budget comes from the directive because "within a budget" is not a statement
until a duration is named. The elapsed time comes from the run's clock rather
than the wall clock: a check that read time.Now would have the machine it runs
on as part of its subject, and would fail a correct implementation on a loaded
box while passing a slow one on an idle box.
*/ -}}
{{- define "suite.check.timeout" -}}
{{ $m := .Method }}
{{ $budget := $m.MixinPartner "timeout" "duration" }}
// {{ .Func }} asserts the call completes within its declared budget.
//
// Fails when: {{ $m.Name }} consumes more than {{ $budget }} on the run's clock,
// which is the duration the source declares. A budget nobody measures is
// documentation, and the method carrying the mixin is the one somebody was
// worried about.
//
// Measured on clk rather than the wall clock. Build the subject with the same
// clock the run holds and this is a claim about the time the implementation
// means to spend — settled exactly, and unaffected by how loaded the machine is.
// The default clock is the real one, so an implementation that takes none is
// measured as it would have been.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, clk {{ renderType .ClockRef }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}
	{{- range $m.CallArgs }}, {{ .Name }} {{ renderType .Type }}{{ end }}) {
	tb.Helper()
{{- if $m.TakesContext }}
	ctx := tb.Context()
{{- end }}
	budget, err := {{ renderExpr (external "time" "ParseDuration") }}({{ printf "%q" $budget }})
	if err != nil {
		tb.Fatalf("the timeout mixin declares %q, which is not a duration: %v", {{ printf "%q" $budget }}, err)
	}
	start := clk.Now()
	{{ if $m.HasResults }}{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}_{{ end }} = {{ end }}subject.{{ $m.Name }}({{ template "suite.args" . }})
	if elapsed := clk.Now().Sub(start); elapsed > budget {
		tb.Errorf("{{ $m.Name }} took %s, over its declared budget of %s", elapsed, budget)
	}
}
{{- end -}}
