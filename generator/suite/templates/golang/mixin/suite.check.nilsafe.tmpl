{{- /*
The one check that refuses the fixture's values on purpose. Every derived
sample is well-formed by construction, so passing one would prove nothing about
what happens when a caller had nothing to pass.
*/ -}}
{{- define "suite.check.nilsafe" -}}
{{ $m := .Method }}
// {{ .Func }} asserts zero-value inputs do not panic.
//
// Fails when: {{ $m.Name }} panics rather than returning for a zero value in any
// parameter. A nil pointer, a nil map, a nil slice all reach production through
// a caller that had nothing to pass — refusing one is a failed request, and
// dereferencing it is an outage.
//
// It supplies its own zeros rather than taking the fixture's, which is the whole
// of the check: a derived value is well-formed by construction.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}) {
	tb.Helper()
	defer func() {
		if r := recover(); r != nil {
			tb.Errorf("{{ $m.Name }} panicked on a zero-value input (%v); return an error instead", r)
		}
	}()
{{- if $m.TakesContext }}
	ctx := tb.Context()
{{- end }}
{{- range $m.CallArgs }}
	var {{ .Name }} {{ renderType .Type }}
{{- end }}
	{{ if $m.HasResults }}{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}_{{ end }} = {{ end }}subject.{{ $m.Name }}({{ template "suite.args" . }})
}
{{- end -}}
