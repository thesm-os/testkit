{{- /*
A store with one namespace: it takes the partition and files everything
together. Two drafts of the partition check shipped-shaped before this existed,
and this is the subject both of them passed against — which is why it is the
guard worth having most.

Two methods overridden, sharing one captured slot. The stub answers each call
from a closure, so state across calls is a variable the closures close over
rather than something a stand-in cannot express.
*/ -}}
{{- define "suite.violate.partition" -}}
{{ $m := .Method }}
{{ $p := .Partner }}
// {{ .TestName }} holds {{ .Check.Func }} to being able to fail.
//
// The stand-in accepts the partition and ignores it, filing every write in one
// place. A check that let that pass would report isolation for a store that has
// none — which is what two earlier drafts of this check did.
func {{ .TestName }}(t *{{ renderExpr (external "testing" "T") }}) {
{{ template "suite.violate.open" . }}
	// One slot for every partition, which is the whole of the violation.
	var flat {{ renderType (index $p.ValueReturns 0).Type }}

	subject := {{ renderExpr (external .HarnessPkg .CtorName) }}{{ .TypeArgs }}(t,
		{{ renderExpr (external .HarnessPkg .Option) }}{{ .TypeArgs }}(func({{ template "suite.violate.namedparams" $m }}){{ template "suite.violate.results" $m }} {
			flat = {{ .Check.CompareAgainst }}
			return nil
		}),
		{{ renderExpr (external .HarnessPkg .PartnerOption) }}{{ .TypeArgs }}(func({{ template "suite.violate.params" $p }}){{ template "suite.violate.results" $p }} {
			return flat, nil
		}))

{{ template "suite.violate.drive" . }}
}
{{- end -}}
