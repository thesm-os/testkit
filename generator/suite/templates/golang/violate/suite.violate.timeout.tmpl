{{- /*
A method that spends more than the budget it declared.

The one violator that has to move time, and it can: the guard builds the
stand-in, so it holds the clock the check measures on and the closure advances
it. On a test clock the overrun is exact — the same reason the check itself
measures there rather than on the wall.
*/ -}}
{{- define "suite.violate.timeout" -}}
{{ $m := .Method }}
{{ $budget := $m.MixinPartner "timeout" "duration" }}
// {{ .TestName }} holds {{ .Check.Func }} to being able to fail.
//
// The stand-in spends twice its declared budget. A check that let that pass
// would leave the duration in the directive as documentation, which is the one
// thing the mixin exists to stop.
func {{ .TestName }}(t *{{ renderExpr (external "testing" "T") }}) {
{{ template "suite.violate.open" . }}
	budget, err := {{ renderExpr (external "time" "ParseDuration") }}({{ printf "%q" $budget }})
	if err != nil {
		t.Fatalf("the timeout mixin declares %q, which is not a duration: %v", {{ printf "%q" $budget }}, err)
	}

	// One clock, held here and handed to the check. A stand-in advancing a
	// clock the check does not read would overrun nothing.
	clk := {{ renderExpr (external (printf "%s/clock" .Runtime) "NewTestClock") }}({{ renderExpr (external "time" "Time") }}{})

	subject := {{ renderExpr (external .HarnessPkg .CtorName) }}{{ .TypeArgs }}(t,
		{{ renderExpr (external .HarnessPkg .Option) }}{{ .TypeArgs }}(func({{ template "suite.violate.params" $m }}){{ template "suite.violate.results" $m }} {
			clk.Advance(2 * budget)
{{- template "suite.violate.zeros" $m }}
		}))

	got := {{ renderExpr (external .Runtime "Rejects") }}(t, {{ printf "%q" .Reason }},
		func(tb {{ renderExpr (external "testing" "TB") }}) {
			tb.Helper()
			{{ renderExpr (external .HarnessPkg .Check.Func) }}{{ .TypeArgs }}(tb, clk, subject{{ range .Check.Args }}, fixture.{{ . }}{{ end }})
		})
	{{ renderExpr (external .Runtime "Assert") }}(t, got).Contains({{ printf "%q" .Because }},
		"and rejects it for the reason the check is about")
}
{{- end -}}
