{{- /*
A method that reports nothing for a deadline that expired before the call.
Separate from the cancellation violator because the two checks are separate: a
subject can consult ctx.Err and report only one of them, which is the defect
neither guard catches alone.
*/ -}}
{{- define "suite.violate.deadline" -}}
{{ $m := .Method }}
// {{ .TestName }} holds {{ .Check.Func }} to being able to fail.
//
// The stand-in answers an expired deadline as though nothing were wrong. A
// check that let that pass would report success for a subject that keeps
// working past the point its caller stopped waiting.
func {{ .TestName }}(t *{{ renderExpr (external "testing" "T") }}) {
{{ template "suite.violate.open" . }}
	subject := {{ renderExpr (external .HarnessPkg .CtorName) }}{{ template "suite.witnessargs" . }}(t,
		{{ renderExpr (external .HarnessPkg .Option) }}{{ template "suite.witnessargs" . }}(func({{ template "suite.violate.params" $m }}){{ template "suite.violate.results" $m }} {
{{- template "suite.violate.zeros" $m }}
		}))

{{ template "suite.violate.drive" . }}
}
{{- end -}}
