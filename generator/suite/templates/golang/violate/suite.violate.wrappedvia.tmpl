{{- /*
A stand-in whose failure carries a cause of its own rather than the one it
reports through the partner.
*/ -}}
{{- define "suite.violate.wrappedvia" -}}
{{ $m := .Method }}
{{ $p := .Partner }}
// {{ .TestName }} holds {{ .Check.Func }} to being able to fail.
//
// The stand-in fails with an error unrelated to the cause it reports. A check
// that let that pass would leave a caller's `errors.Is(err, target)` returning
// false against the documented cause, and the branch they wrote for it never
// running.
func {{ .TestName }}(t *{{ renderExpr (external "testing" "T") }}) {
{{ template "suite.violate.open" . }}
	// Two errors, because one would wrap by accident: what the check asks is
	// whether the failure carries *that* cause, and a stand-in returning the
	// same value both times would satisfy it without wrapping anything.
	cause := {{ renderExpr (external "errors" "New") }}("the cause the subject reports")
	unrelated := {{ renderExpr (external "errors" "New") }}("something else entirely")

	subject := {{ renderExpr (external .HarnessPkg .CtorName) }}{{ .TypeArgs }}(t,
		{{ renderExpr (external .HarnessPkg .Option) }}{{ .TypeArgs }}(func({{ template "suite.violate.params" $m }}){{ template "suite.violate.results" $m }} {
{{- range $m.ValueReturns }}
			var {{ .Local }} {{ renderType .Type }}
{{- end }}
			return {{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}unrelated{{ else }}{{ $r.Local }}{{ end }}{{ end }}
		}),
		{{ renderExpr (external .HarnessPkg .PartnerOption) }}{{ .TypeArgs }}(func({{ template "suite.violate.params" $p }}){{ template "suite.violate.results" $p }} {
			return cause
		}))

{{ template "suite.violate.drive" . }}
}
{{- end -}}
