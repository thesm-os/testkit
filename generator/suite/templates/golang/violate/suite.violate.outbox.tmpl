{{- /*
A stand-in that takes the record and hands back a stream nothing arrives on,
which is what a subject dropping what nobody was listening for looks like from
the outside.
*/ -}}
{{- define "suite.violate.outbox" -}}
{{ $m := .Method }}
{{ $p := .Partner }}
// {{ .TestName }} holds {{ .Check.Func }} to being able to fail.
//
// The stand-in accepts every record and delivers none. A check that let that
// pass would report durability for a subject that drops what nobody was
// waiting for — which is the one thing separating this contract from
// `publisher`, and which every other check in the harness is blind to.
func {{ .TestName }}(t *{{ renderExpr (external "testing" "T") }}) {
{{ template "suite.violate.open" . }}
	// Open and empty. Closing it would make the receive return at once, which
	// the check would read as a delivered zero rather than as nothing arriving.
	stream := make(chan {{ renderType .StreamElem }})

	subject := {{ renderExpr (external .HarnessPkg .CtorName) }}{{ template "suite.witnessargs" . }}(t,
		{{ renderExpr (external .HarnessPkg .Option) }}{{ template "suite.witnessargs" . }}(func({{ template "suite.violate.params" $m }}){{ template "suite.violate.results" $m }} {
{{- template "suite.violate.zeros" $m }}
		}),
		{{ renderExpr (external .HarnessPkg .PartnerOption) }}{{ template "suite.witnessargs" . }}(func({{ template "suite.violate.params" $p }}){{ template "suite.violate.results" $p }} {
			return stream, nil
		}))

{{ template "suite.violate.drive" . }}
}
{{- end -}}
