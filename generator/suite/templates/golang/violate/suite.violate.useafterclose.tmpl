{{- /*
An operation that answers after teardown as though nothing were closed — the
permissive stand-in, which is the whole violation here.
*/ -}}
{{- define "suite.violate.useafterclose" -}}
{{ $m := .Method }}
// {{ .TestName }} holds {{ .Check.Func }} to being able to fail.
//
// The stand-in answers the operation as though nothing were closed; the
// teardown itself stays a stub answering zeros, which is a clean close. A
// check that let the answer pass would read business-as-usual as closure
// discipline.
func {{ .TestName }}(t *{{ renderExpr (external "testing" "T") }}) {
{{ template "suite.violate.open" . }}
	subject := {{ renderExpr (external .HarnessPkg .CtorName) }}{{ template "suite.witnessargs" . }}(t,
		{{ renderExpr (external .HarnessPkg .Option) }}{{ template "suite.witnessargs" . }}(func({{ template "suite.violate.params" $m }}){{ template "suite.violate.results" $m }} {
{{- template "suite.violate.zeros" $m }}
		}))

{{ template "suite.violate.drive" . }}
}
{{- end -}}
