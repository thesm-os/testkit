{{- /*
A method answering a believable value beside its error — the disagreement
between the error-checking caller and the value-checking caller that the
check's zero comparison exists to rule out.
*/ -}}
{{- define "suite.violate.zeroonerror" -}}
{{ $m := .Method }}
// {{ .TestName }} holds {{ .Check.Func }} to being able to fail.
//
// The stand-in refuses the call and answers a value that looks like a result
// anyway. A check that let that pass would leave a caller who checks the error
// and a caller who checks the value disagreeing about what happened — the
// claim's own violation, not a stand-in that merely succeeds.
func {{ .TestName }}(t *{{ renderExpr (external "testing" "T") }}) {
{{ template "suite.violate.open" . }}
	subject := {{ renderExpr (external .HarnessPkg .CtorName) }}{{ template "suite.witnessargs" . }}(t,
		{{ renderExpr (external .HarnessPkg .Option) }}{{ template "suite.witnessargs" . }}(func({{ template "suite.violate.params" $m }}){{ template "suite.violate.results" $m }} {
{{- template "suite.violate.plausibleerr" . }}
		}))

{{ template "suite.violate.drive" . }}
}
{{- end -}}
