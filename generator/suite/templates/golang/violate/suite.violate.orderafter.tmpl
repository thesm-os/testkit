{{- /*
A stand-in that accepts the call without its prerequisite.
*/ -}}
{{- define "suite.violate.orderafter" -}}
// {{ .TestName }} holds {{ .Check.Func }} to being able to fail.
//
// The stand-in answers before the prerequisite has run. A check that let that
// pass would report an ordering constraint for a method that has none, and the
// caller who skipped a step would find out in production.
func {{ .TestName }}(t *{{ renderExpr (external "testing" "T") }}) {
{{- template "suite.violate.permissive" . }}
}
{{- end -}}
