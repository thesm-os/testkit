{{- /*
A method that panics on a nil context.

Nil is not a legal context and reaches production anyway, through a caller that
forgot one. Returning an error is a failed request; dereferencing it is an
outage — so the violation is the dereference.
*/ -}}
{{- define "suite.violate.nilcontext" -}}
{{ $m := .Method }}
// {{ .TestName }} holds {{ .Check.Func }} to being able to fail.
//
// The stand-in panics rather than reporting. A check that let that pass would
// leave a caller who forgot a context taking the process down instead of
// getting an error back.
func {{ .TestName }}(t *{{ renderExpr (external "testing" "T") }}) {
{{ template "suite.violate.open" . }}
	subject := {{ renderExpr (external .HarnessPkg .CtorName) }}{{ .TypeArgs }}(t,
		{{ renderExpr (external .HarnessPkg .Option) }}{{ .TypeArgs }}(func({{ template "suite.violate.params" $m }}){{ template "suite.violate.results" $m }} {
			panic("{{ .IfaceName }}.{{ $m.Name }}: violating the nil-context check")
		}))

{{ template "suite.violate.drive" . }}
}
{{- end -}}
