{{- /*
A reader answering with something believable beside a flag reporting a miss, which is the
subject the zero comparison exists to reject and the only one it can.
*/ -}}
{{- define "suite.violate.missflag" -}}
{{ $m := .Method }}
// {{ .TestName }} holds {{ .Check.Func }} to being able to fail.
//
// The stand-in answers beside a flag reporting a miss with a value that looks like a
// result. A check that let that pass would leave a caller unable to tell an
// answer from an absence, which is the whole of what this shape signals with.
func {{ .TestName }}(t *{{ renderExpr (external "testing" "T") }}) {
{{ template "suite.violate.open" . }}
	subject := {{ renderExpr (external .HarnessPkg .CtorName) }}{{ .TypeArgs }}(t,
		{{ renderExpr (external .HarnessPkg .Option) }}{{ .TypeArgs }}(func({{ template "suite.violate.params" $m }}){{ template "suite.violate.results" $m }} {
{{- template "suite.violate.plausible" . }}
		}))

{{ template "suite.violate.drive" . }}
}
{{- end -}}
