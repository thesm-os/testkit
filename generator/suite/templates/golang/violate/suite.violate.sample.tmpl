{{- /*
A stand-in that refuses what the builder produced.
*/ -}}
{{- define "suite.violate.sample" -}}
// {{ .TestName }} holds {{ .Check.Func }} to being able to fail.
//
// The stand-in refuses the value its own builder made. A check that let that\n// pass would report a working pair for a subject where nothing the builder\n// produces is usable — which is the only thing the mixin claims.
func {{ .TestName }}(t *{{ renderExpr (external "testing" "T") }}) {
{{- template "suite.violate.refuses" . }}
}
{{- end -}}
