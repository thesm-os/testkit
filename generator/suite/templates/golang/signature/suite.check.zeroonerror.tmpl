{{- define "suite.check.zeroonerror" -}}
{{ $m := .Method }}
// {{ .Func }} asserts an error is accompanied by the zero value.
//
// Fails when: {{ $m.Name }} returns a non-zero result alongside a non-nil
// error. A caller who checks the error and a caller who checks the value must
// not disagree about whether the call succeeded.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}
	{{- range $m.CallArgs }}, {{ .Name }} {{ renderType .Type }}{{ end }}) {
	tb.Helper()
{{- if $m.TakesContext }}
	ctx := tb.Context()
{{- end }}
	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ $r.Local }}{{ end }} := subject.{{ $m.Name }}({{ template "suite.args" . }})
	if {{ ($m.ErrReturn).Local }} == nil {
		tb.Fatalf("{{ $m.Name }} succeeded; supply inputs it misses through "+
			"{{ .IfaceName }}WithFixture")
	}
{{- range $m.ValueReturns }}
	{
		var zero {{ renderType .Type }}
		{{ renderExpr (external $.Runtime "Equal") }}(tb, {{ .Local }}, zero,
			"{{ $m.Name }} must return the zero value alongside an error")
	}
{{- end }}
}
{{- end -}}
