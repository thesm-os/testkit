{{- define "suite.check.smoke" -}}
{{ $m := .Method }}
// {{ .Func }} asserts {{ $m.Name }} survives a call with derived inputs.
//
// Fails when: {{ $m.Name }} panics. The weakest check in this file and the one
// that catches the most — a method that panics on a derived value is one no
// other check here reaches.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}
	{{- range $m.CallArgs }}, {{ .Name }} {{ renderType .Type }}{{ end }}) {
	tb.Helper()
	defer func() {
		if r := recover(); r != nil {
			tb.Fatalf("{{ $m.Name }} panicked on a derived value (%v); supply one it "+
				"accepts through {{ .IfaceName }}WithFixture", r)
		}
	}()
{{- if $m.TakesContext }}
	ctx := tb.Context()
{{- end }}
	{{ template "suite.call" . }}
}
{{- end -}}
