{{- /*
The option API has three jobs and no more: supply what derivation could not
reach, add a check no classification implies, and drop one that is wrong for a
subject. A consumer cannot reach the generator, so this is the whole ceiling on
extensibility.
*/ -}}
{{- define "suite.options" -}}
{{ $c := . }}
// {{ .IfaceName }}Option configures a contract run.
type {{ .IfaceName }}Option{{ renderTypeParams .TypeParams }} func(*{{ lower .IfaceName }}Config{{ .TypeArgs }})

// {{ .IfaceName }}Subject declares an implementation to hold to the contract.
//
// Repeat it for every implementation that claims to satisfy the interface — an
// in-memory one, the one backed by a database, the one behind a network. Every
// check and every option is stated once and runs against all of them, which is
// what a conformance suite is for.
func {{ .IfaceName }}Subject{{ renderTypeParams .TypeParams }}(name string, factory func() {{ renderType .IfaceRef }}{{ .TypeArgs }}) {{ .IfaceName }}Option{{ .TypeArgs }} {
	return func(c *{{ lower .IfaceName }}Config{{ .TypeArgs }}) {
		c.subjects = append(c.subjects, named{{ .IfaceName }}Subject{{ .TypeArgs }}{name, factory})
	}
}
{{ if .Double }}
// {{ .IfaceName }}WithoutDouble declines the second run through {{ .Double.TypeName }}.
//
// The double run proves the stand-in is faithful, and costs a second pass over
// every check. Decline it where the double is not used.
func {{ .IfaceName }}WithoutDouble{{ renderTypeParams .TypeParams }}() {{ .IfaceName }}Option{{ .TypeArgs }} {
	return func(c *{{ lower .IfaceName }}Config{{ .TypeArgs }}) { c.withoutDouble = true }
}
{{ end }}
// {{ .IfaceName }}WithClock supplies the clock every time-reading check measures on.
//
// Defaults to the real one, so an implementation that does not take a clock
// behaves as it would have. Supply a [clock.TestClock] — the same one the
// factory builds the subject with — and a budget becomes a claim about the time
// the implementation means to spend rather than about how loaded the machine
// was.
func {{ .IfaceName }}WithClock{{ renderTypeParams .TypeParams }}(c {{ renderType .ClockRef }}) {{ .IfaceName }}Option{{ .TypeArgs }} {
	return func(cfg *{{ lower .IfaceName }}Config{{ .TypeArgs }}) { cfg.clock = c }
}

// {{ .IfaceName }}WithFixture replaces the derived inputs.
func {{ .IfaceName }}WithFixture{{ renderTypeParams .TypeParams }}(f {{ .Fixture.TypeName }}{{ .TypeArgs }}) {{ .IfaceName }}Option{{ .TypeArgs }} {
	return func(c *{{ lower .IfaceName }}Config{{ .TypeArgs }}) { c.Fixture = f }
}

// {{ .IfaceName }}Seed replaces the derived seed.
//
// For an interface with no writer to seed itself through, which is the one
// input a conformance run cannot derive: a reader over an empty subject
// asserts nothing.
//
// Returning an error rather than swallowing one. A seed that failed quietly
// leaves every check after it asserting nothing and reporting success.
func {{ .IfaceName }}Seed{{ renderTypeParams .TypeParams }}(fn func(ctx {{ renderExpr (external "context" "Context") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}) error) {{ .IfaceName }}Option{{ .TypeArgs }} {
	return func(c *{{ lower .IfaceName }}Config{{ .TypeArgs }}) {
		c.seed = fn
{{- if .Seed }}
		c.seedIsDerived = false
{{- end }}
	}
}
{{ range $m := .Methods }}
// {{ $c.IfaceName }}On{{ $m.Name }} adds a named check to {{ $m.Name }}.
func {{ $c.IfaceName }}On{{ $m.Name }}{{ renderTypeParams $c.TypeParams }}(name string, fn {{ $m.CheckType }}{{ $c.TypeArgs }}) {{ $c.IfaceName }}Option{{ $c.TypeArgs }} {
	return func(c *{{ lower $c.IfaceName }}Config{{ $c.TypeArgs }}) {
		c.on{{ $m.Name }} = append(c.on{{ $m.Name }}, named{{ $c.IfaceName }}{{ $m.Name }}Check{{ $c.TypeArgs }}{name, fn})
	}
}
{{ end }}
// {{ .IfaceName }}Without drops generated checks by the path each reports under.
//
// For a subject that legitimately violates one. Without this the only recourse
// is to stop running the suite, which costs every other check in the file — so
// a dropped check is reported as skipped rather than silently omitted.
func {{ .IfaceName }}Without{{ renderTypeParams .TypeParams }}(paths ...string) {{ .IfaceName }}Option{{ .TypeArgs }} {
	return func(c *{{ lower .IfaceName }}Config{{ .TypeArgs }}) {
		for _, p := range paths {
			c.without[p] = struct{}{}
		}
	}
}
{{ range $m := .Methods }}
type named{{ $c.IfaceName }}{{ $m.Name }}Check{{ renderTypeParams $c.TypeParams }} struct {
	name string
	fn   {{ $m.CheckType }}{{ $c.TypeArgs }}
}
{{ end }}
type named{{ .IfaceName }}Subject{{ renderTypeParams .TypeParams }} struct {
	name    string
	factory func() {{ renderType .IfaceRef }}{{ .TypeArgs }}
}

type {{ lower .IfaceName }}Config{{ renderTypeParams .TypeParams }} struct {
	Fixture  {{ .Fixture.TypeName }}{{ .TypeArgs }}
	subjects []named{{ .IfaceName }}Subject{{ .TypeArgs }}
{{- if .Double }}
	withoutDouble bool
{{- end }}
	clock {{ renderType .ClockRef }}
	seed  func(ctx {{ renderExpr (external "context" "Context") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}) error
{{- if .Seed }}
	// seedIsDerived is what lets a failed seed name the right culprit. The
	// derived seed and a consumer's are the same field, and the advice for one
	// is useless for the other.
	seedIsDerived bool
{{- end }}
	without map[string]struct{}
{{- range $m := .Methods }}
	on{{ $m.Name }} []named{{ $c.IfaceName }}{{ $m.Name }}Check{{ $c.TypeArgs }}
{{- end }}
}

func new{{ .IfaceName }}Config{{ renderTypeParams .TypeParams }}(opts ...{{ .IfaceName }}Option{{ .TypeArgs }}) *{{ lower .IfaceName }}Config{{ .TypeArgs }} {
	c := &{{ lower .IfaceName }}Config{{ .TypeArgs }}{
		Fixture: {{ .Fixture.CtorName }}{{ .TypeArgs }}(),
		clock:   {{ renderExpr (external (printf "%s/clock" .Runtime) "RealClock") }}(),
		without: map[string]struct{}{},
	}
{{- if .Seed }}
	// Derived: {{ .Seed.Method.Name }} is classified writer, so the interface
	// populates itself and a reader has something to read.
	c.seed = func(ctx {{ renderExpr (external "context" "Context") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}) error {
		return subject.{{ .Seed.Method.Name }}(ctx{{ range .Seed.Args }}, c.Fixture.{{ . }}{{ end }})
	}
	c.seedIsDerived = true
{{- end }}
	for _, o := range opts {
		o(c)
	}
	return c
}

// subject builds a fresh implementation and seeds it, so every check runs
// against state no other check touched.
func (c *{{ lower .IfaceName }}Config{{ .TypeArgs }}) subject(
	tb {{ renderExpr (external "testing" "TB") }},
	factory func() {{ renderType .IfaceRef }}{{ .TypeArgs }},
	wrap func(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}) {{ renderType .IfaceRef }}{{ .TypeArgs }},
) {{ renderType .IfaceRef }}{{ .TypeArgs }} {
	tb.Helper()
	s := factory()
	if c.seed != nil {
		// Reported rather than ignored. A seed that silently failed would leave
		// every check after it running against an empty subject — passing, and
		// asserting nothing.
		//
		// Which seed ran decides what the message can usefully say. The derived
		// one fails for one of two reasons and both are fixable from here, so it
		// names them. A seed the caller supplied is theirs, and telling them to
		// supply one is advice they already took.
		if err := c.seed(tb.Context(), s); err != nil {
{{- if .Seed }}
			if c.seedIsDerived {
				tb.Fatalf("seeding through {{ .Seed.Method.Name }} failed: %v; "+
					"supply a value it accepts through {{ .IfaceName }}WithFixture, or a "+
					"whole seed through {{ .IfaceName }}Seed", err)
			} else {
				tb.Fatalf("the seed supplied through {{ .IfaceName }}Seed failed: %v", err)
			}
{{- else }}
			tb.Fatalf("the seed supplied through {{ .IfaceName }}Seed failed: %v", err)
{{- end }}
		}
	}
	if wrap != nil {
		s = wrap(tb, s)
	}
	return s
}

// run executes one check unless it was dropped, reporting the drop rather than
// silently omitting it.
func (c *{{ lower .IfaceName }}Config{{ .TypeArgs }}) run(t *{{ renderExpr (external "testing" "T") }}, path, name string, fn func(tb {{ renderExpr (external "testing" "TB") }})) {
	t.Helper()
	if _, dropped := c.without[path]; dropped {
		t.Run(name, func(t *{{ renderExpr (external "testing" "T") }}) {
			t.Skipf("dropped through {{ .IfaceName }}Without(%q)", path)
		})
		return
	}
	t.Run(name, func(t *{{ renderExpr (external "testing" "T") }}) {
		t.Parallel()
		fn(t)
	})
}
{{- end -}}
