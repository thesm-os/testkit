{{- define "suite.contract" -}}
{{ $c := . }}
// The generated conformance surface for {{ .IfaceName }}.
//
// A file-level comment rather than a package doc: three generators write
// into this package and a package doc has one owner, so the listing
// lives with the witness it describes.
//
// Entry points:
//
//	{{ suite_runName .IfaceName }}(t, opts...)      {{ suite_proveName .IfaceName }}(t, checks)
//
// A harness is a config literal ({{ suite_harnessName .IfaceName }}); your own checks are a
// table ({{ suite_rowsName .IfaceName }}); drops are written against the typed index:
//
//	{{ suite_veneerVar .IfaceName }}.Checks.<Method>.<Check>()
//
// Every ID this package emits:
//
{{- range $id := .EmittedIDs }}
//	{{ $id }}
{{- end }}
{{- if .Withheld }}
//
// Derived and not yet spelled, so no ID is emitted for it:
//
{{- range $w := .Withheld }}
//	{{ $w }}
{{- end }}
{{- end }}
{{- if .Gaps }}
//
// Reached by a rule and not derivable here. Each is a claim this file
// does NOT make, so a reader counting coverage from the list above
// knows what is missing and what would bring it back:
//
{{- range $g := .Gaps }}
//	{{ $g }}
{{- end }}
{{- end }}
//
// The compatibility handshake. A breaking change to the check surface
// renames the witness, and every file generated against this one stops
// compiling with the skew named rather than dispatching wrong.
var _ = {{ renderExpr (external $.Vocab "CompatV2") }}

// {{ $.Fixture.TypeName }} holds every input the generated checks run against.
//
// Derived from each method's parameter names and types. Every field has a
// companion holding a second, different value: a check comparing a result
// against a single input passes whenever the subject happened to be seeded with
// it, and a miss check whose key happens to hit asserts nothing.
//
// A field whose type admits no literal — a func, a channel, a type from a
// package this run never read — is declared and left at its zero value, and
// every generated check that needed it was dropped rather than emitted against
// a value nobody could write. Those drops are listed above with what closes
// each; a row you write is handed this fixture either way.
type {{ $.Fixture.TypeName }}{{ renderTypeParams $.TypeParams }} struct {
{{- range $f := $.Fixture.Fields }}
	{{ camel $f.Name }} {{ renderType $f.Type }}
	{{ camel $f.OtherName }} {{ renderType $f.Type }}
{{- end }}
}

// {{ $.Fixture.CtorName }} is what a run with no config draws.
func {{ $.Fixture.CtorName }}{{ renderTypeParams $.TypeParams }}() {{ $.Fixture.TypeName }}{{ $.TypeArgs }} {
	return {{ suite_newFixtureName $.Token }}{{ $.TypeArgs }}({{ if $.Pools }}{{ suite_configName $.IfaceName }}{{ $.TypeArgs }}{}{{ end }})
}

// {{ suite_newFixtureName $.Token }} is what a run draws from, given its config.
//
// Read through the accessors below rather than as fields: a roled value
// comes from the config's pool and an unroled one from its derived
// literal, and no check that draws should be able to tell which.
func {{ suite_newFixtureName $.Token }}{{ renderTypeParams $.TypeParams }}(
	{{- if $.Pools }}cfg {{ suite_configName $.IfaceName }}{{ $.TypeArgs }}{{ end -}}
) {{ $.Fixture.TypeName }}{{ $.TypeArgs }} {
{{- if $.Pools }}
	cfg = cfg.orDefault()
{{- end }}
	return {{ $.Fixture.TypeName }}{{ $.TypeArgs }}{
{{- range $.Fixture.Fields }}
{{- if .OK }}
		{{ camel .Name }}: {{ if .Pool }}cfg.{{ .Pool }}[0]{{ else if .Companion }}{{ renderExpr .Companion }}(){{ else }}{{ template "suite.value" (.Choose false) }}{{ end }},
{{- if or .Composed .Other.OK .Pool }}
		{{ camel .OtherName }}: {{ if .Pool }}cfg.{{ .Pool }}[1]{{ else }}{{ template "suite.value" (.Choose true) }}{{ end }},
{{- end }}
{{- end }}
{{- end }}
	}
}
{{ range $f := $.Fixture.Fields }}
// {{ $f.Name }} is the canonical {{ camel $f.Name }} every check draws.
{{- if $f.Variadic }}
//
// One element of a variadic parameter, not the list. Every generated
// check passes it alone; what a method does with several is a claim only
// a check written by hand can make.
{{- end }}
func (f {{ $.Fixture.TypeName }}{{ $.TypeArgs }}) {{ $f.Name }}() {{ renderType $f.Type }} { return f.{{ camel $f.Name }} }

// {{ $f.OtherName }} is a second {{ camel $f.Name }}, different from the first — which is
// what lets a miss check miss and a comparison mean something.
func (f {{ $.Fixture.TypeName }}{{ $.TypeArgs }}) {{ $f.OtherName }}() {{ renderType $f.Type }} { return f.{{ camel $f.OtherName }} }
{{ end }}

{{- if .Pools }}
{{ template "suite.config" $c }}
{{- end }}

{{ template "suite.harness" $c }}

{{ template "suite.index" $c }}

{{ template "suite.checks" $c }}

{{ template "suite.rows" $c }}

{{ template "suite.run" $c }}
{{- end -}}

{{- /*
suite.value spells one derived value, whole or composed from its fields. A
struct is composed rather than carried as text because a field whose own type is
a struct needs its type spelled beside its braces, and only the backend knows
how to spell it for this file and register the import it needs.
*/ -}}
{{- define "suite.value" -}}
{{- if .Parts }}{{ renderType .Type }}{
{{- range $i, $p := .Parts }}{{ if $i }}, {{ end }}{{ $p.Name }}: {{ if $p.Pool }}cfg.{{ $p.Pool }}[{{ $.Alternate }}]{{ else }}{{ renderSample $p.Value }}{{ end }}{{ end -}} }
{{- else }}{{ renderSample .Value }}{{ end }}
{{- end -}}

