{{- /*
The companion output: every generated check driven against a stand-in that
violates it.

A check that cannot fail is worse than none, and no gate reports one — a vacuous
check passes. This is the gate. It lives in a _test.go file because a Test
function outside one never runs, and because the suffix earns Layout's
external-test-package shift, so each guard reaches the harness across a package
boundary the way a consumer does.
*/ -}}
{{- define "suite.falsification" -}}
{{ $f := . }}
// Every generated check for {{ .IfaceName }}, driven against a stand-in built
// to violate it.
//
//	Proved:   {{ len .Cases }} check{{ if ne (len .Cases) 1 }}s{{ end }}
{{- if .Unproven }}
//	Unproved: {{ len .Unproven }}, named below with what each would take
{{- end }}
//
// Each guard asserts the *reason* the check rejected, not merely that it did. A
// stand-in that failed for some unrelated reason — a nil map, a closed channel
// — would satisfy a guard reading only the fact, which is the vacuity this file
// exists to catch, one level up.
{{ range $v := .Cases }}
{{ render $v }}
{{ end }}
{{- if .Unproven }}
// Checks with no proof here yet, and what one would take.
//
// Nothing below is unbreakable — a stand-in answers each call from a closure,
// so it can carry whatever state a violation needs. Each line names the piece
// that is missing.
//
{{- range .Unproven }}
//   - {{ .Func }}: {{ .Reason }}
{{- end }}
{{- end }}
{{- end -}}

{{- /*
suite.violate.stub builds the stand-in with one method overridden. Every guard
opens the same way, and the only thing that differs is the body — which is what
each violator template supplies.
*/ -}}
{{- define "suite.violate.open" -}}
	t.Parallel()
{{ if .NeedsFixture }}
	fixture := {{ renderExpr (external .HarnessPkg .FixtureCtor) }}{{ template "suite.witnessargs" . }}()
{{- end }}
{{- end -}}

{{- /*
suite.violate.params spells the overriding function's parameter list: types
without names, which is all a func literal handed to the option needs.

The ellipsis is spelled here rather than left to the type, because the
projection keeps a variadic parameter's Type as the *element* type — right for
the signature the method declares, and wrong for the func the stub option takes,
which is `func(context.Context, ...string)` and refuses anything narrower.
*/ -}}
{{- /*
suite.violate.namedparams is the same list with the source's own identifiers, for
a violator whose body reads one of them.

Named only where they are read: a stand-in that ignores everything takes types
alone, and inventing identifiers for parameters no body mentions would put names
in generated source that answer to nothing.
*/ -}}
{{- define "suite.violate.namedparams" -}}
{{- range $i, $p := .Params }}{{ if $i }}, {{ end }}{{ $p.Name }} {{ if $p.Variadic }}...{{ end }}{{ renderType $p.Type }}{{ end }}
{{- end -}}

{{- define "suite.violate.params" -}}
{{- range $i, $p := .Params }}{{ if $i }}, {{ end }}{{ if $p.Variadic }}...{{ end }}{{ renderType $p.Type }}{{ end }}
{{- end -}}

{{- /*
suite.violate.results spells the overriding function's result list, parenthesised
only where Go requires it.
*/ -}}
{{- define "suite.violate.results" -}}
{{- if gt (len .Returns) 1 }} ({{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}{{ renderType $r.Type }}{{ end }})
{{- else if eq (len .Returns) 1 }} {{ renderType (index .Returns 0).Type }}{{ end }}
{{- end -}}

{{- /*
suite.violate.zeros declares a zero for every value return and hands back nil for
the error.

`var r0 T` rather than a literal, because a zero has one spelling for every type
and a literal has one per kind — and the projection carries no derived value for
a result slot.
*/ -}}
{{- define "suite.violate.zeros" -}}
{{- range .ValueReturns }}
			var {{ .Local }} {{ renderType .Type }}
{{- end }}
			return {{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}nil{{ else }}{{ $r.Local }}{{ end }}{{ end }}
{{- end -}}

{{- /*
suite.violate.permissive is the guard for a check whose violation is simply not
refusing: the stand-in answers every call as though nothing were wrong.

Shared because four checks are violated the same way and differ only in what
they were asserting, which is what each caller's own doc comment says.
*/ -}}
{{- define "suite.violate.permissive" -}}
{{ template "suite.violate.open" . }}
	subject := {{ renderExpr (external .HarnessPkg .CtorName) }}{{ template "suite.witnessargs" . }}(t,
		{{ renderExpr (external .HarnessPkg .Option) }}{{ template "suite.witnessargs" . }}(func({{ template "suite.violate.params" .Method }}){{ template "suite.violate.results" .Method }} {
{{- template "suite.violate.zeros" .Method }}
		}){{ if .PartnerOption }},
		{{ renderExpr (external .HarnessPkg .PartnerOption) }}{{ template "suite.witnessargs" . }}(func({{ template "suite.violate.params" .Partner }}){{ template "suite.violate.results" .Partner }} {
{{- template "suite.violate.zeros" .Partner }}
		}){{ end }})

{{ template "suite.violate.drive" . }}
{{- end -}}

{{- /*
suite.violate.refuses is the guard for a check whose violation is refusing: the
stand-in reports a failure where the check requires success.

The error is built inline rather than taken from a sentinel, because what it is
does not matter — only that the call did not succeed. A named one would invite a
reader to look for where it is handled.
*/ -}}
{{- define "suite.violate.refuses" -}}
{{ template "suite.violate.open" . }}
	subject := {{ renderExpr (external .HarnessPkg .CtorName) }}{{ template "suite.witnessargs" . }}(t,
		{{ renderExpr (external .HarnessPkg .Option) }}{{ template "suite.witnessargs" . }}(func({{ template "suite.violate.params" .Method }}){{ template "suite.violate.results" .Method }} {
{{- range .Method.ValueReturns }}
			var {{ .Local }} {{ renderType .Type }}
{{- end }}
			return {{ range $i, $r := .Method.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}{{ renderExpr (external "errors" "New") }}("violating {{ $.Check.Subtest }}"){{ else }}{{ $r.Local }}{{ end }}{{ end }}
		}){{ if .PartnerOption }},
		{{ renderExpr (external .HarnessPkg .PartnerOption) }}{{ template "suite.witnessargs" . }}(func({{ template "suite.violate.params" .Partner }}){{ template "suite.violate.results" .Partner }} {
{{- template "suite.violate.zeros" .Partner }}
		}){{ end }})

{{ template "suite.violate.drive" . }}
{{- end -}}

{{- /*
suite.violate.plausible spells the return list with a believable value in every
slot the check holds to its zero, the zero in the rest, and nil for the error.

The flag, where there is one, stays false: the check excludes it from the
comparison, so inverting it would change what the call reports rather than what
the check is about.
*/ -}}
{{- define "suite.violate.plausible" -}}
{{- $v := .Plausible -}}
{{- $miss := len (.Method.MissReturns) -}}
{{- range $i, $r := .Method.Returns }}
{{- if and (not $r.Error) (ge $i $miss) }}
			var {{ $r.Local }} {{ renderType $r.Type }}
{{- end }}
{{- end }}
			return {{ range $i, $r := .Method.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}nil{{ else if lt $i $miss }}{{ template "suite.value" (index $v $i) }}{{ else }}{{ $r.Local }}{{ end }}{{ end }}
{{- end -}}

{{- /*
suite.violate.drive runs the check under proof through Rejects and holds the
rejection to the phrase the check itself reports.
*/ -}}
{{- /*
suite.violate.plausibleerr answers a believable value in every slot the check
holds to its zero, beside a non-nil error — the zero-on-error violation.
*/ -}}
{{- define "suite.violate.plausibleerr" -}}
{{- $v := .Plausible -}}
{{- $miss := len (.Method.MissReturns) -}}
{{- range $i, $r := .Method.Returns }}
{{- if and (not $r.Error) (ge $i $miss) }}
			var {{ $r.Local }} {{ renderType $r.Type }}
{{- end }}
{{- end }}
			return {{ range $i, $r := .Method.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}{{ renderExpr (external "errors" "New") }}("violate: refused with a believable value"){{ else if lt $i $miss }}{{ template "suite.value" (index $v $i) }}{{ else }}{{ $r.Local }}{{ end }}{{ end }}
{{- end -}}

{{- define "suite.violate.drive" -}}
	got := {{ renderExpr (external .Runtime "Rejects") }}(t, {{ printf "%q" .Reason }},
		func(tb {{ renderExpr (external "testing" "TB") }}) {
			tb.Helper()
			{{ renderExpr (external .HarnessPkg .Check.Func) }}{{ template "suite.witnessargs" . }}(tb, {{ if .Check.NeedsClock }}{{ renderExpr (external (printf "%s/clock" .Runtime) "RealClock") }}(), {{ end }}subject{{ range .Check.Args }}, fixture.{{ . }}{{ end }}{{ range .Check.Extra }}, fixture.{{ .Field }}{{ end }})
		})
	{{ renderExpr (external .Runtime "Assert") }}(t, got).Contains({{ printf "%q" .Because }},
		"and rejects it for the reason the check is about")
{{- end -}}

{{- /*
suite.witnessargs instantiates a generic harness symbol at the witnesses —
`[int, genericbound.Score]` — and renders nothing for a non-generic
interface, so every call site is unconditional. A generic interface without
witnesses never reaches these templates: unfalsifiableReason declines it.
*/ -}}
{{- define "suite.witnessargs" -}}
{{- if .Witnesses }}[{{ range $i, $w := .Witnesses }}{{ if $i }}, {{ end }}{{ renderType $w }}{{ end }}]{{ end -}}
{{- end -}}
