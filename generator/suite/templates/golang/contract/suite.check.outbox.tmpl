{{- /*
The append happens before the subscribe, which is the whole point: `publisher`
carries the same two methods and may drop what nobody was listening for, and an
outbox is the contract that says it holds the record until somebody is.

The wait is a liveness guard rather than a budget — the contract says the record
is delivered, not how quickly — and it runs on the run's clock so a subject
built with a [clock.TestClock] is measured against the same one. Without it a
subject that never delivers hangs until the test binary's own timeout, which
reports as a panic in whatever test happened to be running.
*/ -}}
{{- define "suite.check.outbox" -}}
{{ $m := .Method }}
{{ $p := .Partner }}
{{ $record := (index $m.CallArgs 0).Name }}
// {{ .Func }} asserts a record appended before anyone subscribed is still
// delivered.
//
// Fails when: {{ $p.Name }} does not hand back what {{ $m.Name }} already
// accepted. Every other check in this file passes against a subject that takes
// a record and drops it, because nothing else looks at the stream.
//
// Two records rather than one. The harness seeds each fresh subject through
// {{ $m.Name }}, so a subject that accepted this check's own record and dropped
// it would still deliver the seed's and pass. Both are written here, so the
// claim holds for a consumer whose seed appends nothing too.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, clk {{ renderType .ClockRef }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}
	{{- range $m.CallArgs }}, {{ .Name }} {{ renderType .Type }}{{ end }}) {
	tb.Helper()
	ctx := tb.Context()

	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}err{{ else }}_{{ end }}{{ end }} := subject.{{ $m.Name }}({{ template "suite.args" . }})
	{{ renderExpr (external $.Runtime "NoError") }}(tb, err,
		"a record must be accepted before it can be delivered")

	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}err{{ else }}_{{ end }}{{ end }} = subject.{{ $m.Name }}({{ template "suite.args" . }})
	{{ renderExpr (external $.Runtime "NoError") }}(tb, err,
		"and so must a second, so the seed's own record cannot answer for both")

	{{ range $i, $r := $p.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}streamErr{{ else }}stream{{ end }}{{ end }} := subject.{{ $p.Name }}({{ template "suite.partnerargs" $ }})
	{{ renderExpr (external $.Runtime "NoError") }}(tb, streamErr,
		"a subscriber must be able to attach after the records were appended")

	for i := 1; i <= 2; i++ {
		select {
		case got, open := <-stream:
			{{ renderExpr (external $.Runtime "True") }}(tb, open,
				"the stream must stay open until every appended record is delivered")
			{{ renderExpr (external $.Runtime "Equal") }}(tb, got, {{ $record }},
				"the subscriber must receive what was appended")
		case <-clk.After(2 * {{ renderExpr (external "time" "Second") }}):
			tb.Fatalf("record %d of 2 that {{ $m.Name }} appended never arrived at {{ $p.Name }}; "+
				"an outbox holds a record until it is delivered", i)
		}
	}
}
{{- end -}}
