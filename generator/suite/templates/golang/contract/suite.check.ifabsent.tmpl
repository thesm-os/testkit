{{- /*
The first check whose two calls are the same call. Everything else that writes
twice varies something between the writes; here the point is that nothing does,
and the second attempt has to be told no.
*/ -}}
{{- define "suite.check.ifabsent" -}}
{{ $m := .Method }}
// {{ .Func }} asserts a second write for one key is refused.
//
// Fails when: {{ $m.Name }} accepts the same value twice. That is the whole of
// the contract — an if-absent write is the difference between "create" and
// "save", and a subject that overwrites silently satisfies every other check in
// this file while losing whatever the first caller wrote.
//
// The alternate value rather than the sample. The harness seeds each fresh
// subject through {{ $m.Name }} itself, so handed the seeded value the first
// call here would already be the second — and a correct implementation would
// fail on the line that expects it to succeed.
{{- if not .Sentinel }}
//
// Degraded to presence only: the contract stamps no conflict= sentinel, so
// this asserts that the second write was refused and not which refusal it
// was. Any unrelated failure — a full disk, a closed handle — passes a check
// whose point is identity. Name the sentinel to restore it.
{{- end }}
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}
	{{- range $m.CallArgs }}, {{ .Name }} {{ renderType .Type }}{{ end }}) {
	tb.Helper()
{{- if $m.TakesContext }}
	ctx := tb.Context()
{{- end }}
	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}err{{ else }}_{{ end }}{{ end }} := subject.{{ $m.Name }}({{ template "suite.args" . }})
	{{ renderExpr (external $.Runtime "NoError") }}(tb, err,
		"the first write of a value nothing holds must land")

	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ if $r.Error }}err{{ else }}_{{ end }}{{ end }} = subject.{{ $m.Name }}({{ template "suite.args" . }})
	{{ renderExpr (external $.Runtime "Error") }}(tb, err,
		"a second write for a key already present must be refused{{ if not .Sentinel }} "+
			"(any error passes: no conflict= sentinel is stamped to check identity against){{ end }}")
{{- if .Sentinel }}
	{{ renderExpr (external $.Runtime "ErrorIs") }}(tb, err, {{ renderExpr .Sentinel }},
		"and the refusal reports the declared conflict sentinel")
{{- end }}
}
{{- end -}}
