{{/*
The seeded probes: what a run put in, read back out.

Both need the corpus the harness was populated with, which is why they
take it rather than drawing from the fixture — the fixture holds one of
each role and these judge the whole set. A hit check against one key
would pass for a subject that answers the first thing it was given and
loses the rest.
*/}}
{{- define "suite.body.hit-probe" -}}
{{ if .NeedsCtx }}ctx := tb.Context()
{{ end }}
for k, want := range {{ suite_docsIdent }} {
	{{ .ValueBind }} {{ suite_callExpr .Recv .Body.Call }}
{{- if .HasErr }}
	if err != nil {
		tb.Fatalf("{{ .Method }}(%v) was seeded and must answer: %v", k, err)
	}
{{- end }}
	if got != want {
		tb.Errorf("{{ .Method }}(%v) = %+v, want the seeded %+v", k, got, want)
	}
}
{{- end -}}

{{- /*
The count: an aggregate against the size of what was seeded.

A number the run knows exactly, which is what makes this checkable at
all — an aggregate over a subject nobody seeded has no expected value,
and asserting it is non-negative asserts nothing.
*/ -}}
{{- define "suite.body.count-probe" -}}
{{ if .NeedsCtx }}ctx := tb.Context()
{{ end }}
{{ .ValueBind }} {{ suite_callExpr .Recv .Body.Call }}
{{- if .HasErr }}
if err != nil {
	tb.Fatalf("{{ .Method }} must answer on a seeded subject: %v", err)
}
{{- end }}
if got != len({{ suite_docsIdent }}) {
	tb.Errorf("{{ .Method }} = %d, want the %d entries the run seeded", got, len({{ suite_docsIdent }}))
}
{{- end -}}

{{- /*
The answering write: it happened, and it answered something.

Fatal on the error rather than reporting "answered the zero" — a write
that did not happen says nothing about what it would have answered, and
reporting the second for the first sends a reader to the wrong fault.

The first slot alone. A write answering its stored state answers ONE
thing; a second result beside it is metadata this shape makes no claim
about.
*/ -}}
{{- define "suite.body.non-zero-answer" -}}
{{ if .NeedsCtx }}ctx := tb.Context()
{{ end }}
{{ .ValueBind }} {{ suite_callExpr .Recv .Body.Call }}
{{- if .HasErr }}
if err != nil {
	tb.Fatalf("{{ .Method }} must succeed before its answer can be judged: %v", err)
}
{{- end }}
{{- with index .Zeros 0 }}
{{- if .Nil }}
if {{ .Bind }} == nil {
	tb.Errorf("{{ $.Method }} must {{ $.Body.Must }}, and answered nothing")
}
{{- else }}
var {{ .Zero }} {{ if .Type }}{{ renderExpr .Type }}{{ else }}{{ .Word }}{{ end }}
if {{ .Bind }} == {{ .Zero }} {
	tb.Errorf("{{ $.Method }} must {{ $.Body.Must }}: got the zero %+v", {{ .Bind }})
}
{{- end }}
{{- end }}
{{- end -}}
