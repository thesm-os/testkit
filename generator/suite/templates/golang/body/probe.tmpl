{{/*
The deterministic mixin probes: claims a fixed call sequence settles,
with no reference and no property engine.

Each judges one thing and says which call failed it. Where a probe needs
a call to have succeeded before its claim means anything, that call
fails the check outright — a repeat judged after a first call that
errored would report "not idempotent" for a subject that is simply
broken, which is a different fault with a different fix.
*/}}
{{- define "suite.body.repeat-probe" -}}
{{ if .NeedsCtx }}ctx := tb.Context()
{{ end }}
if {{ .ErrStmt }} {{ suite_callExpr .Recv .Body.Call }}; err != nil {
	tb.Fatalf("{{ .Method }} must succeed before its repeat can be judged: got %v", err)
}
if {{ .ErrStmt }} {{ suite_callExpr .Recv .Body.Call }}; err != nil {
	tb.Errorf("a second {{ .Method }} after a clean one must change nothing: got %v", err)
}
{{- end -}}

{{- /*
The miss: an input nothing supplied, and what the subject owes for it.
With a declared sentinel the claim is that error and nothing else — a
subject reporting some other failure has not reported a miss. Without
one the claim is the zero, and the call has to have succeeded for the
answer to mean anything.
*/ -}}
{{- define "suite.body.miss-probe" -}}
{{ if .NeedsCtx }}ctx := tb.Context()
{{ end }}
{{- if .Sentinel }}
{{ .ErrStmt }} {{ suite_callExpr .Recv .Body.Call }}
if !{{ renderExpr (external "errors" "Is") }}(err, {{ renderExpr .Sentinel }}) {
	tb.Errorf("{{ .Method }} must report a miss as %v: got %v", {{ renderExpr .Sentinel }}, err)
}
{{- else if .HasErr }}
{{ .ValueBind }} {{ suite_callExpr .Recv .Body.Call }}
if err != nil {
	tb.Fatalf("{{ .Method }} for an input nothing supplied must answer: %v", err)
}
{{ template "suite.frag.zero-judge" . }}
{{- else }}
got{{ .ValueDiscard }} := {{ suite_callExpr .Recv .Body.Call }}
{{ template "suite.frag.zero-judge" . }}
{{- end }}
{{- end -}}
