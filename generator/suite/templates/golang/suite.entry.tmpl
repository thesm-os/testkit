{{- /*
The entry point and the run it repeats per subject.

Subjects are plural and named because that is the pattern a conformance suite
exists for: one statement of the contract, run against every implementation that
claims to satisfy it. Singular would make a team state their custom checks once
per implementation, which is where the statements drift.
*/ -}}
{{- define "suite.entry" -}}
{{ $c := . }}
// {{ .EntryName }} runs every generated check against every declared subject.
//
//	Checks:   {{ .CheckCount }} across {{ len .Methods }} method{{ if ne (len .Methods) 1 }}s{{ end }}, per subject
//	Subjects: declare each with {{ .IfaceName }}Subject
{{- if .Double }}
//	Double:   every subject runs a second time wrapped in {{ .Double.TypeName }}, so
//	          anything the wrapper fails that the subject passes is the double
//	          lying. {{ .IfaceName }}WithoutDouble declines it.
{{- end }}
//	Extend:   {{ range $i, $m := .Methods }}{{ if $i }}, {{ end }}{{ $.IfaceName }}On{{ $m.Name }}{{ end }}
//	Drop:     {{ .IfaceName }}Without, by the path each check reports under
{{- with .Unwritten }}
//
// # What this file does not check
//
// The interface declares these and nothing here asserts them. Each is statable
// against a subject you can build, so the check is yours to write:
//
{{- range . }}
//   - {{ .Name }}, on {{ .UncheckedList }} — write it with {{ $.IfaceName }}On{{ index .Unchecked 0 }}
{{- end }}
{{- end }}
{{- with .Elsewhere }}
//
// # What is checked somewhere else
//
// These need a reference implementation to compare against, which a suite run
// has no way to build. Nothing here asserts them and nothing here should:
//
{{- range . }}
//   - {{ .Name }}, on {{ .UncheckedList }}
{{- end }}
//
// //testkit:model on the interface derives that reference, and the
// {{ $.IfaceName }}Model option it generates runs them here. Its own file
// names the path it reports under and the {{ $.IfaceName }}Without call that
// declines it — this header said "model" for every fixture, and a twinned
// reference registers under "model/twin", so it was wrong wherever the
// oracle could not be derived.
{{- end }}
{{- if .Unfalsifiable }}
//
// Nothing proves these checks are able to fail —
// {{ .Unfalsifiable }}.
{{- end }}
func {{ .EntryName }}{{ renderTypeParams .TypeParams }}(t *{{ renderExpr (external "testing" "T") }}, opts ...{{ .IfaceName }}Option{{ .TypeArgs }}) {
	t.Helper()
	cfg := new{{ .IfaceName }}Config{{ .TypeArgs }}(opts...)
	if len(cfg.subjects) == 0 {
		t.Fatalf("{{ .EntryName }} was given no subject; declare one with " +
			"{{ .IfaceName }}Subject(name, factory)")
	}
	for _, p := range cfg.phantoms() {
		t.Errorf("{{ .IfaceName }}Without(%q) declines nothing: no check here reports "+
			"under that path, so this suite asserts one thing more than its "+
			"author believes", p)
	}
	for _, s := range cfg.subjects {
		run{{ .IfaceName }}Checks{{ .TypeArgs }}(t, cfg, s.name, s.factory, nil)
{{- if .Double }}
		if !cfg.withoutDouble {
			run{{ .IfaceName }}Checks{{ .TypeArgs }}(t, cfg, s.name+" through the double", s.factory,
				func(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}) {{ renderType .IfaceRef }}{{ .TypeArgs }} {
					return {{ .Double.CtorName }}{{ .TypeArgs }}(tb, {{ .Double.DelegateToName }}{{ .TypeArgs }}(subject))
				})
		}
{{- end }}
	}
}

// run{{ .IfaceName }}Checks runs the whole contract against one subject.
//
// wrap is applied after the subject is built and seeded, so a wrapper is
// transparent to the seed and every failure it causes is its own.
func run{{ .IfaceName }}Checks{{ renderTypeParams .TypeParams }}(
	t *{{ renderExpr (external "testing" "T") }},
	cfg *{{ lower .IfaceName }}Config{{ .TypeArgs }},
	label string,
	factory func() {{ renderType .IfaceRef }}{{ .TypeArgs }},
	wrap func(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}) {{ renderType .IfaceRef }}{{ .TypeArgs }},
) {
	t.Helper()
	t.Run(label, func(t *{{ renderExpr (external "testing" "T") }}) {
		t.Parallel()
{{ range $m := .Methods }}
		t.Run({{ printf "%q" $m.Name }}, func(t *{{ renderExpr (external "testing" "T") }}) {
			t.Parallel()
{{- if $m.IntegrationOnly }}
			// {{ $m.Name }} reaches something outside this process, so its
			// checks run where that exists and skip where it does not.
			// Unset is a skip rather than a pass: a check that succeeded
			// because its dependency was absent reports coverage it did not
			// earn.
			{{ renderExpr (external $.Runtime "RequireEnv") }}(t, {{ printf "%q" $.IntegrationEnv }})
{{- end }}
{{- range $ck := $m.Checks }}
			cfg.run(t, {{ printf "%q" $ck.Path }}, {{ printf "%q" $ck.Subtest }}, func(tb {{ renderExpr (external "testing" "TB") }}) {
				{{ $ck.Func }}{{ $.TypeArgs }}(tb, {{ if $ck.NeedsClock }}cfg.clock, {{ end }}cfg.subject(tb, factory, wrap){{ range $ck.Args }}, cfg.Fixture.{{ . }}{{ end }}{{ range $ck.Extra }}, cfg.Fixture.{{ .Field }}{{ end }})
			})
{{- end }}
			for _, c := range cfg.on{{ $m.Name }} {
				cfg.run(t, {{ printf "%q" $m.Name }}+"/"+c.name, c.name, func(tb {{ renderExpr (external "testing" "TB") }}) {
					c.fn(tb, cfg.subject(tb, factory, wrap){{ range $m.ArgFields }}, cfg.Fixture.{{ . }}{{ end }})
				})
			}
		})
{{ end }}
		// The extra bodies of checks this run was given, each reporting under its
		// own name and dropped by it.
		//
		// The plain subject only. The wrapped pass exists to prove the double
		// faithful and the per-method checks above already do that, so running one
		// through the wrapper prices the wrapper and says nothing new about the
		// subject.
		if wrap == nil {
			for _, e := range cfg.extensions {
				if cfg.declined(e.name) {
					t.Run(e.name, func(t *{{ renderExpr (external "testing" "T") }}) {
						t.Skipf("dropped through {{ .IfaceName }}Without(%q)", e.name)
					})
					continue
				}
				t.Run(e.name, func(t *{{ renderExpr (external "testing" "T") }}) {
					t.Parallel()
					e.run(t, label, factory, cfg)
				})
			}
		}
	})
}
{{- end -}}
