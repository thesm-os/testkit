{{- /*
The comma-ok half of the miss family: a shape reporting absence through a
trailing bool. The flag itself is excluded from the zero comparison, because
asserting `false` is `false` is a check that cannot fail.
*/ -}}
{{- define "suite.check.missflag" -}}
{{ $m := .Method }}
// {{ .Func }} asserts an absent input is reported as false with the zero
// value beside it.
//
// Fails when: {{ $m.Name }} reports ok for an input derived to be absent, or
// reports a miss while returning something other than the zero. A caller who
// checks the flag and a caller who checks the value must not disagree about
// whether the read found anything.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}
	{{- range $m.CallArgs }}, {{ .Name }} {{ renderType .Type }}{{ end }}) {
	tb.Helper()
{{- if $m.TakesContext }}
	ctx := tb.Context()
{{- end }}
	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ $r.Local }}{{ end }} := subject.{{ $m.Name }}({{ template "suite.args" . }})
	if {{ ($m.FlagReturn).Local }} {
		tb.Fatalf("{{ $m.Name }} found the input it was given; supply one it "+
			"misses through {{ .IfaceName }}WithFixture")
	}
{{- range $m.MissReturns }}
	{
		var zero {{ renderType .Type }}
		{{ renderExpr (external $.Runtime "Equal") }}(tb, {{ .Local }}, zero,
			"{{ $m.Name }} must return the zero value when it reports a miss")
	}
{{- end }}
}
{{- end -}}
