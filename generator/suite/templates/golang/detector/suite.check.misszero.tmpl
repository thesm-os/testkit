{{- /*
The signal-less half of the miss family: a shape with neither an error nor a
flag, where the zero value is the only thing absence can be reported as. A nil
pointer is the same claim — nil is what a pointer's zero is — so one template
serves both.
*/ -}}
{{- define "suite.check.misszero" -}}
{{ $m := .Method }}
// {{ .Func }} asserts an absent input yields the zero value.
//
// Fails when: {{ $m.Name }} returns anything else for an input derived to be
// absent. With no error and no flag, the zero is the only signal this shape
// has — so a subject returning a plausible value for a key it does not hold is
// indistinguishable from one that found it.
func {{ .Func }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, subject {{ renderType .IfaceRef }}{{ .TypeArgs }}
	{{- range $m.CallArgs }}, {{ .Name }} {{ renderType .Type }}{{ end }}) {
	tb.Helper()
{{- if $m.TakesContext }}
	ctx := tb.Context()
{{- end }}
	{{ range $i, $r := $m.Returns }}{{ if $i }}, {{ end }}{{ $r.Local }}{{ end }} := subject.{{ $m.Name }}({{ template "suite.args" . }})
{{- range $m.MissReturns }}
	{
		var zero {{ renderType .Type }}
		{{ renderExpr (external $.Runtime "Equal") }}(tb, {{ .Local }}, zero,
			"{{ $m.Name }} must return the zero value for an input it does not hold")
	}
{{- end }}
}
{{- end -}}
