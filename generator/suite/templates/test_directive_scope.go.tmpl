{{- /* Scope contract: emits one call to [suite.AssertScopeAuthRequired]
       with a typed call closure. Runtime owns the unauthorized/
       authorized split + option validation. */ -}}
{{- define "test-directive-scope" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $opts := .Opts -}}
		suite.AssertScopeAuthRequired[{{ $iface }}](
			{{ printf "%q" $m.ScopeName }},
			{{ $opts }}.ScopeContext,
			{{ $opts }}.ScopeUnauthorized,
			func(ctx context.Context, impl {{ $iface }}) error {
				{{ $m.ErrCaptureLHS }} := impl.{{ $m.Name }}(ctx{{ range $i := seq $m.NonCtxParamCount }}, {{ $m.SampleParamAt $i $tracker }}{{ end }})
				return err
			},
		)(t, factory)
{{- end -}}
