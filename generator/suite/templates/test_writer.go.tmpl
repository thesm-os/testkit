{{- /* Writer-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-writer" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $V := $m.ShapeValType -}}
		sctx := suite.WriterContextFor[{{ $iface }}, {{ $V }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, value {{ $V }}) error {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx, value)
{{- else }}
				return impl.{{ $m.Name }}(value)
{{- end }}
			})
		suite.AssertWriteSucceeds[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }})(sctx)
		suite.AssertWriterRespectsContext[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }})(sctx)
		suite.AssertWriterIdempotent[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }})(sctx)
{{- if $m.HasFirstSentinel }}
		suite.AssertWriteRejectInvalid[{{ $iface }}, {{ $V }}]({{ $m.ZeroParamAt 0 $tracker }}, {{ $m.FirstSentinel }})(sctx)
{{- end }}
		suite.AssertWriterConcurrentSafe[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, 4, 10)(sctx)
{{- end -}}
