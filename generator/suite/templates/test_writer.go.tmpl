{{- /* Writer-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-writer" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $V := $m.ShapeValType -}}
		sctx := suite.WriterContextFor[{{ $iface }}, {{ $V }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, value {{ $V }}) error {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx, value)
{{- else }}
				return impl.{{ $m.Name }}(value)
{{- end }}
			})
		suite.AssertWriterBaseline[{{ $iface }}, {{ $V }}](
			{{ $m.SampleParamAt 0 $tracker }},
{{- if $m.HasFirstSentinel }}
			suite.AssertWriteRejectInvalid[{{ $iface }}, {{ $V }}]({{ $m.ZeroParamAt 0 $tracker }}, {{ $m.SentinelsList }}),
{{- end }}
		)(sctx)
{{- end -}}
