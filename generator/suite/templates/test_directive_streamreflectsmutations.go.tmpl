{{- /* Stream-reflects-mutations contract: directive sits on the
       writer method (Writer shape: ctx, V → error). After write,
       the named stream method must yield the written value. The
       stream is iterated, items collected into a slice, the
       written V's equality membership is asserted.

       The named stream method must be StreamReader-shape and
       compatible with iter.Seq (no error) or iter.Seq2 (paired
       with error). The directive validator (Task 18) rejects on
       mismatched shapes. */ -}}
{{- define "test-directive-streamreflectsmutations" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $V := $m.ShapeValType -}}
		suite.AssertStreamReflectsValueWritten[{{ $iface }}, {{ $V }}](
			{{ $m.SampleParamAt 0 $tracker }},
			func(ctx context.Context, impl {{ $iface }}, v {{ $V }}) error {
				return impl.{{ $m.Name }}(ctx, v)
			},
			func(ctx context.Context, impl {{ $iface }}) ([]{{ $V }}, error) {
				out := make([]{{ $V }}, 0)
				for v, err := range impl.{{ $m.StreamReflectsMutationsStream }}(ctx) {
					if err != nil {
						return out, err
					}
					out = append(out, v)
				}
				return out, nil
			},
		)(t, factory)
{{- end -}}
