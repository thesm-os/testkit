{{- /* Retry-succeeds-on-attempt contract: emits one call to
       [suite.AssertRetrySucceedsOnAttempt] with a typed error-
       returning closure. The closure captures the impl's trailing
       error via [ErrCaptureLHS].

       The retry contract requires N-1 transient failures and then
       success — incompatible with a Writer-shape baseline's
       "succeeds on first call" assertion against the same impl.
       To resolve, the helper accepts a separate retry factory
       (WithRetryFactory option) when present; the Writer baseline
       uses the regular factory (always succeeds), the retry
       contract uses the retry factory (fails N-1 times). When no
       retry factory is supplied, falls back to the regular factory
       — the contract is then unverifiable but we surface the
       failure cleanly rather than silently passing. */ -}}
{{- define "test-directive-retryable" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $opts := .Opts -}}
{{- if $m.ReturnsError }}
		{
			retryFactory := factory
			if rf, ok := {{ $opts }}.RetryFactory.(func() {{ $iface }}); ok {
				retryFactory = rf
			}
			suite.AssertRetrySucceedsOnAttempt[{{ $iface }}](
				{{ $m.RetryN }},
				func(ctx context.Context, impl {{ $iface }}) error {
					{{ $m.ErrCaptureLHS }} := impl.{{ $m.Name }}({{ $m.SampleArgs $tracker }})
					return err
				},
			)(t, retryFactory)
		}
{{- end }}
{{- end -}}
