{{- /* Per-method smoke subtest body.
       Body-only partial — invoked from `test-method` inside the
       per-method t.Run. Receives:
         .M       — the *MethodView
         .Tracker — *generator.Tracker for sample/zero rendering
         .Spec    — *spec.Data for SubstituteTypeParams

       Smoke fails the test on panic via testkit's discipline —
       replacing the legacy t.Skipf-on-panic that silently masked
       contract violations. Methods whose zero-value invocation
       legitimately panics must declare //testkit:sample so the
       smoke uses a non-trivial input. */ -}}
{{- define "test-method-smoke" -}}
{{- $m := .M -}}
{{- $tracker := .Tracker -}}
{{- $spec := .Spec -}}
		t.Run("smoke", func(t *testing.T) {
			t.Parallel()
			impl := factory()
{{- if $m.HasResults }}
			{{ $m.BlankResults }} = impl.{{ $m.Name }}({{ $spec.SubstituteTypeParams ($m.SampleArgs $tracker) }})
{{- else }}
			impl.{{ $m.Name }}({{ $spec.SubstituteTypeParams ($m.SampleArgs $tracker) }})
{{- end }}
		})
{{- end -}}
