{{- /* VoidLifecycle-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-voidlifecycle" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $opts := .Opts -}}
		sctx := suite.VoidLifecycleContextFor[{{ $iface }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}) {
{{- if $m.HasContext }}
				impl.{{ $m.Name }}(ctx)
{{- else }}
				impl.{{ $m.Name }}()
{{- end }}
			})
		var extras []suite.VoidLifecycleAssertion[{{ $iface }}]
		if invalidFactory, ok := {{ $opts }}.InvalidFactory.(func() {{ $iface }}); ok {
			extras = append(extras, suite.AssertVoidLifecycleRejectInvalidWith[{{ $iface }}](invalidFactory))
		}
		suite.AssertVoidLifecycleBaseline[{{ $iface }}](extras...)(sctx)
{{- end -}}
