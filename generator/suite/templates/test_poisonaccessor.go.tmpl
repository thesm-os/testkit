{{- /* PoisonAccessor-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-poisonaccessor" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $opts := .Opts -}}
		sctx := suite.PoisonAccessorContextFor[{{ $iface }}](t, factory,
			func(impl {{ $iface }}) error {
				return impl.{{ $m.Name }}()
			})
		var extras []suite.PoisonAccessorAssertion[{{ $iface }}]
{{- if $m.HasFirstSentinel }}
		if poisonedFactory, ok := {{ $opts }}.PoisonedFactory.(func() {{ $iface }}); ok {
			extras = append(extras, suite.AssertPoisonAccessorRejectInvalid[{{ $iface }}](poisonedFactory, {{ $m.SentinelsList }}))
		}
{{- end }}
		suite.AssertPoisonAccessorBaseline[{{ $iface }}](extras...)(sctx)
{{- end -}}
