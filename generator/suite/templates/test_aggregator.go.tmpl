{{- /* Aggregator-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-aggregator" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $R := $m.ShapeValType -}}
		sctx := suite.AggregatorContextFor[{{ $iface }}, {{ $R }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}) ({{ $R }}, error) {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx)
{{- else }}
				return impl.{{ $m.Name }}()
{{- end }}
			})
		suite.AssertAggregatorReturns[{{ $iface }}, {{ $R }}]({{ $m.SampleResultAt 0 $tracker }})(sctx)
		suite.AssertAggregatorRespectsContext[{{ $iface }}, {{ $R }}]()(sctx)
		suite.AssertAggregatorConsistent[{{ $iface }}, {{ $R }}](3)(sctx)
		t.Run("rejects invalid", func(t *testing.T) {
			t.Skipf("{{ $m.Name }}: RejectInvalid baseline reserved for consumer-supplied bounds via AssertAggregatorBounded")
		})
		suite.AssertAggregatorConcurrentSafe[{{ $iface }}, {{ $R }}](4, 10)(sctx)
{{- end -}}
