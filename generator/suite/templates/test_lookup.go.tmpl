{{- /* Lookup-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-lookup" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
{{- $R := $m.ShapeRetType -}}
		sctx := suite.LookupContextFor[{{ $iface }}, {{ $K }}, {{ $V }}, {{ $R }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, key {{ $K }}) ({{ $V }}, {{ $R }}, bool) {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx, key)
{{- else }}
				return impl.{{ $m.Name }}(key)
{{- end }}
			})
		suite.AssertLookupReturns[{{ $iface }}, {{ $K }}, {{ $V }}, {{ $R }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.SampleResultAt 0 $tracker }})(sctx)
		suite.AssertLookupRespectsContext[{{ $iface }}, {{ $K }}, {{ $V }}, {{ $R }}]({{ $m.SampleParamAt 0 $tracker }})(sctx)
		suite.AssertLookupConsistent[{{ $iface }}, {{ $K }}, {{ $V }}, {{ $R }}]({{ $m.SampleParamAt 0 $tracker }}, 3)(sctx)
		suite.AssertLookupMissing[{{ $iface }}, {{ $K }}, {{ $V }}, {{ $R }}]({{ $m.ZeroParamAt 0 $tracker }})(sctx)
		suite.AssertLookupConcurrentSafe[{{ $iface }}, {{ $K }}, {{ $V }}, {{ $R }}]({{ $m.SampleParamAt 0 $tracker }}, 4, 10)(sctx)
{{- end -}}
