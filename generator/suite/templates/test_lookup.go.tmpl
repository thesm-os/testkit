{{- /* Lookup-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-lookup" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
{{- $R := $m.ShapeRetType -}}
		sctx := suite.LookupContextFor[{{ $iface }}, {{ $K }}, {{ $V }}, {{ $R }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, key {{ $K }}) ({{ $V }}, {{ $R }}, bool) {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx, key)
{{- else }}
				return impl.{{ $m.Name }}(key)
{{- end }}
			})
		suite.AssertLookupBaseline[{{ $iface }}, {{ $K }}, {{ $V }}, {{ $R }}](
			{{ $m.SampleParamAt 0 $tracker }},
			{{ $m.SampleResultAt 0 $tracker }},
			{{ $m.ZeroParamAt 0 $tracker }},
		)(sctx)
{{- end -}}
