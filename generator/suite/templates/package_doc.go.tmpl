{{- define "package-doc" -}}
{{- $iface := .IfaceName -}}
{{- $driver := .DriverName -}}
{{- $across := .AcrossImplsName -}}
// Package {{ .PackageName }} verifies that any implementation of
// [{{ .Spec.QualifiedType }}] honors the contract declared by the
// source interface. Generated by `testkit suite`.
//
// # Usage
//
//	func Test{{ $iface }}Contract(t *testing.T) {
//	    {{ $driver }}{{ .Spec.TypeParamArgs }}(t, func() {{ .QualifiedTypeForTest }} {
//	        return newInMemory()
//	    })
//	}
//
// # Multi-impl conformance
//
// Run the same contract once per implementation with
// `t.Run(name, ...)` per impl:
//
//	func Test{{ $iface }}ContractAcrossImpls(t *testing.T) {
//	    {{ $across }}(t, []{{ .NamedFactoryTypeName }}{
//	        {Name: "InMemory", Factory: newInMemory},
//	        {Name: "Postgres", Factory: newPostgres},
//	    })
//	}
//
// New impls drop into the slice — no per-impl test function to
// hand-wire. The driver emits identical per-method, per-shape, and
// per-directive subtests across every factory. Variadic `suite.Option`
// arguments apply to every factory's contract run.
//
// # Contract coverage
//
// Every non-skipped method gets a smoke subtest that constructs the
// impl, invokes the method with safe arguments (zero-values when
// the method's parameters allow, sample-driven when
// `//testkit:sample` is declared), and fails the test loudly on
// panic. Methods marked `//testkit:integration-only` are skipped —
// the consumer's integration test owns those contracts.
//
// Per-shape baseline assertions (Reader, Writer, Stream, …) and
// per-directive subtests (errors, deprecated, retryable, partition,
// order-after, wrapped-via, …) layer on top of smoke; see the
// [{{ $iface }} contract docs](.) for the full per-shape menu.
{{ end -}}
