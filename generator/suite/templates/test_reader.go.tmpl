{{- /* Reader-shape baseline body. Body-only partial — invoked from
       `test-method` inside the per-method t.Run. Builds the typed
       ReaderContext via [suite.ReaderContextFor] and runs the 5
       baseline assertions:
         - AssertReturnsForKey         (Succeeds)
         - AssertReaderRespectsContext (RespectsContext)
         - AssertConsistentReads       (Idempotent)
         - AssertReturnsSentinel       (RejectInvalid — emitted when
                                        the method carries
                                        //testkit:errors)
         - AssertReaderConcurrentSafe  (ConcurrentSafe)

       Methods without a sentinel directive get a documented
       no-sentinel subtest that records the omission rather than
       silently dropping it. */ -}}
{{- define "test-method-reader" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
		sctx := suite.ReaderContextFor[{{ $iface }}, {{ $K }}, {{ $V }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, key {{ $K }}) ({{ $V }}, error) {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx, key)
{{- else }}
				return impl.{{ $m.Name }}(key)
{{- end }}
			})
		suite.AssertReturnsForKey[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.SampleResultAt 0 $tracker }})(sctx)
		suite.AssertReaderRespectsContext[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }})(sctx)
		suite.AssertConsistentReads[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, 3)(sctx)
{{- if $m.HasFirstSentinel }}
		suite.AssertReturnsSentinel[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.ZeroParamAt 0 $tracker }}, {{ $m.FirstSentinel }})(sctx)
{{- else }}
		t.Run("rejects invalid (no sentinel)", func(t *testing.T) {
			t.Skipf("{{ $m.Name }}: RejectInvalid baseline requires //testkit:errors <Sentinel>; subtest omitted to avoid a meaningless assertion")
		})
{{- end }}
		suite.AssertReaderConcurrentSafe[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, 4, 10)(sctx)
{{- end -}}
