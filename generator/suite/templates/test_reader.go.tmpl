{{- /* Reader-shape baseline body. Body-only partial — invoked from
       `test-method` inside the per-method t.Run. Builds the typed
       ReaderContext via [suite.ReaderContextFor] and runs the Reader
       baseline (Returns, RespectsContext, ConsistentReads,
       ConcurrentSafe). The optional [suite.AssertReturnsSentinel]
       extra fires when the method declares //testkit:errors with a
       nameable sentinel; generic Readers where the sample key equals
       the zero key (`*new(K)`) omit the sentinel — see Task 9 — to
       avoid the sample/missing-key collision. */ -}}
{{- define "test-method-reader" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
		sctx := suite.ReaderContextFor[{{ $iface }}, {{ $K }}, {{ $V }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, key {{ $K }}) ({{ $V }}, error) {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx, key)
{{- else }}
				return impl.{{ $m.Name }}(key)
{{- end }}
			})
		suite.AssertReaderBaseline[{{ $iface }}, {{ $K }}, {{ $V }}](
			{{ $m.SampleParamAt 0 $tracker }},
			{{ $m.SampleResultAt 0 $tracker }},
{{- if and $m.HasFirstSentinel (not ($m.SampleEqualsZero 0 $tracker)) }}
			suite.AssertReturnsSentinel[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.ZeroParamAt 0 $tracker }}, {{ $m.SentinelsList }}),
{{- end }}
		)(sctx)
{{- end -}}
