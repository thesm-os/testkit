{{- /* Idempotent contract: emits one call to
       [suite.AssertIdempotentSecondCall] with a void-returning
       closure that discards results. Pure observability of
       state-equivalence is the cross-method invariant directives'
       job, not this baseline. */ -}}
{{- define "test-directive-idempotent" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
		suite.AssertIdempotentSecondCall[{{ $iface }}](
			func(ctx context.Context, impl {{ $iface }}) {
{{- if $m.HasResults }}
				{{ $m.BlankResults }} = impl.{{ $m.Name }}({{ $m.SampleArgs $tracker }})
{{- else }}
				impl.{{ $m.Name }}({{ $m.SampleArgs $tracker }})
{{- end }}
			},
		)(t, factory)
{{- end -}}
