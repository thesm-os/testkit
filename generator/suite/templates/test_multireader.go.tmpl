{{- /* MultiReader-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-multireader" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
{{- $V1 := $m.ShapeValType -}}
{{- $V2 := $m.ShapeValType2 -}}
		sctx := suite.MultiReaderContextFor[{{ $iface }}, {{ $K }}, {{ $V1 }}, {{ $V2 }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, key {{ $K }}) ({{ $V1 }}, {{ $V2 }}, error) {
{{- if $m.HasContext }}
				return impl.{{ $m.Name }}(ctx, key)
{{- else }}
				return impl.{{ $m.Name }}(key)
{{- end }}
			})
		suite.AssertMultiReaderReturnsForKey[{{ $iface }}, {{ $K }}, {{ $V1 }}, {{ $V2 }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.SampleResultAt 0 $tracker }}, {{ $m.SampleResultAt 1 $tracker }})(sctx)
		suite.AssertMultiReaderRespectsContext[{{ $iface }}, {{ $K }}, {{ $V1 }}, {{ $V2 }}]({{ $m.SampleParamAt 0 $tracker }})(sctx)
		suite.AssertMultiReaderConsistent[{{ $iface }}, {{ $K }}, {{ $V1 }}, {{ $V2 }}]({{ $m.SampleParamAt 0 $tracker }}, 3)(sctx)
{{- if $m.HasFirstSentinel }}
		suite.AssertMultiReaderReturnsSentinel[{{ $iface }}, {{ $K }}, {{ $V1 }}, {{ $V2 }}]({{ $m.ZeroParamAt 0 $tracker }}, {{ $m.FirstSentinel }})(sctx)
{{- end }}
		suite.AssertMultiReaderConcurrentSafe[{{ $iface }}, {{ $K }}, {{ $V1 }}, {{ $V2 }}]({{ $m.SampleParamAt 0 $tracker }}, 4, 10)(sctx)
{{- end -}}
