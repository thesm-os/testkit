{{- /* Mutator-shape baseline body. Body-only partial. */ -}}
{{- define "test-method-mutator" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $opts := .Opts -}}
{{- $V := $m.ShapeValType -}}
		sctx := suite.MutatorContextFor[{{ $iface }}, {{ $V }}](t, factory,
			func(ctx context.Context, impl {{ $iface }}, value {{ $V }}) {
{{- if $m.HasContext }}
				impl.{{ $m.Name }}(ctx, value)
{{- else }}
				impl.{{ $m.Name }}(value)
{{- end }}
			})
		var extras []suite.MutatorAssertion[{{ $iface }}, {{ $V }}]
		if invalidFactory, ok := {{ $opts }}.InvalidFactory.(func() {{ $iface }}); ok {
			extras = append(extras, suite.AssertMutatorRejectInvalidWith[{{ $iface }}, {{ $V }}](invalidFactory, {{ $m.SampleParamAt 0 $tracker }}))
		}
		suite.AssertMutatorBaseline[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, extras...)(sctx)
{{- end -}}
