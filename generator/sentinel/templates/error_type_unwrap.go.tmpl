{{- /*
The "error-type-unwrap" partial emits the Unwrap() error subtests
included only when the error type defines a custom Unwrap method:

  - Unwrap returns the cause field's value
  - errors.Is traverses the Unwrap chain to find a sentinel
  - Unwrap returns nil when the cause field is unset

Cause-field assertions are gated on UnwrapField — when the error
type has Unwrap but no error-typed field to populate, only the bare
invocation is meaningful and the assertions are skipped.

Data input: one sentinel.ErrorType.
*/ -}}
{{define "error-type-unwrap"}}
	// Unwrap() must return the cause field's value — confirms the
	// declared cause is reachable via the stdlib unwrap protocol.
	t.Run("Unwrap returns cause", func(t *testing.T) {
		t.Parallel()
		cause := errors.New("inner cause")
		err := &{{.Qualifier}}{{.Name}}{
{{- if .UnwrapField}}
			{{.UnwrapField}}: cause,
{{- end}}
		}
		got := err.Unwrap()
{{- if .UnwrapField}}
		testkit.ErrorIs(t, got, cause, "Unwrap must return the cause")
{{- end}}
	})

	// errors.Is must traverse the Unwrap chain to find a sentinel
	// stored in the cause field — if not, callers can't reach the
	// underlying error with the canonical Is API.
	t.Run("errors.Is traverses Unwrap chain", func(t *testing.T) {
		t.Parallel()
		sentinel := errors.New("findable")
		err := &{{.Qualifier}}{{.Name}}{
{{- if .UnwrapField}}
			{{.UnwrapField}}: sentinel,
{{- end}}
		}
{{- if .UnwrapField}}
		testkit.ErrorIs(t, err, sentinel,
			"errors.Is must find sentinel through Unwrap chain")
{{- end}}
	})
{{- if .UnwrapField}}

	// A zero-value error must return nil from Unwrap, not panic.
	// Catches Unwrap implementations that dereference the cause field
	// or wrap nil into a non-nil error interface.
	t.Run("Unwrap returns nil when cause is unset", func(t *testing.T) {
		t.Parallel()
		err := &{{.Qualifier}}{{.Name}}{}
		testkit.True(t, err.Unwrap() == nil,
			"Unwrap must return nil when cause is unset")
	})
{{- end}}
{{end}}
