{{- define "sentinel.tests" -}}
{{- $T := sentinelRef "testing.T" -}}
{{- $equal := sentinelRef "testkit.Equal" -}}
{{- $notEqual := sentinelRef "testkit.NotEqual" -}}
{{- $true := sentinelRef "testkit.True" -}}
{{- $false := sentinelRef "testkit.False" -}}
{{- $hasPrefix := sentinelRef "testkit.HasPrefix" -}}
{{- $contains := sentinelRef "testkit.Contains" -}}
{{- $errorIs := sentinelRef "testkit.ErrorIs" -}}
{{- $errorsIs := sentinelRef "errors.Is" -}}
{{- $errorf := sentinelRef "fmt.Errorf" -}}
{{- $newErr := sentinelRef "errors.New" -}}
{{- $strHasPrefix := sentinelRef "strings.HasPrefix" -}}
{{- $types := .ErrTypes -}}
{{- $pkg := pascal .PackageName -}}
{{- $sentinels := .Sentinels -}}
{{- if $sentinels }}
// Test{{ $pkg }}Sentinels pins the contract every sentinel in this package
// carries. Callers match on these values, read them in logs, and branch on
// them, so their messages and identities are as much an API as any exported
// signature — and nothing in the compiler holds them to it.
func Test{{ $pkg }}Sentinels(t *{{ renderExpr $T }}) {
	t.Parallel()

	all := []struct {
		name string
		err  error
	}{
{{- range $sentinels }}
		{"{{ .Name }}", {{ renderExpr .Ref }}},
{{- end }}
	}

	t.Run("every sentinel is non-nil", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A var declared and never assigned is nil, compiles, and satisfies
		// errors.Is against nothing — so every caller's branch on it is dead
		// and no other check here can even run without panicking.
		for _, e := range all {
			{{ renderExpr $true }}(t, e.err != nil, e.name+" must be assigned")
		}
	})

	t.Run("every sentinel has a message", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// An empty message reaches a log as nothing at all, which is worse
		// than a bad one: the operator sees that something failed and no
		// indication of what.
		for _, e := range all {
			{{ renderExpr $notEqual }}(t, e.err.Error(), "", e.name+" must carry a message")
		}
	})
{{- if .Prefix }}

	t.Run("every sentinel carries the package prefix", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A message without it reads in a log exactly like one from any other
		// package, which is the confusion the prefix exists to prevent.
		for _, e := range all {
			{{ renderExpr $hasPrefix }}(t, e.err.Error(), {{ printf "%q" .Prefix }},
				e.name+" must carry the package prefix")
		}
	})
{{- else }}

	// No prefix check: this package declares prefix=off, so its messages are
	// deliberately bare. Suppression is explicit because a generator that
	// quietly dropped a failing check would be worse than having none.
{{- end }}

	t.Run("no two sentinels share a message", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Two identical messages cannot be told apart in a log, and the second
		// is usually a copy-paste that was meant to be edited.
		seen := map[string]string{}
		for _, e := range all {
			{{ renderExpr $equal }}(t, seen[e.err.Error()], "",
				e.name+" must not repeat another sentinel's message")
			seen[e.err.Error()] = e.name
		}
	})

	t.Run("no sentinel's message is a prefix of another's", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Distinct from sharing a message. One message that starts with
		// another makes every grep for the shorter one match the longer, and
		// any code matching on message text ambiguous — which is why the two
		// are separate checks rather than one equality.
		for _, a := range all {
			for _, b := range all {
				if a.name == b.name {
					continue
				}
				{{ renderExpr $false }}(t, {{ renderExpr $strHasPrefix }}(a.err.Error(), b.err.Error()),
					a.name+" must not begin with the whole of "+b.name)
			}
		}
	})

	t.Run("no sentinel matches another", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Two that match collapse a caller's branches into one, and the caller
		// cannot see it from the declarations.
		for _, a := range all {
			for _, b := range all {
				if a.name == b.name {
					continue
				}
				{{ renderExpr $false }}(t, {{ renderExpr $errorsIs }}(a.err, b.err),
					a.name+" must not satisfy errors.Is against "+b.name)
			}
		}
	})


	// No check that a sentinel survives %w or errors.Join. errors.Is compares
	// identity before it consults anything a type declares, so every value
	// passes both — including one whose Is always refuses. The assertion would
	// be about the standard library rather than about this package.
{{- range .Neighbours }}

	t.Run("no sentinel matches one in {{ .Name }}", func(t *{{ renderExpr $T }}) {
		t.Parallel()
{{- if .Sentinels }}
		// Distinct values describing the same conditions are where a
		// copy-paste between packages produces an alias, and neither package
		// can see it alone.
		for _, a := range all {
			for _, b := range []struct {
				name string
				err  error
			}{
{{- range .Sentinels }}
				{"{{ .Name }}", {{ renderExpr .Ref }}},
{{- end }}
			} {
				{{ renderExpr $false }}(t, {{ renderExpr $errorsIs }}(a.err, b.err),
					a.name+" must not satisfy errors.Is against "+b.name)
			}
		}
{{- else }}
		// {{ .Path }} declares no sentinel, so there is nothing to overlap.
		// The subtest is emitted anyway: a directive naming a package that has
		// none should read as an empty check rather than as one that was never
		// generated.
		_ = all
{{- end }}
	})
{{- end }}
}
{{- end }}
{{- range .ErrTypes }}
{{- $amp := "" }}{{ if .Pointer }}{{ $amp = "&" }}{{ end }}
{{- $lit := printf "%s%s{}" $amp (renderExpr .Ref) }}

// Test{{ .Name }}Contract pins what this type owes a caller beyond
// implementing error.
func Test{{ .Name }}Contract(t *{{ renderExpr $T }}) {
	t.Parallel()

	t.Run("reports a message for its zero value", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A message that dereferences a field the zero value leaves nil panics
		// — replacing the error a caller needed to report with a crash inside
		// whatever was already going wrong.
		{{ renderExpr $notEqual }}(t, ({{ $lit }}).Error(), "",
			"{{ .Name }} must report a message without panicking")
	})

{{- if $.Prefix }}

	t.Run("carries the package prefix like a sentinel does", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A custom error reaches the same logs as a sentinel and is read the
		// same way, so it owes the same prefix. Checking only the Err* vars
		// leaves half a package's messages unexamined.
		{{ renderExpr $hasPrefix }}(t, ({{ $lit }}).Error(), {{ printf "%q" $.Prefix }},
			"{{ .Name }} must carry the package prefix")
	})
{{- end }}

	// No errors.As recovery check: As finds a value by assignability while
	// walking the chain, so it succeeds for any type reachable through it and
	// fails for none. What a type can genuinely get wrong is its own Unwrap,
	// which is checked below when it declares one.

{{- $self := .Name }}
{{- $siblings := false }}{{ range $types }}{{ if ne .Name $self }}{{ $siblings = true }}{{ end }}{{ end }}
{{- if $siblings }}

	t.Run("does not match the package's other error types", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Two error types that satisfy errors.Is against each other collapse a
		// caller's branches, and the caller cannot see it from the
		// declarations.
		subject := {{ $lit }}
		for _, other := range []error{
{{- range $types }}{{ if ne .Name $self }}
			{{ if .Pointer }}&{{ end }}{{ renderExpr .Ref }}{},
{{- end }}{{ end }}
		} {
			{{ renderExpr $false }}(t, {{ renderExpr $errorsIs }}(subject, other),
				"{{ $self }} must not satisfy errors.Is against another type here")
		}
	})
{{- end }}
{{- if and .HasIs $sentinels }}

	t.Run("agrees with errors.Is about what it matches", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Emitted because the type declares Is; one that does not gets no such
		// check rather than a vacuous one. What is asserted is that errors.Is
		// reaches the declared method — an Is on the wrong receiver form is
		// never consulted, and the type then silently matches nothing.
		subject := {{ $lit }}
		for _, e := range []error{
{{- range $sentinels }}
			{{ renderExpr .Ref }},
{{- end }}
		} {
			{{ renderExpr $equal }}(t, {{ renderExpr $errorsIs }}(subject, e), subject.Is(e),
				"errors.Is must agree with {{ .Name }}.Is")
		}
	})
{{- end }}
{{- if and .HasUnwrap .CauseField }}

	t.Run("exposes the cause it was given", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Emitted because the type declares Unwrap and carries a cause. A
		// wrapper that does not return its cause silently truncates every
		// chain it takes part in.
		cause := {{ renderExpr $errorf }}("cause")
		{{ renderExpr $errorIs }}(t, {{ if .Pointer }}&{{ end }}{{ renderExpr .Ref }}{ {{- .CauseField }}: cause}, cause,
			"{{ .Name }} must expose its cause")
	})
{{- end }}
{{- if .Checked }}

	t.Run("puts every field it carries into its message", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A field the message drops is a detail the operator cannot see, and
		// the struct is the only record that it was meant to be visible.
		got := {{ if .Pointer }}&{{ end }}{{ renderExpr .Ref }}{
{{- range .Fields }}{{ if .Sample }}
			{{ .Name }}: {{ .Sample }},
{{- end }}{{ end }}
		}
{{- range .Fields }}{{ if .Sample }}
		{{ renderExpr $contains }}(t, got.Error(), {{ .Sample }},
			"{{ .Name }} must reach the message")
{{- end }}{{ end }}
	})
{{- end }}
}
{{- end }}
{{- end -}}
