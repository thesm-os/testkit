{{- /*
The "sentinel-vars" partial emits Test<Pkg>SentinelErrors — the
top-level test function covering every Err* sentinel in the package.
Subtests assert five invariants:

  - prefix             — every sentinel's .Error() starts with "<pkg>: "
  - uniqueness         — no two sentinels share an .Error() string
  - non-overlap        — errors.Is rejects every cross-pair
  - errors.Join chain  — errors.Is sees through errors.Join
  - fmt.Errorf chain   — errors.Is sees through fmt.Errorf("...: %w", err)

Data input: the full sentinel.Data.
*/ -}}
{{define "sentinel-vars"}}
// Test{{.TestName}} verifies the package's sentinel error variables
// (every Err* package-level var) satisfy five invariants:
//
//   - prefix:            every .Error() starts with "{{.Prefix}}"
//   - uniqueness:        no two sentinels share a .Error() message
//   - non-overlap:       errors.Is is false for every cross-pair
//   - errors.Join chain: errors.Is sees through errors.Join wrapping
//   - fmt.Errorf chain:  errors.Is sees through fmt.Errorf("...: %w", err)
//
// Together these guarantee callers can distinguish sentinels with
// errors.Is and that wrapping doesn't break the chain.
func Test{{.TestName}}(t *testing.T) {
	t.Parallel()

	type errEntry struct {
		name string
		err  error
	}
	all := []errEntry{
{{- range .Sentinels}}
		{"{{.Name}}", {{$.Qualifier}}{{.Name}}},
{{- end}}
	}

	// "prefix": every Err* var's .Error() must start with the
	// package-derived prefix ("{{.Prefix}}"). Catches sentinels that
	// silently lose their prefix during refactors.
	t.Run("prefix", func(t *testing.T) {
		t.Parallel()
		prefix := "{{.Prefix}}"
		for _, e := range all {
			t.Run(e.name+" has correct prefix", func(t *testing.T) {
				t.Parallel()
				testkit.HasPrefix(t, e.err.Error(), prefix,
					e.name+" must start with "+prefix)
			})
		}
	})

	// "uniqueness": no two sentinels may share an identical .Error()
	// message — duplicate text would let errors.Is succeed for the
	// wrong reason in user code that compares strings.
	t.Run("uniqueness", func(t *testing.T) {
		t.Parallel()
		seen := make(map[string]string)
		for _, e := range all {
			msg := e.err.Error()
			other, dup := seen[msg]
			testkit.False(t, dup,
				e.name+" and "+other+" have identical .Error(): "+msg)
			seen[msg] = e.name
		}
	})

	// "non-overlap": errors.Is(a, b) must be false for every distinct
	// pair. A passing test guarantees a caller's `if errors.Is(err,
	// ErrNotFound)` cannot accidentally match a different sentinel.
	t.Run("non-overlap", func(t *testing.T) {
		t.Parallel()
		for i, a := range all {
			for j, b := range all {
				if i == j {
					continue
				}
				t.Run(a.name+" is not "+b.name, func(t *testing.T) {
					t.Parallel()
					testkit.ErrorIsNot(t, a.err, b.err,
						a.name+" must not match "+b.name)
				})
			}
		}
	})

	// "errors.Join chain": wrapping a sentinel via errors.Join must
	// preserve errors.Is — confirms sentinels are usable inside
	// multi-error aggregates without callers losing identity checks.
	t.Run("errors.Join chain", func(t *testing.T) {
		t.Parallel()
		for _, e := range all {
			t.Run(e.name+" preserves chain when joined", func(t *testing.T) {
				t.Parallel()
				wrapped := errors.Join(e.err, errors.New("extra context"))
				testkit.ErrorIs(t, wrapped, e.err,
					"errors.Join("+e.name+", ...) must satisfy errors.Is")
			})
		}
	})

	// "fmt.Errorf chain": wrapping with fmt.Errorf("...: %w", err)
	// must preserve errors.Is — the most common wrapping idiom in
	// Go must not break sentinel identity.
	t.Run("fmt.Errorf chain", func(t *testing.T) {
		t.Parallel()
		for _, e := range all {
			t.Run(e.name+" preserves chain through fmt.Errorf", func(t *testing.T) {
				t.Parallel()
				wrapped := fmt.Errorf("context: %w", e.err)
				testkit.ErrorIs(t, wrapped, e.err,
					"fmt.Errorf(\"%w\", "+e.name+") must satisfy errors.Is")
			})
		}
	})
}
{{end}}
