{{- /*
The "header" partial emits package + import block + a file-level
doc comment summarizing what's in the file. Used by both the impl
and test renderers — they share the same Imports list (resolved at
analyze time via [generator.ImportTracker]).

Data input: enum.Data.
*/ -}}
{{define "header"}}
// This file holds fluent builders for test fixtures. Each builder
// follows the same contract:
//
//   - New<Type>()       creates a builder seeded with defaults (when
//                       a <Type>Defaults factory or //testkit:default
//                       directives are present) or zero values.
//   - New<Type>From(v)  creates a builder seeded with v.
//   - With<Field>(v)    sets a field; chains.
//   - Append<Field>(v)  appends to a slice field (slice fields only).
//   - With<Field>Entry(k, v) adds a map entry (map fields only).
//   - Mutate(fn)        applies fn to the value under construction.
//   - Clone()           returns a deep copy (slice/map/bytes deep-copied).
//   - Build()           returns the constructed value.
{{- if .Directives}}
//
// Directives consumed:
{{- range .Directives}}
//   {{.}}
{{- end}}
{{- end}}
package {{.PackageName}}
{{- if .Imports}}

import (
{{- range .Imports}}
	{{if .Alias}}{{.Alias}} {{end}}"{{.Path}}"
{{- end}}
)
{{- end}}
{{end}}
