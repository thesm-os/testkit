{{- /*
The "builder" template renders the impl file (the builders
themselves). Composes:

  - "header"        — package + import block + file-level doc
  - "builder-type"  — one builder per requested struct (constructor,
                      per-field setters, Mutate, Clone, Build)

The companion test file is rendered separately by the
"builder-test" template against the same Data.
*/ -}}
{{define "builder"}}
{{template "header" .}}
{{- range $s := .Structs}}
{{template "builder-type" $s}}
{{- end}}
{{end}}
