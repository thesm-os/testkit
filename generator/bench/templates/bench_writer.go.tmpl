{{- /* Writer-shape body. `func(ctx?, V) error` — single-value
       writes. */ -}}
{{- define "bench-method-writer" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $V := $m.ShapeValType -}}
		wctx := bench.WriterContext[{{ $iface }}, {{ $V }}]{
			B: b,
			WriterBindings: bindings.WriterBindings[{{ $iface }}, {{ $V }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}, v {{ $V }}) error {
{{- if $m.HasContext }}
					return impl.{{ $m.Name }}(ctx, v)
{{- else }}
					return impl.{{ $m.Name }}(v)
{{- end }}
				},
			},
		}
		bench.WriterHotPath[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }})(wctx)
{{- if $m.EmitsConcurrent }}
		bench.WriterConcurrentThroughput[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, 4)(wctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.WriterAllocsWithin[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.AllocsBudget }})(wctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.WriterLatencyWithin[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.LatencyBudgetExpr }})(wctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(wctx)
		}
{{- end -}}
