{{- /* PoisonAccessor-shape body. `func() error` — the poisoned-state
       reporter idiom (e.g. Err() error on a Scanner-like type). */ -}}
{{- define "bench-method-poisonaccessor" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
		paxctx := bench.PoisonAccessorContext[{{ $iface }}]{
			B: b,
			PoisonAccessorBindings: bindings.PoisonAccessorBindings[{{ $iface }}]{
				Factory: seededFactory,
				Call: func(impl {{ $iface }}) error {
					return impl.{{ $m.Name }}()
				},
			},
		}
		bench.PoisonAccessorHotPath[{{ $iface }}]()(paxctx)
{{- if $m.EmitsConcurrent }}
		bench.PoisonAccessorConcurrentThroughput[{{ $iface }}](4)(paxctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.PoisonAccessorAllocsWithin[{{ $iface }}]({{ $m.AllocsBudget }})(paxctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.PoisonAccessorLatencyWithin[{{ $iface }}]({{ $m.LatencyBudgetExpr }})(paxctx)
{{- end }}
{{- if $m.HasPercentiles }}
		bench.PoisonAccessorLatencyPercentilesWithin[{{ $iface }}]({{ $m.PercentilesBudgetsExpr }})(paxctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(paxctx)
		}
{{- end -}}
