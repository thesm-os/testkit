{{- /* Pure-shape body. `func() V` — no ctx, no params, single
       return. Pure assertions are impl-independent (same input →
       same output) so the bench primitives just measure the call
       cost. */ -}}
{{- define "bench-method-pure" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $V := $m.ShapeValType -}}
		pctx := bench.PureContext[{{ $iface }}, {{ $V }}]{
			B: b,
			PureBindings: bindings.PureBindings[{{ $iface }}, {{ $V }}]{
				Factory: seededFactory,
				Call: func(impl {{ $iface }}) {{ $V }} {
					return impl.{{ $m.Name }}()
				},
			},
		}
		bench.PureHotPath[{{ $iface }}, {{ $V }}]()(pctx)
{{- if $m.EmitsConcurrent }}
		bench.PureConcurrentThroughput[{{ $iface }}, {{ $V }}](4)(pctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.PureAllocsWithin[{{ $iface }}, {{ $V }}]({{ $m.AllocsBudget }})(pctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.PureLatencyWithin[{{ $iface }}, {{ $V }}]({{ $m.LatencyBudgetExpr }})(pctx)
{{- end }}
{{- if $m.HasPercentiles }}
		bench.PureLatencyPercentilesWithin[{{ $iface }}, {{ $V }}]({{ $m.PercentilesBudgetsExpr }})(pctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(pctx)
		}
{{- end -}}
