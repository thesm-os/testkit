{{- /* StreamReader-shape body. Source method returns
       iter.Seq[V] or iter.Seq2[V, error]. The bench primitive
       expects iter.Seq2[V, error] — we adapt by either passing
       through (Seq2 + error) or wrapping each value with a nil
       error (Seq, or Seq2 with non-error second type).

       Extra non-ctx params on the source method are sample-driven:
       the closure captures sample literals at construction time, so
       every iteration calls the method with the same args. */ -}}
{{- define "bench-method-streamreader" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $V := $m.ShapeIterValType -}}
		srctx := bench.StreamContext[{{ $iface }}, {{ $V }}]{
			B:          b,
			BytesPerOp: cfg.bytesPerOp["{{ $m.Name }}"],
			StreamBindings: bindings.StreamBindings[{{ $iface }}, {{ $V }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}) iter.Seq2[{{ $V }}, error] {
{{- $callArgs := "" -}}
{{- if $m.HasContext -}}{{- $callArgs = "ctx" -}}{{- end -}}
{{- range $i := seq $m.NonCtxParamCount -}}
{{- if $callArgs -}}{{- $callArgs = printf "%s, %s" $callArgs ($m.SampleParamAt $i $tracker) -}}
{{- else -}}{{- $callArgs = $m.SampleParamAt $i $tracker -}}{{- end -}}
{{- end }}
{{- if and $m.Shape.Iter.IsSeq2 $m.Shape.Iter.Seq2Error }}
					return impl.{{ $m.Name }}({{ $callArgs }})
{{- else }}
					return func(yield func({{ $V }}, error) bool) {
						for v := range impl.{{ $m.Name }}({{ $callArgs }}) {
							if !yield(v, nil) {
								return
							}
						}
					}
{{- end }}
				},
			},
		}
		bench.StreamHotPath[{{ $iface }}, {{ $V }}]()(srctx)
{{- if $m.EmitsConcurrent }}
		bench.StreamConcurrentThroughput[{{ $iface }}, {{ $V }}](4)(srctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.StreamAllocsWithin[{{ $iface }}, {{ $V }}]({{ $m.AllocsBudget }})(srctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.StreamLatencyWithin[{{ $iface }}, {{ $V }}]({{ $m.LatencyBudgetExpr }})(srctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(srctx)
		}
{{- end -}}
