{{- /* BatchReader-shape body. `func(ctx?, ...K) ([]V, error)` —
       variadic-key fetch. The Call closure adapts the bench
       primitive's []K param to the impl's variadic call by spreading
       the slice. */ -}}
{{- define "bench-method-batchreader" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
		brctx := bench.BatchReaderContext[{{ $iface }}, {{ $K }}, {{ $V }}]{
			B:          b,
			BytesPerOp: cfg.bytesPerOp["{{ $m.Name }}"],
			BatchReaderBindings: bindings.BatchReaderBindings[{{ $iface }}, {{ $K }}, {{ $V }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}, keys []{{ $K }}) ([]{{ $V }}, error) {
{{- if $m.HasContext }}
					return impl.{{ $m.Name }}(ctx, keys...)
{{- else }}
					return impl.{{ $m.Name }}(keys...)
{{- end }}
				},
			},
		}
		sampleKeys := {{ $m.SampleParamAt 0 $tracker }}
		bench.BatchReaderHotPath[{{ $iface }}, {{ $K }}, {{ $V }}](sampleKeys)(brctx)
{{- if $m.EmitsConcurrent }}
		bench.BatchReaderConcurrentThroughput[{{ $iface }}, {{ $K }}, {{ $V }}](sampleKeys, 4)(brctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.BatchReaderAllocsWithin[{{ $iface }}, {{ $K }}, {{ $V }}](sampleKeys, {{ $m.AllocsBudget }})(brctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.BatchReaderLatencyWithin[{{ $iface }}, {{ $K }}, {{ $V }}](sampleKeys, {{ $m.LatencyBudgetExpr }})(brctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(brctx)
		}
{{- end -}}
