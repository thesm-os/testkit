{{- /* Deleter-shape body. `func(ctx?, K) error` — key-driven
       deletes. */ -}}
{{- define "bench-method-deleter" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
		dctx := bench.DeleterContext[{{ $iface }}, {{ $K }}]{
			B: b,
			DeleterBindings: bindings.DeleterBindings[{{ $iface }}, {{ $K }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}, key {{ $K }}) error {
{{- if $m.HasContext }}
					return impl.{{ $m.Name }}(ctx, key)
{{- else }}
					return impl.{{ $m.Name }}(key)
{{- end }}
				},
			},
		}
		bench.DeleterHotPath[{{ $iface }}, {{ $K }}]({{ $m.SampleParamAt 0 $tracker }})(dctx)
{{- if $m.EmitsConcurrent }}
		bench.DeleterConcurrentThroughput[{{ $iface }}, {{ $K }}]({{ $m.SampleParamAt 0 $tracker }}, 4)(dctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.DeleterAllocsWithin[{{ $iface }}, {{ $K }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.AllocsBudget }})(dctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.DeleterLatencyWithin[{{ $iface }}, {{ $K }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.LatencyBudgetExpr }})(dctx)
{{- end }}
{{- if $m.HasPercentiles }}
		bench.DeleterLatencyPercentilesWithin[{{ $iface }}, {{ $K }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.PercentilesBudgetsExpr }})(dctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(dctx)
		}
{{- end -}}
