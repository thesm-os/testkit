{{- /* MultiAggregator-shape body. `func(ctx?) (V1, V2, error)` —
       2-tuple aggregations like Stats(ctx) (count, total, error). */ -}}
{{- define "bench-method-multiaggregator" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $V1 := $m.ShapeValType -}}
{{- $V2 := $m.ShapeValType2 -}}
		mactx := bench.MultiAggregatorContext[{{ $iface }}, {{ $V1 }}, {{ $V2 }}]{
			B: b,
			MultiAggregatorBindings: bindings.MultiAggregatorBindings[{{ $iface }}, {{ $V1 }}, {{ $V2 }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}) ({{ $V1 }}, {{ $V2 }}, error) {
{{- if $m.HasContext }}
					return impl.{{ $m.Name }}(ctx)
{{- else }}
					return impl.{{ $m.Name }}()
{{- end }}
				},
			},
		}
		bench.MultiAggregatorHotPath[{{ $iface }}, {{ $V1 }}, {{ $V2 }}]()(mactx)
{{- if $m.EmitsConcurrent }}
		bench.MultiAggregatorConcurrentThroughput[{{ $iface }}, {{ $V1 }}, {{ $V2 }}](4)(mactx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.MultiAggregatorAllocsWithin[{{ $iface }}, {{ $V1 }}, {{ $V2 }}]({{ $m.AllocsBudget }})(mactx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.MultiAggregatorLatencyWithin[{{ $iface }}, {{ $V1 }}, {{ $V2 }}]({{ $m.LatencyBudgetExpr }})(mactx)
{{- end }}
{{- if $m.HasPercentiles }}
		bench.MultiAggregatorLatencyPercentilesWithin[{{ $iface }}, {{ $V1 }}, {{ $V2 }}]({{ $m.PercentilesBudgetsExpr }})(mactx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(mactx)
		}
{{- end -}}
