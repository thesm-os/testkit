{{- /* Method-helpers partial: emits one helper function per
       non-skipped method. The driver dispatches to these helpers in
       sequence; each helper opens a `b.Run("<Method>", ...)` namespace
       so every emitted sub-benchmark groups under it.

       The body inside the run-scope is shape-specific — dispatched
       through `bench-method` to one of the 21 per-shape body
       partials. Each partial emits the typed Context, the
       always-emit primitives (HotPath + ConcurrentThroughput), the
       opt-in budget gates (AllocsWithin / LatencyWithin) gated by
       the directive presence, and the plug-in dispatch loop. */ -}}
{{- define "method-helpers" -}}
{{- $iface := .IfaceName -}}
{{- $type := .QualifiedTypeForTest -}}
{{- $config := .ConfigTypeName -}}
{{- $tracker := .Spec.Tracker -}}
{{ range $m := .Methods }}{{ if not $m.IsIntegrationOnly }}

// {{ $m.HelperName }} measures {{ $iface }}.{{ $m.Name }}{{ $m.SignatureSummary $tracker }}.
//
//	Shape:      {{ $m.ShapeName }}
{{- $dirs := $m.DirectiveLines }}
{{- if $dirs }}
//	Directives: {{ range $i, $line := $dirs }}{{ if $i }}
//	            {{ end }}{{ $line }}{{ end }}
{{- end }}
{{- $samples := $m.SampleInputsRendered $tracker }}
{{- if $samples }}
//	Sample inputs: {{ range $i, $expr := $samples }}{{ if $i }}
//	               {{ end }}{{ $expr }}{{ end }}
//	Factory must seed these values for the hot-path measurement to
//	land on the success path; unseeded keys hit the not-found path
//	and report error-allocation costs instead of operation costs.
{{- end }}
//	Emits:      {{ $m.Name }}/hot-path
{{- if $m.EmitsConcurrent }}
//	            {{ $m.Name }}/concurrent-4
{{- end }}
{{- if $m.HasAllocsBudget }}
//	            {{ $m.Name }}/allocs-within-{{ $m.AllocsBudget }}     (//testkit:allocs gate)
{{- end }}
{{- if $m.HasLatencyBudget }}
//	            {{ $m.Name }}/latency-within-{{ $m.LatencyBudgetRaw }}     (//testkit:latency gate)
{{- end }}
//	            {{ $m.Name }}/<consumer-supplied>     (via cfg.{{ $m.OnFieldName }})
func {{ $m.HelperName }}(b *testing.B, factory func() {{ $type }}, cfg *{{ $config }}) {
	b.Helper()
	b.Run("{{ $m.Name }}", func(b *testing.B) {
		seededFactory := func() {{ $type }} {
			impl := factory()
			if cfg.prePopulate != nil {
				cfg.prePopulate(b.Context(), impl)
			}
			return impl
		}
{{- $args := (dict "M" $m "Iface" $type "Tracker" $tracker "Config" $config) -}}
{{- if eq $m.ShapeName "Reader" }}
{{ template "bench-method-reader" $args }}
{{- else if eq $m.ShapeName "ReaderNoError" }}
{{ template "bench-method-readernoerror" $args }}
{{- else if eq $m.ShapeName "ReaderWithBool" }}
{{ template "bench-method-readerwithbool" $args }}
{{- else if eq $m.ShapeName "Lookup" }}
{{ template "bench-method-lookup" $args }}
{{- else if eq $m.ShapeName "PointerReader" }}
{{ template "bench-method-pointerreader" $args }}
{{- else if eq $m.ShapeName "MultiReader" }}
{{ template "bench-method-multireader" $args }}
{{- else if eq $m.ShapeName "BatchReader" }}
{{ template "bench-method-batchreader" $args }}
{{- else if eq $m.ShapeName "Writer" }}
{{ template "bench-method-writer" $args }}
{{- else if eq $m.ShapeName "CompositeWriter" }}
{{ template "bench-method-compositewriter" $args }}
{{- else if eq $m.ShapeName "Mutator" }}
{{ template "bench-method-mutator" $args }}
{{- else if eq $m.ShapeName "Deleter" }}
{{ template "bench-method-deleter" $args }}
{{- else if eq $m.ShapeName "MultiArgWriter" }}
{{- if eq $m.NonCtxParamCount 3 }}
{{ template "bench-method-multiargwriter" $args }}
{{- else }}
{{ template "bench-method-unknown" $args }}
{{- end }}
{{- else if eq $m.ShapeName "Aggregator" }}
{{ template "bench-method-aggregator" $args }}
{{- else if eq $m.ShapeName "MultiAggregator" }}
{{ template "bench-method-multiaggregator" $args }}
{{- else if eq $m.ShapeName "StreamReader" }}
{{ template "bench-method-streamreader" $args }}
{{- else if eq $m.ShapeName "StreamConsumer" }}
{{ template "bench-method-streamconsumer" $args }}
{{- else if eq $m.ShapeName "Lifecycle" }}
{{ template "bench-method-lifecycle" $args }}
{{- else if eq $m.ShapeName "VoidLifecycle" }}
{{ template "bench-method-voidlifecycle" $args }}
{{- else if eq $m.ShapeName "Pure" }}
{{ template "bench-method-pure" $args }}
{{- else if eq $m.ShapeName "Predicate" }}
{{ template "bench-method-predicate" $args }}
{{- else if eq $m.ShapeName "PoisonAccessor" }}
{{ template "bench-method-poisonaccessor" $args }}
{{- else }}
{{ template "bench-method-unknown" $args }}
{{- end }}
	})
}
{{ end }}{{ end -}}
{{- end -}}
