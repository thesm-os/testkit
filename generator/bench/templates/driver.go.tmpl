{{- /* Driver partial: emits the consumer-facing entry point —
       Benchmark<Iface>Contract(b, factory, ...Option). The driver
       resolves options once, then dispatches to one helper per
       non-skipped method. Custom sub-benchmarks fold in last so
       consumers can reference the same factory.

       Methods marked `//testkit:integration-only` are skipped
       entirely — the helper isn't even emitted. */ -}}
{{- define "driver" -}}
{{- $iface := .IfaceName -}}
{{- $type := .QualifiedTypeForTest -}}
{{- $driver := .DriverName -}}
{{- $option := .OptionTypeName -}}
{{- $newConfig := .NewConfigFunc -}}

// {{ $driver }} measures the performance characteristics of any
// implementation of [{{ $type }}] produced by `factory`. Each
// per-method helper constructs a fresh impl via `factory()` so
// per-benchmark state isolation is the caller's responsibility.
//
// Variadic `opts` carry consumer-supplied extensions:
//   - {{ .PrePopulateName }}    — one-shot seeder per freshly factory'd impl
//   - {{ .CustomName }}         — free-form sub-benchmarks
//   - {{ $iface }}BenchOn<Method>     — typed plug-in bench primitives
func {{ $driver }}(b *testing.B, factory func() {{ $type }}, opts ...{{ $option }}) {
	b.Helper()
	cfg := {{ $newConfig }}(opts...)
{{ range $m := .Methods -}}
{{- if not $m.IsIntegrationOnly }}
	{{ $m.HelperName }}(b, factory, &cfg)
{{- end }}
{{ end }}
	for _, custom := range cfg.custom {
		b.Run(custom.name, func(b *testing.B) {
			custom.fn(b, factory())
		})
	}
}
{{- end -}}
