{{- /* StreamConsumer-shape body. `func(ctx, S) (V, error)` where S
       is interface-typed. The bench primitive needs a
       `streamFactory func() S` to produce fresh stream values per
       iteration; the generator can synthesize one only for
       io.Reader-shaped S (default: `bytes.NewReader([]byte("test-data"))`).
       For other interface types, the always-emit primitives and
       budget gates are omitted — the consumer supplies them via the
       plug-in `<Iface>BenchOn<Method>(...)` slot with a hand-written
       streamFactory. */ -}}
{{- define "bench-method-streamconsumer" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $S := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
		scctx := bench.StreamConsumerContext[{{ $iface }}, {{ $S }}, {{ $V }}]{
			B: b,
{{- if eq $S "io.Reader" }}
			// Auto-derive BytesPerOp from the synthesized stream sample
			// (bytes.NewReader([]byte("test-data")), 9 bytes) so MB/s
			// reports without per-method configuration. A consumer-supplied
			// {{ $iface }}BenchSetBytes overrides.
			BytesPerOp: cfg.bytesPerOpOr("{{ $m.Name }}", 9),
{{- else }}
			BytesPerOp: cfg.bytesPerOp["{{ $m.Name }}"],
{{- end }}
			StreamConsumerBindings: bindings.StreamConsumerBindings[{{ $iface }}, {{ $S }}, {{ $V }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}, s {{ $S }}) ({{ $V }}, error) {
					return impl.{{ $m.Name }}(ctx, s)
				},
			},
		}
{{- if eq $S "io.Reader" }}
		streamFactory := func() io.Reader { return bytes.NewReader([]byte("test-data")) }
		bench.StreamConsumerHotPath[{{ $iface }}, {{ $S }}, {{ $V }}](streamFactory)(scctx)
{{- if $m.EmitsConcurrent }}
		bench.StreamConsumerConcurrentThroughput[{{ $iface }}, {{ $S }}, {{ $V }}](streamFactory, 4)(scctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.StreamConsumerAllocsWithin[{{ $iface }}, {{ $S }}, {{ $V }}](streamFactory, {{ $m.AllocsBudget }})(scctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.StreamConsumerLatencyWithin[{{ $iface }}, {{ $S }}, {{ $V }}](streamFactory, {{ $m.LatencyBudgetExpr }})(scctx)
{{- end }}
{{- if $m.HasPercentiles }}
		bench.StreamConsumerLatencyPercentilesWithin[{{ $iface }}, {{ $S }}, {{ $V }}](streamFactory, {{ $m.PercentilesBudgetsExpr }})(scctx)
{{- end }}
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(scctx)
		}
{{- end -}}
