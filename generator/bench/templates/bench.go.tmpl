{{- /*
       Bench root template — composes the per-concern partials. The
       output is the consumer-facing benchmark driver: a function
       Benchmark<Iface>Contract(b, factory, ...Option) plus the
       per-method helpers and option scaffolding.

       Output structure:
         1. package-doc       — // Package X_test ... block
         2. header            — package + imports
         3. driver            — Benchmark<Iface>Contract scaffold
         4. options           — option type, prePopulate, custom,
                                 per-method On<Method> options, config
         5. method-helpers    — bench<Iface><Method>(b, factory, cfg)
                                 per non-skipped method, dispatched
                                 through bench-method to the right
                                 per-shape body partial
*/ -}}
{{- define "bench" -}}
{{ template "package-doc" . -}}
{{ template "header" . }}
{{ template "driver" . }}
{{ template "options" . }}
{{ template "method-helpers" . }}
{{- end -}}
