{{- /* Mutator-shape body. `func(ctx?, V)` — no-return mutators
       (Set, Push, Add, etc.). */ -}}
{{- define "bench-method-mutator" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $V := $m.ShapeValType -}}
		mctx := bench.MutatorContext[{{ $iface }}, {{ $V }}]{
			B: b,
			MutatorBindings: bindings.MutatorBindings[{{ $iface }}, {{ $V }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}, v {{ $V }}) {
{{- if $m.HasContext }}
					impl.{{ $m.Name }}(ctx, v)
{{- else }}
					impl.{{ $m.Name }}(v)
{{- end }}
				},
			},
		}
		bench.MutatorHotPath[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }})(mctx)
{{- if $m.EmitsConcurrent }}
		bench.MutatorConcurrentThroughput[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, 4)(mctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.MutatorAllocsWithin[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.AllocsBudget }})(mctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.MutatorLatencyWithin[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.LatencyBudgetExpr }})(mctx)
{{- end }}
{{- if $m.HasPercentiles }}
		bench.MutatorLatencyPercentilesWithin[{{ $iface }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.PercentilesBudgetsExpr }})(mctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(mctx)
		}
{{- end -}}
