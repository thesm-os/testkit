{{- /* ReaderWithBool-shape body. `func(ctx?, K) (V, bool)` — the
       comma-ok idiom for missing-key signaling without an error. */ -}}
{{- define "bench-method-readerwithbool" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
		rctx := bench.ReaderWithBoolContext[{{ $iface }}, {{ $K }}, {{ $V }}]{
			B: b,
			ReaderWithBoolBindings: bindings.ReaderWithBoolBindings[{{ $iface }}, {{ $K }}, {{ $V }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}, key {{ $K }}) ({{ $V }}, bool) {
{{- if $m.HasContext }}
					return impl.{{ $m.Name }}(ctx, key)
{{- else }}
					return impl.{{ $m.Name }}(key)
{{- end }}
				},
			},
		}
		bench.ReaderWithBoolHotPath[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }})(rctx)
{{- if $m.EmitsConcurrent }}
		bench.ReaderWithBoolConcurrentThroughput[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, 4)(rctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.ReaderWithBoolAllocsWithin[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.AllocsBudget }})(rctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.ReaderWithBoolLatencyWithin[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.LatencyBudgetExpr }})(rctx)
{{- end }}
{{- if $m.HasPercentiles }}
		bench.ReaderWithBoolLatencyPercentilesWithin[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.PercentilesBudgetsExpr }})(rctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(rctx)
		}
{{- end -}}
