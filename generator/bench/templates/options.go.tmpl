{{- /* Options partial: emits the consumer-facing option type plus
       the per-method On<Method> options, the prePopulate option,
       the custom escape-hatch, and the unexported config struct
       the driver folds options into.

       The On<Method> option's primitive type comes from
       MethodView.OnMethodBenchType — typed bench.<Shape>[...] for
       known shapes, raw func(*testing.B, T) for Unknown shapes
       and MultiArgWriter with arity ≠ 3.

       Primitive emission decisions (always-emit hot-path, default-
       skip ConcurrentThroughput for Lifecycle/VoidLifecycle/Unknown,
       opt-in budget gates) are made at generation time — the
       templates emit only the primitive calls that apply, so the
       generated code stays free of runtime skip-checks. Per-method
       overrides live in source as `//testkit:bench-concurrent` /
       `//testkit:bench-no-concurrent` directives. */ -}}
{{- define "options" -}}
{{- $iface := .IfaceName -}}
{{- $type := .QualifiedTypeForTest -}}
{{- $option := .OptionTypeName -}}
{{- $config := .ConfigTypeName -}}
{{- $customSub := .CustomSubTypeName -}}
{{- $newConfig := .NewConfigFunc -}}
{{- $tracker := .Spec.Tracker -}}

// {{ $option }} configures [{{ .DriverName }}].
type {{ $option }} func(*{{ $config }})

// {{ .PrePopulateName }} runs once against every freshly-factory'd
// impl before per-method benchmarks observe it. Use it for cache
// warm-ups, fixture loading, or any setup the contract treats as
// out-of-band of the per-method primitives.
func {{ .PrePopulateName }}(fn func(ctx context.Context, impl {{ $type }})) {{ $option }} {
	return func(c *{{ $config }}) { c.prePopulate = fn }
}

// {{ .CustomName }} adds a free-form sub-benchmark for measurements
// outside the shape vocabulary — multi-method scenarios, end-to-end
// flows, scenarios where the shape primitives are too granular.
func {{ .CustomName }}(name string, fn func(*testing.B, {{ $type }})) {{ $option }} {
	return func(c *{{ $config }}) {
		c.custom = append(c.custom, {{ $customSub }}{name: name, fn: fn})
	}
}

// {{ $iface }}BenchSetBytes records bytes processed per iteration
// for a Stream / BatchReader / StreamConsumer method. When set, the
// matching primitive calls b.SetBytes(n) so `go test -bench` reports
// MB/s alongside ns/op. Methods of other shapes ignore the value.
func {{ $iface }}BenchSetBytes(method string, n int64) {{ $option }} {
	return func(c *{{ $config }}) {
		if c.bytesPerOp == nil {
			c.bytesPerOp = map[string]int64{}
		}
		c.bytesPerOp[method] = n
	}
}
{{ range $m := .Methods }}{{ if not $m.IsIntegrationOnly }}
// {{ $iface }}BenchOn{{ $m.Name }} adds plug-in bench primitives for
// the {{ $m.Name }} method. Supplied primitives run after the
// always-emitted hot-path and any opt-in gates / measurements.
func {{ $iface }}BenchOn{{ $m.Name }}(primitives ...{{ $m.OnMethodBenchType $type $tracker }}) {{ $option }} {
	return func(c *{{ $config }}) {
		c.{{ $m.OnFieldName }} = append(c.{{ $m.OnFieldName }}, primitives...)
	}
}
{{ end }}{{ end }}

type {{ $customSub }} struct {
	name string
	fn   func(*testing.B, {{ $type }})
}

type {{ $config }} struct {
	prePopulate func(context.Context, {{ $type }})
	custom      []{{ $customSub }}
	bytesPerOp  map[string]int64
{{- range $m := .Methods }}{{ if not $m.IsIntegrationOnly }}
	{{ $m.OnFieldName }} []{{ $m.OnMethodBenchType $type $tracker }}
{{- end }}{{ end }}
}

func {{ $newConfig }}(opts ...{{ $option }}) {{ $config }} {
	var cfg {{ $config }}
	for _, opt := range opts {
		opt(&cfg)
	}
	return cfg
}

// bytesPerOpOr returns the consumer-supplied BytesPerOp for the
// named method, or fallback when no value was set via
// {{ $iface }}BenchSetBytes. The fallback is generator-derived
// (e.g. len("test-data") for io.Reader-shaped StreamConsumer
// methods) so MB/s reporting works out of the box without
// per-method configuration.
func (cfg *{{ $config }}) bytesPerOpOr(method string, fallback int64) int64 {
	if v, ok := cfg.bytesPerOp[method]; ok {
		return v
	}
	return fallback
}
{{- end -}}
