{{- /* PointerReader-shape body. `func(ctx?, K) *V` — the
       nil-on-miss idiom. */ -}}
{{- define "bench-method-pointerreader" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
		pctx := bench.PointerReaderContext[{{ $iface }}, {{ $K }}, {{ $V }}]{
			B: b,
			PointerReaderBindings: bindings.PointerReaderBindings[{{ $iface }}, {{ $K }}, {{ $V }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}, key {{ $K }}) *{{ $V }} {
{{- if $m.HasContext }}
					return impl.{{ $m.Name }}(ctx, key)
{{- else }}
					return impl.{{ $m.Name }}(key)
{{- end }}
				},
			},
		}
		bench.PointerReaderHotPath[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }})(pctx)
{{- if $m.EmitsConcurrent }}
		bench.PointerReaderConcurrentThroughput[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, 4)(pctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.PointerReaderAllocsWithin[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.AllocsBudget }})(pctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.PointerReaderLatencyWithin[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.LatencyBudgetExpr }})(pctx)
{{- end }}
{{- if $m.HasPercentiles }}
		bench.PointerReaderLatencyPercentilesWithin[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.PercentilesBudgetsExpr }})(pctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(pctx)
		}
{{- end -}}
