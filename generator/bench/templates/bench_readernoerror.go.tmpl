{{- /* ReaderNoError-shape body. ReaderNoError is `func(ctx?, K) V` —
       the infallible-lookup idiom (caches, gauges, stable mappings).
       Same primitive surface as Reader, no error in the Call. */ -}}
{{- define "bench-method-readernoerror" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
		rctx := bench.ReaderNoErrorContext[{{ $iface }}, {{ $K }}, {{ $V }}]{
			B: b,
			ReaderNoErrorBindings: bindings.ReaderNoErrorBindings[{{ $iface }}, {{ $K }}, {{ $V }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}, key {{ $K }}) {{ $V }} {
{{- if $m.HasContext }}
					return impl.{{ $m.Name }}(ctx, key)
{{- else }}
					return impl.{{ $m.Name }}(key)
{{- end }}
				},
			},
		}
		bench.ReaderNoErrorHotPath[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }})(rctx)
{{- if $m.EmitsConcurrent }}
		bench.ReaderNoErrorConcurrentThroughput[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, 4)(rctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.ReaderNoErrorAllocsWithin[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.AllocsBudget }})(rctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.ReaderNoErrorLatencyWithin[{{ $iface }}, {{ $K }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.LatencyBudgetExpr }})(rctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(rctx)
		}
{{- end -}}
