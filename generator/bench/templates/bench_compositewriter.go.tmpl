{{- /* CompositeWriter-shape body. `func(ctx?, K1, V) error` —
       namespaced stores, tagged caches, two-key indexes. */ -}}
{{- define "bench-method-compositewriter" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $tracker := .Tracker -}}
{{- $K1 := $m.ShapeKeyType -}}
{{- $V := $m.ShapeValType -}}
		cwctx := bench.CompositeWriterContext[{{ $iface }}, {{ $K1 }}, {{ $V }}]{
			B: b,
			CompositeWriterBindings: bindings.CompositeWriterBindings[{{ $iface }}, {{ $K1 }}, {{ $V }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}, ns {{ $K1 }}, v {{ $V }}) error {
{{- if $m.HasContext }}
					return impl.{{ $m.Name }}(ctx, ns, v)
{{- else }}
					return impl.{{ $m.Name }}(ns, v)
{{- end }}
				},
			},
		}
		bench.CompositeWriterHotPath[{{ $iface }}, {{ $K1 }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.SampleParamAt 1 $tracker }})(cwctx)
{{- if $m.EmitsConcurrent }}
		bench.CompositeWriterConcurrentThroughput[{{ $iface }}, {{ $K1 }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.SampleParamAt 1 $tracker }}, 4)(cwctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.CompositeWriterAllocsWithin[{{ $iface }}, {{ $K1 }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.SampleParamAt 1 $tracker }}, {{ $m.AllocsBudget }})(cwctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.CompositeWriterLatencyWithin[{{ $iface }}, {{ $K1 }}, {{ $V }}]({{ $m.SampleParamAt 0 $tracker }}, {{ $m.SampleParamAt 1 $tracker }}, {{ $m.LatencyBudgetExpr }})(cwctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(cwctx)
		}
{{- end -}}
