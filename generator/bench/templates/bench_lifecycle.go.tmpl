{{- /* Lifecycle-shape body. `func(ctx?) error` — Open/Close/Reset
       lifecycle hooks. */ -}}
{{- define "bench-method-lifecycle" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
		lctx := bench.LifecycleContext[{{ $iface }}]{
			B: b,
			LifecycleBindings: bindings.LifecycleBindings[{{ $iface }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}) error {
{{- if $m.HasContext }}
					return impl.{{ $m.Name }}(ctx)
{{- else }}
					return impl.{{ $m.Name }}()
{{- end }}
				},
			},
		}
		bench.LifecycleHotPath[{{ $iface }}]()(lctx)
{{- if $m.EmitsConcurrent }}
		bench.LifecycleConcurrentThroughput[{{ $iface }}](4)(lctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.LifecycleAllocsWithin[{{ $iface }}]({{ $m.AllocsBudget }})(lctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.LifecycleLatencyWithin[{{ $iface }}]({{ $m.LatencyBudgetExpr }})(lctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(lctx)
		}
{{- end -}}
