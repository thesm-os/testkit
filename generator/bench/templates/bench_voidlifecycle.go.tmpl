{{- /* VoidLifecycle-shape body. `func()` or `func(ctx)` — Reset,
       parameterless lifecycle hooks. */ -}}
{{- define "bench-method-voidlifecycle" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
		vlctx := bench.VoidLifecycleContext[{{ $iface }}]{
			B: b,
			VoidLifecycleBindings: bindings.VoidLifecycleBindings[{{ $iface }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}) {
{{- if $m.HasContext }}
					impl.{{ $m.Name }}(ctx)
{{- else }}
					impl.{{ $m.Name }}()
{{- end }}
				},
			},
		}
		bench.VoidLifecycleHotPath[{{ $iface }}]()(vlctx)
{{- if $m.EmitsConcurrent }}
		bench.VoidLifecycleConcurrentThroughput[{{ $iface }}](4)(vlctx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.VoidLifecycleAllocsWithin[{{ $iface }}]({{ $m.AllocsBudget }})(vlctx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.VoidLifecycleLatencyWithin[{{ $iface }}]({{ $m.LatencyBudgetExpr }})(vlctx)
{{- end }}
{{- if $m.HasPercentiles }}
		bench.VoidLifecycleLatencyPercentilesWithin[{{ $iface }}]({{ $m.PercentilesBudgetsExpr }})(vlctx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(vlctx)
		}
{{- end -}}
