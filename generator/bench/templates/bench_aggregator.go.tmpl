{{- /* Aggregator-shape body. `func(ctx?) (R, error)` — single-result
       aggregate (Count, Sum, etc.). */ -}}
{{- define "bench-method-aggregator" -}}
{{- $m := .M -}}
{{- $iface := .Iface -}}
{{- $V := $m.ShapeValType -}}
		actx := bench.AggregatorContext[{{ $iface }}, {{ $V }}]{
			B: b,
			AggregatorBindings: bindings.AggregatorBindings[{{ $iface }}, {{ $V }}]{
				Factory: seededFactory,
				Call: func(ctx context.Context, impl {{ $iface }}) ({{ $V }}, error) {
{{- if $m.HasContext }}
					return impl.{{ $m.Name }}(ctx)
{{- else }}
					return impl.{{ $m.Name }}()
{{- end }}
				},
			},
		}
		bench.AggregatorHotPath[{{ $iface }}, {{ $V }}]()(actx)
{{- if $m.EmitsConcurrent }}
		bench.AggregatorConcurrentThroughput[{{ $iface }}, {{ $V }}](4)(actx)
{{- end }}
{{- if $m.HasAllocsBudget }}
		bench.AggregatorAllocsWithin[{{ $iface }}, {{ $V }}]({{ $m.AllocsBudget }})(actx)
{{- end }}
{{- if $m.HasLatencyBudget }}
		bench.AggregatorLatencyWithin[{{ $iface }}, {{ $V }}]({{ $m.LatencyBudgetExpr }})(actx)
{{- end }}
{{- if $m.HasPercentiles }}
		bench.AggregatorLatencyPercentilesWithin[{{ $iface }}, {{ $V }}]({{ $m.PercentilesBudgetsExpr }})(actx)
{{- end }}
		for _, p := range cfg.{{ $m.OnFieldName }} {
			p(actx)
		}
{{- end -}}
