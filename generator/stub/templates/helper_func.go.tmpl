{{- /* Func() helper partial: emitted per non-skip method. Sets a
       function override that takes precedence over the fallback
       record but loses to fault injection. */ -}}
{{- define "helper-func" -}}
{{- $tracker := .Spec.Tracker -}}
{{ range $m := .Methods }}{{ if not $m.Skip }}
// Func sets a function override for {{ $m.Name }}.
func (s *{{ $m.QualStubType }}) Func(fn {{ $m.FuncType $tracker }}) *{{ $m.QualStubType }} {
	s.fn = fn
	return s
}
{{ end }}{{ end -}}
{{- end -}}
