{{- /* Strict-mode fatal subtest per non-skip method. Verifies
       that an unconfigured method (no Func / Returns / Faults)
       fatals the test under <Stub>Strict() — the safety net for
       tests that want any unexpected dispatch to surface as a
       failure. Uses [testkit.FailableTB] to capture the fatal
       without aborting the surrounding test. */ -}}
{{- define "test-method-strict" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- range $m := .Methods }}{{ if not $m.Skip }}
	t.Run("Strict mode fails on unconfigured {{ $m.Name }}", func(t *testing.T) {
		t.Parallel()
		f := testkit.NewFailableTB()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(f, {{ $gq }}{{ $stub }}Strict{{ $.TestTypeArgs }}())
{{- if $m.HasResults }}
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- else }}
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- end }}
		testkit.True(t, f.Failed(), "{{ $m.Name }}: unconfigured strict-mode call must fatal")
	})
{{ end }}{{ end -}}
{{- end -}}
