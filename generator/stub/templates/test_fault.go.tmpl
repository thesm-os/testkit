{{- /* Fault-injection subtests per error-returning method:
       - Faults() returns the configured error
       - Fault path beats Func() in the priority order (Func must
         not run)
       - Counted argument N=2 leaves call 1 uninjected; call 2
         fires the fault.
       Skipped for non-error returners — Faults() is not generated
       when the method has no error result. */ -}}
{{- define "test-method-fault" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- range $m := .Methods }}{{ if and (not $m.Skip) $m.ReturnsError }}
	t.Run("{{ $m.Name }}/fault injection fires", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
		s.On{{ $m.Name }}.Faults(errTest, 1)
		{{ $m.ErrCaptureLHS }} := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		testkit.ErrorIs(t, err, errTest, "{{ $m.Name }}: must return injected fault")
	})

	t.Run("{{ $m.Name }}/Faults wins over Func", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
		s.On{{ $m.Name }}.Faults(errTest, 1)
		s.On{{ $m.Name }}.Func(func({{ $.Spec.SubstituteTypeParams ($m.ParamList $tracker) }}){{ if $m.HasResults }} {{ $.Spec.SubstituteTypeParams ($m.ResultList $tracker) }}{{ end }} {
			t.Fatalf("{{ $m.Name }}: Func must not run when Faults is configured")
{{- if $m.HasResults }}
			return {{ $.Spec.SubstituteTypeParams ($m.ZeroResults $tracker) }}
{{- end }}
		})
		{{ $m.ErrCaptureLHS }} := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		testkit.ErrorIs(t, err, errTest, "{{ $m.Name }}: Faults must win over Func")
	})

	t.Run("{{ $m.Name }}/counted fault fires on Nth call", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
		s.On{{ $m.Name }}.Faults(errTest, 2)
		{{ $m.ErrCaptureLHS }} := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		testkit.NoError(t, err, "{{ $m.Name }}: call 1 must precede the fault")
		{{ $m.ErrCaptureLHS }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		testkit.ErrorIs(t, err, errTest, "{{ $m.Name }}: call 2 must fire the counted fault")
	})
{{ end }}{{ end -}}
{{- end -}}
