{{- /* Per-method With<Type><Method> option partial: emits one
       constructor option per non-skip method that wires a
       function override at construction time (eliminates the
       three-line Func() ceremony at the call site). */ -}}
{{- define "option-with-method" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $type := .Spec.Interface.Name -}}
{{- $tpDecl := .Spec.TypeParamDecl -}}
{{- $tpArgs := .Spec.TypeParamArgs -}}
{{ range $m := .Methods }}{{ if not $m.Skip }}
// With{{ $type }}{{ $m.Name }} sets a function override at construction time.
func With{{ $type }}{{ $m.Name }}{{ $tpDecl }}(fn {{ $m.FuncType $tracker }}) {{ $.StubName }}Option{{ $tpArgs }} {
	return func(s *{{ $.StubName }}{{ $tpArgs }}) { s.On{{ $m.Name }}.Func(fn) }
}
{{ end }}{{ end -}}
{{- end -}}
