{{- /* RetrySchedule helper partial: emitted per method that carries
       //testkit:retry-succeeds-on-attempt N. Configures a retry-
       succeeds-on-attempt fault: the first N-1 calls return err;
       call N onward succeed. */ -}}
{{- define "helper-retry" -}}
{{ range $m := .Methods }}{{ if and (not $m.Skip) $m.RetryN }}
// RetrySchedule configures a retry-succeeds-on-attempt fault: the
// first {{ $m.RetryN }}-1 calls return err; call {{ $m.RetryN }} and onward succeed.
func (s *{{ $m.QualStubType }}) RetrySchedule(err error) *{{ $m.QualStubType }} {
	s.SetFault(testkit.NewRetryFault[{{ $m.QualCallType }}](err, {{ $m.RetryN }}))
	return s
}
{{ end }}{{ end -}}
{{- end -}}
