{{- /* ResetCalls partial: clears recordings + fault counters +
       call-count expectations on every per-method stub. Func /
       Returns / Faults configuration is preserved (consumers
       opt into clearing those by reconstructing the stub). */ -}}
{{- define "reset-calls" -}}
{{- $tpArgs := .Spec.TypeParamArgs -}}
// ResetCalls clears recorded calls, fault counters, and call-count
// expectations. Func, Returns, and Faults configuration is preserved.
func (s *{{ .StubName }}{{ $tpArgs }}) ResetCalls() {
{{- range $m := .Methods }}{{ if not $m.Skip }}
	s.On{{ $m.Name }}.Reset()
{{- end }}{{ end }}
{{- if .HasOrderConstraint }}
	s.order.Reset()
{{- end }}
}
{{- end -}}
