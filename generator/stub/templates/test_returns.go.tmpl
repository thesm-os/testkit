{{- /* Returns subtest per HasResults non-skip method. Verifies
       the fallback path: Returns(sample...) sets the per-method
       stub's fallback record; the next dispatch reads the record,
       stamps the values onto the recorded Call, and surfaces them
       to the caller. The captured result variables must equal the
       same sample literals fed into Returns. Skipped for void
       methods (Returns is not generated) and for iterator methods
       (the function-typed return panics go-cmp). */ -}}
{{- define "test-method-returns" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- range $m := .Methods }}
{{- $iter := $m.IterReturn $tracker -}}
{{- if and (not $m.Skip) $m.HasResults (not $iter.IsSeq) (not $iter.IsSeq2) }}
	t.Run("{{ $m.Name }}/Returns fixed value", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
		s.On{{ $m.Name }}.Returns({{ $.Spec.SubstituteTypeParams ($m.SampleResults $tracker) }})
{{- if $m.HasAssertableNonErrorResults }}
		{{ $.Spec.SubstituteTypeParams $m.ResultNames }} := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- if $m.ReturnsError }}
		testkit.NoError(t, err, "{{ $m.Name }}: Returns must surface nil error")
{{- end }}
		{{ $.Spec.SubstituteTypeParams ($m.SampleResultAsserts $tracker (printf "%s Returns" $m.Name)) }}
{{- else if $m.ReturnsError }}
		{{ $m.ErrCaptureLHS }} := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		testkit.NoError(t, err, "{{ $m.Name }}: Returns must surface nil error")
{{- else }}
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- end }}
	})
{{ end }}{{ end -}}
{{- end -}}
