{{- /* Interface-level BenchMode-disables-recording subtest. The
       BenchMode option flips Recorder.bench on every per-method
       stub so Record returns a no-op: dispatch still runs (Func /
       Returns / Faults all fire), but no Call entry is appended to
       the Recorder, no OnRecord hook fires, no timestamp is taken.
       The subtest invokes a representative method under BenchMode
       and asserts CallCount() stays at zero — the recording-
       disabled invariant.

       The companion Test<Stub>BenchModeZeroAlloc top-level test
       gates allocation; this subtest gates the behavioral
       invariant. They cover orthogonal contracts. */ -}}
{{- define "test-iface-benchmode" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- with $m := .FirstNonSkipMethod }}
	t.Run("BenchMode disables recording", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t, {{ $gq }}{{ $stub }}BenchMode{{ $.TestTypeArgs }}())
{{- if $m.HasResults }}
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- else }}
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- end }}
		testkit.Equal(t, s.On{{ $m.Name }}.CallCount(), 0, "{{ $m.Name }}: BenchMode must skip recording")
	})
{{- end }}
{{- end -}}
