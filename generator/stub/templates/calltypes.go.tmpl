{{- /* Call types partial: emits a <Method>Call recording struct
       per non-skipped method. Fields = params (stamped before
       dispatch) + comparable non-error results + Err (both stamped
       after the dispatch path completes).

       Non-comparable result types (function values such as
       iter.Seq, channels) are intentionally OMITTED. Recording a
       function pointer adds no observability — cmp.Diff panics on
       it, the iterator is exhausted by consumption (so a captured
       pointer doesn't replay), and pinning the closure prevents
       GC. Consumers needing to observe yielded items register an
       OnRecord hook or use the directive-driven Yields helper. */ -}}
{{- define "calltypes" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $iface := .Spec.QualifiedType -}}
{{- $tpDecl := .Spec.TypeParamDecl -}}
{{ range $m := .Methods }}{{ if not $m.Skip }}
// {{ $m.CallType }} records one invocation of {{ $iface }}.{{ $m.Name }}.
// Param fields are stamped at dispatch start (before fault checks);
// result fields are stamped after whichever dispatch path fires
// (fault, Func, fallback, or unexpected).
type {{ $m.CallType }}{{ $tpDecl }} struct {
{{- range $f := $m.CallStructFields $tracker }}
{{- if and $f.IsResult $f.NotComparable }}
{{- /* Omit: recording a function/channel value is dead weight. */ -}}
{{- else if $f.IsError }}
	{{ $f.Name }} {{ $f.TypeStr }} // stamped after dispatch (fault/Func/fallback)
{{- else if $f.IsResult }}
	{{ $f.Name }} {{ $f.TypeStr }} // stamped after dispatch
{{- else }}
	{{ $f.Name }} {{ $f.TypeStr }} // captured at dispatch start
{{- end }}
{{- end }}
}
{{ end }}{{ end -}}
{{- end -}}
