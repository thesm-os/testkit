{{- /* Iterator-yield subtests per iter.Seq / iter.Seq2 method:
       - Yields(items...) routes the configured items through the
         iterator returned by the method.
       - Iterating the same iterator with `break` after one item
         halts iteration (Yields' inner closure honors the
         yield-returns-false contract).
       - YieldsError (Seq2 with error second slot) surfaces the
         configured trailing error after the items. */ -}}
{{- define "test-method-yields" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- range $m := .Methods }}{{ if not $m.Skip }}
{{- $iter := $m.IterReturn $tracker -}}
{{- if or $iter.IsSeq $iter.Seq2Error }}
	t.Run("{{ $m.Name }}/Yields returns configured items", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
		var zero {{ $.Spec.SubstituteTypeParams $iter.ValType }}
		s.On{{ $m.Name }}.Yields(zero, zero)
		seq := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		var got []{{ $.Spec.SubstituteTypeParams $iter.ValType }}
{{- if $iter.Seq2Error }}
		for v, err := range seq {
			testkit.NoError(t, err, "{{ $m.Name }}: Yields must not surface a terminal error")
			got = append(got, v)
		}
{{- else }}
		for v := range seq {
			got = append(got, v)
		}
{{- end }}
		testkit.Len(t, got, 2, "{{ $m.Name }}: Yields must surface every item")
	})

	t.Run("{{ $m.Name }}/Yields supports early break", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
		var zero {{ $.Spec.SubstituteTypeParams $iter.ValType }}
		s.On{{ $m.Name }}.Yields(zero, zero, zero)
		seq := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		count := 0
{{- if $iter.Seq2Error }}
		for _, _ = range seq {
			count++
			break
		}
{{- else }}
		for range seq {
			count++
			break
		}
{{- end }}
		testkit.Equal(t, count, 1, "{{ $m.Name }}: early break must halt iteration")
	})
{{- end }}
{{- if $iter.Seq2Error }}

	t.Run("{{ $m.Name }}/YieldsError yields items then error", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
		var zero {{ $.Spec.SubstituteTypeParams $iter.ValType }}
		s.On{{ $m.Name }}.YieldsError([]{{ $.Spec.SubstituteTypeParams $iter.ValType }}{zero, zero}, errTest)
		seq := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		var got []{{ $.Spec.SubstituteTypeParams $iter.ValType }}
		var lastErr error
		for v, err := range seq {
			if err != nil {
				lastErr = err
				break
			}
			got = append(got, v)
		}
		testkit.Len(t, got, 2, "{{ $m.Name }}: YieldsError must surface every item before the error")
		testkit.ErrorIs(t, lastErr, errTest, "{{ $m.Name }}: YieldsError must surface the terminal error")
	})

	t.Run("{{ $m.Name }}/YieldsError supports early break", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
		var zero {{ $.Spec.SubstituteTypeParams $iter.ValType }}
		s.On{{ $m.Name }}.YieldsError([]{{ $.Spec.SubstituteTypeParams $iter.ValType }}{zero, zero, zero}, errTest)
		seq := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		count := 0
		for _, _ = range seq {
			count++
			break
		}
		testkit.Equal(t, count, 1, "{{ $m.Name }}: early break must halt YieldsError iteration before the terminal error")
	})
{{- end }}
{{ end }}{{ end -}}
{{- end -}}
