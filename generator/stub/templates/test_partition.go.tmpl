{{- /* Partition-fault subtests per //testkit:partition method.
       FaultForPartition(key, ...) installs a predicate that fires
       when the call's partition field equals key. ZeroArgs gives
       every partition slot a zero value, so:
         - Pairing FaultForPartition with ZeroKey (zero == zero) →
           predicate matches → fault fires.
         - Pairing FaultForOtherPartitions with SampleKey (non-zero)
           → c.Field=zero != sample-key → predicate matches → fault
           fires.
       Together they cover both branches of the per-key isolation
       predicate.

       FaultForPartition uses ZeroKey + asserts the fault FIRES on a
       matching call.
       FaultForOtherPartitions uses SampleKey + asserts the fault
       fires on a NON-matching call (c.Field=zero != non-zero key). */ -}}
{{- define "test-method-partition" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- range $m := .Methods }}{{ if and (not $m.Skip) $m.Partition }}
{{- $p := $m.Partition }}
	t.Run("{{ $m.Name }}/FaultForPartition matches the configured key", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
		s.On{{ $m.Name }}.FaultForPartition({{ $p.ZeroKey }}, errTest, 1)
		{{ $m.ErrCaptureLHS }} := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		testkit.ErrorIs(t, err, errTest, "{{ $m.Name }}: FaultForPartition must fire on matching key")
	})

	t.Run("{{ $m.Name }}/FaultForOtherPartitions matches non-configured keys", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
		s.On{{ $m.Name }}.FaultForOtherPartitions({{ $p.SampleKey }}, errTest, 1)
		{{ $m.ErrCaptureLHS }} := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		testkit.ErrorIs(t, err, errTest, "{{ $m.Name }}: FaultForOtherPartitions must fire on non-matching key")
	})
{{ end }}{{ end -}}
{{- end -}}
