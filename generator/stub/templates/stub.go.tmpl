{{- /*
       Stub impl root template — composes the per-concern partials.
       Each partial owns a single emitted Go-source concern; the
       root just orders them. No god templates: every partial is
       focused on one shape (struct / option / helper / dispatch).

       Section markers (`// --- X ---`) used to live in the source
       of this template; we dropped them because godoc treats them
       as part of the next type's doc comment, garbling the
       rendered package documentation. Type and function godoc
       speaks for itself.

       Output order (matters for readability of the generated file):
          1. package-doc               — `// Package X ...` block
          2. header                    — package + imports
          3. iface-check               — var _ Iface = (*Stub)(nil)
          4. calltypes                 — per-method Call structs
          5. per-method-stub           — per-method <Stub><Method> types
          6. per-method-return         — fallback record types (HasResults)
          7. helper-returns            — Returns() per HasResults method
          8. helper-func               — Func() per non-skip method
          9. helper-sentinel           — Fault<X>() per //testkit:errors
         10. helper-retry              — RetrySchedule() per //testkit:retry
         11. helper-partition          — FaultForPartition[+OtherPartitions]
         12. helper-yields             — Yields[Error]() per iter method
         13. helper-miss               — FaultMiss() per HasTrailingBool method
         14. option-type               — <Stub>Option type alias
         15. option-strict             — Strict()
         16. option-delegate           — DelegateTo()
         17. option-clock              — WithClock()
         18. option-rand               — WithRandSource()
         19. option-benchmode          — BenchMode()
         20. option-with-method        — With<Type><Method>() per method
         21. stub-struct               — the Stub struct
         22. ctor-new                  — NewStub()
         23. reset-calls               — ResetCalls()
         24. dispatch                  — per-method func bodies
*/ -}}
{{- define "stub" -}}
{{ template "package-doc" . -}}
{{ template "header" . }}
{{ template "iface-check" . }}
{{ template "calltypes" . }}
{{ template "per-method-stub" . }}
{{ template "per-method-return" . }}
{{ template "helper-returns" . }}
{{ template "helper-func" . }}
{{ template "helper-sentinel" . }}
{{ template "helper-retry" . }}
{{ template "helper-partition" . }}
{{ template "helper-yields" . }}
{{ template "helper-miss" . }}
{{ template "option-type" . }}
{{ template "option-strict" . }}
{{ template "option-delegate" . }}
{{ template "option-clock" . }}
{{ template "option-rand" . }}
{{ template "option-benchmode" . }}
{{ template "option-with-method" . }}
{{ template "stub-struct" . }}
{{ template "ctor-new" . }}
{{ template "reset-calls" . }}
{{ template "dispatch" . }}
{{- end -}}
