{{- /* Interface-level ResetCalls subtest. Verifies that the
       per-method recorders are emptied across every method by a
       single ResetCalls() call: drives one dispatch per method,
       calls ResetCalls, then asserts every CallCount() returned
       to zero. */ -}}
{{- define "test-iface-resetcalls" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
	t.Run("ResetCalls clears all recordings", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
{{- range $m := .Methods }}{{ if not $m.Skip }}
{{- if $m.HasResults }}
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- else }}
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- end }}
{{- end }}{{ end }}
		s.ResetCalls()
{{- range $m := .Methods }}{{ if not $m.Skip }}
		testkit.Equal(t, s.On{{ $m.Name }}.CallCount(), 0, "{{ $m.Name }}: ResetCalls must clear recordings")
{{- end }}{{ end }}
	})
{{- end -}}
