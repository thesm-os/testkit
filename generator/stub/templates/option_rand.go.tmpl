{{- /* WithRandSource option partial: injects a rand.Source into
       every per-method stub for deterministic probabilistic-fault
       testing. */ -}}
{{- define "option-rand" -}}
{{- $tpDecl := .Spec.TypeParamDecl -}}
{{- $tpArgs := .Spec.TypeParamArgs -}}
// {{ .StubName }}WithRandSource injects a [rand.Source] into all per-method stubs.
func {{ .StubName }}WithRandSource{{ $tpDecl }}(src rand.Source) {{ .StubName }}Option{{ $tpArgs }} {
	return func(s *{{ .StubName }}{{ $tpArgs }}) {
{{- range $m := .Methods }}{{ if not $m.Skip }}
		s.On{{ $m.Name }}.WithRandSource(src)
{{- end }}{{ end }}
	}
}
{{- end -}}
