{{- /* OnRecord-hook subtest per non-skip method. Verifies that
       installing an OnRecord callback fires once per dispatch, with
       the just-recorded Call value passed through. The hook is the
       integration point for cross-method assertion DSLs (suite,
       bench). */ -}}
{{- define "test-method-onrecord" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- range $m := .Methods }}{{ if not $m.Skip }}
	t.Run("{{ $m.Name }}/OnRecord hook fires", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
		var observed []{{ $gq }}{{ $m.QualCallType }}
		s.On{{ $m.Name }}.OnRecord(func(c {{ $gq }}{{ $m.QualCallType }}) {
			observed = append(observed, c)
		})
{{- if $m.HasResults }}
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- else }}
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- end }}
		testkit.Len(t, observed, 2, "{{ $m.Name }}: OnRecord hook must fire per dispatch")
	})
{{ end }}{{ end -}}
{{- end -}}
