{{- /* Interface-level WithClock subtest. Verifies that a
       [clock.TestClock] installed via WithClock propagates to the
       per-method Recorder so timestamps recorded against
       Timestamped() match the virtual-clock origin (not real time).
       Uses FirstNonSkipMethod as the representative — the
       constructor option wires every method identically. */ -}}
{{- define "test-iface-withclock" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- with $m := .FirstNonSkipMethod }}
	t.Run("WithClock propagates", func(t *testing.T) {
		t.Parallel()
		origin := time.Unix(1234567890, 0)
		clk := clock.NewTestClock(origin)
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t, {{ $gq }}{{ $stub }}WithClock{{ $.TestTypeArgs }}(clk))
{{- if $m.HasResults }}
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- else }}
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- end }}
		ts := s.On{{ $m.Name }}.Timestamped()
		testkit.Len(t, ts, 1, "{{ $m.Name }}: WithClock-bound dispatch must record exactly one timestamp")
		testkit.Equal(t, ts[0].At, origin, "{{ $m.Name }}: timestamp must reflect the configured clock")
	})
{{- end }}
{{- end -}}
