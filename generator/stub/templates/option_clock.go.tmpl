{{- /* WithClock option partial: injects a clock.Clock into every
       per-method stub for virtual-time control of latency / fault
       windows / timestamped recording. */ -}}
{{- define "option-clock" -}}
{{- $tpDecl := .Spec.TypeParamDecl -}}
{{- $tpArgs := .Spec.TypeParamArgs -}}
// {{ .StubName }}WithClock injects a [clock.Clock] into all per-method stubs.
func {{ .StubName }}WithClock{{ $tpDecl }}(clk clock.Clock) {{ .StubName }}Option{{ $tpArgs }} {
	return func(s *{{ .StubName }}{{ $tpArgs }}) {
{{- range $m := .Methods }}{{ if not $m.Skip }}
		s.On{{ $m.Name }}.WithClock(clk)
{{- end }}{{ end }}
	}
}
{{- end -}}
