{{- /* Deprecated-method log subtest per //testkit:deprecated method.
       The dispatch's tb.Logf("X is deprecated, use Y instead")
       fires on every call when tb is non-nil. We stage a
       FailableTB to capture the log entries via Logs(), invoke the
       method once, and assert the log contains both the method
       name and the replacement target. */ -}}
{{- define "test-method-deprecated" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $type := .Spec.Interface.Name -}}
{{- $gq := .GenQualifier -}}
{{- range $m := .Methods }}{{ if and (not $m.Skip) $m.Deprecated }}
	t.Run("{{ $m.Name }}/deprecated logs replacement guidance", func(t *testing.T) {
		t.Parallel()
		f := testkit.NewFailableTB()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(f)
{{- if $m.HasResults }}
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- else }}
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- end }}
		logs := f.Logs()
		testkit.Equal(t, len(logs), 1, "{{ $m.Name }}: deprecated dispatch must log exactly once")
		testkit.True(t, strings.Contains(logs[0], "{{ $m.Name }}"), "{{ $m.Name }}: log must name the method")
		testkit.True(t, strings.Contains(logs[0], "{{ $m.Deprecated }}"), "{{ $m.Name }}: log must point at {{ $m.Deprecated }}")
	})
{{ end }}{{ end -}}
{{- end -}}
