{{- /* Func-wins-over-Returns subtest per HasResults non-skip
       method. The dispatch's priority chain reads Func before
       fallback (fault is checked first; absent that, Func; then
       fallback; then unexpected). This subtest asserts the order
       holds: with both Returns(<sample>) and Func() configured,
       Func runs and Returns is dormant.

       Iter methods are skipped (they don't take fixed Returns;
       Yields is the corresponding helper). */ -}}
{{- define "test-method-func-wins" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- range $m := .Methods }}
{{- $iter := $m.IterReturn $tracker -}}
{{- if and (not $m.Skip) $m.HasResults (not $iter.IsSeq) (not $iter.IsSeq2) }}
	t.Run("{{ $m.Name }}/Func wins over Returns", func(t *testing.T) {
		t.Parallel()
		called := false
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
		s.On{{ $m.Name }}.Returns({{ $.Spec.SubstituteTypeParams ($m.SampleResults $tracker) }})
		s.On{{ $m.Name }}.Func(func({{ $.Spec.SubstituteTypeParams ($m.ParamList $tracker) }}){{ if $m.HasResults }} {{ $.Spec.SubstituteTypeParams ($m.ResultList $tracker) }}{{ end }} {
			called = true
{{- if $m.HasResults }}
			return {{ $.Spec.SubstituteTypeParams ($m.ZeroResults $tracker) }}
{{- end }}
		})
{{- if $m.HasResults }}
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- else }}
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- end }}
		testkit.True(t, called, "{{ $m.Name }}: Func must beat Returns in the dispatch chain")
	})
{{ end }}{{ end -}}
{{- end -}}
