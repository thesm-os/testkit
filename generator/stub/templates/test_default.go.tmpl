{{- /* Default-returns-zero subtest per non-skip method. Verifies
       the runtime MethodStub's zero-fallback path: when no Func /
       Returns / fault is configured, the method returns zero
       results, the error is nil (when ReturnsError), and the call
       is recorded.

       Capture shape:
       - HasAssertable + ReturnsError → capture all (`v0, err := ...`)
       - HasAssertable + no error     → capture vars (`v0 := ...`)
       - !HasAssertable + ReturnsError → ErrCaptureLHS (`_, err := ...`)
       - !HasAssertable + no error    → BlankResults discard
       Non-comparable result types (functions, channels) skip the
       Equal assertion silently. */ -}}
{{- define "test-method-default" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- range $m := .Methods }}{{ if not $m.Skip }}
	t.Run("{{ $m.Name }}/default returns zero", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
{{- if $m.HasAssertableNonErrorResults }}
		{{ $.Spec.SubstituteTypeParams $m.ResultNames }} := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- if $m.ReturnsError }}
		testkit.NoError(t, err, "{{ $m.Name }}: default path must not error")
{{- end }}
		{{ $.Spec.SubstituteTypeParams ($m.ZeroResultAsserts $tracker (printf "%s default" $m.Name)) }}
{{- else if $m.ReturnsError }}
		{{ $m.ErrCaptureLHS }} := s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		testkit.NoError(t, err, "{{ $m.Name }}: default path must not error")
{{- else if $m.HasResults }}
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- else }}
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- end }}
		s.On{{ $m.Name }}.AssertCalledOnce(t, "{{ $m.Name }}: default path must record")
	})
{{ end }}{{ end -}}
{{- end -}}
