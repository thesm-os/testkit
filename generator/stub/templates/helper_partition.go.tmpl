{{- /* Partition helpers partial: emitted per method that carries
       //testkit:partition. Pairs FaultForPartition (matching key
       faults) with FaultForOtherPartitions (non-matching faults)
       so tests can isolate per-key behavior. */ -}}
{{- define "helper-partition" -}}
{{ range $m := .Methods }}{{ if not $m.Skip }}{{ with $p := $m.Partition }}
// FaultForPartition fires only when {{ $p.FieldName }} matches key
// (every nth matching call).
func (s *{{ $m.QualStubType }}) FaultForPartition(key {{ $p.FieldType }}, err error, n int) *{{ $m.QualStubType }} {
	s.SetFault(testkit.And[{{ $m.QualCallType }}](
		testkit.NewPredicateFault[{{ $m.QualCallType }}](err, func(c {{ $m.QualCallType }}) bool {
			return c.{{ $p.FieldPath }} == key
		}),
		testkit.NewCountedFault[{{ $m.QualCallType }}](err, n),
	))
	return s
}

// FaultForOtherPartitions fires only when {{ $p.FieldName }} does NOT
// match key (every nth non-matching call).
func (s *{{ $m.QualStubType }}) FaultForOtherPartitions(key {{ $p.FieldType }}, err error, n int) *{{ $m.QualStubType }} {
	s.SetFault(testkit.And[{{ $m.QualCallType }}](
		testkit.NewPredicateFault[{{ $m.QualCallType }}](err, func(c {{ $m.QualCallType }}) bool {
			return c.{{ $p.FieldPath }} != key
		}),
		testkit.NewCountedFault[{{ $m.QualCallType }}](err, n),
	))
	return s
}
{{ end }}{{ end }}{{ end -}}
{{- end -}}
