{{- /* Recording subtest per non-skip method. Confirms that two
       successive dispatches both land Call entries in the per-
       method MethodStub's Recorder. CallCount() == 2 — the
       contract that observation primitives (OnRecord, suite
       assertions, Calls()) build on. */ -}}
{{- define "test-method-records" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- range $m := .Methods }}{{ if not $m.Skip }}
	t.Run("{{ $m.Name }}/records calls", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
{{- if $m.HasResults }}
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- else }}
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- end }}
		testkit.Equal(t, s.On{{ $m.Name }}.CallCount(), 2, "{{ $m.Name }}: every dispatch must be recorded")
	})
{{ end }}{{ end -}}
{{- end -}}
