{{- define "stub.test" -}}
{{- $T := external "testing" "T" -}}
{{- $TB := external "testing" "TB" -}}
{{- $equal := external $.Runtime "Equal" -}}
{{- $errorIs := external $.Runtime "ErrorIs" -}}
{{- $true := external $.Runtime "True" -}}
{{- $len := external $.Runtime "Len" -}}
{{- $testErr := external $.Runtime "TestError" -}}
{{- $failable := external $.Runtime "NewFailableTB" -}}
{{- $hour := external "time" "Hour" -}}
{{- $iface := .IfaceName -}}
{{- $behaviour := external $.RuntimeStub "Behaviour" -}}
{{- $doubleBehaviour := external $.RuntimeStub "DoubleBehaviour" -}}
{{- $doubleT := external $.RuntimeStub "Double" -}}
{{- $instance := external $.RuntimeStub "Instance" -}}
{{- $clock := external $.RuntimeClock "Clock" -}}
{{- $randsrc := external $.RuntimeRand "Source" -}}
{{- $subject := external $.RuntimeStub "Subject" -}}
{{- $pkg := .StubRef.Pkg -}}
{{- $stub := .TypeName -}}
{{- $tp := renderTypeParams .TypeParams -}}
{{- if .Generic -}}
{{- /* A Go test function cannot take type parameters, so there is no way to
       name the types the double would be instantiated at. The note is emitted
       rather than nothing at all: a companion that silently vanished would
       read as a generator that failed. */ -}}
// Skipped: {{ $stub }} is generic — instantiate it with concrete types and
// write the checks in the consuming package.
{{- else }}
{{ range $m := .Methods }}
// {{ camel $stub }}{{ $m.Name }}Subject binds {{ $m.Name }} into the shape
// [stub.Behaviour] drives: how to call it, what it answers with, and how to
// override it.
//
// Each call builds a fresh double, because several of the checks assert on
// failure and need one bound to a failable TB rather than to the running
// test.
func {{ camel $stub }}{{ $m.Name }}Subject{{ $tp }}(tb {{ renderExpr $TB }}) {{ renderExpr $subject }}[{{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}, {{ if $m.HasResults }}{{ renderExpr (external $pkg $m.ReturnType) }}{{ $.TypeArgs }}{{ else }}struct{}{{ end }}] {
	tb.Helper()
	s := {{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(tb)
	return {{ renderExpr $subject }}[{{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}, {{ if $m.HasResults }}{{ renderExpr (external $pkg $m.ReturnType) }}{{ $.TypeArgs }}{{ else }}struct{}{{ end }}]{
		Stub: s.{{ $m.OnField }}.MethodStub,
		Call: func() {
{{- template "stub.testargs" $m }}
			{{ if $m.HasResults }}{{ stub_blanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		},
{{- if $m.HasResults }}
		Result: func() {{ renderExpr (external $pkg $m.ReturnType) }}{{ $.TypeArgs }} {
{{- template "stub.testargs" $m }}
			{{ stub_idents "got" (len $m.Returns) }} := s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
			return {{ renderExpr (external $pkg $m.ReturnType) }}{{ $.TypeArgs }}{ {{- stub_identFields "got" $m.Sig -}} }
		},
{{- end }}
		Override: func(mark func()) {
			s.{{ $m.OnField }}.Func(func({{ template "stub.testfuncparams" $m }}) {{ template "stub.results" $m }} {
				mark()
{{- if $m.HasResults }}
{{- range $i, $r := $m.Returns }}
				var z{{ $i }} {{ renderType $r.Type }}
{{- end }}
				return {{ stub_idents "z" (len $m.Returns) }}
{{- end }}
			})
		},
{{- with $err := $m.ErrReturn }}
		Fails: func() error {
{{- template "stub.testargs" $m }}
			{{ stub_fails $m.Sig }} := s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
			return {{ $err.Local }}
		},
{{- end }}
	}
}

// Test{{ $stub }}{{ $m.Name }} pins how {{ $m.Name }} answers.
//
// Recording, resetting, call-count expectations, strict mode, fault injection
// and zero-value dispatch are the same contract for every method, so they are
// asserted once in [stub.Behaviour] rather than restated here. What remains
// below needs a value this method's signature can tell apart from a zero one.
{{ if $.Witnesses -}}
func {{ camel $stub }}{{ $m.Name }}Checks{{ $tp }}(t *{{ renderExpr $T }}) {
{{- else -}}
func Test{{ $stub }}{{ $m.Name }}(t *{{ renderExpr $T }}) {
{{- end }}
	t.Parallel()

	{{ renderExpr $behaviour }}(t, "{{ $m.Name }}", {{ camel $stub }}{{ $m.Name }}Subject{{ $.TypeArgs }})
{{- if $m.HasResults }}

	t.Run("answers with the value pinned by Returns", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		s := {{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(t)
{{- range $i, $r := $m.Returns }}
		var want{{ $i }} {{ renderType $r.Type }}
{{- end }}
		s.{{ $m.OnField }}.Returns({{ stub_idents "want" (len $m.Returns) }})
{{- template "stub.testargs" $m }}
		{{ stub_idents "got" (len $m.Returns) }} := s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
{{- range $i, $r := $m.Returns }}
		{{ renderExpr $equal }}(t, got{{ $i }}, want{{ $i }}, "{{ $m.Name }} must answer with what Returns pinned")
{{- end }}
	})
{{- end }}
	t.Run("records what it was called with", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Asserting only that a call happened would pass against a double
		// that recorded the wrong arguments, which is the failure a reader
		// most needs the log to surface.
		s := {{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(t)
{{- template "stub.testargs" $m }}
		{{ if $m.HasResults }}{{ stub_blanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		{{ if $m.Params }}got := {{ end }}s.{{ $m.OnField }}.AssertCalledOnce(t, "{{ $m.Name }} must record the call")
{{- range $i, $p := $m.Params }}
		{{ renderExpr $equal }}(t, got.{{ $p.Field }}, a{{ $i }}, "the recorded call carries {{ $p.Field }}")
{{- end }}
	})

	t.Run("fires the OnRecord hook for every call", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// The hook fires synchronously as each call lands, which is what a
		// concurrency test observes progress with — polling the log instead
		// races the thing under test.
		s := {{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(t)
		var seen []{{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}
		s.{{ $m.OnField }}.OnRecord(func(c {{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}) { seen = append(seen, c) })
{{- template "stub.testargs" $m }}
		{{ if $m.HasResults }}{{ stub_blanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		{{ if $m.HasResults }}{{ stub_blanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		{{ renderExpr $len }}(t, seen, 2, "OnRecord must fire once per {{ $m.Name }} call")
	})

	t.Run("wires With{{ $iface }}{{ $m.Name }} at construction", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		called := false
		s := {{ renderExpr $.CtorRef }}(t, {{ renderExpr (external $pkg (printf "With%s%s" $iface $m.Name)) }}{{ $.TypeArgs }}(func({{ template "stub.testfuncparams" $m }}) {{ template "stub.results" $m }} {
			called = true
{{- if $m.HasResults }}
{{- range $i, $r := $m.Returns }}
			var z{{ $i }} {{ renderType $r.Type }}
{{- end }}
			return {{ stub_idents "z" (len $m.Returns) }}
{{- end }}
		}))
{{- template "stub.testargs" $m }}
		{{ if $m.HasResults }}{{ stub_blanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		{{ renderExpr $true }}(t, called, "With{{ $iface }}{{ $m.Name }} must install the override")
	})
{{- if $m.HasResults }}

	t.Run("keeps the Returns configuration across a reset", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A reset clears what happened, not what was configured. Losing the
		// configuration would make a double answer differently in the second
		// half of a test than in the first, for no reason the reader can see.
		s := {{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(t)
{{- range $i, $r := $m.Returns }}
		var want{{ $i }} {{ renderType $r.Type }}
{{- end }}
		s.{{ $m.OnField }}.Returns({{ stub_idents "want" (len $m.Returns) }})
{{- template "stub.testargs" $m }}
		{{ stub_blanks (len $m.Returns) }} = s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		s.ResetCalls()
		{{ stub_idents "got" (len $m.Returns) }} := s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
{{- range $i, $r := $m.Returns }}
		{{ renderExpr $equal }}(t, got{{ $i }}, want{{ $i }}, "a reset must keep what Returns pinned")
{{- end }}
	})
{{- end }}
{{- if $m.Sequence.Kind }}

	t.Run("yields the items Yields configured", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		s := {{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(t)
		var want {{ renderType $m.Sequence.Elem }}
		s.{{ $m.OnField }}.Yields(want, want)
{{- template "stub.testargs" $m }}
		got0 := s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		seen := 0
		for range got0 {
			seen++
		}
		{{ renderExpr $equal }}(t, seen, 2, "{{ $m.Name }} must yield every configured item")
	})

	t.Run("stops yielding when the caller breaks", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A range-over-func that ignores its yield's false is the classic way
		// to write one wrong, and the loop it breaks out of is a consumer's,
		// not ours — so the double has to honour it or every consumer's early
		// exit silently runs to completion.
		s := {{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(t)
		var want {{ renderType $m.Sequence.Elem }}
		s.{{ $m.OnField }}.Yields(want, want, want)
{{- template "stub.testargs" $m }}
		got0 := s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		seen := 0
		for range got0 {
			seen++
			break
		}
		{{ renderExpr $equal }}(t, seen, 1, "{{ $m.Name }} must stop when the caller breaks")
	})
{{- end }}
{{- if $m.Sequence.YieldsError }}

	t.Run("yields the items YieldsError configured and then fails", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Failing partway through is the case a consumer's loop most often
		// gets wrong, and a sequence that only ever succeeds never reaches it.
		s := {{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(t)
		var item {{ renderType $m.Sequence.Elem }}
		want := {{ renderExpr $testErr }}("{{ $m.Name }}-yields")
		s.{{ $m.OnField }}.YieldsError([]{{ renderType $m.Sequence.Elem }}{item, item}, want)
{{- template "stub.testargs" $m }}
		got0 := s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		seen := 0
		var last error
		for _, err := range got0 {
			if err != nil {
				last = err
				break
			}
			seen++
		}
		{{ renderExpr $equal }}(t, seen, 2, "{{ $m.Name }} must yield every item before failing")
		{{ renderExpr $errorIs }}(t, last, want, "{{ $m.Name }} must end with the configured error")
	})

	t.Run("stops a failing sequence when the caller breaks", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Breaking before the error is the path a caller takes when it has
		// seen enough, and a sequence that ran on regardless would keep
		// producing after its consumer stopped listening.
		s := {{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(t)
		var item {{ renderType $m.Sequence.Elem }}
		s.{{ $m.OnField }}.YieldsError([]{{ renderType $m.Sequence.Elem }}{item, item, item}, {{ renderExpr $testErr }}("{{ $m.Name }}-yields"))
{{- template "stub.testargs" $m }}
		got0 := s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		seen := 0
		for range got0 {
			seen++
			break
		}
		{{ renderExpr $equal }}(t, seen, 1, "{{ $m.Name }} must stop when the caller breaks")
	})
{{- end }}
{{- if $m.OrderAfter }}

	t.Run("refuses {{ $m.Name }} before {{ $m.OrderAfter }} in strict mode", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Out-of-order use is a caller's bug, and one that silently works
		// against a double will not work against the real implementation.
		f := {{ renderExpr $failable }}()
		s := {{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(f, {{ renderExpr (external $pkg (printf "%sStrict" $stub)) }}{{ $.TypeArgs }}())
{{- template "stub.testargs" $m }}
		{{ if $m.HasResults }}{{ stub_blanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		{{ renderExpr $true }}(t, f.Failed(), "{{ $m.Name }} before {{ $m.OrderAfter }} must be refused")
	})
{{- end }}
}
{{ end }}
{{ with $m := index .Methods 0 }}
// {{ camel $stub }}Double describes how to build a {{ $stub }} under each
// option whose effect is the same whatever a method's signature.
//
// {{ $m.Name }} stands in for the double as a whole: what these checks assert
// is that an option reached it at all, and the first method witnesses that as
// well as any other would.
func {{ camel $stub }}Double{{ $tp }}() {{ renderExpr $doubleT }}[{{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}] {
	instance := func(s *{{ renderExpr $.StubRef }}{{ $.TypeArgs }}) {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}] {
		return {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}]{
			Stub: s.{{ $m.OnField }}.MethodStub,
			Call: func() {
{{- template "stub.testargs" $m }}
				{{ if $m.HasResults }}{{ stub_blanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
			},
			Reset: s.ResetCalls,
		}
	}
	return {{ renderExpr $doubleT }}[{{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}]{
		New: func(tb {{ renderExpr $TB }}) {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}] {
			return instance({{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(tb))
		},
		WithClock: func(tb {{ renderExpr $TB }}, clk {{ renderExpr $clock }}) {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}] {
			return instance({{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(tb, {{ renderExpr (external $pkg (printf "%sWithClock" $stub)) }}{{ $.TypeArgs }}(clk)))
		},
		WithRandSource: func(tb {{ renderExpr $TB }}, src {{ renderExpr $randsrc }}) {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}] {
			return instance({{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(tb, {{ renderExpr (external $pkg (printf "%sWithRandSource" $stub)) }}{{ $.TypeArgs }}(src)))
		},
		BenchMode: func(tb {{ renderExpr $TB }}) {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}] {
			return instance({{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(tb, {{ renderExpr (external $pkg (printf "%sBenchMode" $stub)) }}{{ $.TypeArgs }}()))
		},
		Strict: func(tb {{ renderExpr $TB }}) {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}{{ $.TypeArgs }}] {
			return instance({{ renderExpr $.CtorRef }}{{ $.TypeArgs }}(tb, {{ renderExpr (external $pkg (printf "%sStrict" $stub)) }}{{ $.TypeArgs }}()))
		},
	}
}

// Test{{ $stub }}Options pins the settings that apply to the double rather
// than to one method: bench mode, the injected clock and random source, and
// what a reset clears.
{{ if $.Witnesses -}}
func {{ camel $stub }}OptionChecks{{ $tp }}(t *{{ renderExpr $T }}) {
{{- else -}}
func Test{{ $stub }}Options(t *{{ renderExpr $T }}) {
{{- end }}
	t.Parallel()

	{{ renderExpr $doubleBehaviour }}(t, {{ camel $stub }}Double{{ $.TypeArgs }}())
}
{{ end }}
// Test{{ $stub }}DelegateTo pins that a wrapped implementation is called
// through, and recorded on the way past.
//
// This is what lets one generated suite run against both the double and a
// production type, which is the point of conformance testing.
{{ if .Witnesses -}}
func {{ camel $stub }}DelegationChecks{{ $tp }}(t *{{ renderExpr $T }}) {
{{- else -}}
func Test{{ $stub }}DelegateTo(t *{{ renderExpr $T }}) {
{{- end }}
	t.Parallel()

	inner := {{ renderExpr .CtorRef }}{{ .TypeArgs }}(t)
	s := {{ renderExpr .CtorRef }}{{ .TypeArgs }}(t, {{ renderExpr (external $pkg (printf "%sDelegateTo" $stub)) }}{{ .TypeArgs }}(inner))
{{ range $m := .Methods }}
	t.Run("forwards {{ $m.Name }} to the wrapped implementation", func(t *{{ renderExpr $T }}) {
{{- template "stub.testargs" $m }}
		{{ if $m.HasResults }}{{ stub_blanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		inner.{{ $m.OnField }}.AssertCalledOnce(t, "{{ $m.Name }} must reach the wrapped implementation")
	})
{{- with $err := $m.ErrReturn }}

	t.Run("surfaces what {{ $m.Name }} answered", func(t *{{ renderExpr $T }}) {
		// Reaching the wrapped implementation is not enough: a double that
		// called through and then discarded the answer would pass the check
		// above while telling its caller nothing true.
		want := {{ renderExpr $testErr }}("{{ $m.Name }}-delegate")
		inner.{{ $m.OnField }}.FaultsFor({{ renderExpr $hour }}, want)
{{- template "stub.testargs" $m }}
		{{ stub_fails $m.Sig }} := s.{{ $m.Name }}({{ stub_identArgs "a" $m.Sig }})
		{{ renderExpr $errorIs }}(t, {{ $err.Local }}, want, "{{ $m.Name }} must surface the wrapped answer")
	})
{{- end }}
{{ end }}}
{{ if .Witnesses }}
{{ range $m := .Methods }}
// Test{{ $stub }}{{ $m.Name }} runs {{ $m.Name }}'s checks at the witness types
// its constraints admit.
//
// A Go test function cannot take type parameters, so the checks live in a
// generic helper and this instantiates it. One instantiation is enough: the
// generated double never branches on its type parameters, so a single set of
// witnesses reaches every statement.
func Test{{ $stub }}{{ $m.Name }}(t *{{ renderExpr $T }}) { {{ camel $stub }}{{ $m.Name }}Checks{{ template "stub.witness" $ }}(t) }
{{ end }}
// Test{{ $stub }}Options runs the whole-double checks at the same witnesses.
func Test{{ $stub }}Options(t *{{ renderExpr $T }}) { {{ camel $stub }}OptionChecks{{ template "stub.witness" $ }}(t) }
// Test{{ $stub }}DelegateTo runs the delegation checks at the same witnesses.
func Test{{ $stub }}DelegateTo(t *{{ renderExpr $T }}) { {{ camel $stub }}DelegationChecks{{ template "stub.witness" $ }}(t) }
{{- end }}
{{- end }}
{{- end -}}

{{- /* Only the lists that spell a type live here; the rest are Go helpers in
       eidos's lang/golang, under this plugin's `stub_` prefix. See
       stub.double.tmpl for why the split falls where it does. */ -}}

{{- /* Arguments are declared as zero values rather than invented: what these
       tests assert is dispatch, and the argument values are incidental. */ -}}
{{- define "stub.testargs" -}}
{{ range $i, $p := .Params }}
			var a{{ $i }} {{ if $p.Variadic }}[]{{ end }}{{ renderType $p.Type }}
{{- end }}
{{- end -}}

{{- define "stub.testfuncparams" -}}
{{ range $i, $p := .Params }}{{ if $i }}, {{ end }}_ {{ if $p.Variadic }}...{{ end }}{{ renderType $p.Type }}{{ end }}
{{- end -}}

{{- /* The concrete instantiation each entry point uses — `[string, int]`, or
       nothing at all for a non-generic double, so a call site can append it
       unconditionally. */ -}}
{{- define "stub.witness" -}}
{{- if .Witnesses }}[{{ range $i, $w := .Witnesses }}{{ if $i }}, {{ end }}{{ renderType $w }}{{ end }}]{{ end }}
{{- end -}}
