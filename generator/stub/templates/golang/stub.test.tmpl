{{- define "stub.test" -}}
{{- $T := stubRef "testing.T" -}}
{{- $TB := stubRef "testing.TB" -}}
{{- $equal := stubRef "testkit.Equal" -}}
{{- $errorIs := stubRef "testkit.ErrorIs" -}}
{{- $true := stubRef "testkit.True" -}}
{{- $len := stubRef "testkit.Len" -}}
{{- $noError := stubRef "testkit.NoError" -}}
{{- $testErr := stubRef "testkit.TestError" -}}
{{- $failable := stubRef "testkit.NewFailableTB" -}}
{{- $hour := stubRef "time.Hour" -}}
{{- $iface := .IfaceName -}}
{{- $behaviour := stubRef "stub.Behaviour" -}}
{{- $doubleBehaviour := stubRef "stub.DoubleBehaviour" -}}
{{- $doubleT := stubRef "stub.Double" -}}
{{- $instance := stubRef "stub.Instance" -}}
{{- $clock := stubRef "clock.Clock" -}}
{{- $randsrc := stubRef "rand.Source" -}}
{{- $subject := stubRef "stub.Subject" -}}
{{- $pkg := .StubRef.Pkg -}}
{{- $stub := .TypeName -}}
{{- if .Generic -}}
{{- /* A Go test function cannot take type parameters, so there is no way to
       name the types the double would be instantiated at. The note is emitted
       rather than nothing at all: a companion that silently vanished would
       read as a generator that failed. */ -}}
// Skipped: {{ $stub }} is generic — instantiate it with concrete types and
// write the checks in the consuming package.
{{- else }}
{{ if .Complete -}}
// Compile-time proof that {{ $stub }} satisfies the interface it doubles.
// A drifted signature fails here rather than at the first test that assigns
// the double.
var _ {{ renderExpr .IfaceRef }} = (*{{ renderExpr .StubRef }})(nil)
{{- end }}
{{ range $m := .Methods }}
// {{ camel $stub }}{{ $m.Name }}Subject binds {{ $m.Name }} into the shape
// [stub.Behaviour] drives: how to call it, what it answers with, and how to
// override it.
//
// Each call builds a fresh double, because several of the checks assert on
// failure and need one bound to a failable TB rather than to the running
// test.
func {{ camel $stub }}{{ $m.Name }}Subject(tb {{ renderExpr $TB }}) {{ renderExpr $subject }}[{{ renderExpr (external $pkg $m.CallType) }}, {{ if $m.HasResults }}{{ renderExpr (external $pkg $m.ReturnType) }}{{ else }}struct{}{{ end }}] {
	tb.Helper()
	s := {{ renderExpr $.CtorRef }}(tb)
	return {{ renderExpr $subject }}[{{ renderExpr (external $pkg $m.CallType) }}, {{ if $m.HasResults }}{{ renderExpr (external $pkg $m.ReturnType) }}{{ else }}struct{}{{ end }}]{
		Stub: s.{{ $m.OnField }}.MethodStub,
		Call: func() {
{{- template "stub.testargs" $m }}
			{{ if $m.HasResults }}{{ stubBlanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		},
{{- if $m.HasResults }}
		Result: func() {{ renderExpr (external $pkg $m.ReturnType) }} {
{{- template "stub.testargs" $m }}
			{{ stubIdents "got" (len $m.Returns) }} := s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
			return {{ renderExpr (external $pkg $m.ReturnType) }}{ {{- stubIdentFields "got" $m.Returns -}} }
		},
{{- end }}
		Override: func(mark func()) {
			s.{{ $m.OnField }}.Func(func({{ template "stub.testfuncparams" $m }}) {{ template "stub.results" $m }} {
				mark()
{{- if $m.HasResults }}
{{- range $i, $r := $m.Returns }}
				var z{{ $i }} {{ renderType $r.Type }}
{{- end }}
				return {{ stubIdents "z" (len $m.Returns) }}
{{- end }}
			})
		},
{{- with $err := $m.ErrReturn }}
		Fails: func() error {
{{- template "stub.testargs" $m }}
			{{ stubFails $m.Returns }} := s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
			return {{ $err.Local }}
		},
{{- end }}
	}
}

// Test{{ $stub }}{{ $m.Name }} pins how {{ $m.Name }} answers.
//
// Recording, resetting, call-count expectations, strict mode, fault injection
// and zero-value dispatch are the same contract for every method, so they are
// asserted once in [stub.Behaviour] rather than restated here. What remains
// below needs a value this method's signature can tell apart from a zero one.
func Test{{ $stub }}{{ $m.Name }}(t *{{ renderExpr $T }}) {
	t.Parallel()

	{{ renderExpr $behaviour }}(t, "{{ $m.Name }}", {{ camel $stub }}{{ $m.Name }}Subject)
{{- if $m.HasResults }}

	t.Run("answers with the value pinned by Returns", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		s := {{ renderExpr $.CtorRef }}(t)
{{- range $i, $r := $m.Returns }}
		var want{{ $i }} {{ renderType $r.Type }}
{{- end }}
		s.{{ $m.OnField }}.Returns({{ stubIdents "want" (len $m.Returns) }})
{{- template "stub.testargs" $m }}
		{{ stubIdents "got" (len $m.Returns) }} := s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
{{- range $i, $r := $m.Returns }}
		{{ renderExpr $equal }}(t, got{{ $i }}, want{{ $i }}, "{{ $m.Name }} must answer with what Returns pinned")
{{- end }}
	})
{{- end }}
	t.Run("records what it was called with", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Asserting only that a call happened would pass against a double
		// that recorded the wrong arguments, which is the failure a reader
		// most needs the log to surface.
		s := {{ renderExpr $.CtorRef }}(t)
{{- template "stub.testargs" $m }}
		{{ if $m.HasResults }}{{ stubBlanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		{{ if $m.Params }}got := {{ end }}s.{{ $m.OnField }}.AssertCalledOnce(t, "{{ $m.Name }} must record the call")
{{- range $i, $p := $m.Params }}
		{{ renderExpr $equal }}(t, got.{{ $p.Field }}, a{{ $i }}, "the recorded call carries {{ $p.Field }}")
{{- end }}
	})

	t.Run("fires the OnRecord hook for every call", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// The hook fires synchronously as each call lands, which is what a
		// concurrency test observes progress with — polling the log instead
		// races the thing under test.
		s := {{ renderExpr $.CtorRef }}(t)
		var seen []{{ renderExpr (external $pkg $m.CallType) }}
		s.{{ $m.OnField }}.OnRecord(func(c {{ renderExpr (external $pkg $m.CallType) }}) { seen = append(seen, c) })
{{- template "stub.testargs" $m }}
		{{ if $m.HasResults }}{{ stubBlanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		{{ if $m.HasResults }}{{ stubBlanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		{{ renderExpr $len }}(t, seen, 2, "OnRecord must fire once per {{ $m.Name }} call")
	})

	t.Run("wires With{{ $iface }}{{ $m.Name }} at construction", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		called := false
		s := {{ renderExpr $.CtorRef }}(t, {{ renderExpr (external $pkg (printf "With%s%s" $iface $m.Name)) }}(func({{ template "stub.testfuncparams" $m }}) {{ template "stub.results" $m }} {
			called = true
{{- if $m.HasResults }}
{{- range $i, $r := $m.Returns }}
			var z{{ $i }} {{ renderType $r.Type }}
{{- end }}
			return {{ stubIdents "z" (len $m.Returns) }}
{{- end }}
		}))
{{- template "stub.testargs" $m }}
		{{ if $m.HasResults }}{{ stubBlanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		{{ renderExpr $true }}(t, called, "With{{ $iface }}{{ $m.Name }} must install the override")
	})
{{- if $m.HasResults }}

	t.Run("keeps the Returns configuration across a reset", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A reset clears what happened, not what was configured. Losing the
		// configuration would make a double answer differently in the second
		// half of a test than in the first, for no reason the reader can see.
		s := {{ renderExpr $.CtorRef }}(t)
{{- range $i, $r := $m.Returns }}
		var want{{ $i }} {{ renderType $r.Type }}
{{- end }}
		s.{{ $m.OnField }}.Returns({{ stubIdents "want" (len $m.Returns) }})
{{- template "stub.testargs" $m }}
		{{ stubBlanks (len $m.Returns) }} = s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		s.ResetCalls()
		{{ stubIdents "got" (len $m.Returns) }} := s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
{{- range $i, $r := $m.Returns }}
		{{ renderExpr $equal }}(t, got{{ $i }}, want{{ $i }}, "a reset must keep what Returns pinned")
{{- end }}
	})
{{- end }}
{{- if $m.Iterator }}

	t.Run("yields the items Yields configured", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		s := {{ renderExpr $.CtorRef }}(t)
		var want {{ renderType $m.IteratorElem }}
		s.{{ $m.OnField }}.Yields(want, want)
{{- template "stub.testargs" $m }}
		got0 := s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		seen := 0
		for range got0 {
			seen++
		}
		{{ renderExpr $equal }}(t, seen, 2, "{{ $m.Name }} must yield every configured item")
	})

	t.Run("stops yielding when the caller breaks", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A range-over-func that ignores its yield's false is the classic way
		// to write one wrong, and the loop it breaks out of is a consumer's,
		// not ours — so the double has to honour it or every consumer's early
		// exit silently runs to completion.
		s := {{ renderExpr $.CtorRef }}(t)
		var want {{ renderType $m.IteratorElem }}
		s.{{ $m.OnField }}.Yields(want, want, want)
{{- template "stub.testargs" $m }}
		got0 := s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		seen := 0
		for range got0 {
			seen++
			break
		}
		{{ renderExpr $equal }}(t, seen, 1, "{{ $m.Name }} must stop when the caller breaks")
	})
{{- end }}
{{- if $m.IteratorYieldsError }}

	t.Run("yields the items YieldsError configured and then fails", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Failing partway through is the case a consumer's loop most often
		// gets wrong, and a sequence that only ever succeeds never reaches it.
		s := {{ renderExpr $.CtorRef }}(t)
		var item {{ renderType $m.IteratorElem }}
		want := {{ renderExpr $testErr }}("{{ $m.Name }}-yields")
		s.{{ $m.OnField }}.YieldsError([]{{ renderType $m.IteratorElem }}{item, item}, want)
{{- template "stub.testargs" $m }}
		got0 := s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		seen := 0
		var last error
		for _, err := range got0 {
			if err != nil {
				last = err
				break
			}
			seen++
		}
		{{ renderExpr $equal }}(t, seen, 2, "{{ $m.Name }} must yield every item before failing")
		{{ renderExpr $errorIs }}(t, last, want, "{{ $m.Name }} must end with the configured error")
	})

	t.Run("stops a failing sequence when the caller breaks", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Breaking before the error is the path a caller takes when it has
		// seen enough, and a sequence that ran on regardless would keep
		// producing after its consumer stopped listening.
		s := {{ renderExpr $.CtorRef }}(t)
		var item {{ renderType $m.IteratorElem }}
		s.{{ $m.OnField }}.YieldsError([]{{ renderType $m.IteratorElem }}{item, item, item}, {{ renderExpr $testErr }}("{{ $m.Name }}-yields"))
{{- template "stub.testargs" $m }}
		got0 := s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		seen := 0
		for range got0 {
			seen++
			break
		}
		{{ renderExpr $equal }}(t, seen, 1, "{{ $m.Name }} must stop when the caller breaks")
	})
{{- end }}
{{- if $m.OrderAfter }}

	t.Run("refuses {{ $m.Name }} before {{ $m.OrderAfter }} in strict mode", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Out-of-order use is a caller's bug, and one that silently works
		// against a double will not work against the real implementation.
		f := {{ renderExpr $failable }}()
		s := {{ renderExpr $.CtorRef }}(f, {{ renderExpr (external $pkg (printf "%sStrict" $stub)) }}())
{{- template "stub.testargs" $m }}
		{{ if $m.HasResults }}{{ stubBlanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		{{ renderExpr $true }}(t, f.Failed(), "{{ $m.Name }} before {{ $m.OrderAfter }} must be refused")
	})
{{- end }}
}
{{ end }}
{{ with $m := index .Methods 0 }}
// {{ camel $stub }}Double describes how to build a {{ $stub }} under each
// option whose effect is the same whatever a method's signature.
//
// {{ $m.Name }} stands in for the double as a whole: what these checks assert
// is that an option reached it at all, and the first method witnesses that as
// well as any other would.
func {{ camel $stub }}Double() {{ renderExpr $doubleT }}[{{ renderExpr (external $pkg $m.CallType) }}] {
	instance := func(s *{{ renderExpr $.StubRef }}) {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}] {
		return {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}]{
			Stub: s.{{ $m.OnField }}.MethodStub,
			Call: func() {
{{- template "stub.testargs" $m }}
				{{ if $m.HasResults }}{{ stubBlanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
			},
			Reset: s.ResetCalls,
		}
	}
	return {{ renderExpr $doubleT }}[{{ renderExpr (external $pkg $m.CallType) }}]{
		New: func(tb {{ renderExpr $TB }}) {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}] {
			return instance({{ renderExpr $.CtorRef }}(tb))
		},
		WithClock: func(tb {{ renderExpr $TB }}, clk {{ renderExpr $clock }}) {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}] {
			return instance({{ renderExpr $.CtorRef }}(tb, {{ renderExpr (external $pkg (printf "%sWithClock" $stub)) }}(clk)))
		},
		WithRandSource: func(tb {{ renderExpr $TB }}, src {{ renderExpr $randsrc }}) {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}] {
			return instance({{ renderExpr $.CtorRef }}(tb, {{ renderExpr (external $pkg (printf "%sWithRandSource" $stub)) }}(src)))
		},
		BenchMode: func(tb {{ renderExpr $TB }}) {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}] {
			return instance({{ renderExpr $.CtorRef }}(tb, {{ renderExpr (external $pkg (printf "%sBenchMode" $stub)) }}()))
		},
		Strict: func(tb {{ renderExpr $TB }}) {{ renderExpr $instance }}[{{ renderExpr (external $pkg $m.CallType) }}] {
			return instance({{ renderExpr $.CtorRef }}(tb, {{ renderExpr (external $pkg (printf "%sStrict" $stub)) }}()))
		},
	}
}

// Test{{ $stub }}Options pins the settings that apply to the double rather
// than to one method: bench mode, the injected clock and random source, and
// what a reset clears.
func Test{{ $stub }}Options(t *{{ renderExpr $T }}) {
	t.Parallel()

	{{ renderExpr $doubleBehaviour }}(t, {{ camel $stub }}Double())
}
{{ end }}
{{- if .Complete }}
{{- /* The check wraps the double in itself, so it needs the double to satisfy
       the interface — the same condition the compile-time assertion is emitted
       under. An incomplete double is one an embedded interface contributed
       methods to that the projection did not carry. */}}
// Test{{ $stub }}DelegateTo pins that a wrapped implementation is called
// through, and recorded on the way past.
//
// This is what lets one generated suite run against both the double and a
// production type, which is the point of conformance testing.
func Test{{ $stub }}DelegateTo(t *{{ renderExpr $T }}) {
	t.Parallel()

	inner := {{ renderExpr .CtorRef }}(t)
	s := {{ renderExpr .CtorRef }}(t, {{ renderExpr (external $pkg (printf "%sDelegateTo" $stub)) }}(inner))
{{ range $m := .Methods }}
	t.Run("forwards {{ $m.Name }} to the wrapped implementation", func(t *{{ renderExpr $T }}) {
{{- template "stub.testargs" $m }}
		{{ if $m.HasResults }}{{ stubBlanks (len $m.Returns) }} = {{ end }}s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		inner.{{ $m.OnField }}.AssertCalledOnce(t, "{{ $m.Name }} must reach the wrapped implementation")
	})
{{- with $err := $m.ErrReturn }}

	t.Run("surfaces what {{ $m.Name }} answered", func(t *{{ renderExpr $T }}) {
		// Reaching the wrapped implementation is not enough: a double that
		// called through and then discarded the answer would pass the check
		// above while telling its caller nothing true.
		want := {{ renderExpr $testErr }}("{{ $m.Name }}-delegate")
		inner.{{ $m.OnField }}.FaultsFor({{ renderExpr $hour }}, want)
{{- template "stub.testargs" $m }}
		{{ stubFails $m.Returns }} := s.{{ $m.Name }}({{ stubIdentArgs "a" $m.Params }})
		{{ renderExpr $errorIs }}(t, {{ $err.Local }}, want, "{{ $m.Name }} must surface the wrapped answer")
	})
{{- end }}
{{ end }}}
{{- end }}
{{- end }}
{{- end -}}

{{- /* Only the lists that spell a type live here; the rest are Go helpers in
       internal/gotmpl. See stub.double.tmpl for why the split falls where it
       does. */ -}}

{{- /* Arguments are declared as zero values rather than invented: what these
       tests assert is dispatch, and the argument values are incidental. */ -}}
{{- define "stub.testargs" -}}
{{ range $i, $p := .Params }}
			var a{{ $i }} {{ if $p.Variadic }}[]{{ end }}{{ renderType $p.Type }}
{{- end }}
{{- end -}}

{{- define "stub.testfuncparams" -}}
{{ range $i, $p := .Params }}{{ if $i }}, {{ end }}_ {{ if $p.Variadic }}...{{ end }}{{ renderType $p.Type }}{{ end }}
{{- end -}}
