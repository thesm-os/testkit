{{- define "stub.double" -}}
{{- $stub := .TypeName -}}
{{- $iface := .IfaceName -}}
{{- range .Methods }}
// {{ .CallType }} records one invocation of {{ $iface }}.{{ .Name }}.
//
// Fields take their names from the source signature — parameters and named
// returns alike — so a failure message names what the author named. A slot
// the source left unnamed or blank falls back to a positional name.
type {{ .CallType }}{{ renderTypeParams $.TypeParams }} struct {
{{- range .Params }}
	{{ .Field }} {{ if .Variadic }}[]{{ end }}{{ renderType .Type }}
{{- end }}
{{- range .Returns }}
	{{ .Field }} {{ renderType .Type }}
{{- end }}
}
{{ end }}
// --- Per-method configuration ---
{{ range $m := .Methods }}
// {{ $m.StubType }} controls how the double answers {{ $m.Name }} and records
// what it was asked.
//
// The embedded MethodStub supplies the machinery every method shares: call
// recording, fault injection, latency against a virtual clock, gates,
// call-count expectations, and strict mode.
type {{ $m.StubType }}{{ renderTypeParams $.TypeParams }} struct {
	*{{ renderExpr (external $.RuntimeStub "MethodStub") }}[{{ $m.CallType }}{{ $.TypeArgs }}]

	fn func({{ template "stub.paramtypes" $m }}) {{ template "stub.results" $m }}
{{- if $m.HasResults }}
	fallback *{{ $m.ReturnType }}{{ $.TypeArgs }}
{{- end }}
}
{{ if $m.HasResults }}
// {{ $m.ReturnType }} holds the fixed answer configured through Returns.
type {{ $m.ReturnType }}{{ renderTypeParams $.TypeParams }} struct {
{{- range $m.Returns }}
	{{ .Field }} {{ renderType .Type }}
{{- end }}
}

// Returns pins a fixed result for every call to {{ $m.Name }}. A Func
// override and an injected fault both take precedence over it.
func (s *{{ $m.StubType }}{{ $.TypeArgs }}) Returns({{ template "stub.returnparams" $m }}) *{{ $m.StubType }}{{ $.TypeArgs }} {
	s.fallback = &{{ $m.ReturnType }}{{ $.TypeArgs }}{ {{- stub_namedFields $m.Sig -}} }
	return s
}
{{ end }}
// Func supplies a body for {{ $m.Name }}, for when the answer depends on the
// arguments. An injected fault still takes precedence.
func (s *{{ $m.StubType }}{{ $.TypeArgs }}) Func(fn func({{ template "stub.paramtypes" $m }}) {{ template "stub.results" $m }}) *{{ $m.StubType }}{{ $.TypeArgs }} {
	s.fn = fn
	return s
}
{{- if $m.Sequence.Kind }}
// Yields makes {{ $m.Name }} return a sequence over items.
//
// Building a range-over-func by hand is a closure with a break-handling
// branch in it, and a test that gets that branch wrong reports a bug in
// itself rather than in the subject.
func (s *{{ $m.StubType }}{{ $.TypeArgs }}) Yields(items ...{{ renderType $m.Sequence.Elem }}) *{{ $m.StubType }}{{ $.TypeArgs }} {
	s.fn = func({{ template "stub.blankparams" $m }}) {{ template "stub.results" $m }} {
		return func(yield func({{ template "stub.yieldparams" $m }}) bool) {
			for _, v := range items {
				if !yield({{ template "stub.yieldargs" $m }}) {
					return
				}
			}
		}
	}
	return s
}
{{ end }}
{{- if $m.Sequence.YieldsError }}
// YieldsError makes {{ $m.Name }} return a sequence that produces items and
// then fails.
//
// Failing partway through is the case a consumer's loop most often gets
// wrong, and it cannot be reached by a sequence that only ever succeeds.
func (s *{{ $m.StubType }}{{ $.TypeArgs }}) YieldsError(items []{{ renderType $m.Sequence.Elem }}, err error) *{{ $m.StubType }}{{ $.TypeArgs }} {
	s.fn = func({{ template "stub.blankparams" $m }}) {{ template "stub.results" $m }} {
		return func(yield func({{ template "stub.yieldparams" $m }}) bool) {
			for _, v := range items {
				if !yield(v, nil) {
					return
				}
			}
			var zero {{ renderType $m.Sequence.Elem }}
			yield(zero, err)
		}
	}
	return s
}
{{ end }}
{{ end }}
// --- {{ $stub }} ---

// The double-runtime witness for the surface this double rides. A
// breaking change to the runtime renames it, and this file stops
// compiling with the skew named.
var _ = {{ renderExpr (external $.RuntimeStub "CompatV1") }}

// {{ $stub }}Option configures a [{{ $stub }}] at construction time.
type {{ $stub }}Option{{ renderTypeParams .TypeParams }} func(*{{ $stub }}{{ .TypeArgs }})

// {{ $stub }}Strict makes an unconfigured method fail the test rather than
// return its zero value, which turns a call nobody planned for into a failure
// at the call site instead of a puzzling zero further downstream.
func {{ $stub }}Strict{{ renderTypeParams .TypeParams }}() {{ $stub }}Option{{ .TypeArgs }} {
	return func(s *{{ $stub }}{{ .TypeArgs }}) { s.strict = true }
}

// {{ $stub }}DelegateTo wraps a real implementation: every method forwards to
// impl and is recorded on the double on the way through.
//
// This is what lets one generated suite run against both the double and the
// production type, which is the point of conformance testing.
func {{ .DelegateToName }}{{ renderTypeParams .TypeParams }}(impl {{ renderExpr .IfaceRef }}{{ .TypeArgs }}) {{ $stub }}Option{{ .TypeArgs }} {
	return func(s *{{ $stub }}{{ .TypeArgs }}) {
{{- range .Methods }}
		s.{{ .OnField }}.Func(impl.{{ .Name }})
{{- end }}
	}
}

// {{ $stub }}WithClock drives latency and time-windowed faults from clk
// rather than from wall time, so a test asserting on a five-second timeout
// does not take five seconds.
func {{ $stub }}WithClock{{ renderTypeParams .TypeParams }}(clk {{ renderExpr (external $.RuntimeClock "Clock") }}) {{ $stub }}Option{{ .TypeArgs }} {
	return func(s *{{ $stub }}{{ .TypeArgs }}) { s.group.SetClock(clk) }
}

// {{ $stub }}WithRandSource makes probabilistic fault injection reproducible.
// A failure nobody can replay is not a finding.
func {{ $stub }}WithRandSource{{ renderTypeParams .TypeParams }}(src {{ renderExpr (external $.RuntimeRand "Source") }}) {{ $stub }}Option{{ .TypeArgs }} {
	return func(s *{{ $stub }}{{ .TypeArgs }}) { s.group.SetRandSource(src) }
}

// {{ $stub }}BenchMode disables call recording. Dispatch still works; only
// the accumulating call log is dropped, because its allocations are what a
// benchmark would otherwise be measuring.
func {{ $stub }}BenchMode{{ renderTypeParams .TypeParams }}() {{ $stub }}Option{{ .TypeArgs }} {
	return func(s *{{ $stub }}{{ .TypeArgs }}) { s.group.BenchMode() }
}
{{ range $m := .Methods }}
// With{{ $iface }}{{ $m.Name }} sets {{ $m.Name }}'s body at construction
// time, for the common case of configuring one method and taking the
// defaults for the rest.
func With{{ $iface }}{{ $m.Name }}{{ renderTypeParams $.TypeParams }}(fn func({{ template "stub.paramtypes" $m }}) {{ template "stub.results" $m }}) {{ $stub }}Option{{ $.TypeArgs }} {
	return func(s *{{ $stub }}{{ $.TypeArgs }}) { s.{{ $m.OnField }}.Func(fn) }
}
{{ end }}
// {{ $stub }} is a recording test double for {{ $iface }}.
//
// Each On<Method> field is that method's configuration point. Left alone, a
// method returns its zero value and records the call.
type {{ $stub }}{{ renderTypeParams .TypeParams }} struct {
{{- range .Methods }}
{{- if .From }}
	// {{ .OnField }} configures {{ .Name }}, contributed by {{ .From }}.
{{- end }}
	{{ .OnField }} *{{ .StubType }}{{ $.TypeArgs }}
{{- end }}

	// group is every method stub above, viewed through the surface that
	// does not depend on a signature — one home for the settings and the
	// lifecycle that apply to the whole double.
	group *{{ renderExpr (external $.RuntimeStub "Group") }}
{{- if .Ordered }}

	order *{{ renderExpr (external $.RuntimeStub "OrderTracker") }}
{{- end }}
	strict bool
}

{{ if or (not .TypeParams) .Witnesses }}
// Compile-time proof that {{ $stub }} satisfies {{ $iface }}.
//
// It lives here rather than in the companion so a drifted signature fails
// `go build` rather than waiting for a test run — the double is unusable the
// moment it stops satisfying the interface, and that is worth learning at the
// earliest point it can be known.
{{- if .Witnesses }}
//
// A generic double is asserted at one instantiation. It never branches on its
// type parameters, so satisfying the interface at these types means satisfying
// it at every type the constraints admit.
{{- end }}
var _ {{ renderExpr .IfaceRef }}{{ template "stub.doublewitness" . }} = (*{{ $stub }}{{ template "stub.doublewitness" . }})(nil)
{{ end }}
// New{{ $stub }} returns a double bound to tb.
//
// Passing tb registers a cleanup that verifies every method's call-count
// expectations when the test ends, so an unmet Times is reported without the
// caller remembering to check. A nil tb skips that, which is what benchmarks
// and non-test callers want.
func {{ .CtorName }}{{ renderTypeParams .TypeParams }}(tb {{ renderExpr (external "testing" "TB") }}, opts ...{{ $stub }}Option{{ .TypeArgs }}) *{{ $stub }}{{ .TypeArgs }} {
	s := &{{ $stub }}{{ .TypeArgs }}{
{{- range .Methods }}
		{{ .OnField }}: &{{ .StubType }}{{ $.TypeArgs }}{MethodStub: {{ renderExpr (external $.RuntimeStub "NewMethodStub") }}[{{ .CallType }}{{ $.TypeArgs }}](tb, "{{ $iface }}.{{ .Name }}")},
{{- end }}
	}
	s.group = {{ renderExpr (external $.RuntimeStub "NewGroup") }}(
{{- range .Methods }}
		s.{{ .OnField }}.MethodStub,
{{- end }}
	)
	for _, opt := range opts {
		opt(s)
	}
	if s.strict {
		s.group.StrictAll()
	}
{{- if .Ordered }}
	// Allocated after the options run: the tracker only fails the test in
	// strict mode, so it has to be told which mode it is in.
	s.order = {{ renderExpr (external $.RuntimeStub "NewOrderTracker") }}(tb, s.strict)
{{- end }}
	s.group.Bind(tb)
	return s
}

// ResetCalls clears recorded calls, fault counters, and call-count
// expectations. Func and Returns configuration is deliberately preserved, so
// a test can reuse one double across phases without rebuilding it.
func (s *{{ $stub }}{{ .TypeArgs }}) ResetCalls() {
	s.group.Reset()
{{- if .Ordered }}
	s.order.Reset()
{{- end }}
}

// --- Interface methods ---
{{ range $m := .Methods }}
{{- if not $m.HasResults }}
// invokeVoid adapts the Func override to the shape [stub.Answer] consumes.
// A method returning nothing still has an override worth dispatching to and
// a call worth recording; the empty struct is the return tuple of no returns.
func ({{ $m.ReceiverIdent }} *{{ $m.StubType }}{{ $.TypeArgs }}) invokeVoid({{ template "stub.paramdecls" $m }}) func() struct{} {
	if {{ $m.ReceiverIdent }}.fn == nil {
		return nil
	}
	return func() struct{} {
		{{ $m.ReceiverIdent }}.fn({{ stub_args $m.Sig }})
		return struct{}{}
	}
}
{{ end }}
{{- if $m.HasResults }}
// invoke adapts the Func override to the shape [stub.Answer] consumes, or
// returns nil when no override is set — which is how Answer tells "no
// override" from "an override that returns zero".
func ({{ $m.ReceiverIdent }} *{{ $m.StubType }}{{ $.TypeArgs }}) invoke({{ template "stub.paramdecls" $m }}) func() {{ $m.ReturnType }}{{ $.TypeArgs }} {
	if {{ $m.ReceiverIdent }}.fn == nil {
		return nil
	}
	return func() {{ $m.ReturnType }}{{ $.TypeArgs }} {
		{{ stub_locals $m.Sig }} := {{ $m.ReceiverIdent }}.fn({{ stub_args $m.Sig }})
		return {{ $m.ReturnType }}{{ $.TypeArgs }}{ {{- stub_localFields $m.Sig -}} }
	}
}
{{ end }}
// {{ $m.Name }} records the call and answers it.
//
// Which arm answers — injected fault, Func override, Returns fallback, or the
// zero value — is [stub.Answer]'s to decide, so every generated double
// resolves a call the same way and the ordering is tested once rather than
// restated per method.
func ({{ $m.ReceiverIdent }} *{{ $stub }}{{ $.TypeArgs }}) {{ $m.Name }}({{ template "stub.paramdecls" $m }}) {{ template "stub.namedresults" $m }} {
{{- if $m.Deprecated }}
	if tb := {{ $m.ReceiverIdent }}.{{ $m.OnField }}.TB(); tb != nil {
		tb.Logf("{{ $iface }}.{{ $m.Name }} is deprecated")
	}
{{- end }}
{{- if $m.OrderAfter }}
	{{ $m.ReceiverIdent }}.order.AssertAfter("{{ $m.Name }}", "{{ $m.OrderAfter }}")
{{- end }}
{{- if $.Ordered }}
	defer {{ $m.ReceiverIdent }}.order.Record("{{ $m.Name }}")
{{- end }}
	call := {{ $m.CallType }}{{ $.TypeArgs }}{ {{- stub_callFields $m.Sig -}} }
{{- if $m.HasResults }}
	r := {{ renderExpr (external $.RuntimeStub "Answer") }}({{ $m.ReceiverIdent }}.{{ $m.OnField }}.MethodStub, &call, {{ renderExpr (external $.RuntimeStub "Arms") }}[{{ $m.CallType }}{{ $.TypeArgs }}, {{ $m.ReturnType }}{{ $.TypeArgs }}]{
		Invoke:   {{ $m.ReceiverIdent }}.{{ $m.OnField }}.invoke({{ stub_args $m.Sig }}),
		Fallback: {{ $m.ReceiverIdent }}.{{ $m.OnField }}.fallback,
{{- with $err := $m.ErrReturn }}
		Fault:    func(err error) {{ $m.ReturnType }}{{ $.TypeArgs }} { return {{ $m.ReturnType }}{{ $.TypeArgs }}{ {{- $err.Field }}: err} },
{{- end }}
		Stamp: func(c *{{ $m.CallType }}{{ $.TypeArgs }}, r {{ $m.ReturnType }}{{ $.TypeArgs }}) {
{{- range $m.Returns }}
			c.{{ .Field }} = r.{{ .Field }}
{{- end }}
		},
	})
	return {{ stub_reads "r" $m.Sig }}
{{- else }}
	{{ renderExpr (external $.RuntimeStub "Answer") }}({{ $m.ReceiverIdent }}.{{ $m.OnField }}.MethodStub, &call, {{ renderExpr (external $.RuntimeStub "Arms") }}[{{ $m.CallType }}{{ $.TypeArgs }}, struct{}]{
		Invoke: {{ $m.ReceiverIdent }}.{{ $m.OnField }}.invokeVoid({{ stub_args $m.Sig }}),
	})
{{- end }}
}
{{ end }}
{{- end -}}

{{- /* Only the lists that spell a type live here. Everything else — argument
       lists, field assignments, capture locals — is a Go helper in eidos's
       lang/golang, reached under this plugin's own `stub_` prefix, because
       renderType is the one thing a plain function cannot do: it registers the
       rendered file's imports and elides the same-package qualifier. Each of
       those helpers takes the whole projection, `.Sig`, rather than a slice of
       parameters or returns: the field, local and error-slot conventions are
       the projection's, and a caller reconstructing them is the duplication
       they exist to remove.

       Every reference into testkit's runtime goes through the backend's own
       `external <path> <Symbol>`, which registers the import as it renders.
       The paths come off the emit value ($.RuntimeStub and friends) rather
       than being spelled here, so the module path lives in one Go constant
       and this plugin registers no helper of its own. */ -}}

{{- /* A sequence helper ignores the call's arguments — it answers the same way
       however it was called — so the generated closure blanks them. */ -}}
{{- define "stub.blankparams" -}}
{{ range $i, $p := .Params }}{{ if $i }}, {{ end }}_ {{ if $p.Variadic }}...{{ end }}{{ renderType $p.Type }}{{ end }}
{{- end -}}

{{- define "stub.yieldparams" -}}
{{ renderType .Sequence.Elem }}{{ if .Sequence.Second }}, {{ renderType .Sequence.Second }}{{ end }}
{{- end -}}

{{- define "stub.yieldargs" -}}
v{{ if .Sequence.Second }}, {{ if .Sequence.YieldsError }}nil{{ else }}v{{ end }}{{ end }}
{{- end -}}

{{- define "stub.paramtypes" -}}
{{ range $i, $p := .Params }}{{ if $i }}, {{ end }}{{ if $p.Variadic }}...{{ end }}{{ renderType $p.Type }}{{ end }}
{{- end -}}

{{- define "stub.paramdecls" -}}
{{ range $i, $p := .Params }}{{ if $i }}, {{ end }}{{ $p.Name }} {{ if $p.Variadic }}...{{ end }}{{ renderType $p.Type }}{{ end }}
{{- end -}}

{{- define "stub.results" -}}
{{- if eq (len .Returns) 0 }}
{{- else if eq (len .Returns) 1 }}{{ renderType (index .Returns 0).Type }}
{{- else }}({{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}{{ renderType $r.Type }}{{ end }})
{{- end -}}
{{- end -}}

{{- define "stub.namedresults" -}}
{{- if eq (len .Returns) 0 }}
{{- else if not .NamedReturns }}{{ template "stub.results" . }}
{{- else }}({{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}{{ $r.Name }} {{ renderType $r.Type }}{{ end }})
{{- end -}}
{{- end -}}

{{- /* Returns is part of the consumer-facing surface, so its parameters are
       named after the recorded-call fields — `result`, `err` — rather than
       after the internal capture locals. */ -}}
{{- define "stub.returnparams" -}}
{{ range $i, $r := .Returns }}{{ if $i }}, {{ end }}{{ camel $r.Field }} {{ renderType $r.Type }}{{ end }}
{{- end -}}

{{- /* The concrete instantiation the compile-time guard uses — `[string, int]`,
       or nothing at all for a non-generic double. */ -}}
{{- define "stub.doublewitness" -}}
{{- if .Witnesses }}[{{ range $i, $w := .Witnesses }}{{ if $i }}, {{ end }}{{ renderType $w }}{{ end }}]{{ end }}
{{- end -}}
