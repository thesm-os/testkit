{{- /* Returns() helper partial: emitted per HasResults non-skip
       method. Sets the per-method stub's fallback record so
       methods without an OnX.Func override return a fixed value. */ -}}
{{- define "helper-returns" -}}
{{- $tracker := .Spec.Tracker -}}
{{ range $m := .Methods }}{{ if and (not $m.Skip) $m.HasResults }}
// Returns sets a fixed return value for {{ $m.Name }}.
func (s *{{ $m.QualStubType }}) Returns({{ $m.ReturnParams $tracker }}) *{{ $m.QualStubType }} {
	s.fallback = &{{ $m.QualReturnType }}{ {{ $m.ReturnFieldAssign $tracker }} }
	return s
}
{{ end }}{{ end -}}
{{- end -}}
