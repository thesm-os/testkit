{{- /* FaultMiss helper partial: emitted per non-skip method whose
       result list is a non-empty value tuple followed by a bool, no
       error (ReaderWithBool: `(V, bool)`; Lookup: `(V0, V1, bool)`).
       The helper installs a zero-valued fallback record so dispatch
       surfaces the canonical "miss" outcome — every non-bool result
       is its zero, the trailing bool is false. Equivalent to
       Returns(<zeros>, false), provided as sugar so consumers don't
       re-spell the zeros. Single-bool Predicates are excluded by
       HasTrailingBool — they would conflate a fault with a
       legitimate `false` outcome. */ -}}
{{- define "helper-miss" -}}
{{- $tracker := .Spec.Tracker -}}
{{ range $m := .Methods }}{{ if and (not $m.Skip) $m.HasTrailingBool }}
// FaultMiss configures the dispatch to surface the canonical "miss"
// outcome for {{ $m.Name }} — ({{ $m.MissResultsTuple $tracker }}).
// Equivalent to Returns({{ $m.MissResultsTuple $tracker }}).
func (s *{{ $m.QualStubType }}) FaultMiss() *{{ $m.QualStubType }} {
	var miss {{ $m.QualReturnType }}
	s.fallback = &miss
	return s
}
{{ end }}{{ end -}}
{{- end -}}
