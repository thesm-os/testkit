{{- /* DelegateTo option partial: wraps a real implementation.
       Configures Func() on every per-method stub to forward to
       impl's corresponding method. Calls flow through the stub's
       recording layer (so DelegateTo doesn't lose visibility). */ -}}
{{- define "option-delegate" -}}
{{- $iface := .Spec.QualifiedType -}}
{{- $tpDecl := .Spec.TypeParamDecl -}}
{{- $tpArgs := .Spec.TypeParamArgs -}}
// {{ .StubName }}DelegateTo wraps a real implementation — calls without
// an OnX override delegate to it.
func {{ .StubName }}DelegateTo{{ $tpDecl }}(impl {{ $iface }}) {{ .StubName }}Option{{ $tpArgs }} {
	return func(s *{{ .StubName }}{{ $tpArgs }}) {
{{- range $m := .Methods }}{{ if not $m.Skip }}
		s.On{{ $m.Name }}.Func(impl.{{ $m.Name }})
{{- end }}{{ end }}
	}
}
{{- end -}}
