{{- /* Records-call-args subtest per non-skip method that has at
       least one non-ctx, comparable parameter. Verifies the
       generated dispatch's ParamFieldAssign block stamps each
       non-ctx param onto the Call struct's per-param field. The
       sample values that go in must come back out identically.

       Variadic params are dropped (the call uses `f()` form) and
       function- and channel-typed params are silently skipped
       (cmp.Diff panics on those). */ -}}
{{- define "test-method-call-args" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- range $m := .Methods }}{{ if and (not $m.Skip) $m.HasAssertableNonCtxParams }}
	t.Run("{{ $m.Name }}/records call args", func(t *testing.T) {
		t.Parallel()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(t)
{{- if $m.HasResults }}
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.SampleArgs $tracker) }})
{{- else }}
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.SampleArgs $tracker) }})
{{- end }}
		call := s.On{{ $m.Name }}.LastCall(t)
		{{ $.Spec.SubstituteTypeParams ($m.ParamFieldAsserts $tracker (printf "%s records args" $m.Name) "call") }}
	})
{{ end }}{{ end -}}
{{- end -}}
