{{- /* The <Stub> top-level struct partial. Carries one On<Method>
       per non-skip method, plus the optional OrderTracker (when
       any method has //testkit:order-after) and the strict-mode
       flag set by the [Strict] option. */ -}}
{{- define "stub-struct" -}}
{{- $iface := .Spec.QualifiedType -}}
{{- $tpDecl := .Spec.TypeParamDecl -}}
// {{ .StubName }} is a configurable test double for [{{ $iface }}].
type {{ .StubName }}{{ $tpDecl }} struct {
{{- range $m := .Methods }}{{ if not $m.Skip }}
	On{{ $m.Name }} *{{ $m.QualStubType }}
{{- end }}{{ end }}
{{- if .HasOrderConstraint }}
	order *stub.OrderTracker
{{- end }}
	strict bool
}
{{- end -}}
