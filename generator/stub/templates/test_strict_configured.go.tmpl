{{- /* Strict-mode-with-configured-method subtest, paired with
       test-method-strict (which verifies the unconfigured-method
       fatal). This subtest verifies the inverse: when the user
       installs a Func() override, strict mode must NOT fatal —
       FailUnexpectedCall is only reached on the truly-unconfigured
       fall-through path.

       Picks FirstNonSkipMethod as a representative — Strict
       propagates identically to every per-method stub. The
       FailableTB confirms the absence of any t.Fatalf. */ -}}
{{- define "test-iface-strict-configured" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $stub := .StubName -}}
{{- $gq := .GenQualifier -}}
{{- with $m := .FirstNonSkipMethod }}
	t.Run("Strict mode passes when method is configured", func(t *testing.T) {
		t.Parallel()
		f := testkit.NewFailableTB()
		s := {{ $gq }}New{{ $stub }}{{ $.TestTypeArgs }}(f, {{ $gq }}{{ $stub }}Strict{{ $.TestTypeArgs }}())
		s.On{{ $m.Name }}.Func(func({{ $.Spec.SubstituteTypeParams ($m.ParamList $tracker) }}){{ if $m.HasResults }} {{ $.Spec.SubstituteTypeParams ($m.ResultList $tracker) }}{{ end }} {
{{- if $m.HasResults }}
			return {{ $.Spec.SubstituteTypeParams ($m.ZeroResults $tracker) }}
{{- end }}
		})
{{- if $m.HasResults }}
		{{ $m.BlankResults }} = s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- else }}
		s.{{ $m.Name }}({{ $.Spec.SubstituteTypeParams ($m.ZeroArgs $tracker) }})
{{- end }}
		testkit.False(t, f.Failed(), "{{ $m.Name }}: strict + configured must not fatal")
	})
{{- end }}
{{- end -}}
