{{- /* Per-method return-record partial: emits one
       <lowerStub><Method>Return struct per HasResults non-skip
       method. Carries the result fields the fallback path stamps
       into, plus the constructor used by Returns(). */ -}}
{{- define "per-method-return" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $tpDecl := .Spec.TypeParamDecl -}}
{{ range $m := .Methods }}{{ if and (not $m.Skip) $m.HasResults }}
type {{ $m.ReturnType }}{{ $tpDecl }} struct {
{{- range $f := $m.CallStructFields $tracker }}{{ if $f.IsResult }}
	{{ $f.Name }} {{ $f.TypeStr }}
{{- end }}{{ end }}
}
{{ end }}{{ end -}}
{{- end -}}
