{{- /* Per-method stub type partial: emits one <Stub><Method>
       struct per non-skip method, embedding *stub.MethodStub[Call]
       plus the function-override (fn) and fallback-record fields.

       Type doc lists ONLY the method-specific helpers the stub adds
       on top of the inherited stub.MethodStub + Recorder surface.
       The package-level doc covers the inherited surface in one
       place — repeating it on every per-method type would balloon
       the file with copy-paste documentation. */ -}}
{{- define "per-method-stub" -}}
{{- $tracker := .Spec.Tracker -}}
{{- $tpDecl := .Spec.TypeParamDecl -}}
{{ range $m := .Methods }}{{ if not $m.Skip }}
// {{ $m.StubType }} controls dispatch and observation for {{ $m.Name }}.
// Method-specific helpers (see the package doc for the inherited
// stub.MethodStub + Recorder surface):
//
//   - Func(fn)              — install a function override.
{{- if $m.HasResults }}
//   - Returns(vals…)        — install a fixed return value (fallback).
{{- end }}
{{- range $sentinel := $m.Errors }}
//   - Fault{{ $sentinel.ShortName }}()        — fault returning {{ $sentinel.VarName }}{{ if $m.WrappedVia }} wrapped via {{ $m.WrappedVia.VarName }}{{ end }}.
{{- end }}
{{- if $m.RetryN }}
//   - RetrySchedule(err)    — fail {{ $m.RetryN }}-1 times, then succeed.
{{- end }}
{{- with $p := $m.Partition }}
//   - FaultForPartition(key, err, n)         — fault when {{ $p.FieldPath }} matches.
//   - FaultForOtherPartitions(key, err, n)   — fault when {{ $p.FieldPath }} differs.
{{- end }}
{{- $iter := $m.IterReturn $tracker -}}
{{- if or $iter.IsSeq $iter.Seq2Error }}
//   - Yields(items…)        — iterator yields the listed items.
{{- end }}
{{- if $iter.Seq2Error }}
//   - YieldsError(items, err) — iterator yields items then a terminal error.
{{- end }}
{{- if $m.HasTrailingBool }}
//   - FaultMiss()           — dispatch surfaces (zero, false).
{{- end }}
type {{ $m.StubType }}{{ $tpDecl }} struct {
	*stub.MethodStub[{{ $m.QualCallType }}]
	fn       {{ $m.FuncType $tracker }}
{{- if $m.HasResults }}
	fallback *{{ $m.QualReturnType }}
{{- end }}
}
{{ end }}{{ end -}}
{{- end -}}
