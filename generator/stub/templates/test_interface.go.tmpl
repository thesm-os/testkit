{{- /*
       Interface-level + per-method auto-test root template — composes
       the per-concern test partials. Each partial owns a single
       subtest concern and emits its own `range Methods | if not Skip`
       loop predicated on the relevant method shape (HasResults,
       ReturnsError, Errors, RetryN, Partition, iterator, OrderAfter,
       Deprecated, HasAssertableNonCtxParams,
       HasAssertableNonErrorResults).

       Output order (subtests group by concern, not by method — the
       impl templates use the same order-by-concern pattern):

       Per-method subtests (looped, predicated):
         - default              (always)
         - func                 (always)
         - returns              (HasResults, not iter)
         - records              (always)
         - call-args            (HasAssertableNonCtxParams)
         - call-results         (HasAssertableNonErrorResults, not iter)
         - onrecord             (always)
         - with-method          (always)
         - strict               (always)
         - fault                (when ReturnsError)
         - sentinel             (per //testkit:errors entry)
         - retry                (when RetryN > 0)
         - partition            (when Partition is set)
         - yields               (when iter.Seq / iter.Seq2)
         - orderafter           (when OrderAfter is set)
         - deprecated           (when Deprecated is set)
         - integrationonly      (when Skip)

       Interface-level subtests (single emission):
         - resetcalls
         - randsource
         - withclock
         - benchmode (recording-disabled invariant)
         - strict-configured (paired with per-method strict)
         - delegateto
*/ -}}
{{- define "test-interface" -}}
{{- $stub := .StubName -}}
{{- $type := .Spec.Interface.Name -}}

func Test{{ $stub }}(t *testing.T) {
	t.Parallel()
{{ if .HasErrorMethod }}	errTest := testkit.TestError("{{ $type }}-stub-test")
{{ end }}
{{ template "test-method-default" . }}
{{ template "test-method-func" . }}
{{ template "test-method-returns" . }}
{{ template "test-method-records" . }}
{{ template "test-method-call-args" . }}
{{ template "test-method-call-results" . }}
{{ template "test-method-onrecord" . }}
{{ template "test-method-with-method" . }}
{{ template "test-method-strict" . }}
{{ template "test-method-fault" . }}
{{ template "test-method-func-wins" . }}
{{ template "test-method-sentinel" . }}
{{ template "test-method-retry" . }}
{{ template "test-method-partition" . }}
{{ template "test-method-yields" . }}
{{ template "test-method-miss" . }}
{{ template "test-method-orderafter" . }}
{{ template "test-method-deprecated" . }}
{{ template "test-method-integrationonly" . }}
{{ template "test-iface-resetcalls" . }}
{{ template "test-iface-reset-preserves" . }}
{{ template "test-iface-times" . }}
{{ template "test-iface-randsource" . }}
{{ template "test-iface-withclock" . }}
{{ template "test-iface-benchmode" . }}
{{ template "test-iface-strict-configured" . }}
{{ template "test-iface-delegateto" . }}
}
{{- end -}}
