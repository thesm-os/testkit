{{- /* Yields / YieldsError helper partial: emitted per method whose
       return is iter.Seq[V] or iter.Seq2[V, error]. Yields handles
       both forms; YieldsError adds the trailing error yield for
       Seq2[V, error] specifically. */ -}}
{{- define "helper-yields" -}}
{{- $tracker := .Spec.Tracker -}}
{{ range $m := .Methods }}{{ if not $m.Skip }}
{{- $iter := $m.IterReturn $tracker }}
{{- if or $iter.IsSeq $iter.Seq2Error }}
// Yields configures the stub to yield items from an iterator.
func (s *{{ $m.QualStubType }}) Yields(items ...{{ $iter.ValType }}) *{{ $m.QualStubType }} {
	s.fn = func({{ $m.ParamList $tracker }}) {{ $m.ResultList $tracker }} {
{{- if $iter.Seq2Error }}
		return func(yield func({{ $iter.ValType }}, error) bool) {
			for _, item := range items {
				if !yield(item, nil) {
					return
				}
			}
		}
{{- else }}
		return func(yield func({{ $iter.ValType }}) bool) {
			for _, item := range items {
				if !yield(item) {
					return
				}
			}
		}
{{- end }}
	}
	return s
}
{{- end }}
{{- if $iter.Seq2Error }}

// YieldsError yields items then a final error.
func (s *{{ $m.QualStubType }}) YieldsError(items []{{ $iter.ValType }}, err error) *{{ $m.QualStubType }} {
	s.fn = func({{ $m.ParamList $tracker }}) {{ $m.ResultList $tracker }} {
		return func(yield func({{ $iter.ValType }}, error) bool) {
			for _, item := range items {
				if !yield(item, nil) {
					return
				}
			}
			var zero {{ $iter.ValType }}
			yield(zero, err)
		}
	}
	return s
}
{{- end }}
{{ end }}{{ end -}}
{{- end -}}
