{{- /* enum.set declares the variant list a check drives. Through the
       generated accessor where there is one, so it is exercised rather than
       merely emitted; a literal repeated here would agree with itself by
       construction. */ -}}
{{- define "enum.set" -}}
{{- if .Enumerates }}
	all := {{ renderExpr .ValuesRef }}()
{{- else }}
	all := []{{ renderExpr .TypeRef }}{
{{- range .Variants }}
		{{ renderExpr .Ref }},
{{- end }}
	}
{{- end }}
{{- end -}}

{{- define "enum.test" -}}
{{- $T := enumRef "testing.T" -}}
{{- $equal := enumRef "testkit.Equal" -}}
{{- $notEqual := enumRef "testkit.NotEqual" -}}
{{- $true := enumRef "testkit.True" -}}
{{- $false := enumRef "testkit.False" -}}
{{- $len := enumRef "testkit.Len" -}}
{{- $noError := enumRef "testkit.NoError" -}}
{{- $errorIs := enumRef "testkit.ErrorIs" -}}
{{- $t := renderExpr .TypeRef -}}
{{- $variants := .Variants -}}
{{- $n := len .Variants -}}
// Test{{ .TypeName }}Variants pins the declared set itself, which every other
// check here takes as given.
func Test{{ .TypeName }}Variants(t *{{ renderExpr $T }}) {
	t.Parallel()

{{ template "enum.set" . }}

	t.Run("declares exactly {{ $n }} variants", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A variant added without the handling it needs is the defect. The
		// count is the one place a reviewer is made to notice.
		{{ renderExpr $len }}(t, all, {{ $n }}, "{{ $.TypeName }} must declare {{ $n }} variants")
	})

	t.Run("no two variants share a value", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Two names for one value make one of their switch arms unreachable,
		// and the compiler has nothing to say about it.
		seen := map[{{ $t }}]bool{}
		for _, v := range all {
			{{ renderExpr $false }}(t, seen[v], "each variant must hold a distinct value")
			seen[v] = true
		}
	})
{{- if .Renders }}

	t.Run("no two variants share a textual form", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Parse maps text back to exactly one variant, so a collision makes
		// one of them unreachable through it.
		seen := map[string]bool{}
		for _, v := range all {
			{{ renderExpr $false }}(t, seen[v.String()], "each variant must render distinctly")
			seen[v.String()] = true
		}
	})
{{- end }}
{{- if .Validates }}

{{- if .OutOfRange }}

	t.Run("a value outside the set is not valid", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A conversion admits any value of the underlying type, so this is the
		// one place an undeclared value is turned away. An enum whose zero is
		// itself a variant has no other check that reaches this arm.
		{{ renderExpr $false }}(t, {{ $t }}({{ .OutOfRange }}).IsValid(), "an undeclared value must not be valid")
	})
{{- end }}

	t.Run("every declared variant is valid", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// IsValid is the only thing standing between a conversion and the rest
		// of the program, so a variant it rejects is one the type's own API
		// treats as corrupt.
		for _, v := range all {
			{{ renderExpr $true }}(t, v.IsValid(), "a declared variant must be valid")
		}
	})
{{- if .ZeroName }}

	t.Run("the zero value is {{ .ZeroName }}", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// An unset {{ .TypeName }} means {{ .ZeroName }} rather than nothing, so
		// a caller who forgot to set one gets a working value and no warning.
		// The neighbouring fixture makes the opposite choice.
		var zero {{ $t }}
		{{ renderExpr $true }}(t, zero.IsValid(), "the zero value is a declared variant")
		{{ renderExpr $equal }}(t, zero, {{ renderExpr (index $variants 0).Ref }}, "the zero value is {{ .ZeroName }}")
	})
{{- else }}

	t.Run("the zero value is not a declared variant", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// The declaration starts past zero, so an unset {{ .TypeName }} is
		// invalid rather than silently meaning the first variant.
		var zero {{ $t }}
		{{ renderExpr $false }}(t, zero.IsValid(), "the zero value must not be a variant")
	})
{{- end }}
{{- end }}
}
{{- if .Parses }}

// Test{{ .TypeName }}Text pins the round trip a value makes through anything
// that carries it as text — a log line, a JSON field, a database column.
func Test{{ .TypeName }}Text(t *{{ renderExpr $T }}) {
	t.Parallel()
{{ template "enum.set" . }}

	t.Run("every variant survives String and back", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A variant that renders one way and parses another is a value that
		// leaves the process and does not come home.
		for _, v := range all {
			got, err := {{ renderExpr .ParseRef }}(v.String())
			{{ renderExpr $noError }}(t, err, "a declared variant must parse back")
			{{ renderExpr $equal }}(t, got, v, "the round trip must be lossless")
		}
	})

	t.Run("text naming no variant is refused", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// Admitting it would let an unnamed value in through the one door
		// that exists to keep it out.
		_, err := {{ renderExpr .ParseRef }}("{{ .TypeName }}__no_such_variant")
		{{ renderExpr $errorIs }}(t, err, {{ renderExpr .SentinelRef }}, "unknown text must be refused")
	})
{{- if .OutOfRange }}

	t.Run("a value outside the set does not render as one inside it", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// A conversion admits any value of the underlying type. One whose
		// fallback collided with a declared variant's text would be
		// indistinguishable from it in a log.
		out := {{ $t }}({{ .OutOfRange }})
		for _, v := range all {
			{{ renderExpr $notEqual }}(t, out.String(), v.String(), "an undeclared value must render distinctly")
		}
	})
{{- end }}
}
{{- end }}
{{- if and .Encodes (not .Marshals) }}

// Test{{ .TypeName }}Marshalling pins the encoding half, which is all that
// exists here — the decoder rides with Parse, and Parse was not generated.
func Test{{ .TypeName }}Marshalling(t *{{ renderExpr $T }}) {
	t.Parallel()
{{ template "enum.set" . }}

	t.Run("every variant marshals to its textual form", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// The encoder and String must agree, or a value reads one way in a log
		// and another on the wire.
		for _, v := range all {
			text, err := v.MarshalText()
			{{ renderExpr $noError }}(t, err, "a declared variant must marshal")
			{{ renderExpr $equal }}(t, string(text), v.String(), "the encoding must match String")
		}
	})
}
{{- end }}
{{- if .Marshals }}

// Test{{ .TypeName }}Marshalling pins the encoding boundary, which is where a
// value most often crosses out of the program's control.
func Test{{ .TypeName }}Marshalling(t *{{ renderExpr $T }}) {
	t.Parallel()
{{ template "enum.set" . }}

	t.Run("every variant survives a marshal round trip", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		for _, v := range all {
			text, err := v.MarshalText()
			{{ renderExpr $noError }}(t, err, "a declared variant must marshal")
			var got {{ $t }}
			{{ renderExpr $noError }}(t, got.UnmarshalText(text), "and unmarshal back")
			{{ renderExpr $equal }}(t, got, v, "the round trip must be lossless")
		}
	})

	t.Run("text naming no variant is refused on unmarshal", func(t *{{ renderExpr $T }}) {
		t.Parallel()
		// The decoder is the boundary an unnamed value arrives at, so refusing
		// here is what keeps it out of everything downstream.
		var got {{ $t }}
		{{ renderExpr $true }}(t, got.UnmarshalText([]byte("{{ .TypeName }}__no_such_variant")) != nil,
			"unknown text must not decode")
	})
}
{{- end }}
{{- end -}}
