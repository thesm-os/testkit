{{- /*
The "enum-type" partial emits one top-level Test<Type>Enum function
covering exhaustiveness, distinctness, zero-value, wire
compatibility, and (gated by method-presence flags) stringer / parse
/ marshal round-trips.

Each Test<Type>Enum owns its wire-compat subtest, asserting just
its slice of the file-level Data.GoldenFile via
golden.AssertGoldenJSONField. One golden file per generation holds
every type's mapping; per-type drift fails only that subtest with a
diff scoped to its slice, while reviewers see all types' state in
one PR-friendly artifact.

Data input: a dict with two keys:
  - "Type"  — one enum.TypeData
  - "Local" — the enclosing enum.Data (for GoldenFile)

The dict shape is the standard text/template idiom for passing
multiple values to a sub-template.
*/ -}}
{{define "enum-type"}}
{{- $e := .Type}}{{- $local := .Local -}}

// Test{{$e.TypeName}}Enum verifies the *{{$e.Qualifier}}{{$e.TypeName}}
// enum's invariants — exhaustiveness, distinctness, zero-value
// alignment, wire compatibility against the committed golden, and
// (when the type implements them) stringer / parse / marshal
// round-trips.
func Test{{$e.TypeName}}Enum(t *testing.T) {
	t.Parallel()

	type enumEntry struct {
		value {{$e.Qualifier}}{{$e.TypeName}}
		name  string
{{- if $e.HasString}}
		want  string
{{- end}}
	}

	all := []enumEntry{
{{- range $e.Values}}
		{
			value: {{$e.Qualifier}}{{.Name}},
			name:  "{{.Name}}",
{{- if $e.HasString}}
			want:  "{{.ExpectedStr}}",
{{- end}}
		},
{{- end}}
	}

	// "exhaustive": the test set must include every declared
	// constant. Catches accidental drops during refactors.
	t.Run("exhaustive", func(t *testing.T) {
		t.Parallel()
		testkit.Len(t, all, {{len $e.Values}},
			"must have exactly {{len $e.Values}} values")
	})

{{- if $e.ZeroValueName}}

	// "zero value is {{$e.ZeroValueName}}": the type's zero value
	// (var x {{$e.TypeName}}) must match iota[0]. Catches reorderings
	// that silently change which value uninitialized variables take.
	t.Run("zero value is {{$e.ZeroValueName}}", func(t *testing.T) {
		t.Parallel()
		var zero {{$e.Qualifier}}{{$e.TypeName}}
		testkit.Equal(t, zero, {{$e.Qualifier}}{{$e.ZeroValueName}},
			"zero value must equal first iota declaration")
	})
{{- end}}

	// "all values are distinct": no two constants share an integer
	// value. Distinctness is required for errors.Is-style switches
	// and for wire compatibility.
	t.Run("all values are distinct", func(t *testing.T) {
		t.Parallel()
		seen := make(map[{{$e.Qualifier}}{{$e.TypeName}}]string)
		for _, tt := range all {
			prev, dup := seen[tt.value]
			testkit.False(t, dup,
				tt.name+" and "+prev+" have identical value")
			seen[tt.value] = tt.name
		}
	})
{{- if $e.HasString}}

	// "stringer": String() must return the canonical name for every
	// declared value. The canonical name comes from the inline comment
	// on each const declaration; the prefix-stripped fallback is used
	// when no comment is present.
	t.Run("stringer", func(t *testing.T) {
		t.Parallel()
		for _, tt := range all {
			t.Run(tt.name, func(t *testing.T) {
				t.Parallel()
				testkit.Equal(t, tt.value.String(), tt.want,
					tt.name+" String() must match")
			})
		}
	})

	// "out of range uses fallback format": values past MaxValue must
	// fall back to the fmt-formatted form (`{{$e.TypeName}}(N)`),
	// proving the stringer's default branch fires for unknown values.
	t.Run("out of range uses fallback format", func(t *testing.T) {
		t.Parallel()
		outOfRange := {{$e.Qualifier}}{{$e.TypeName}}(len(all))
		expected := fmt.Sprintf("{{$e.TypeName}}(%d)", len(all))
		testkit.Equal(t, outOfRange.String(), expected,
			"out-of-range value must use fallback format")
	})
{{- end}}
{{- if $e.HasParse}}

	// "parse round-trip": Parse<Type>(value.String()) must round-trip
	// to the original value. Catches divergence between the stringer
	// and the parser.
	t.Run("parse round-trip", func(t *testing.T) {
		t.Parallel()
		for _, tt := range all {
			t.Run(tt.name, func(t *testing.T) {
				t.Parallel()
				got, err := {{$e.Qualifier}}{{$e.ParseFunc}}(tt.value.String())
				testkit.NoError(t, err, "{{$e.ParseFunc}} must succeed for "+tt.name)
				testkit.Equal(t, got, tt.value,
					"{{$e.ParseFunc}} → String round-trip for "+tt.name)
			})
		}
	})

	// "parse rejects unknown string": defensive — the parser must
	// reject strings that don't correspond to any declared constant.
	t.Run("parse rejects unknown string", func(t *testing.T) {
		t.Parallel()
		_, err := {{$e.Qualifier}}{{$e.ParseFunc}}("<invalid-{{$e.TypeName}}>")
		testkit.Error(t, err, "{{$e.ParseFunc}} must reject unknown string")
	})
{{- end}}
{{- if $e.HasMarshalText}}

	// "marshal text round-trip": MarshalText followed by UnmarshalText
	// must yield the original value for every declared constant.
	t.Run("marshal text round-trip", func(t *testing.T) {
		t.Parallel()
		for _, tt := range all {
			t.Run(tt.name, func(t *testing.T) {
				t.Parallel()
				data, err := tt.value.MarshalText()
				testkit.NoError(t, err, "MarshalText must succeed for "+tt.name)
				var got {{$e.Qualifier}}{{$e.TypeName}}
				err = got.UnmarshalText(data)
				testkit.NoError(t, err, "UnmarshalText must succeed for "+tt.name)
				testkit.Equal(t, got, tt.value,
					"MarshalText → UnmarshalText round-trip for "+tt.name)
			})
		}
	})

	// "unmarshal rejects unknown text": symmetric to the parse-reject
	// subtest, ensuring the unmarshaler doesn't silently accept
	// arbitrary input.
	t.Run("unmarshal rejects unknown text", func(t *testing.T) {
		t.Parallel()
		var got {{$e.Qualifier}}{{$e.TypeName}}
		err := got.UnmarshalText([]byte("<invalid-{{$e.TypeName}}>"))
		testkit.Error(t, err, "UnmarshalText must reject unknown text")
	})
{{- end}}
{{- if $e.HasMarshalJSON}}

	// "json round-trip": json.Marshal followed by json.Unmarshal must
	// yield the original value for every declared constant. Uses the
	// stdlib encoders rather than the methods directly so the test
	// covers the actual JSON wire format.
	t.Run("json round-trip", func(t *testing.T) {
		t.Parallel()
		for _, tt := range all {
			t.Run(tt.name, func(t *testing.T) {
				t.Parallel()
				data, err := json.Marshal(tt.value)
				testkit.NoError(t, err, "json.Marshal must succeed for "+tt.name)
				var got {{$e.Qualifier}}{{$e.TypeName}}
				err = json.Unmarshal(data, &got)
				testkit.NoError(t, err, "json.Unmarshal must succeed for "+tt.name)
				testkit.Equal(t, got, tt.value,
					"json round-trip for "+tt.name)
			})
		}
	})

	// "json unmarshal rejects unknown": defensive — the unmarshaler
	// must reject JSON values that don't correspond to any constant.
	t.Run("json unmarshal rejects unknown", func(t *testing.T) {
		t.Parallel()
		var got {{$e.Qualifier}}{{$e.TypeName}}
		err := json.Unmarshal([]byte(`"<invalid-{{$e.TypeName}}>"`), &got)
		testkit.Error(t, err, "json.Unmarshal must reject unknown value")
	})
{{- end}}
{{- if $e.HasMarshalBinary}}

	// "binary round-trip": MarshalBinary followed by UnmarshalBinary
	// must yield byte-equal output and a value-equal result. Critical
	// for enums persisted to durable storage where wire format
	// stability is load-bearing.
	t.Run("binary round-trip", func(t *testing.T) {
		t.Parallel()
		for _, tt := range all {
			t.Run(tt.name, func(t *testing.T) {
				t.Parallel()
				data, err := tt.value.MarshalBinary()
				testkit.NoError(t, err, "MarshalBinary must succeed for "+tt.name)
				var got {{$e.Qualifier}}{{$e.TypeName}}
				err = got.UnmarshalBinary(data)
				testkit.NoError(t, err, "UnmarshalBinary must succeed for "+tt.name)
				testkit.Equal(t, got, tt.value,
					"MarshalBinary → UnmarshalBinary round-trip for "+tt.name)
				// Re-marshal must produce byte-identical output.
				data2, err := got.MarshalBinary()
				testkit.NoError(t, err, "second MarshalBinary must succeed")
				testkit.True(t, bytes.Equal(data, data2),
					"MarshalBinary must be deterministic for "+tt.name)
			})
		}
	})
{{- end}}

	// "wire compatibility": this type's slice of the consolidated
	// golden file at {{$local.GoldenFile}} must match the live
	// constant→int mapping. Reordering or renumbering any constant
	// fails this subtest until the golden is regenerated with
	// `go test -update`.
	//
	// Why this matters: enum integer values frequently end up
	// persisted to durable storage (databases, message queues, audit
	// logs). A silent reorder corrupts every existing record. CI runs
	// without `-update`, so accidental drift fails the build; a
	// deliberate change shows up in code review as a diff to the JSON
	// golden alongside the source change. The diff is scoped to this
	// type's slice — sibling types' values stay out of the way.
	t.Run("wire compatibility", func(t *testing.T) {
		t.Parallel()
		live, err := json.Marshal(map[string]int{
{{- range $e.Values}}
			"{{.Name}}": int({{$e.Qualifier}}{{.Name}}),
{{- end}}
		})
		testkit.NoError(t, err, "marshal live mapping")
		golden.AssertGoldenJSONField(t,
			"{{$local.GoldenFile}}", "{{$e.TypeName}}",
			live, golden.ShouldUpdate())
	})
}
{{end}}
